# Generated by ggg sync; DO NOT EDIT.
#
# Every key a selected module declares. Copy to .env and edit; .env is
# auto-loaded in development only and never overrides the real environment.
# Secrets are intentionally blank. Keys marked production-required have no
# fallback when APP_ENV=production.

# --- ggg/system/config ---

# development | test | production
# One of: development, test, production
APP_ENV=development

# Public base URL; trailing slash trimmed. Feeds auth and checkout redirects, email links, and webhook targets
APP_URL=http://localhost:8080

# debug | info | warn | error. Defaults to debug in development and info otherwise
LOG_LEVEL=

# RFC3339 instant that freezes the render clock, honored only when APP_ENV=test so visual baselines stay deterministic
TEST_NOW=

# --- ggg/system/analytics ---

# PostHog project key. Empty disables capture entirely: no client script, no `/ingest` proxy, server capture no-ops
POSTHOG_API_KEY=

# Target of the `/ingest` reverse proxy
POSTHOG_HOST=https://us.i.posthog.com

# --- ggg/system/database ---

# Postgres connection string. The dev default matches `docker compose up -d db`; production has no fallback because booting into the wrong database is worse than not booting
# Required when APP_ENV=production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gogogadget?sslmode=disable

# --- ggg/system/identity ---

# First sign-in with this address is granted the full admin role. Empty means nobody is staff
ADMIN_EMAIL=

# --- ggg/system/identity-clerk ---

# Clerk Frontend API origin, which feeds the CSP `connect-src`. Derived from APP_URL when unset: `https://clerk.<host>` in production, the Clerk dev wildcard otherwise
CLERK_FRONTEND_API_URL=

# Hosted Account Portal base, e.g. `https://accounts.your-app.com`
# Required when APP_ENV=production.
CLERK_PORTAL_URL=

# Drives the vendored clerk-js that keeps the `__session` JWT fresh
# Required when APP_ENV=production.
CLERK_PUBLISHABLE_KEY=

# Clerk API secret. Empty means auth is not configured and `/app` renders 503 (unless the dev bypass is on)
# Required when APP_ENV=production.
CLERK_SECRET_KEY=

# Verifies `svix-*` signatures on `/webhooks/clerk`
# Required when APP_ENV=production.
CLERK_WEBHOOK_SECRET=

# --- ggg/system/identity-dev ---

# Enables synthetic `e2e:` session tokens. true with APP_ENV=production is a hard boot error
DEV_AUTH_BYPASS=true

# --- ggg/system/llm ---

# With LLM_MODEL this enables `/api/v1/ai/chat`; empty returns 503 not_configured
LLM_API_KEY=

# Any OpenAI-compatible API base
LLM_BASE_URL=https://api.openai.com/v1

# Forced server-side, so callers cannot pick a model
LLM_MODEL=

# --- ggg/system/mail ---

# From header on outbound mail
EMAIL_FROM=GoGoGadget <hello@example.com>

# --- ggg/system/mail-resend ---

# Resend API key
RESEND_API_KEY=

# --- ggg/system/observability ---

# Sentry DSN. Empty selects the no-op reporter
SENTRY_DSN=

# --- ggg/system/audit ---

# The daily janitor deletes audit rows older than this many days; 0 retains forever
# Integer >= 0
AUDIT_RETENTION_DAYS=

# --- ggg/system/billing-polar ---

# Polar API token. Empty means billing routes render 503 not-configured
POLAR_ACCESS_TOKEN=

# Polar product id for the Pro plan
POLAR_PRODUCT_PRO=

# Polar product id for the Team plan
POLAR_PRODUCT_TEAM=

# sandbox | production
# One of: sandbox, production
POLAR_SERVER=sandbox

# Verifies `webhook-*` signatures on `/webhooks/polar`
POLAR_WEBHOOK_SECRET=

# --- ggg/system/rate-limit ---

# Per-IP request budget per minute (burst is 2x). Raise it for load tests and e2e harnesses, which drive a single IP hard
# Integer >= 1
RATE_LIMIT_RPM=100

# --- ggg/system/api ---

# Per-API-token request budget per minute (burst is 2x) on `/api/v1`. Independent of the per-IP shield because a token survives NAT and roaming, and can be rotated
# Integer >= 1
API_RATE_LIMIT_RPM=60

# --- ggg/system/server ---

# HTTP listen port
# Integer between 1 and 65535
PORT=8080

# --- ggg/system/metrics ---

# Bearer token for `GET /metrics`. Empty outside production leaves the scrape open; empty in production leaves the route unregistered, so internal stats are never public by default
METRICS_TOKEN=

# --- ggg/system/security ---

# true sheds everything except `/healthz`, `/readyz`, `/static/`, and `/favicon.ico` with a 503 page, and JSON 503 under `/api/`
MAINTENANCE_MODE=

# --- ggg/system/storage-s3 ---

# S3 access key id
STORAGE_R2_ACCESS_KEY_ID=

# R2 account id used for the default endpoint
STORAGE_R2_ACCOUNT_ID=

# S3 bucket name
STORAGE_R2_BUCKET=

# S3 secret access key
STORAGE_R2_SECRET_ACCESS_KEY=

# S3-compatible endpoint override; empty uses the R2 account endpoint
STORAGE_S3_ENDPOINT=
