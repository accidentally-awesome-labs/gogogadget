APP_ENV=development
APP_URL=http://localhost:8080
PORT=8080

# Postgres. Local default matches `docker compose up -d db`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gogogadget?sslmode=disable

# --- Clerk (auth) ---
# Leave empty to run with DEV_AUTH_BYPASS (zero SaaS accounts needed locally).
# All four CLERK_* keys are required when APP_ENV=production.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Account Portal base URL, e.g. https://accounts.your-app.com
CLERK_PORTAL_URL=
CLERK_PUBLISHABLE_KEY=
# Clerk Frontend API origin (feeds CSP connect-src).
# Dev default: https://*.clerk.accounts.dev — prod default: https://clerk.<APP_URL host>
CLERK_FRONTEND_API_URL=

# Email address granted the site-admin flag on first sign-in (see /docs/admin).
ADMIN_EMAIL=

# --- Polar.sh (billing) ---
# Empty → billing routes render 503 "not configured".
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_TEAM=
POLAR_SERVER=sandbox

# --- Resend (transactional email) ---
# Empty → DevSender: logs + writes rendered HTML to tmp/emails/.
RESEND_API_KEY=
EMAIL_FROM=GoGoGadget <hello@example.com>

# --- PostHog (product analytics) ---
# Empty → disabled (no client script, no /ingest proxy, server capture no-ops).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error tracking) ---
# Empty → disabled.
SENTRY_DSN=

# --- Storage (Cloudflare R2 / S3-compatible) ---
# Empty → DevStore: files land on local disk under tmp/uploads (zero accounts).
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=
# Override for AWS S3 / MinIO (e.g. http://localhost:9000); empty = R2 default.
STORAGE_R2_ENDPOINT=

# --- LLM (any OpenAI-compatible API) ---
# Empty → AI routes 503 not_configured (same degrade as billing).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Freeze the render clock (RFC3339). Honored only when APP_ENV=test — powers
# deterministic visual baselines.
TEST_NOW=

# Synthetic e2e session tokens (never honored in production — boot error there).
# Fresh clone runs the FULL app with zero SaaS accounts when true.
DEV_AUTH_BYPASS=true

# debug | info | warn | error. Default: debug in development, info otherwise.
LOG_LEVEL=
