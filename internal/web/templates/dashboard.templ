package templates

import "fmt"

templ StatCard(title, value, sub string) {
	<div class="card" data-testid="stat-card">
		<p class="text-sm text-fg-muted">{ title }</p>
		<p class="text-3xl font-bold mt-1">{ value }</p>
		if sub != "" {
			<p class="text-sm text-fg-muted mt-1">{ sub }</p>
		}
	</div>
}

templ Dashboard(d DashboardData) {
	<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

	<div x-data="checklist" x-show="!dismissed" x-cloak class="card mb-6">
		<div class="flex items-start justify-between">
			<div>
				<h2 class="font-semibold">Getting started</h2>
				<ul class="mt-3 space-y-2 text-sm text-fg-muted">
					<li>1. <a href="/app/projects/new" class="link">Create your first project</a></li>
					<li>2. <a href="/app/settings/org" class="link">Invite your team</a> (from the Clerk organization profile)</li>
					<li>3. <a href="/app/settings/billing" class="link">Review plans</a> when you outgrow free</li>
				</ul>
			</div>
			<button type="button" @click="dismiss" class="btn-ghost !px-2 text-sm" aria-label="Dismiss checklist">✕</button>
		</div>
	</div>

	<div class="grid sm:grid-cols-3 gap-4">
		@StatCard("Active projects", fmt.Sprint(d.ActiveProjects), "")
		@StatCard("Team members", fmt.Sprint(d.MemberCount), "")
		@StatCard("Current plan", d.Plan.Name, d.Plan.PriceDisplay)
	</div>

	<h2 class="text-lg font-semibold mt-10 mb-3">Recent activity</h2>
	<div class="card !p-0 overflow-hidden">
		if len(d.Recent) == 0 {
			<p class="p-6 text-sm text-fg-muted">Nothing yet — create a project to see activity here.</p>
		} else {
			<table class="table">
				<tbody>
					for _, row := range d.Recent {
						<tr>
							<td>{ row.ActorEmail }</td>
							<td><span class="badge bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300">{ row.Action }</span></td>
							<td class="text-right text-fg-muted"><span data-testid="relative-time">{ RelTime(d.Now, row.CreatedAt.Time) }</span></td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
