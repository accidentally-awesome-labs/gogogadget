package templates

import (
	"fmt"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

templ Dashboard(d DashboardData) {
	@PageHeader(i18n.T(ctx, "dashboard.title"))

	// One dismissible pattern for the whole product: data-key names the
	// localStorage entry, so the checklist needs no component of its own.
	<div x-data="dismissible" data-key="gg_checklist_dismissed" x-show="!hidden" x-cloak class="card mb-6">
		<div class="flex items-start justify-between">
			<div>
				<h2 class="font-semibold">{ i18n.T(ctx, "dashboard.getting_started") }</h2>
				<ul class="mt-3 space-y-2 text-sm text-fg-muted">
					<li>1. <a href="/app/projects/new" class="link">{ i18n.T(ctx, "dashboard.checklist.create_project") }</a></li>
					<li>2. <a href="/app/settings/org" class="link">{ i18n.T(ctx, "dashboard.checklist.invite_team") }</a> { i18n.T(ctx, "dashboard.checklist.invite_team_note") }</li>
					<li>3. <a href="/app/settings/billing" class="link">{ i18n.T(ctx, "dashboard.checklist.review_plans") }</a> { i18n.T(ctx, "dashboard.checklist.review_plans_note") }</li>
				</ul>
			</div>
			<button type="button" @click="dismiss()" class="btn btn-ghost btn-xs" aria-label={ i18n.T(ctx, "dashboard.checklist.dismiss") }>✕</button>
		</div>
	</div>

	<div class="grid sm:grid-cols-3 gap-4">
		@StatCard(i18n.T(ctx, "dashboard.stats.active_projects"), fmt.Sprint(d.ActiveProjects), "")
		@StatCard(i18n.T(ctx, "dashboard.stats.team_members"), fmt.Sprint(d.MemberCount), "")
		@StatCard(i18n.T(ctx, "dashboard.stats.current_plan"), d.Plan.Name, d.Plan.PriceDisplay)
	</div>

	@SectionHeading(i18n.T(ctx, "dashboard.recent_activity"), "mt-10 mb-3")
	@TableCard("") {
		if len(d.Recent) == 0 {
			@TableEmpty(i18n.T(ctx, "dashboard.recent_empty"))
		} else {
			<table class="table">
				<tbody>
					for _, row := range d.Recent {
						<tr>
							<td>{ row.ActorEmail }</td>
							<td>@Badge(row.Action, KindBrand)</td>
							<td class="text-right text-fg-muted"><span data-testid="relative-time">{ RelTime(d.Now, row.CreatedAt.Time) }</span></td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
