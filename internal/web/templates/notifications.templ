package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

// NotificationsBadge is the unread-bubble FRAGMENT returned by the badge
// endpoint: just the bubble (or nothing when unread == 0). The persistent
// span wrapper lives in the sidebar — it self-refreshes with the default
// innerHTML swap, so the shell never carries a drifted hx-swap literal.
templ NotificationsBadge(unread int64) {
	if unread > 0 {
		<span class="count-badge" aria-label={ i18n.T(ctx, "notifications.unread_aria", unread) }>{ fmt.Sprint(unread) }</span>
	}
}

// NotificationsPage is the list: unread rows bolded, per-row read buttons,
// read-all, pagination.
templ NotificationsPage(d NotificationsData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "notifications.title")}) {
		if d.Unread > 0 {
			<button
				type="button"
				hx-post="/app/notifications/read-all"
				hx-target="#notif-list"
				hx-swap="outerHTML"
				class="btn btn-ghost"
				data-testid="notifications-read-all"
			>{ i18n.T(ctx, "notifications.read_all") }</button>
		}
	}
	@NotificationsList(d)
}

// NotificationsList is the swap target (#notif-list) for read/read-all.
templ NotificationsList(d NotificationsData) {
	<div id="notif-list">
		if len(d.Items) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Title: i18n.T(ctx, "notifications.empty_title"), Body: i18n.T(ctx, "notifications.empty_body")})
		} else {
			@ui.TableCard(ui.TableCardOpts{Attrs: ui.Attrs{TestID: ""}}) {
				<ul class="divide-y divide-border">
					for _, n := range d.Items {
						<li class={ "flex items-start gap-3 px-4 py-3", templ.KV("font-medium", !n.ReadAt.Valid), "text-fg-muted", templ.KV("text-fg", !n.ReadAt.Valid) } data-testid="notification-row">
							<div class="flex-1 min-w-0">
								<p class="text-sm">{ n.Title }</p>
								if n.Body != "" {
									<p class="text-xs text-fg-muted mt-0.5">{ n.Body }</p>
								}
								<p class="text-xs text-fg-muted mt-1">{ n.CreatedAt.Time.Format("Jan 2, 2006 15:04") }</p>
							</div>
							<div class="flex items-center gap-2 shrink-0">
								if n.Url != "" {
									<a
										href={ templ.SafeURL(n.Url) }
										hx-boost="true"
										hx-target={ NavTarget }
										hx-select={ NavTarget }
										hx-swap={ NavSwap }
										class="btn btn-ghost btn-xs"
										data-testid="notification-link"
									>{ i18n.T(ctx, "notifications.open") }</a>
								}
								if !n.ReadAt.Valid {
									<button
										type="button"
										hx-post={ fmt.Sprintf("/app/notifications/%d/read", n.ID) }
										hx-target="#notif-list"
										hx-swap="outerHTML"
										class="btn btn-ghost btn-xs"
										data-testid="notification-read"
									>{ i18n.T(ctx, "notifications.mark_read") }</button>
								}
							</div>
						</li>
					}
				</ul>
			}
			@ui.Pagination(ui.PaginationOpts{Page: d.Page, TotalPages: d.TotalPages, BaseURL: "/app/notifications", Target: "#notif-list", Labels: pagerLabels(ctx)})
		}
	</div>
}
