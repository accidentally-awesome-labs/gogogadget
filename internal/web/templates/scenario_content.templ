package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// The content surface: an author editing a published page, with the rendered
// result beside the source.
//
// Two rules shape this composition and neither is cosmetic.
//
// First, the stored value is Markdown text and stays text. Nothing here reaches
// for templ's raw-HTML escape hatch, and the preview below is authored markup
// rather than a rendered string, so no path exists by which a document body
// could become live HTML. A WYSIWYG engine would store HTML and delete that
// guarantee.
//
// Second, the MediaPicker is nested inside the MarkdownEditor's children rather
// than placed beside it. Its insert buttons carry data-editor-action="insert"
// and are found by the editor controller through its own root: a picker
// rendered as a sibling looks identical, and every insert button in it silently
// does nothing.

// ScenarioContent renders the Markdown editing surface.
templ ScenarioContent(gc GalleryContext) {
	if gc.State == "success" {
		// Polite: the save finished without the author asking a question, so
		// interrupting their next sentence to say so is a cost with no benefit.
		@ui.Notice(ui.NoticeOpts{Kind: ui.KindSuccess, Live: ui.LivePolite, Attrs: ui.Attrs{TestID: "content-saved-notice"}}) {
			Draft saved as revision 12 on 15 January 2026 at 09:24 UTC. It is not published yet.
		}
	}
	if gc.State == "error" {
		// Assertive, because the author pressed Publish and the answer is no.
		// A refusal that waits for the next natural pause is a refusal the
		// author does not hear before they press it again.
		@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{TestID: "content-error-notice"}}) {
			The draft was not published. One field needs attention, and the body has been kept exactly as you left it.
		}
	}
	// The media upload's owning form, and deliberately a sibling of the save
	// form rather than a child: a nested <form> is discarded by the parser, so
	// the picker's file input reaches this one through HTML's form attribute
	// instead. Uploading a file and saving a draft are two different requests
	// and each needs its own destination.
	<form
		id="content-media-upload"
		action={ templ.SafeURL(contentAction()) }
		method="post"
		enctype="multipart/form-data"
		hidden
	></form>
	@ui.Form(ui.FormOpts{Method: "post", Action: contentAction(), Attrs: ui.Attrs{TestID: "content-editor-form"}}) {
		@ui.PanelGroup(ui.PanelGroupOpts{
			ID:          "content-editor-panels",
			PersistKey:  "scenario-content",
			Orientation: ui.OrientationHorizontal,
			Panels: []ui.PanelData{
				{ID: "content-draft", Title: "Draft", Level: 2, Size: 55, MinSize: 30, Content: contentDraftPanelBody(gc), Attrs: ui.Attrs{TestID: "content-draft-panel"}},
				{ID: "content-preview", Title: "Preview", Level: 2, Size: 45, MinSize: 30, Content: contentPreviewPanelBody(gc), Attrs: ui.Attrs{TestID: "content-preview-panel"}},
			},
		})
		@ui.FormActions(ui.FormActionsOpts{}) {
			@ui.Button(ui.ButtonOpts{Label: "Discard changes", Size: ui.SizeSM})
			@ui.Button(ui.ButtonOpts{Label: "Save draft", Type: ui.TypeSubmit, Size: ui.SizeSM})
			@ui.Button(ui.ButtonOpts{Label: "Publish", Type: ui.TypeSubmit, Action: ui.ActionPrimary, Size: ui.SizeSM})
		}
	}
	@ui.Section(ui.SectionOpts{Title: "Attachments", Level: 2, Attrs: ui.Attrs{ID: "content-attachments"}}) {
		@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true}) {
			Files linked from this page. Removing one here does not remove it from the media library.
		}
		<ul class="space-y-2" data-testid="content-attachments-list">
			for _, file := range contentAttachments(gc) {
				<li>
					@ui.Attachment(ui.AttachmentOpts{
						Name:    file.Name,
						Size:    file.Size,
						Href:    file.Href,
						Icon:    file.Icon,
						Actions: contentAttachmentActions(file),
					})
				</li>
			}
		</ul>
	}
}

// contentDraftPanelBody is the Draft panel's contents.
//
// The MediaPicker is nested inside the MarkdownEditor's children rather than
// placed beside it: its insert buttons are found by the editor controller
// through its own root, so a picker rendered as a sibling looks identical and
// every insert button in it silently does nothing.
templ contentDraftPanelBody(gc GalleryContext) {
	@ui.Label(ui.LabelOpts{For: "body", Text: "Body", Required: true})
	if contentBodyError(gc) == "" {
		@ui.Hint(ui.HintOpts{For: "body", Text: "Markdown. Headings, lists, links and images; raw HTML is stripped when the page is rendered."})
	}
	@ui.MarkdownEditor(ui.MarkdownEditorOpts{
		Name:        "body",
		Label:       "Body",
		Value:       contentBody(gc),
		Placeholder: "Start with a heading.",
		Hint:        "Markdown. Headings, lists, links and images; raw HTML is stripped when the page is rendered.",
		Error:       contentBodyError(gc),
		Rows:        14,
		MaxLength:   4000,
		Required:    true,
		// PreviewURL and MediaURL are deliberately unset. Both make the editor
		// issue requests, and the dev catalog serves no preview or media
		// fragment: a debounced request to a 404 on every keystroke is a broken
		// control that looks live. The preview beside this panel is
		// server-authored, and the media list is already in the DOM, so neither
		// needs a fetch to be real.
		Attrs: ui.Attrs{TestID: "content-body-editor"},
	}) {
		@ui.MediaPicker(ui.MediaPickerOpts{
			ID:          "content-media",
			UploadForm:  "content-media-upload",
			UploadLabel: "Drop an image here, or choose a file",
			EmptyLabel:  "No media in this space yet.",
			Items:       contentMedia(gc),
			Attrs:       ui.Attrs{TestID: "content-media-picker"},
		})
	}
}

// contentPreviewPanelBody is the Preview panel's contents.
templ contentPreviewPanelBody(gc GalleryContext) {
	@ui.EditorPreview(ui.EditorPreviewOpts{ID: "content-body-preview"}) {
		@contentPreviewBody(gc)
	}
}

// contentAttachmentActions is the trailing control cluster on one file row.
templ contentAttachmentActions(file contentFile) {
	@ui.IconButton(ui.IconButtonOpts{
		Icon:  ui.IconRemove,
		Label: "Unlink " + file.Name,
		Size:  ui.SizeSM,
	})
}

// contentPreviewBody is the rendered counterpart of the draft.
//
// It is authored markup, not a rendered string: the point of the whole surface
// is that a document body is Markdown text the server renders through one
// pipeline, and a fixture that reached for the raw-HTML escape hatch to fake
// that would be the exact hole this repository refuses to open.
templ contentPreviewBody(gc GalleryContext) {
	if gc.State == "error" {
		// The draft that failed validation has no heading, so the preview has
		// none either. A preview that disagrees with the source is worse than
		// no preview: the author trusts it and ships the wrong thing.
		<p>
			We rewrote how the scheduler claims work. It now takes a batch of rows in a single
			statement rather than one round trip per job, which is where most of the latency was.
		</p>
		<p>Batch size is capped, and a rejected batch falls back to single claims.</p>
	} else {
		<h2>{ contentTitle(gc) }</h2>
		<p>
			The scheduler now claims work in batches, which removes the per-job round trip that
			dominated queue latency on busy installs.
		</p>
		<ul>
			<li>Batch size is capped at 50 rows.</li>
			<li>A rejected batch falls back to single claims, so a contended queue still drains.</li>
			<li>Visibility timeouts are unchanged.</li>
		</ul>
		<blockquote>
			<p>Upgrading requires no migration. The change is entirely in the claim query.</p>
		</blockquote>
	}
}

// contentFile is one attachment fixture row.
type contentFile struct {
	Name string
	Size string
	Href string
	Icon ui.IconName
}

// contentAction is where the draft posts. The dev catalog serves the scenario
// path itself rather than a write endpoint, which is the same convention the
// component gallery's forms use: the markup is real, the destination is the
// page you are standing on.
func contentAction() string {
	return "/dev/scenarios/content"
}

// contentBody is the Markdown in the textarea. The error state carries a body
// that genuinely fails the stated rule, so the message and the value agree -
// an error banner over valid content teaches the reader to ignore the banner.
func contentBody(gc GalleryContext) string {
	if gc.State == "error" {
		return "We rewrote how the scheduler claims work. It now takes a batch of rows in a\n" +
			"single statement rather than one round trip per job, which is where most of\n" +
			"the latency was.\n\n" +
			"Batch size is capped, and a rejected batch falls back to single claims.\n"
	}
	return "## " + contentTitle(gc) + "\n\n" +
		"The scheduler now claims work in batches, which removes the per-job round trip\n" +
		"that dominated queue latency on busy installs.\n\n" +
		"- Batch size is capped at 50 rows.\n" +
		"- A rejected batch falls back to single claims, so a contended queue still drains.\n" +
		"- Visibility timeouts are unchanged.\n\n" +
		"> Upgrading requires no migration. The change is entirely in the claim query.\n"
}

// contentBodyError is the server's verdict on the body. It is empty in every
// state but error, because the editor reads it to set aria-invalid and to
// choose which element describes the control.
func contentBodyError(gc GalleryContext) string {
	if gc.State == "error" {
		return "The body must open with a heading before this page can be published."
	}
	return ""
}

// contentTitle stretches to a length that forces the preview column to wrap and
// the draft's first line to overflow, which is where a two-panel layout breaks
// if it is going to.
func contentTitle(gc GalleryContext) string {
	if gc.LongContent {
		return "Batched job claiming, visibility timeout changes, and what installs running a self-hosted worker pool need to check before upgrading"
	}
	return "Batched job claiming"
}

// contentMedia is the library the insert buttons write from. No thumbnails: a
// fixture pointing at an image that does not exist renders a broken icon and
// teaches the reader nothing about the component.
func contentMedia(gc GalleryContext) []ui.MediaItem {
	if gc.State == "error" {
		// The failed publish did not touch the library, so it is the same list.
		return contentMediaLibrary()
	}
	if gc.State == "success" {
		// The save carried the upload, so the new file is in the library and is
		// listed first: an upload that vanishes into alphabetical order looks
		// like an upload that failed.
		return append([]ui.MediaItem{
			{URL: "/static/images/queue-latency.png", Alt: "Queue latency before and after batching", Name: "queue-latency.png"},
		}, contentMediaLibrary()...)
	}
	return contentMediaLibrary()
}

func contentMediaLibrary() []ui.MediaItem {
	return []ui.MediaItem{
		{URL: "/static/images/scheduler-claim.png", Alt: "Sequence of a batched claim", Name: "scheduler-claim.png"},
		{URL: "/static/images/worker-pool.png", Alt: "Worker pool topology", Name: "worker-pool.png"},
		{URL: "/static/images/release-header.png", Alt: "Release note header artwork", Name: "release-header.png"},
	}
}

// contentAttachments is the file list under the editor.
func contentAttachments(gc GalleryContext) []contentFile {
	files := []contentFile{
		{Name: "scheduler-claim.png", Size: "184 KB", Href: "/static/images/scheduler-claim.png", Icon: ui.IconFile},
		{Name: "batching-benchmark.csv", Size: "12 KB", Href: "/static/files/batching-benchmark.csv", Icon: ui.IconChart},
		{Name: contentLongAttachmentName(gc), Size: "2.1 MB", Href: "/static/files/upgrade-checklist.pdf", Icon: ui.IconFile},
	}
	if gc.State == "success" {
		files = append(files, contentFile{
			Name: "queue-latency.png",
			Size: "96 KB",
			Href: "/static/images/queue-latency.png",
			Icon: ui.IconFile,
		})
	}
	return files
}

func contentLongAttachmentName(gc GalleryContext) string {
	if gc.LongContent {
		return "self-hosted-worker-pool-upgrade-checklist-for-installs-pinned-below-the-batched-claim-release.pdf"
	}
	return "upgrade-checklist.pdf"
}
