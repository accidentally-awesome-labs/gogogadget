package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"encoding/json"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// RelTime renders a relative timestamp (masked in visual tests).
func RelTime(now, t time.Time) string {
	d := now.Sub(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%d minutes ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%d hours ago", int(d.Hours()))
	case d < 30*24*time.Hour:
		return fmt.Sprintf("%d days ago", int(d.Hours()/24))
	default:
		return t.Format("Jan 2, 2006")
	}
}

func prettyMetadata(raw []byte) string {
	var v any
	if err := json.Unmarshal(raw, &v); err != nil {
		return string(raw)
	}
	pretty, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		return string(raw)
	}
	return string(pretty)
}

templ ActivityTable(rows []sqlc.ListAuditByOrgRow, now time.Time, page, totalPages int) {
	<div id="table-container">
		if len(rows) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Title: i18n.T(ctx, "activity.empty_title"), Body: i18n.T(ctx, "activity.empty_body")}) {
			}
		} else {
			@ui.TableCard(ui.TableCardOpts{Attrs: ui.Attrs{TestID: ""}}) {
				<table class="table">
					<thead>
						<tr><th>{ i18n.T(ctx, "activity.col_actor") }</th><th>{ i18n.T(ctx, "activity.col_action") }</th><th>{ i18n.T(ctx, "activity.col_when") }</th><th>{ i18n.T(ctx, "activity.col_details") }</th></tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr id={ fmt.Sprintf("audit-%d", row.ID) }>
								<td>{ row.ActorEmail }</td>
								<td>@ui.Badge(ui.BadgeOpts{Text: row.Action, Kind: ui.KindBrand})</td>
								<td>
									<span data-testid="relative-time" title={ row.CreatedAt.Time.Format(time.RFC3339) }>{ RelTime(now, row.CreatedAt.Time) }</span>
								</td>
								<td>
									if len(row.Metadata) > 2 {
										<details>
											<summary class="cursor-pointer text-fg-muted">{ i18n.T(ctx, "activity.metadata") }</summary>
											<pre class="text-xs mt-1 overflow-auto">{ prettyMetadata(row.Metadata) }</pre>
										</details>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			@ui.Pagination(ui.PaginationOpts{Page: page, TotalPages: totalPages, BaseURL: "/app/activity", Target: "#table-container", Labels: pagerLabels(ctx)})
		}
	</div>
}

templ ActivityPage(rows []sqlc.ListAuditByOrgRow, now time.Time, page, totalPages int) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "activity.title")})
	@ActivityTable(rows, now, page, totalPages)
}
