package templates

import (
	"context"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// ContentListData is the admin content table. Types comes straight from the
// registry, so filters and New buttons appear for a newly declared type
// without a template edit.
type ContentListData struct {
	Items      []sqlc.ContentEntry
	Types      []content.Type // registry order
	Kind       string         // "" = all
	Query      string
	Page       int
	TotalPages int
	Now        func() time.Time
}

// ContentErrors carries field-level validation messages back to the editor.
type ContentErrors struct {
	Title       string
	Slug        string
	Locale      string
	Summary     string
	Body        string
	PublishedAt string
	UnpublishAt string
	Meta        map[string]string
}

// ContentEditorData drives the create and edit form. ID 0 means "new".
type ContentEditorData struct {
	ID                                   int64
	Type                                 content.Type
	Locales                              []string // "" + i18n.Locales codes
	Title, Slug, Locale, Summary, BodyMd string
	Meta                                 map[string]string
	PublishedAt, UnpublishAt             string // datetime-local values
	Status                               string
	PreviewHTML                          string
	Revisions                            []sqlc.ContentRevision
	Media                                []sqlc.ContentMedium
	Errs                                 ContentErrors
}

// MediaData is the platform image library.
type MediaData struct {
	Items      []sqlc.ContentMedium
	Page       int
	TotalPages int
	Err        string
	Now        func() time.Time
}

// contentStatus is the badge an editor reads. It is COMPUTED from the same
// facts the public live predicate uses, never stored: a stored badge and a
// SQL predicate drift, and the badge is the one that lies.
func contentStatus(e sqlc.ContentEntry, now time.Time) string {
	if e.Status != "published" {
		return "draft"
	}
	if e.UnpublishAt.Valid && !e.UnpublishAt.Time.After(now) {
		return "expired"
	}
	if e.PublishedAt.Valid && e.PublishedAt.Time.After(now) {
		return "scheduled"
	}
	return "live"
}

// contentStatusKind maps the computed status onto the shared semantic axis.
func contentStatusKind(status string) ui.Kind {
	switch status {
	case "live":
		return ui.KindSuccess
	case "scheduled":
		return ui.KindWarn
	default: // expired, draft
		return ui.KindNeutral
	}
}

func contentNow(d ContentListData) time.Time {
	if d.Now != nil {
		return d.Now()
	}
	return time.Now()
}

func mediaNow(d MediaData) time.Time {
	if d.Now != nil {
		return d.Now()
	}
	return time.Now()
}

// typeLabel resolves a kind to its plural label through the registry list, so
// the table shows "Posts" rather than "post".
func typeLabel(types []content.Type, kind string) string {
	for _, t := range types {
		if t.Kind == kind {
			return t.PluralKey
		}
	}
	return ""
}

// mediaMarkdown is the string the copy button puts on the clipboard.
func mediaMarkdown(m sqlc.ContentMedium) string {
	return fmt.Sprintf("![%s](%s)", mediaAlt(m), mediaURL(m))
}

func mediaURL(m sqlc.ContentMedium) string {
	return fmt.Sprintf("/media/%d/%s", m.ID, m.Filename)
}

// mediaAlt falls back to the filename: an image inserted with no description
// is invisible to a screen reader, and the filename is the only description
// available at this point.
func mediaAlt(m sqlc.ContentMedium) string {
	if m.Alt == "" {
		return m.Filename
	}
	return m.Alt
}

// contentFilterClass marks the active filter. It is computed in Go rather than
// with templ.KV because ui.Attrs takes a class string, not a class list.
func contentFilterClass(active bool) string {
	if active {
		return "font-semibold text-fg"
	}
	return ""
}

func adminContentColumns(ctx context.Context) []ui.Column {
	return []ui.Column{
		{Key: "title", Label: i18n.T(ctx, "admin.content.col_title")},
		{Key: "type", Label: i18n.T(ctx, "admin.content.col_type")},
		{Key: "locale", Label: i18n.T(ctx, "admin.content.col_locale"), HideBelow: ui.BreakpointSM},
		{Key: "status", Label: i18n.T(ctx, "admin.content.col_status")},
		{Key: "published", Label: i18n.T(ctx, "admin.content.col_published"), HideBelow: ui.BreakpointMD},
		{Key: "actions", Label: i18n.T(ctx, "admin.content.col_actions"), Align: ui.AlignEnd},
	}
}

templ AdminContentPage(d ContentListData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.content.title")}) {
		if AdminWrite(ctx) {
			@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.content.actions_aria")}) {
				@ui.ButtonLink(ui.ButtonLinkOpts{
					Label: i18n.T(ctx, "admin.media.title"), Href: "/admin/media",
					Attrs: ui.Attrs{
						TestID: "content-media-link",
						HX:     ui.HX{Boost: true, Target: ui.NavTarget, Select: ui.NavTarget, Swap: ui.NavSwap},
					},
				})
				for _, t := range d.Types {
					// The plus is an icon, not copy. Composing "New" with the
					// type label yields "Nuevo Publicación" in Spanish, and
					// gender agreement is not something a template can fix, so
					// the accessible name is the type's own singular label.
					@ui.ButtonLink(ui.ButtonLinkOpts{
						Label: i18n.T(ctx, t.LabelKey), Href: "/admin/content/new?kind=" + t.Kind,
						Action: ui.ActionPrimary, Icon: ui.IconAdd,
						Attrs: ui.Attrs{
							TestID: "content-new-" + t.Kind,
							HX:     ui.HX{Boost: true, Target: ui.NavTarget, Select: ui.NavTarget, Swap: ui.NavSwap},
						},
					})
				}
			}
		}
	}
	@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.content.filter_aria")}) {
		@ui.ButtonLink(ui.ButtonLinkOpts{
			Label: i18n.T(ctx, "admin.content.all"), Href: "/admin/content", Size: ui.SizeSM,
			Attrs: ui.Attrs{
				TestID: "content-filter-all",
				Class:  contentFilterClass(d.Kind == ""),
				HX:     ui.HX{Get: "/admin/content", Target: "#table-container", Swap: "innerMorph", PushURL: "true"},
			},
		})
		for _, t := range d.Types {
			@ui.ButtonLink(ui.ButtonLinkOpts{
				Label: i18n.T(ctx, t.PluralKey), Href: "/admin/content?kind=" + t.Kind, Size: ui.SizeSM,
				Attrs: ui.Attrs{
					TestID: "content-filter-" + t.Kind,
					Class:  contentFilterClass(d.Kind == t.Kind),
					HX:     ui.HX{Get: "/admin/content?kind=" + t.Kind, Target: "#table-container", Swap: "innerMorph", PushURL: "true"},
				},
			})
		}
	}
	@ui.SearchInput(ui.SearchInputOpts{Name: "q", Value: d.Query, Placeholder: i18n.T(ctx, "admin.content.search_placeholder"), AriaLabel: i18n.T(ctx, "admin.content.search_aria"), GetURL: "/admin/content?kind=" + d.Kind, Target: "#table-container", IndicatorID: "content-search-indicator", Attrs: ui.Attrs{TestID: "content-search"}})
	@AdminContentTable(d)
}

templ AdminContentTable(d ContentListData) {
	<div id="table-container">
		@ui.DataTable(ui.DataTableOpts{
			Caption:       i18n.T(ctx, "admin.content.title"),
			HiddenCaption: true,
			Columns:       adminContentColumns(ctx),
			RowCount:      len(d.Items),
			Empty:         adminContentEmpty(d),
			Target:        "#table-container",
			Attrs:         ui.Attrs{TestID: "content-table"},
			Pagination: ui.Pagination(ui.PaginationOpts{
				Page: d.Page, TotalPages: d.TotalPages, BaseURL: "/admin/content?q=" + d.Query,
				Target: "#table-container", Labels: pagerLabels(ctx),
			}),
		}) {
			for _, e := range d.Items {
				<tr id={ fmt.Sprintf("content-row-%d", e.ID) } data-testid={ fmt.Sprintf("content-row-%d", e.ID) }>
					<td class="font-medium">
						@ui.Link(ui.LinkOpts{Label: e.Title, Href: fmt.Sprintf("/admin/content/%d", e.ID), Boost: true})
					</td>
					<td class="text-fg-muted text-xs">
						if key := typeLabel(d.Types, e.Kind); key != "" {
							{ i18n.T(ctx, key) }
						} else {
							{ e.Kind }
						}
					</td>
					<td class="text-fg-muted text-xs hidden sm:table-cell">
						if e.Locale == "" {
							{ i18n.T(ctx, "admin.content.locale_all") }
						} else {
							{ e.Locale }
						}
					</td>
					<td>
						@contentStatusBadge(contentStatus(e, contentNow(d)))
					</td>
					<td class="text-fg-muted text-xs hidden md:table-cell">
						if e.PublishedAt.Valid {
							<time datetime={ e.PublishedAt.Time.UTC().Format("2006-01-02") }>{ e.PublishedAt.Time.UTC().Format("Jan 2, 2006 15:04") }</time>
						} else {
							—
						}
					</td>
					<td class="text-right">
						if AdminWrite(ctx) {
							@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.content.row_actions_aria", e.Title), Attrs: ui.Attrs{Class: "justify-end"}}) {
								@contentPublishButton(e.ID, e.Status, ui.SizeXS)
								@ui.ConfirmAction(ui.ConfirmActionOpts{
									ID:           fmt.Sprintf("content-delete-dialog-%d", e.ID),
									TriggerLabel: i18n.T(ctx, "admin.content.delete_row", e.Title),
									Title:        i18n.T(ctx, "admin.content.delete_title"),
									Message:      i18n.T(ctx, "admin.content.delete_confirm"),
									ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
									CancelLabel:  i18n.T(ctx, "admin.cancel"),
									Kind:         ui.KindDanger,
									HX:           ui.HX{Post: fmt.Sprintf("/admin/content/%d/delete", e.ID)},
									Attrs:        ui.Attrs{TestID: fmt.Sprintf("content-delete-%d", e.ID)},
								})
							}
						} else {
							<span class="text-xs text-fg-muted" data-testid="admin-readonly">{ i18n.T(ctx, "admin.read_only") }</span>
						}
					</td>
				</tr>
			}
		}
	</div>
}

// contentPublishButton is the publish/unpublish control, shared by the table
// row and the editor's action bar so the two cannot drift.
templ contentPublishButton(id int64, status string, size ui.Size) {
	if status == "published" {
		@ui.Button(ui.ButtonOpts{
			Label: i18n.T(ctx, "admin.content.unpublish"), Size: size,
			Attrs: ui.Attrs{
				TestID: fmt.Sprintf("content-unpublish-%d", id),
				HX:     ui.HX{Post: fmt.Sprintf("/admin/content/%d/unpublish", id)},
			},
		})
	} else {
		@ui.Button(ui.ButtonOpts{
			Label: i18n.T(ctx, "admin.content.publish"), Size: size,
			Attrs: ui.Attrs{
				TestID: fmt.Sprintf("content-publish-%d", id),
				HX:     ui.HX{Post: fmt.Sprintf("/admin/content/%d/publish", id)},
			},
		})
	}
}

templ adminContentEmpty(d ContentListData) {
	@ui.EmptyState(ui.EmptyStateOpts{
		Body:       i18n.T(ctx, "admin.content.empty"),
		Variant:    ui.EmptyInline,
		Filtered:   d.Query != "" || d.Kind != "",
		ClearURL:   "/admin/content",
		ClearLabel: i18n.T(ctx, "admin.clear_search"),
		Target:     "#table-container",
		Attrs:      ui.Attrs{TestID: "content-empty"},
	})
}

templ contentStatusBadge(status string) {
	switch status {
		case "live":
			@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.content.status_live"), Kind: contentStatusKind(status), Attrs: ui.Attrs{TestID: "content-status"}})
		case "scheduled":
			@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.content.status_scheduled"), Kind: contentStatusKind(status), Attrs: ui.Attrs{TestID: "content-status"}})
		case "expired":
			@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.content.status_expired"), Kind: contentStatusKind(status), Attrs: ui.Attrs{TestID: "content-status"}})
		default:
			@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.content.status_draft"), Kind: contentStatusKind(status), Attrs: ui.Attrs{TestID: "content-status"}})
	}
}

// AdminContentEditorPage wraps the editor with its heading and back link.
templ AdminContentEditorPage(d ContentEditorData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, d.Type.LabelKey)}) {
		@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.content.actions_aria")}) {
			if d.ID != 0 && d.Type.Path != "" {
				// Deliberately NOT boosted: boosting would swap the public
				// chrome into #content inside the admin shell. External opens
				// it in its own tab with rel="noopener".
				@ui.ButtonLink(ui.ButtonLinkOpts{
					Label:    i18n.T(ctx, "admin.content.preview"),
					Href:     fmt.Sprintf("/admin/content/%d/preview", d.ID),
					External: true,
					Attrs:    ui.Attrs{TestID: "content-preview-link"},
				})
			}
			@ui.BackLink(ui.BackLinkOpts{Label: i18n.T(ctx, "admin.content.title"), Href: "/admin/content"})
		}
	}
	@AdminContentEditor(d)
}

// AdminContentEditor is the editor surface: metadata first, then a resizable
// body/preview split, then the revision history. It is its own swap target so
// a 422 re-render keeps the submitted values.
templ AdminContentEditor(d ContentEditorData) {
	<div id="content-editor" class="space-y-8">
		@ui.Form(ui.FormOpts{
			Target: "#content-editor", Swap: "outerHTML",
			Attrs: ui.Attrs{
				Class: "space-y-4", TestID: "content-editor-form",
				Alpine: ui.Alpine{Data: "slugify"},
				HX:     ui.HX{Post: contentEditorPost(d), Disable: true},
			},
		}) {
			<input type="hidden" name="kind" value={ d.Type.Kind }/>
			@ui.Field(ui.FieldOpts{Name: "title", Label: i18n.T(ctx, "admin.content.title_label"), Error: d.Errs.Title}) {
				@ui.TextInput(ui.TextInputOpts{
					Name: "title", Value: d.Title, Error: d.Errs.Title,
					Attrs: ui.Attrs{TestID: "content-title", Alpine: ui.Alpine{On: map[string]string{"input": "onTitle"}}},
				})
			}
			@ui.Field(ui.FieldOpts{Name: "slug", Label: i18n.T(ctx, "admin.content.slug_label"), Hint: i18n.T(ctx, "admin.content.slug_hint"), Error: d.Errs.Slug}) {
				@ui.TextInput(ui.TextInputOpts{
					Name: "slug", Value: d.Slug, Hint: i18n.T(ctx, "admin.content.slug_hint"), Error: d.Errs.Slug,
					Attrs: ui.Attrs{
						TestID: "content-slug",
						Data:   slugLockData(d),
						Alpine: ui.Alpine{Ref: "slug", On: map[string]string{"input": "onSlug"}},
					},
				})
			}
			@ui.Field(ui.FieldOpts{Name: "locale", Label: i18n.T(ctx, "admin.content.locale_label"), Hint: i18n.T(ctx, "admin.content.locale_hint"), Error: d.Errs.Locale}) {
				@ui.Select(ui.SelectOpts{Name: "locale", Options: localeOptions(ctx, d), Attrs: ui.Attrs{TestID: "content-locale"}})
			}
			@ui.Field(ui.FieldOpts{Name: "summary", Label: i18n.T(ctx, "admin.content.summary_label"), Error: d.Errs.Summary}) {
				@ui.TextInput(ui.TextInputOpts{Name: "summary", Value: d.Summary, Error: d.Errs.Summary, Attrs: ui.Attrs{TestID: "content-summary"}})
			}
			for _, f := range d.Type.Fields {
				@contentField(f, d.Meta[f.Key], d.Errs.Meta[f.Key])
			}
			@ui.Grid(ui.GridOpts{Cols: 2}) {
				@ui.Field(ui.FieldOpts{Name: "published_at", Label: i18n.T(ctx, "admin.content.published_at_label"), Hint: i18n.T(ctx, "admin.content.published_at_hint"), Error: d.Errs.PublishedAt}) {
					@ui.DateTimePicker(ui.DateTimePickerOpts{
						TriggerLabel: i18n.T(ctx, "admin.content.published_at_calendar"),
						Field: ui.DateTimeFieldOpts{
							Name: "published_at", Value: d.PublishedAt,
							Hint: i18n.T(ctx, "admin.content.published_at_hint"), Error: d.Errs.PublishedAt,
							Attrs: ui.Attrs{TestID: "content-published-at"},
						},
					})
				}
				@ui.Field(ui.FieldOpts{Name: "unpublish_at", Label: i18n.T(ctx, "admin.content.unpublish_at_label"), Hint: i18n.T(ctx, "admin.content.unpublish_at_hint"), Error: d.Errs.UnpublishAt}) {
					@ui.DateTimePicker(ui.DateTimePickerOpts{
						TriggerLabel: i18n.T(ctx, "admin.content.unpublish_at_calendar"),
						Field: ui.DateTimeFieldOpts{
							Name: "unpublish_at", Value: d.UnpublishAt,
							Hint: i18n.T(ctx, "admin.content.unpublish_at_hint"), Error: d.Errs.UnpublishAt,
							Attrs: ui.Attrs{TestID: "content-unpublish-at"},
						},
					})
				}
			}
			// Body and preview are the resizable split. The textarea is still
			// the form value and the preview is still produced by the server's
			// own goldmark pipeline — the panels only decide how much room each
			// pane gets, and the split degrades to two stacked blocks with no
			// JavaScript at all.
			@ui.PanelGroup(ui.PanelGroupOpts{
				ID:         "content-editor-panels",
				PersistKey: "admin-content-editor",
				Panels: []ui.PanelData{
					{
						ID: "content-body-panel", Title: i18n.T(ctx, "admin.content.body_label"), Level: 2,
						Size: 55, MinSize: 30, Content: contentBodyEditor(d),
					},
					{
						ID: "content-preview-panel", Title: i18n.T(ctx, "admin.content.preview_heading"), Level: 2,
						Size: 45, MinSize: 25, Content: contentPreviewPane(d),
					},
				},
			})
			if AdminWrite(ctx) {
				@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart, Attrs: ui.Attrs{Class: "flex-wrap"}}) {
					@ui.Button(ui.ButtonOpts{
						Label: contentSaveLabel(ctx, d), Type: ui.TypeSubmit, Action: ui.ActionPrimary,
						Attrs: ui.Attrs{TestID: "content-save"},
					})
					@ui.Spinner(ui.SpinnerOpts{})
					if d.ID != 0 {
						@contentPublishButton(d.ID, d.Status, ui.SizeMD)
						@ui.ConfirmAction(ui.ConfirmActionOpts{
							ID:           fmt.Sprintf("content-editor-delete-dialog-%d", d.ID),
							TriggerLabel: i18n.T(ctx, "admin.content.delete_row", d.Title),
							Title:        i18n.T(ctx, "admin.content.delete_title"),
							Message:      i18n.T(ctx, "admin.content.delete_confirm"),
							ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
							CancelLabel:  i18n.T(ctx, "admin.cancel"),
							Kind:         ui.KindDanger,
							HX:           ui.HX{Post: fmt.Sprintf("/admin/content/%d/delete", d.ID)},
							Attrs:        ui.Attrs{TestID: fmt.Sprintf("content-delete-%d", d.ID)},
						})
					}
				}
			}
		}
		if d.ID != 0 {
			@contentRevisions(d)
		}
	</div>
}

// contentBodyEditor is the Markdown surface. Target points the debounced
// preview request at the sibling panel, which is also what suppresses the
// editor's own inline preview pane.
templ contentBodyEditor(d ContentEditorData) {
	@ui.MarkdownEditor(ui.MarkdownEditorOpts{
		Name:       "body_md",
		Value:      d.BodyMd,
		Rows:       18,
		PreviewURL: "/admin/content/preview",
		Target:     "#content-preview",
		Error:      d.Errs.Body,
		Attrs:      ui.Attrs{TestID: "content-body"},
	}) {
		@contentMediaPicker(d)
	}
}

// contentPreviewPane renders the server's HTML. templ.Raw is safe here for one
// reason and it is worth stating: PreviewHTML is goldmark output produced
// WITHOUT html.WithUnsafe, so raw HTML in the author's Markdown was already
// dropped upstream. No author-supplied string reaches this call unrendered,
// and nothing on this page renders Markdown client-side.
templ contentPreviewPane(d ContentEditorData) {
	@ui.EditorPreview(ui.EditorPreviewOpts{ID: "content-preview", Attrs: ui.Attrs{TestID: "content-preview"}}) {
		@templ.Raw(d.PreviewHTML)
	}
}

// contentEditorPost is the editor's endpoint: create has no id in the path,
// update does. It is a function rather than a branch inside the markup because
// the URL now travels through FormOpts, which also derives the no-script
// action from it - two branches in two places would let those disagree.
func contentEditorPost(d ContentEditorData) string {
	if d.ID == 0 {
		return "/admin/content"
	}
	return fmt.Sprintf("/admin/content/%d", d.ID)
}

// slugLockData marks an existing entry's slug as locked, so the slugify
// behaviour stops rewriting it from the title.
func slugLockData(d ContentEditorData) map[string]string {
	if d.ID == 0 {
		return nil
	}
	return map[string]string{"slug-locked": "true"}
}

func localeOptions(ctx context.Context, d ContentEditorData) []ui.Option {
	out := make([]ui.Option, 0, len(d.Locales))
	for _, code := range d.Locales {
		label := code
		if code == "" {
			label = i18n.T(ctx, "admin.content.locale_all")
		}
		out = append(out, ui.Option{Value: code, Label: label, Selected: d.Locale == code})
	}
	return out
}

func contentSaveLabel(ctx context.Context, d ContentEditorData) string {
	if d.ID == 0 {
		return i18n.T(ctx, "admin.content.save_draft")
	}
	return i18n.T(ctx, "admin.content.save")
}

// contentField renders one type-declared field. The meta_ prefix keeps a
// field named "title" or "slug" from colliding with a core input.
templ contentField(f content.Field, value, err string) {
	@ui.Field(ui.FieldOpts{Name: "meta_" + f.Key, Label: i18n.T(ctx, f.LabelKey), Error: err}) {
		switch f.Kind {
			case content.FieldTextarea:
				@ui.Textarea(ui.TextareaOpts{Name: "meta_" + f.Key, Value: value, Rows: 3, Attrs: ui.Attrs{TestID: "content-meta-" + f.Key}})
			case content.FieldSelect:
				@ui.Select(ui.SelectOpts{Name: "meta_" + f.Key, Options: metaSelectOptions(ctx, f, value), Attrs: ui.Attrs{TestID: "content-meta-" + f.Key}})
			case content.FieldBool:
				@ui.Select(ui.SelectOpts{Name: "meta_" + f.Key, Options: metaBoolOptions(ctx, value), Attrs: ui.Attrs{TestID: "content-meta-" + f.Key}})
			case content.FieldURL:
				@ui.TextInput(ui.TextInputOpts{Name: "meta_" + f.Key, Type: ui.InputTypeURL, Value: value, Error: err, Attrs: ui.Attrs{TestID: "content-meta-" + f.Key}})
			default:
				@ui.TextInput(ui.TextInputOpts{Name: "meta_" + f.Key, Value: value, Error: err, Attrs: ui.Attrs{TestID: "content-meta-" + f.Key}})
		}
	}
}

// metaSelectOptions keeps the empty first choice: a declared field is optional
// unless the type says otherwise, and without a blank option the first value is
// submitted by accident.
func metaSelectOptions(ctx context.Context, f content.Field, value string) []ui.Option {
	out := make([]ui.Option, 0, len(f.Options)+1)
	out = append(out, ui.Option{Value: "", Label: "", Selected: value == ""})
	for _, o := range f.Options {
		out = append(out, ui.Option{Value: o, Label: i18n.T(ctx, f.LabelKey+"_"+o), Selected: value == o})
	}
	return out
}

func metaBoolOptions(ctx context.Context, value string) []ui.Option {
	return []ui.Option{
		{Value: "false", Label: i18n.T(ctx, "flags.off"), Selected: value != "true"},
		{Value: "true", Label: i18n.T(ctx, "flags.on"), Selected: value == "true"},
	}
}

templ contentRevisions(d ContentEditorData) {
	@ui.Card(ui.CardOpts{}) {
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "admin.content.revisions_heading"), Attrs: ui.Attrs{Class: "mb-3"}})
		if len(d.Revisions) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "admin.content.revisions_empty"), Variant: ui.EmptyInline})
		} else {
			@ui.List(ui.ListOpts{Attrs: ui.Attrs{Class: "text-sm"}}) {
				for i, rev := range d.Revisions {
					@ui.Item(ui.ItemOpts{
						Attrs: ui.Attrs{
							Class:  "flex items-center justify-between gap-3",
							TestID: fmt.Sprintf("content-revision-%d", rev.ID),
						},
					}) {
						<span class="truncate">
							{ rev.Title }
							<span class="text-fg-muted text-xs ml-2">{ rev.CreatedAt.Time.UTC().Format("Jan 2, 2006 15:04") }</span>
						</span>
						if i == 0 {
							@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.content.revision_current"), Kind: ui.KindNeutral, Attrs: ui.Attrs{Class: "shrink-0"}})
						} else if AdminWrite(ctx) {
							@ui.ConfirmAction(ui.ConfirmActionOpts{
								ID:           fmt.Sprintf("content-restore-dialog-%d", rev.ID),
								TriggerLabel: i18n.T(ctx, "admin.content.restore_row", rev.Title),
								Title:        i18n.T(ctx, "admin.content.restore_title"),
								Message:      i18n.T(ctx, "admin.content.restore_confirm"),
								ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
								CancelLabel:  i18n.T(ctx, "admin.cancel"),
								Kind:         ui.KindWarn,
								HX:           ui.HX{Post: fmt.Sprintf("/admin/content/%d/revisions/%d/restore", d.ID, rev.ID)},
								Attrs:        ui.Attrs{TestID: fmt.Sprintf("content-restore-%d", rev.ID), Class: "shrink-0"},
							})
						}
					}
				}
			}
		}
	}
}

// contentMediaPicker rides inside the editor's own root: the insert controls
// write at the caret, so they have to be where the editor controller can reach
// them. Upload is deliberately absent — a file input inside this form would be
// submitted with the entry, and the library owns uploads.
templ contentMediaPicker(d ContentEditorData) {
	@ui.MediaPicker(ui.MediaPickerOpts{
		ID:         "content-media",
		Items:      mediaItems(d.Media),
		EmptyLabel: i18n.T(ctx, "admin.media.empty"),
	})
}

func mediaItems(media []sqlc.ContentMedium) []ui.MediaItem {
	out := make([]ui.MediaItem, 0, len(media))
	for _, m := range media {
		out = append(out, ui.MediaItem{
			URL: mediaURL(m), Alt: mediaAlt(m), Name: m.Filename, Thumb: mediaURL(m),
		})
	}
	return out
}

func adminMediaColumns(ctx context.Context) []ui.Column {
	return []ui.Column{
		{Key: "preview", Label: i18n.T(ctx, "admin.media.col_preview")},
		{Key: "filename", Label: i18n.T(ctx, "admin.media.col_filename")},
		{Key: "size", Label: i18n.T(ctx, "admin.media.col_size"), Numeric: true},
		{Key: "uploaded", Label: i18n.T(ctx, "admin.media.col_uploaded"), HideBelow: ui.BreakpointSM},
		{Key: "actions", Label: i18n.T(ctx, "admin.media.col_actions"), Align: ui.AlignEnd},
	}
}

// AdminMediaPage is the platform image library: upload, copy, delete.
templ AdminMediaPage(d MediaData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.media.title")}) {
		@ui.BackLink(ui.BackLinkOpts{Label: i18n.T(ctx, "admin.media.back_to_content"), Href: "/admin/content"})
	}
	if AdminWrite(ctx) {
		@MediaUploadCard(d)
	}
	<div id="table-container">
		@ui.DataTable(ui.DataTableOpts{
			Caption:       i18n.T(ctx, "admin.media.title"),
			HiddenCaption: true,
			Columns:       adminMediaColumns(ctx),
			RowCount:      len(d.Items),
			Empty:         adminMediaEmpty(),
			Target:        "#table-container",
			Attrs:         ui.Attrs{TestID: "media-table"},
			Pagination: ui.Pagination(ui.PaginationOpts{
				Page: d.Page, TotalPages: d.TotalPages, BaseURL: "/admin/media",
				Target: "#table-container", Labels: pagerLabels(ctx),
			}),
		}) {
			for _, m := range d.Items {
				<tr id={ fmt.Sprintf("media-row-%d", m.ID) } data-testid={ fmt.Sprintf("media-row-%d", m.ID) }>
					<td>
						<img src={ mediaURL(m) } alt={ m.Alt } class="h-10 w-10 object-cover rounded" loading="lazy"/>
					</td>
					<td class="font-medium">{ m.Filename }</td>
					<td class="text-fg-muted text-xs text-right tabular-nums">{ humanBytes(m.SizeBytes) }</td>
					<td class="text-fg-muted text-xs hidden sm:table-cell"><span data-testid="relative-time">{ RelTime(mediaNow(d), m.CreatedAt.Time) }</span></td>
					<td class="text-right">
						@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.media.row_actions_aria", m.Filename), Attrs: ui.Attrs{Class: "justify-end"}}) {
							@ui.CopyButton(ui.CopyButtonOpts{
								Value:       mediaMarkdown(m),
								Label:       i18n.T(ctx, "admin.content.media_copy"),
								CopiedLabel: i18n.T(ctx, "api.copied"),
								Size:        ui.SizeXS,
								Attrs:       ui.Attrs{TestID: fmt.Sprintf("media-copy-%d", m.ID)},
							})
							if AdminWrite(ctx) {
								@ui.ConfirmAction(ui.ConfirmActionOpts{
									ID:           fmt.Sprintf("media-delete-dialog-%d", m.ID),
									TriggerLabel: i18n.T(ctx, "admin.media.delete_row", m.Filename),
									Title:        i18n.T(ctx, "admin.media.delete_title"),
									Message:      i18n.T(ctx, "admin.media.delete_confirm"),
									ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
									CancelLabel:  i18n.T(ctx, "admin.cancel"),
									Kind:         ui.KindDanger,
									HX:           ui.HX{Post: fmt.Sprintf("/admin/media/%d/delete", m.ID)},
									Attrs:        ui.Attrs{TestID: fmt.Sprintf("media-delete-%d", m.ID)},
								})
							}
						}
					</td>
				</tr>
			}
		}
	</div>
}

templ adminMediaEmpty() {
	@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "admin.media.empty"), Variant: ui.EmptyInline, Attrs: ui.Attrs{TestID: "media-empty"}})
}

// MediaUploadCard is its own swap target so a rejected upload re-renders the
// card alone. Without hx-target the 422 page would be swapped INSIDE the
// form, duplicating the whole library below it.
//
// Enctype and HX.Encoding are both multipart, and both are load-bearing: htmx
// reads hx-encoding, a plain browser submit reads enctype, and neither implies
// the other. A file input in a form that sends the default encoding posts the
// filename as text and leaves the bytes on the machine, with a 200 to say so.
templ MediaUploadCard(d MediaData) {
	<div id="media-form" class="mb-8 max-w-3xl">
		@ui.Form(ui.FormOpts{
			Enctype: "multipart/form-data",
			Target:  "#media-form", Swap: "outerHTML",
			Attrs: ui.Attrs{
				Class: "card space-y-4", TestID: "media-upload-form",
				HX: ui.HX{Post: "/admin/media", Encoding: "multipart/form-data", Disable: true},
			},
		}) {
			if d.Err != "" {
				@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{TestID: "media-error"}}) {
					{ d.Err }
				}
			}
			@ui.Field(ui.FieldOpts{Name: "file", Label: i18n.T(ctx, "admin.media.upload_label")}) {
				@ui.FileInput(ui.FileInputOpts{
					Name:   "file",
					Accept: "image/png,image/jpeg,image/gif,image/webp",
					Attrs:  ui.Attrs{TestID: "media-file"},
				})
			}
			@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
				@ui.Button(ui.ButtonOpts{
					Label: i18n.T(ctx, "admin.media.upload"), Type: ui.TypeSubmit, Action: ui.ActionPrimary,
					Attrs: ui.Attrs{TestID: "media-upload"},
				})
				@ui.Spinner(ui.SpinnerOpts{})
			}
		}
	</div>
}
