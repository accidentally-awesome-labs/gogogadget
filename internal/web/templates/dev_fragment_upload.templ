package templates

import (
	"fmt"
	"strings"

	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// DevUploadReason is why an upload was refused, or empty when it was accepted.
// A reason rather than a message: the handler decides, the template writes the
// sentence, and neither has to know the other's job.
type DevUploadReason string

const (
	DevUploadOK          DevUploadReason = ""
	DevUploadMissing     DevUploadReason = "missing"
	DevUploadUnsupported DevUploadReason = "unsupported"
)

// DevUploadState is what the upload example renders.
type DevUploadState struct {
	// Filename and DeclaredType are what the multipart part claimed to be.
	Filename, DeclaredType string
	Size                   int64
	Reason                 DevUploadReason
}

// Accepted reports whether a file made it through.
func (s DevUploadState) Accepted() bool {
	return s.Reason == DevUploadOK && s.Filename != ""
}

// devUploadTypes are the declared content types the example accepts.
func devUploadTypes() []string {
	return []string{"image/png", "image/jpeg", "application/pdf", "text/markdown", "text/plain"}
}

// devUploadAccept is the picker filter. It is derived from nothing - the
// extensions and the MIME list are two different vocabularies - so both live
// here, next to each other, where a change to one is visibly a change to the
// other.
const devUploadAccept = ".png,.jpg,.jpeg,.pdf,.md,.txt"

const devUploadHint = "PNG, JPEG, PDF, Markdown or plain text."

// DevUploadAllows reports whether the example accepts a declared content type.
//
// The DECLARED type, which is exactly as far as this example goes: it holds no
// bytes to inspect. A real handler must not stop here - the media upload sniffs
// the magic bytes, because the type a browser declares is whatever the client
// chose to send.
func DevUploadAllows(declared string) bool {
	// Browsers append parameters ("text/plain; charset=utf-8"), so the
	// comparison is on the media type alone or a plain text file is refused for
	// declaring its encoding.
	media := strings.TrimSpace(strings.Split(declared, ";")[0])
	for _, allowed := range devUploadTypes() {
		if media == allowed {
			return true
		}
	}
	return false
}

// devUploadError is the sentence under the field.
//
// The refused file is named because it cannot be put back into the input: a file
// input's value is not settable from markup, by design, so being told which file
// was refused is the only way the user knows which one to replace.
func devUploadError(state DevUploadState) string {
	switch state.Reason {
	case DevUploadMissing:
		return "Choose a file to upload."
	case DevUploadUnsupported:
		return fmt.Sprintf("%s declares %s, which is not accepted. Allowed: %s.",
			state.Filename, state.DeclaredType, devUploadHint)
	default:
		return ""
	}
}

// devUploadSize formats the size the server actually received, not the size the
// request claimed.
func devUploadSize(size int64) string {
	if size < 1024 {
		return fmt.Sprintf("%d bytes", size)
	}
	return fmt.Sprintf("%d KB", size/1024)
}

// DevUploadExample renders the upload form's resting state inside the box it
// swaps.
templ DevUploadExample() {
	<div id="dev-upload-region" data-testid="dev-upload-region">
		@DevUploadFragment(DevUploadState{})
	</div>
}

// DevUploadFragment is the upload form plus, once a file is accepted, its row.
//
// A refusal re-renders the FIELD with the error rather than reporting the
// failure elsewhere on the page: the message has to be the element the input's
// aria-describedby points at, or a screen-reader user hears "Attachment,
// invalid" and never learns why.
templ DevUploadFragment(state DevUploadState) {
	<div class="space-y-3">
		@ui.Form(ui.FormOpts{
			Method: "post", Action: "/dev/ui/upload/receive",
			Target: "#dev-upload-region", Swap: "innerHTML",
			Attrs: ui.Attrs{
				Class: "space-y-3", TestID: "dev-upload-form",
				// multipart because the request carries a file; without the
				// encoding htmx posts the field name and no bytes.
				HX: ui.HX{Post: "/dev/ui/upload/receive", Encoding: "multipart/form-data", Disable: true},
			},
		}) {
			@ui.Field(ui.FieldOpts{
				Name: "file", Label: "Attachment", Required: true,
				Hint: devUploadHint, Error: devUploadError(state),
			}) {
				@ui.FileInput(ui.FileInputOpts{
					Name: "file", Accept: devUploadAccept, Required: true,
					Hint: devUploadHint, Error: devUploadError(state),
				})
			}
			@ui.FormActions(ui.FormActionsOpts{}) {
				@ui.Spinner(ui.SpinnerOpts{})
				@ui.Button(ui.ButtonOpts{
					Label: "Upload", Type: ui.TypeSubmit, Action: ui.ActionPrimary, Icon: ui.IconUpload,
					Attrs: ui.Attrs{TestID: "dev-upload-submit"},
				})
			}
		}
		if state.Accepted() {
			@ui.Attachment(ui.AttachmentOpts{
				Name: state.Filename, Size: devUploadSize(state.Size), Icon: ui.IconFile,
				Attrs: ui.Attrs{TestID: "dev-upload-row"},
			})
		}
	</div>
}
