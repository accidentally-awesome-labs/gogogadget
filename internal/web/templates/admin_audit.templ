package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// Admin audit viewer — platform-wide, mirrors the org activity page.

templ AdminAuditTable(rows []sqlc.ListAuditAllRow, now time.Time, filter string, page, totalPages int) {
	<div id="table-container">
		if len(rows) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Title: i18n.T(ctx, "admin.audit.title"), Body: i18n.T(ctx, "admin.audit.empty")}) {
			}
		} else {
			@ui.TableCard(ui.TableCardOpts{Attrs: ui.Attrs{TestID: "audit-table"}}) {
				<table class="table">
					<thead>
						<tr><th>{ i18n.T(ctx, "activity.col_when") }</th><th>{ i18n.T(ctx, "activity.col_actor") }</th><th>{ i18n.T(ctx, "admin.audit.col_org") }</th><th>{ i18n.T(ctx, "activity.col_action") }</th><th>{ i18n.T(ctx, "activity.col_details") }</th></tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr id={ fmt.Sprintf("audit-row-%d", row.ID) }>
								<td>
									<span data-testid="relative-time" title={ row.CreatedAt.Time.Format(time.RFC3339) }>{ RelTime(now, row.CreatedAt.Time) }</span>
								</td>
								<td>
									if row.ActorEmail != "" {
										{ row.ActorEmail }
									} else {
										<span class="text-fg-muted">{ row.ClerkUserID.String }</span>
									}
								</td>
								<td class="text-fg-muted">{ row.ClerkOrgID.String }</td>
								<td>@ui.Badge(ui.BadgeOpts{Text: row.Action, Kind: ui.KindBrand})</td>
								<td>
									if len(row.Metadata) > 2 {
										<details>
											<summary class="cursor-pointer text-fg-muted">{ i18n.T(ctx, "activity.metadata") }</summary>
											<pre class="text-xs mt-1 overflow-auto">{ prettyMetadata(row.Metadata) }</pre>
										</details>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			@ui.Pagination(ui.PaginationOpts{Page: page, TotalPages: totalPages, BaseURL: "/admin/audit?q="+filter, Target: "#table-container", Labels: pagerLabels(ctx)})
		}
	</div>
}

templ AdminAuditPage(rows []sqlc.ListAuditAllRow, now time.Time, filter string, page, totalPages int) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.audit.title")})
	@ui.SearchInput(ui.SearchInputOpts{Name: "q", Value: filter, Placeholder: i18n.T(ctx, "admin.audit.search_placeholder"), AriaLabel: i18n.T(ctx, "admin.audit.search_aria"), GetURL: "/admin/audit", Target: "#table-container", IndicatorID: "admin-audit-search-indicator", Attrs: ui.Attrs{TestID: ""}})
	@AdminAuditTable(rows, now, filter, page, totalPages)
}
