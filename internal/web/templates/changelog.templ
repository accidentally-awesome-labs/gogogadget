package templates

import (
	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// ChangelogPage renders every release on one scrollable page, newest first.
//
// One page rather than a post per release: a changelog is read by scanning
// backwards until you reach the version you were on. Each entry still carries
// a stable anchor id, so a support reply can link straight at the release
// that fixed someone's problem.
templ ChangelogPage(releases []content.Release) {
	<article class="page-narrow">
		@ui.Heading(ui.HeadingOpts{Text: i18n.T(ctx, "changelog.title"), Level: 1, Size: ui.SizeLG})
		@ui.Text(ui.TextOpts{Size: ui.SizeLG, Muted: true, Attrs: ui.Attrs{Class: "mt-3"}}) {
			{ i18n.T(ctx, "changelog.intro") }
		}
		<div class="mt-12 space-y-16">
			for _, release := range releases {
				<section id={ release.Anchor } class="scroll-mt-24" data-testid="changelog-entry">
					<div class="flex items-baseline gap-3 flex-wrap">
						// Unstyled on both, and Boost off: this is an in-page
						// fragment, so boosting it would repaint the content box
						// at the top before scrolling and land on the wrong
						// release. Heading owns the level; Link owns the anchor.
						@ui.Heading(ui.HeadingOpts{Level: 2, Unstyled: true, Attrs: ui.Attrs{Class: "text-2xl font-bold"}}) {
							@ui.Link(ui.LinkOpts{
								Label: release.Title, Href: "#" + release.Anchor, Unstyled: true,
								Attrs: ui.Attrs{Class: "hover:text-brand-text"},
							})
						}
						<time datetime={ release.Date.Format("2006-01-02") } class="text-sm text-fg-muted" data-testid="changelog-date">
							{ release.Date.Format("January 2, 2006") }
						</time>
					</div>
					if release.Summary != "" {
						@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-2"}}) {
							{ release.Summary }
						}
					}
					@ui.Prose(ui.ProseOpts{Attrs: ui.Attrs{Class: "mt-6"}}) {
						@templ.Raw(release.Body)
					}
				</section>
			}
		</div>
	</article>
}
