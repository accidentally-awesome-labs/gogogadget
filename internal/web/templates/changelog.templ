package templates

import (
	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// ChangelogPage renders every release on one scrollable page, newest first.
//
// One page rather than a post per release: a changelog is read by scanning
// backwards until you reach the version you were on. Each entry still carries
// a stable anchor id, so a support reply can link straight at the release
// that fixed someone's problem.
templ ChangelogPage(releases []content.Release) {
	<article class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold tracking-tight">{ i18n.T(ctx, "changelog.title") }</h1>
		<p class="mt-3 text-lg text-fg-muted">{ i18n.T(ctx, "changelog.intro") }</p>
		<div class="mt-12 space-y-16">
			for _, r := range releases {
				<section id={ r.Anchor } class="scroll-mt-24" data-testid="changelog-entry">
					<div class="flex items-baseline gap-3 flex-wrap">
						<h2 class="text-2xl font-bold">
							<a href={ templ.SafeURL("#" + r.Anchor) } class="hover:text-brand-600 dark:hover:text-brand-400">{ r.Title }</a>
						</h2>
						<time datetime={ r.Date.Format("2006-01-02") } class="text-sm text-fg-muted" data-testid="changelog-date">
							{ r.Date.Format("January 2, 2006") }
						</time>
					</div>
					if r.Summary != "" {
						<p class="mt-2 text-fg-muted">{ r.Summary }</p>
					}
					<div class="prose mt-6">
						@templ.Raw(r.Body)
					</div>
				</section>
			}
		</div>
	</article>
}
