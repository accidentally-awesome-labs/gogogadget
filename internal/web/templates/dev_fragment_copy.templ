package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// devCopyValue is the fixture token. A literal rather than a generated value:
// two renders have to be byte-identical, or every screenshot of this example is
// a diff and nobody can tell a real change from a fresh random string.
const devCopyValue = "ggg_live_9f2c41d8a7b3"

// DevCopyExample renders the copy row in its resting state.
templ DevCopyExample() {
	@DevCopyRow(false)
}

// DevCopyRow is both the resting state and the fragment the confirm action
// returns, because the row replaces itself: hx-swap="outerMorph" against its own
// id, the same self-replacement the billing fragment uses when it polls.
//
// The clipboard write stays in the browser - a server cannot reach the
// clipboard, so CopyButton's Alpine handler is still what copies. The request
// exists because a product that reveals a secret usually has to record that it
// happened, and once the server is involved the confirmation the user reads
// should be the server's answer rather than an optimistic guess.
templ DevCopyRow(copied bool) {
	<div id="dev-copy-row" data-testid="dev-copy-row" class="flex flex-wrap items-center gap-3">
		@ui.Code(ui.CodeOpts{Text: devCopyValue})
		@ui.CopyButton(ui.CopyButtonOpts{
			Value: devCopyValue, Label: "Copy token", CopiedLabel: "Copied", Size: ui.SizeSM,
			Attrs: ui.Attrs{
				TestID: "dev-copy-button",
				// The value rides in hx-vals because the control is not inside
				// a form: without it the server would be asked to record a
				// reveal it cannot name.
				HX: ui.HX{
					Post:   "/dev/ui/copy/confirm",
					Target: "#dev-copy-row",
					Swap:   "outerMorph",
					Vals:   map[string]string{"value": devCopyValue},
				},
			},
		})
		if copied {
			// role=status, not alert: confirming something the user just asked
			// for does not warrant interrupting whatever they are reading.
			<p role="status" class="text-sm text-fg-muted" data-testid="dev-copy-recorded">Copied. The reveal was recorded.</p>
		}
	</div>
}
