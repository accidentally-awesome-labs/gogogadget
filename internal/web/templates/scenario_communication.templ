package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// The communication scenario: notifications, a discussion, a chat transcript,
// its composer and the files hanging off it - the four regions a product's
// messaging surface actually has.
//
// Every string below is a literal. A scenario that reads the database renders
// differently on every machine, which makes it worthless as a visual baseline
// and worthless in a bug report: "this looks wrong" is unanswerable when nobody
// else can reach the same page. Two renders of this file are byte-identical.
templ ScenarioCommunication(gc GalleryContext) {
	switch gc.State {
		case "empty":
			@commsQuietWorkspace()
		case "loading":
			@commsArrivingWorkspace()
		default:
			@commsPopulatedWorkspace(gc)
	}
}

// commsPopulatedWorkspace is the happy path: everything has content.
templ commsPopulatedWorkspace(gc GalleryContext) {
	@ui.Grid(ui.GridOpts{Cols: 2, Gap: ui.GapLG}) {
		@ui.Section(ui.SectionOpts{
			Title: "Notifications", Level: 2,
			Attrs: ui.Attrs{ID: "comms-notifications"},
		}) {
			@ui.List(ui.ListOpts{Attrs: ui.Attrs{TestID: "comms-notification-list"}}) {
				for _, item := range commsNotifications(gc.LongContent) {
					@ui.NotificationItem(item)
				}
			}
		}
		@ui.Section(ui.SectionOpts{
			Title: "Assistant", Level: 2,
			Attrs: ui.Attrs{ID: "comms-chat"},
		}) {
			// One log, one composer, in that order. The transcript is a polite
			// live region: assertive would interrupt the screen reader on every
			// token of the streaming reply below, which makes the page unusable
			// for exactly the person the live region exists to serve.
			@ui.ChatLog(ui.ChatLogOpts{
				Label:     "Workspace assistant transcript",
				Streaming: true,
				Attrs:     ui.Attrs{TestID: "comms-chat-log"},
			}) {
				for _, message := range commsChatMessages(gc.LongContent) {
					@ui.ChatMessage(message)
				}
			}
			@ui.Composer(ui.ComposerOpts{
				Name:        "chat-message",
				Placeholder: "Message the assistant",
				SubmitLabel: "Send",
				Rows:        3,
			})
		}
	}
	@ui.Section(ui.SectionOpts{
		Title: "Discussion", Level: 2,
		Attrs: ui.Attrs{ID: "comms-thread"},
	}) {
		@ui.CommentThread(ui.CommentThreadOpts{
			Label: "Discussion on release 2.14",
			Attrs: ui.Attrs{TestID: "comms-thread-list"},
		}) {
			for _, comment := range commsComments(gc.LongContent) {
				@ui.Comment(comment)
			}
		}
		@ui.Section(ui.SectionOpts{
			Title: "Attached to this thread", Level: 3,
			Attrs: ui.Attrs{ID: "comms-attachments"},
		}) {
			@ui.Stack(ui.StackOpts{Gap: ui.GapSM}) {
				for _, file := range commsAttachments(gc.LongContent) {
					@ui.Attachment(file)
				}
			}
		}
		@ui.Composer(ui.ComposerOpts{
			Name:        "thread-reply",
			Placeholder: "Reply to the discussion",
			SubmitLabel: "Post reply",
			Rows:        4,
		})
	}
}

// commsQuietWorkspace is the workspace before anyone has used it.
//
// Each region states what will appear there rather than collapsing to nothing.
// A region that renders zero pixels is indistinguishable from a region that
// failed to render, and nobody files a bug against a panel they never saw.
templ commsQuietWorkspace() {
	@ui.Grid(ui.GridOpts{Cols: 2, Gap: ui.GapLG}) {
		@ui.Section(ui.SectionOpts{
			Title: "Notifications", Level: 2,
			Attrs: ui.Attrs{ID: "comms-notifications"},
		}) {
			@ui.EmptyState(ui.EmptyStateOpts{
				Title:   "No notifications yet",
				Body:    "Deploys, quota warnings and accepted invitations land here, newest first. Unread ones stay tinted until you open them.",
				Variant: ui.EmptyCard,
			})
		}
		@ui.Section(ui.SectionOpts{
			Title: "Assistant", Level: 2,
			Attrs: ui.Attrs{ID: "comms-chat"},
		}) {
			@ui.EmptyState(ui.EmptyStateOpts{
				Title:   "No conversation yet",
				Body:    "Ask the assistant a question and the exchange appears here. Its replies stream in a word at a time and are announced politely, not read over you.",
				Variant: ui.EmptyCard,
			})
			// The composer stays. An empty transcript is not a reason to remove
			// the only control that can fill it.
			@ui.Composer(ui.ComposerOpts{
				Name:        "chat-message",
				Placeholder: "Message the assistant",
				SubmitLabel: "Send",
				Rows:        3,
			})
		}
	}
	@ui.Section(ui.SectionOpts{
		Title: "Discussion", Level: 2,
		Attrs: ui.Attrs{ID: "comms-thread"},
	}) {
		@ui.EmptyState(ui.EmptyStateOpts{
			Title:   "Nobody has commented",
			Body:    "Comments appear oldest first, with replies indented under the message they answer. Files dropped on a reply are listed beneath the thread.",
			Variant: ui.EmptyCard,
		})
		@ui.Composer(ui.ComposerOpts{
			Name:        "thread-reply",
			Placeholder: "Start the discussion",
			SubmitLabel: "Post comment",
			Rows:        4,
		})
	}
}

// commsArrivingWorkspace is the first paint, before any of it has arrived.
//
// Skeletons in the same three regions at roughly the shape their content takes,
// so nothing jumps when the real rows land. The live region is mounted empty
// rather than replaced by a placeholder: it has to exist before the first
// message arrives, or the arrival is never announced.
templ commsArrivingWorkspace() {
	@ui.Grid(ui.GridOpts{Cols: 2, Gap: ui.GapLG}) {
		@ui.Section(ui.SectionOpts{
			Title: "Notifications", Level: 2,
			Attrs: ui.Attrs{ID: "comms-notifications"},
		}) {
			@ui.Card(ui.CardOpts{}) {
				@ui.Skeleton(ui.SkeletonOpts{Lines: 8})
			}
		}
		@ui.Section(ui.SectionOpts{
			Title: "Assistant", Level: 2,
			Attrs: ui.Attrs{ID: "comms-chat"},
		}) {
			@ui.ChatLog(ui.ChatLogOpts{
				Label:     "Workspace assistant transcript",
				Streaming: true,
				Attrs:     ui.Attrs{TestID: "comms-chat-log"},
			}) {
				@ui.Skeleton(ui.SkeletonOpts{Lines: 6})
			}
			@ui.Composer(ui.ComposerOpts{
				Name:        "chat-message",
				Placeholder: "Message the assistant",
				SubmitLabel: "Send",
				Rows:        3,
			})
		}
	}
	@ui.Section(ui.SectionOpts{
		Title: "Discussion", Level: 2,
		Attrs: ui.Attrs{ID: "comms-thread"},
	}) {
		@ui.Card(ui.CardOpts{}) {
			@ui.Skeleton(ui.SkeletonOpts{Lines: 10})
		}
	}
}

// commsNotifications is the notification list.
// Href is empty on every row. The fixture stands for no stored record, and a
// link to an invented id is a 404 the reader only discovers by clicking - which
// teaches them to distrust the rest of the page.
func commsNotifications(long bool) []ui.NotificationItemOpts {
	return []ui.NotificationItemOpts{
		{
			Title: commsStretch(long, "Deploy finished",
				"Deploy finished for api-gateway, orders-worker, billing-sync and the four edge functions that ship alongside them"),
			Body:        "api-gateway v2.14.0 is serving production traffic.",
			Timestamp:   "12 Mar 2026, 14:02",
			MachineTime: "2026-03-12T14:02:00Z",
			Kind:        ui.KindSuccess,
			Unread:      true,
			UnreadLabel: "Unread",
		},
		{
			Title:       "File storage at 82%",
			Body:        "At the current rate this workspace reaches its limit in about nine days.",
			Timestamp:   "12 Mar 2026, 09:15",
			MachineTime: "2026-03-12T09:15:00Z",
			Kind:        ui.KindWarn,
			Unread:      true,
			UnreadLabel: "Unread",
		},
		{
			Title:       "Webhook retries exhausted",
			Body:        "orders.created stopped delivering to hooks.example.test after 8 attempts.",
			Timestamp:   "11 Mar 2026, 22:40",
			MachineTime: "2026-03-11T22:40:00Z",
			Kind:        ui.KindDanger,
		},
		{
			Title:       "Invitation accepted",
			Body:        "Priya Raman joined as an editor.",
			Timestamp:   "10 Mar 2026, 16:05",
			MachineTime: "2026-03-10T16:05:00Z",
			Kind:        ui.KindInfo,
		},
	}
}

// commsComments is the discussion, oldest first.
//
// Body is a plain string on every entry and BodySlot is never used here: a
// comment is user-authored text, and the one call site that could hand it
// pre-rendered markup is the one call site that could ship a stored XSS. The
// reply is inset with a padding class rather than nesting a second thread, so
// each comment keeps its own divider row.
func commsComments(long bool) []ui.CommentOpts {
	return []ui.CommentOpts{
		{
			Author:      "Dana Whitfield",
			Timestamp:   "11 Mar 2026, 11:20",
			MachineTime: "2026-03-11T11:20:00Z",
			Body: commsStretch(long,
				"Holding 2.14 until the webhook retry budget is settled. Two customers hit the ceiling last night.",
				"Holding 2.14 until the webhook retry budget is settled. Two customers hit the ceiling last night, and both of them read the exhausted-retry notification as an outage on our side rather than a misconfigured endpoint on theirs, which tells me the copy is doing more harm than the failure."),
		},
		{
			Author:      "Priya Raman",
			Timestamp:   "11 Mar 2026, 13:44",
			MachineTime: "2026-03-11T13:44:00Z",
			Body:        "Retry budget is eight attempts over roughly six hours. Raising it hides the broken endpoint for longer.",
			Edited:      true,
			EditedLabel: "(edited)",
			Attrs:       ui.Attrs{Class: "pl-10"},
		},
		{
			Author:      "Marco Lenz",
			Timestamp:   "12 Mar 2026, 08:02",
			MachineTime: "2026-03-12T08:02:00Z",
			Body:        "Agreed. Shipping 2.14 as-is and reworking the notification copy separately.",
		},
	}
}

// commsChatMessages is the transcript.
//
// The last message is still streaming, which is the state worth looking at: the
// log is marked busy, the half-written message says so in words, and the
// politeness of the live region is what keeps that from being read aloud on
// every token.
func commsChatMessages(long bool) []ui.ChatMessageOpts {
	return []ui.ChatMessageOpts{
		{
			Role:      ui.ChatRoleSystem,
			RoleLabel: "System",
			Body:      "Connected to the workspace assistant.",
		},
		{
			Role:      ui.ChatRoleUser,
			RoleLabel: "Dana Whitfield",
			Body:      "Which endpoints exhausted their retries last night?",
		},
		{
			Role:      ui.ChatRoleAssistant,
			RoleLabel: "Assistant",
			Body:      "One: hooks.example.test, on orders.created. Eight attempts between 16:12 and 22:40, all refused with connection reset.",
		},
		{
			Role:      ui.ChatRoleUser,
			RoleLabel: "Dana Whitfield",
			Body: commsStretch(long,
				"Draft a note to that customer.",
				"Draft a note to that customer explaining what we retried, when we stopped, what they need to change on their side, and how they replay the eight deliveries once their endpoint answers again."),
		},
		{
			Role:      ui.ChatRoleAssistant,
			RoleLabel: "Assistant",
			Body:      "Subject: orders.created deliveries paused. We attempted delivery eight times between 16:12 and 22:40 and",
			// Streaming is on the message as well as the log: the log says work
			// is happening, the message says which sentence is unfinished. A
			// half-sentence with no marker reads as a complete answer.
			Streaming:      true,
			StreamingLabel: "(still writing)",
		},
	}
}

// commsAttachments is the file list under the thread.
//
// Href is empty for the same reason the notifications carry none, and Actions is
// nil rather than a remove button: there is no endpoint behind it here, and a
// control that silently does nothing is worse than an absent one.
func commsAttachments(long bool) []ui.AttachmentOpts {
	return []ui.AttachmentOpts{
		{
			Name: commsStretch(long, "retry-budget-analysis.pdf",
				"retry-budget-analysis-including-the-per-endpoint-breakdown-and-the-proposed-ceiling.pdf"),
			Size: "412 KB",
			Icon: ui.IconFile,
		},
		{
			Name: "delivery-log-2026-03-11.csv",
			Size: "1.8 MB",
			Icon: ui.IconFile,
		},
	}
}

// commsStretch substitutes a deliberately long string when the reader asked for
// long content, at the call sites where a translation would stretch too. The
// point is to break the layout here, in a scenario, rather than in production
// German.
func commsStretch(long bool, normal, stretched string) string {
	if long {
		return stretched
	}
	return normal
}
