package templates

import (
	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// ImpersonateData backs the impersonation interstitial: who is being viewed
// as, which org, and the stated reason (kept across a 422 re-render).
type ImpersonateData struct {
	Target sqlc.User
	Orgs   []sqlc.Org
	Reason string
	Err    string
}

// AdminImpersonateForm is the deliberate step before "view as": it names what
// gets recorded (reason + both audit entries) before the session starts.
templ AdminImpersonateForm(d ImpersonateData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "impersonation.start_title")})
	@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mb-6"}}) {
		{ i18n.T(ctx, "impersonation.start_intro", string(d.Target.Email)) }
	}
	<div id="impersonate-form-wrap" class="card max-w-lg" data-testid="impersonate-form">
		if d.Err != "" {
			@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{Class: "mb-4", TestID: "impersonate-error"}}) {
				{ d.Err }
			}
		}
		if len(d.Orgs) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "impersonation.no_orgs"), Variant: ui.EmptyInline})
		} else {
			@ui.Form(ui.FormOpts{
				Target: "#impersonate-form-wrap", Swap: "outerHTML",
				Attrs: ui.Attrs{
					Class: "space-y-4",
					HX:    ui.HX{Post: "/admin/users/" + d.Target.UserID + "/impersonate", Disable: true},
				},
			}) {
				@ui.Field(ui.FieldOpts{Name: "org", Label: i18n.T(ctx, "impersonation.org_label")}) {
					@ui.Select(ui.SelectOpts{Name: "org", Options: orgOptions(d.Orgs)})
				}
				@ui.Field(ui.FieldOpts{Name: "reason", Label: i18n.T(ctx, "impersonation.reason_label"), Hint: i18n.T(ctx, "impersonation.reason_hint")}) {
					@ui.TextInput(ui.TextInputOpts{
						Name: "reason", Value: d.Reason,
						Placeholder: i18n.T(ctx, "impersonation.reason_placeholder"),
						Hint:        i18n.T(ctx, "impersonation.reason_hint"),
						Attrs:       ui.Attrs{TestID: "impersonate-reason", Data: map[string]string{"maxlength": "280"}},
					})
				}
				@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
					@ui.Button(ui.ButtonOpts{
						Label: i18n.T(ctx, "impersonation.start_button"), Type: ui.TypeSubmit,
						Action: ui.ActionPrimary, Attrs: ui.Attrs{TestID: "impersonate-start"},
					})
					@ui.Link(ui.LinkOpts{Label: i18n.T(ctx, "impersonation.cancel"), Href: "/admin/users", Attrs: ui.Attrs{Class: "text-sm"}})
					@ui.Spinner(ui.SpinnerOpts{})
				}
			}
		}
	</div>
}
