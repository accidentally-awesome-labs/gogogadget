package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// devToastChoice is one trigger in the toast example.
type devToastChoice struct {
	Kind  ui.Kind
	Label string
}

// devToastChoices covers the kinds that differ in how they are ANNOUNCED rather
// than all six: the distinction worth demonstrating is polite versus assertive,
// and three more buttons differing only in colour add nothing to read.
func devToastChoices() []devToastChoice {
	return []devToastChoice{
		{Kind: ui.KindSuccess, Label: "Saved"},
		{Kind: ui.KindWarn, Label: "Quota warning"},
		{Kind: ui.KindDanger, Label: "Save failed"},
	}
}

// DevToastExample renders the toast triggers and the region they swap.
//
// Production queues its own toasts with the HX-Trigger header (web.Toast) and
// the shell's persistent toast root renders them; the row-delete example does
// exactly that. This example returns the component in the response body
// instead, which is the shape for a message that belongs in the page rather
// than in the transient stack that times out after five seconds.
templ DevToastExample() {
	<div class="space-y-3" data-testid="dev-toast-example">
		<div class="flex flex-wrap gap-2">
			for _, choice := range devToastChoices() {
				@ui.Button(ui.ButtonOpts{
					Label: choice.Label, Size: ui.SizeSM,
					Attrs: ui.Attrs{
						TestID: "dev-toast-show-" + string(choice.Kind),
						HX: ui.HX{
							Post:   "/dev/ui/toast/show",
							Target: "#dev-toast-region",
							Swap:   "innerMorph",
							Vals:   map[string]string{"kind": string(choice.Kind)},
						},
					},
				})
			}
		</div>
		// The region is deliberately not itself a live region. Toast owns
		// role="status", and nesting one live region inside another leaves it
		// ambiguous which one announces - several screen readers read the
		// insertion twice. The shell's toast root has the mirror-image
		// arrangement for the same reason: it owns the role, and app.js inserts
		// role-less children into it.
		<div id="dev-toast-region" data-testid="dev-toast-region">
			<p class="text-sm text-fg-muted">Nothing posted yet.</p>
		</div>
	</div>
}

// DevToastFragment is the toast the show action returns.
//
// The id is what makes innerMorph replace the toast in place rather than stack a
// second one: morph matches by id, so a fragment with no id is a fresh element
// every time.
templ DevToastFragment(kind string) {
	@ui.Toast(ui.ToastOpts{
		Kind:        ui.Kind(kind),
		Text:        devToastText(kind),
		Live:        devToastLive(kind),
		Dismissible: true,
		Attrs:       ui.Attrs{ID: "dev-toast", TestID: "dev-toast"},
	})
}

// devToastText names what happened. A toast reading "Success" tells the user
// nothing about which of the three things they just did succeeded.
func devToastText(kind string) string {
	switch ui.Kind(kind) {
	case ui.KindSuccess:
		return "Project saved."
	case ui.KindWarn:
		return "You have used most of your file quota."
	case ui.KindDanger:
		return "The project could not be saved. Nothing was changed."
	default:
		return "Sync finished."
	}
}

// devToastLive announces a failure assertively and everything else politely.
// A failure the user has to act on is the one case worth interrupting them for;
// announcing a save the same way trains them to ignore the interruption.
func devToastLive(kind string) ui.Live {
	if ui.Kind(kind) == ui.KindDanger {
		return ui.LiveAssertive
	}
	return ui.LivePolite
}
