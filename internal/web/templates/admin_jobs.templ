package templates

import (
	"context"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// Admin job-queue viewer. Status comes from the ListJobs projection: a
// claimed job and a backoff-retry job both read "retrying" — the 5-minute
// visibility lease is indistinguishable from backoff by design. "dead" is
// the dead-letter end state (attempts exhausted); only those rows offer a
// requeue.

func jobStatusBadgeClass(status string) string {
	switch status {
	case "pending":
		return "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
	case "running":
		return "bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300"
	case "retrying":
		return "bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300"
	case "done":
		return "bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300"
	default: // dead
		return "bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300"
	}
}

// jobStatusLabel resolves the i18n label for the projected status
// (pending/retrying/running/dead/done).
func jobStatusKey(status string) string { return "admin.jobs.status_" + status }

func jobStatusLabel(ctx context.Context, status string) string {
	return i18n.T(ctx, jobStatusKey(status))
}
templ AdminJobsTable(rows []sqlc.ListJobsRow, now time.Time, filter string, page, totalPages int) {
	<div id="table-container">
		if len(rows) == 0 {
			@EmptyState(i18n.T(ctx, "admin.jobs.title"), i18n.T(ctx, "admin.jobs.empty")) {
			}
		} else {
			<div class="card !p-0 overflow-hidden" data-testid="jobs-table">
				<table class="table">
					<thead>
						<tr><th>{ i18n.T(ctx, "admin.jobs.col_kind") }</th><th>{ i18n.T(ctx, "admin.jobs.col_status") }</th><th>{ i18n.T(ctx, "admin.jobs.col_attempts") }</th><th>{ i18n.T(ctx, "admin.jobs.col_run_at") }</th><th>{ i18n.T(ctx, "admin.jobs.col_error") }</th><th class="text-right">{ i18n.T(ctx, "admin.jobs.col_actions") }</th></tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr id={ fmt.Sprintf("job-row-%d", row.ID) }>
								<td class="font-medium">{ row.Kind }</td>
								<td>
									<span class={ "badge", jobStatusBadgeClass(row.Status) } data-testid="job-status">{ jobStatusLabel(ctx, row.Status) }</span>
								</td>
								<td>{ fmt.Sprintf("%d/%d", row.Attempts, row.MaxAttempts) }</td>
								<td>
									<span data-testid="relative-time" title={ row.RunAt.Time.Format(time.RFC3339) }>{ RelTime(now, row.RunAt.Time) }</span>
								</td>
								<td class="max-w-xs truncate text-fg-muted" title={ row.LastError.String }>{ row.LastError.String }</td>
								<td class="text-right">
									if row.Status == "dead" {
										<button
											type="button"
											hx-post={ fmt.Sprintf("/admin/jobs/%d/requeue", row.ID) }
											hx-confirm={ i18n.T(ctx, "admin.jobs.requeue_confirm") }
											class="btn-ghost !px-2 !py-1 text-xs"
											data-testid={ fmt.Sprintf("job-requeue-%d", row.ID) }
										>{ i18n.T(ctx, "admin.jobs.requeue") }</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@Pagination(page, totalPages, "/admin/jobs?q="+filter)
		}
	</div>
}

templ AdminJobsPage(rows []sqlc.ListJobsRow, now time.Time, filter string, page, totalPages int) {
	<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "admin.jobs.title") }</h1>
	<div class="flex items-center gap-2 mb-4">
		<input
			type="search" name="q" value={ filter } placeholder={ i18n.T(ctx, "admin.jobs.search_placeholder") }
			class="input max-w-sm"
			hx-get="/admin/jobs" hx-trigger="input changed delay:300ms, search"
			hx-target="#table-container" hx-swap="innerMorph" hx-push-url="true" hx-include="this"
			hx-sync="this:replace"
			hx-indicator="#admin-jobs-search-indicator"
			aria-label={ i18n.T(ctx, "admin.jobs.search_aria") }
		/>
		<span id="admin-jobs-search-indicator" class="text-fg-muted">
			@Spinner()
		</span>
	</div>
	@AdminJobsTable(rows, now, filter, page, totalPages)
}
