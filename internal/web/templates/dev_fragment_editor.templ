package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// DevEditorField is the textarea's name. The handler reads the same constant, so
// renaming the field cannot leave the preview reading a value nobody posts.
const DevEditorField = "dev_body_md"

// devEditorSample is what the editor starts with.
//
// It ends with a script-bearing img tag on purpose. goldmark runs without
// html.WithUnsafe, so that line comes back escaped as text - the reader sees the
// repository's XSS answer demonstrated rather than described, and a preview that
// ever rendered it would be visibly broken here first.
const devEditorSample = `## Release notes

**Bold**, ` + "`code`" + `, and a [link](/docs).

- Markdown is what gets stored
- HTML is what the server renders, once

<img src=x onerror=alert(1)>
`

// DevEditorExample renders the editor and its preview pane.
//
// The preview is the same goldmark pipeline the published page uses, reached
// over HTTP - never a client-side Markdown renderer. A second renderer in the
// browser is a second set of escaping rules, and the author would be reviewing
// output no reader will ever get.
templ DevEditorExample() {
	@ui.Form(ui.FormOpts{
		Method: "post", Action: "/dev/ui/editor/preview",
		Target: "#" + DevEditorField + "-preview", Swap: "innerHTML",
		Attrs: ui.Attrs{
			Class: "space-y-3", TestID: "dev-editor-form",
			HX: ui.HX{Post: "/dev/ui/editor/preview", Disable: true},
		},
	}) {
		// Wrapped in a Field because MarkdownEditor renders no label of its
		// own: a textarea with no label is announced as "edit text, blank".
		@ui.Field(ui.FieldOpts{Name: DevEditorField, Label: "Body"}) {
			@ui.MarkdownEditor(ui.MarkdownEditorOpts{
				Name: DevEditorField, Value: devEditorSample,
				PreviewURL: "/dev/ui/editor/preview", Rows: 10,
				Attrs: ui.Attrs{TestID: "dev-editor"},
			})
		}
		@ui.FormActions(ui.FormActionsOpts{}) {
			@ui.Spinner(ui.SpinnerOpts{})
			// A real submit, so the preview also works with no JavaScript: the
			// editor's own debounced request is the enhancement, not the only
			// way to get a preview.
			@ui.Button(ui.ButtonOpts{
				Label: "Update preview", Type: ui.TypeSubmit, Action: ui.ActionPrimary,
				Attrs: ui.Attrs{TestID: "dev-editor-submit"},
			})
		}
	}
}

// DevEditorPreviewError is what the preview pane shows when rendering failed.
//
// A Notice rather than a raw string through the preview: the pane's content is
// normally goldmark output reaching templ.Raw, and putting a hand-written
// literal down that path is how the one exception to "never Raw" grows a second
// member.
templ DevEditorPreviewError() {
	@ui.Notice(ui.NoticeOpts{
		Kind: ui.KindDanger, Live: ui.LiveAssertive,
		Attrs: ui.Attrs{TestID: "dev-editor-error"},
	}) {
		<p>That Markdown could not be rendered.</p>
	}
}
