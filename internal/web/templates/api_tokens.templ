package templates

import (
	"fmt"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

templ SettingsAPI(d APITokensData) {
	@SettingsTabs("/app/settings/api")
	@PageHeader(i18n.T(ctx, "api.title"))

	<div id="api-tokens-container">
		@APITokensSection(d)
	</div>
}

templ APITokensSection(d APITokensData) {
	if d.NewToken != "" {
		<div class="card mb-6 max-w-lg border-success" data-testid="api-token-reveal">
			<h2 class="font-semibold text-success-text">{ i18n.T(ctx, "api.reveal_title") }</h2>
			<p class="text-sm text-fg-muted mt-1">{ i18n.T(ctx, "api.reveal_note") }</p>
			@CopyRow(d.NewToken, i18n.T(ctx, "api.copy"), i18n.T(ctx, "api.copied"))
		</div>
	}

	<div class="card max-w-lg mb-6">
		<h2 class="font-semibold mb-3">{ i18n.T(ctx, "api.create_title") }</h2>
		if d.NameErr != "" {
			@Alert(KindDanger, "alert", "mb-3", "") {
				{ d.NameErr }
			}
		}
		<form hx-post="/app/settings/api/tokens" hx-target="#api-tokens-container" hx-swap="innerHTML" hx-disable="this" novalidate class="flex gap-3 items-end">
			<div class="flex-1">
				<label for="name" class="label">{ i18n.T(ctx, "api.name_label") }</label>
				<input id="name" name="name" type="text" class="input" placeholder={ i18n.T(ctx, "api.name_placeholder") } required/>
			</div>
			<div>
				<label for="scope" class="label">{ i18n.T(ctx, "api.scope_label") }</label>
				<select id="scope" name="scope" class="input">
					<option value="read">read</option>
					<option value="write">write</option>
				</select>
			</div>
			<button type="submit" class="btn btn-primary">
				@Spinner()
				{ i18n.T(ctx, "api.create") }
			</button>
		</form>
	</div>

	<div class="table-card max-w-3xl">
		<table class="table">
			<thead>
				<tr><th>{ i18n.T(ctx, "api.col_name") }</th><th>{ i18n.T(ctx, "api.col_scope") }</th><th>{ i18n.T(ctx, "api.col_last_used") }</th><th>{ i18n.T(ctx, "api.col_created") }</th><th class="text-right"></th></tr>
			</thead>
			<tbody>
				if len(d.Tokens) == 0 {
					<tr><td colspan="5" class="text-center text-fg-muted py-6">{ i18n.T(ctx, "api.empty") }</td></tr>
				}
				for _, t := range d.Tokens {
					<tr>
						<td class="font-medium">{ t.Name }</td>
						<td>@Badge(t.Scope, KindNeutral)</td>
						<td class="text-fg-muted">
							if t.LastUsedAt.Valid {
								{ t.LastUsedAt.Time.Format("Jan 2, 2006") }
							} else {
								{ i18n.T(ctx, "api.never_used") }
							}
						</td>
						<td class="text-fg-muted">{ t.CreatedAt.Time.Format("Jan 2, 2006") }</td>
						<td class="text-right">
							if t.RevokedAt.Valid {
								@Badge(i18n.T(ctx, "api.revoked"), KindDanger)
							} else {
								<button
									type="button"
									hx-delete={ fmt.Sprintf("/app/settings/api/tokens/%d", t.ID) }
									hx-confirm={ i18n.T(ctx, "api.revoke_confirm") }
									hx-target="closest tr"
									hx-swap="outerHTML"
									class="btn btn-danger btn-xs"
								>{ i18n.T(ctx, "api.revoke") }</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
