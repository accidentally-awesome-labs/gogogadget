package templates

import (
	"context"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// AnnouncementsData carries the admin list plus the create-form state (kept
// on 422 re-render, project-form convention).
type AnnouncementsData struct {
	Items   []sqlc.Announcement
	Kind    string
	Message string
	Url     string
	Invalid bool
}

func adminAnnouncementColumns(ctx context.Context) []ui.Column {
	return []ui.Column{
		{Key: "kind", Label: i18n.T(ctx, "admin.announcements.col_kind")},
		{Key: "message", Label: i18n.T(ctx, "admin.announcements.col_message")},
		{Key: "status", Label: i18n.T(ctx, "admin.announcements.col_status")},
		{Key: "created", Label: i18n.T(ctx, "admin.announcements.col_created"), HideBelow: ui.BreakpointSM},
		{Key: "actions", Label: i18n.T(ctx, "admin.announcements.col_actions"), Align: ui.AlignEnd},
	}
}

templ AdminAnnouncementsPage(d AnnouncementsData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.announcements.title")})
	if AdminWrite(ctx) {
		<div id="announcement-form-wrap">
			@AnnouncementForm(d)
		</div>
	}
	@ui.DataTable(ui.DataTableOpts{
		Caption:       i18n.T(ctx, "admin.announcements.title"),
		HiddenCaption: true,
		Columns:       adminAnnouncementColumns(ctx),
		RowCount:      len(d.Items),
		Empty:         adminAnnouncementsEmpty(),
		Attrs:         ui.Attrs{TestID: "announcements-table"},
	}) {
		for _, a := range d.Items {
			<tr id={ "announcement-row-" + fmt.Sprintf("%d", a.ID) }>
				<td>
					@ui.Badge(ui.BadgeOpts{Text: announcementKindLabel(ctx, a.Kind), Kind: announcementKind(a.Kind)})
				</td>
				<td class="max-w-md font-medium">
					@ui.Truncate(ui.TruncateOpts{Text: a.Message})
				</td>
				<td>
					if a.Active {
						@ui.StatusDot(ui.StatusDotOpts{Kind: ui.KindSuccess, Label: i18n.T(ctx, "admin.announcements.active")})
					} else {
						@ui.StatusDot(ui.StatusDotOpts{Kind: ui.KindNeutral, Label: i18n.T(ctx, "admin.announcements.inactive")})
					}
				</td>
				<td class="text-fg-muted hidden sm:table-cell">{ a.CreatedAt.Time.Format("Jan 2, 2006") }</td>
				<td class="text-right">
					if AdminWrite(ctx) {
						@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.announcements.row_actions_aria", a.Message), Attrs: ui.Attrs{Class: "justify-end"}}) {
							if a.Active {
								@ui.Button(ui.ButtonOpts{
									Label: i18n.T(ctx, "admin.announcements.deactivate"),
									Size:  ui.SizeXS,
									Attrs: ui.Attrs{
										TestID: "announcement-deactivate-" + fmt.Sprintf("%d", a.ID),
										HX:     ui.HX{Post: "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/deactivate"},
									},
								})
							} else {
								@ui.Button(ui.ButtonOpts{
									Label: i18n.T(ctx, "admin.announcements.activate"),
									Size:  ui.SizeXS,
									Attrs: ui.Attrs{
										TestID: "announcement-activate-" + fmt.Sprintf("%d", a.ID),
										HX:     ui.HX{Post: "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/activate"},
									},
								})
							}
							@ui.ConfirmAction(ui.ConfirmActionOpts{
								ID:           "announcement-delete-dialog-" + fmt.Sprintf("%d", a.ID),
								TriggerLabel: i18n.T(ctx, "admin.announcements.delete_row", a.Message),
								Title:        i18n.T(ctx, "admin.announcements.delete_title"),
								Message:      i18n.T(ctx, "admin.announcements.delete_confirm"),
								ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
								CancelLabel:  i18n.T(ctx, "admin.cancel"),
								Kind:         ui.KindDanger,
								HX:           ui.HX{Post: "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/delete"},
								Attrs:        ui.Attrs{TestID: "announcement-delete-" + fmt.Sprintf("%d", a.ID)},
							})
						}
					}
				</td>
			</tr>
		}
	}
}

templ adminAnnouncementsEmpty() {
	@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "admin.announcements.empty"), Variant: ui.EmptyInline})
}

func announcementKindKey(kind string) string { return "admin.announcements.kind_" + kind }

func announcementKindLabel(ctx context.Context, kind string) string {
	return i18n.T(ctx, announcementKindKey(kind))
}

// AnnouncementForm is the create card. Extracted so the 422 re-render swaps
// exactly this fragment (project-form convention).
templ AnnouncementForm(d AnnouncementsData) {
	<div class="card mb-8 max-w-xl">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "admin.announcements.create_title"), Attrs: ui.Attrs{Class: "mb-4"}})
		@ui.Form(ui.FormOpts{
			Target: "#announcement-form-wrap", Swap: "outerHTML",
			Attrs: ui.Attrs{
				Class: "space-y-4", TestID: "announcement-create-form",
				HX: ui.HX{Post: "/admin/announcements", Disable: true},
			},
		}) {
			if d.Invalid {
				@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive}) {
					{ i18n.T(ctx, "admin.announcements.invalid") }
				}
			}
			@ui.Field(ui.FieldOpts{Name: "kind", Label: i18n.T(ctx, "admin.announcements.kind_label")}) {
				@ui.Select(ui.SelectOpts{Name: "kind", Options: []ui.Option{
					{Value: "info", Label: i18n.T(ctx, "admin.announcements.kind_info"), Selected: d.Kind == "info"},
					{Value: "warning", Label: i18n.T(ctx, "admin.announcements.kind_warning"), Selected: d.Kind == "warning"},
					{Value: "critical", Label: i18n.T(ctx, "admin.announcements.kind_critical"), Selected: d.Kind == "critical"},
				}})
			}
			@ui.Field(ui.FieldOpts{Name: "message", Label: i18n.T(ctx, "admin.announcements.message_label")}) {
				@ui.TextInput(ui.TextInputOpts{Name: "message", Value: d.Message, Placeholder: i18n.T(ctx, "admin.announcements.message_placeholder")})
			}
			@ui.Field(ui.FieldOpts{Name: "url", Label: i18n.T(ctx, "admin.announcements.url_label")}) {
				@ui.TextInput(ui.TextInputOpts{Name: "url", Type: ui.InputTypeURL, Value: d.Url, Placeholder: i18n.T(ctx, "admin.announcements.url_placeholder")})
			}
			@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true}) {
				{ i18n.T(ctx, "admin.announcements.one_active_hint") }
			}
			@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
				@ui.Button(ui.ButtonOpts{Label: i18n.T(ctx, "admin.announcements.create"), Type: ui.TypeSubmit, Action: ui.ActionPrimary})
				@ui.Spinner(ui.SpinnerOpts{})
			}
		}
	</div>
}
