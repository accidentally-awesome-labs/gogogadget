package templates

import (
	"context"
	"fmt"
	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// AnnouncementsData carries the admin list plus the create-form state (kept
// on 422 re-render, project-form convention).
type AnnouncementsData struct {
	Items   []sqlc.Announcement
	Kind    string
	Message string
	Url     string
	Invalid bool
}

templ AdminAnnouncementsPage(d AnnouncementsData) {
	@PageHeader(i18n.T(ctx, "admin.announcements.title"))
	if AdminWrite(ctx) {
		<div id="announcement-form-wrap">
			@AnnouncementForm(d)
		</div>
	}
	@TableCard("announcements-table") {
		if len(d.Items) == 0 {
			@TableEmpty(i18n.T(ctx, "admin.announcements.empty"))
		} else {
			<table class="table">
				<thead>
					<tr><th>{ i18n.T(ctx, "admin.announcements.col_kind") }</th><th>{ i18n.T(ctx, "admin.announcements.col_message") }</th><th>{ i18n.T(ctx, "admin.announcements.col_status") }</th><th>{ i18n.T(ctx, "admin.announcements.col_created") }</th><th class="text-right">{ i18n.T(ctx, "admin.announcements.col_actions") }</th></tr>
				</thead>
				<tbody>
					for _, a := range d.Items {
						<tr id={ "announcement-row-" + fmt.Sprintf("%d", a.ID) }>
							<td>@Badge(announcementKindLabel(ctx, a.Kind), announcementKind(a.Kind))</td>
							<td class="max-w-md truncate font-medium" title={ a.Message }>{ a.Message }</td>
							<td>
								if a.Active {
									@Badge(i18n.T(ctx, "admin.announcements.active"), KindSuccess)
								} else {
									@Badge(i18n.T(ctx, "admin.announcements.inactive"), KindNeutral)
								}
							</td>
							<td class="text-fg-muted">{ a.CreatedAt.Time.Format("Jan 2, 2006") }</td>
							<td class="text-right">
								if AdminWrite(ctx) {
									<div class="card-actions">
										if a.Active {
											<button type="button" hx-post={ "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/deactivate" }
												class="btn btn-ghost btn-xs" data-testid={ "announcement-deactivate-" + fmt.Sprintf("%d", a.ID) }>
												{ i18n.T(ctx, "admin.announcements.deactivate") }
											</button>
										} else {
											<button type="button" hx-post={ "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/activate" }
												class="btn btn-ghost btn-xs" data-testid={ "announcement-activate-" + fmt.Sprintf("%d", a.ID) }>
												{ i18n.T(ctx, "admin.announcements.activate") }
											</button>
										}
										<button type="button" hx-post={ "/admin/announcements/" + fmt.Sprintf("%d", a.ID) + "/delete" }
											hx-confirm={ i18n.T(ctx, "admin.announcements.delete_confirm") }
											class="btn btn-ghost btn-xs text-danger-text" data-testid={ "announcement-delete-" + fmt.Sprintf("%d", a.ID) }>
											{ i18n.T(ctx, "admin.announcements.delete") }
										</button>
									</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

func announcementKindKey(kind string) string { return "admin.announcements.kind_" + kind }

func announcementKindLabel(ctx context.Context, kind string) string {
	return i18n.T(ctx, announcementKindKey(kind))
}

// AnnouncementForm is the create card. Extracted so the 422 re-render swaps
// exactly this fragment (project-form convention).
templ AnnouncementForm(d AnnouncementsData) {
	<div class="card mb-8 max-w-xl">
		@SectionHeading(i18n.T(ctx, "admin.announcements.create_title"), "mb-4")
		<form hx-post="/admin/announcements" hx-target="#announcement-form-wrap" hx-swap="outerHTML" novalidate hx-disable="this" data-testid="announcement-create-form" class="space-y-4">
			if d.Invalid {
				@Alert(KindDanger, "alert", "", "") {
					{ i18n.T(ctx, "admin.announcements.invalid") }
				}
			}
			<div>
				<label class="label" for="announcement-kind">{ i18n.T(ctx, "admin.announcements.kind_label") }</label>
				<select id="announcement-kind" name="kind" class="input">
					<option value="info" selected?={ d.Kind == "info" }>{ i18n.T(ctx, "admin.announcements.kind_info") }</option>
					<option value="warning" selected?={ d.Kind == "warning" }>{ i18n.T(ctx, "admin.announcements.kind_warning") }</option>
					<option value="critical" selected?={ d.Kind == "critical" }>{ i18n.T(ctx, "admin.announcements.kind_critical") }</option>
				</select>
			</div>
			<div>
				<label class="label" for="announcement-message">{ i18n.T(ctx, "admin.announcements.message_label") }</label>
				<input id="announcement-message" type="text" name="message" value={ d.Message } maxlength="280"
					placeholder={ i18n.T(ctx, "admin.announcements.message_placeholder") } class="input"/>
			</div>
			<div>
				<label class="label" for="announcement-url">{ i18n.T(ctx, "admin.announcements.url_label") }</label>
				<input id="announcement-url" type="url" name="url" value={ d.Url }
					placeholder={ i18n.T(ctx, "admin.announcements.url_placeholder") } class="input"/>
			</div>
			<p class="text-sm text-fg-muted">{ i18n.T(ctx, "admin.announcements.one_active_hint") }</p>
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "admin.announcements.create") }</button>
				@Spinner()
			</div>
		</form>
	</div>
}
