package templates

import "github.com/gogogadget/gogogadget/internal/web/templates/ui"

// galleryBoardColumns is the board's fixed shape. Moves are applied to a copy,
// so the demo is stateless: two people opening the gallery never see each
// other's drags.
func galleryBoardColumns() []ui.KanbanColumnData {
	return []ui.KanbanColumnData{
		{ID: "backlog", Title: "Backlog"},
		{ID: "doing", Title: "In progress", Limit: 2},
		{ID: "done", Title: "Shipped"},
	}
}

// galleryBoardCards places each card in its home column.
func galleryBoardCards() map[string][]ui.KanbanCardData {
	return map[string][]ui.KanbanCardData{
		"backlog": {
			{
				ID: "card-catalog", Title: "Split the catalog",
				Description: "One renderer per installable module.",
				Badge:       &ui.BadgeOpts{Text: "Done", Kind: ui.KindSuccess},
				Assignees:   []ui.AvatarOpts{{Name: "Ada Lovelace"}},
			},
			{
				ID: "card-docs", Title: "Write the module docs",
				Assignees: []ui.AvatarOpts{{Name: "Grace Hopper"}, {Name: "Alan Turing"}},
			},
		},
		"doing": {
			{
				ID: "card-grid", Title: "Ship the data grid",
				Badge: &ui.BadgeOpts{Text: "Review", Kind: ui.KindInfo},
			},
		},
		"done": {},
	}
}

// GalleryBoardHasColumn reports whether a move destination exists. An unknown
// column is refused rather than silently created, because a move to a column
// that does not exist is a lost card.
func GalleryBoardHasColumn(id string) bool {
	for _, column := range galleryBoardColumns() {
		if column.ID == id {
			return true
		}
	}
	return false
}

// galleryBoardWithMove builds the board, optionally relocating one card. The
// count comes from the cards actually placed, so the readout and the board can
// never disagree - including when a move pushes a column over its limit.
func galleryBoardWithMove(card, to string) []ui.KanbanColumnData {
	placed := galleryBoardCards()
	if card != "" && GalleryBoardHasColumn(to) {
		var moved *ui.KanbanCardData
		for id, cards := range placed {
			kept := make([]ui.KanbanCardData, 0, len(cards))
			for i := range cards {
				if cards[i].ID == card {
					found := cards[i]
					moved = &found
					continue
				}
				kept = append(kept, cards[i])
			}
			placed[id] = kept
		}
		if moved != nil {
			placed[to] = append(placed[to], *moved)
		}
	}

	columns := galleryBoardColumns()
	for i := range columns {
		columns[i].Cards = placed[columns[i].ID]
		columns[i].Count = len(columns[i].Cards)
	}
	return columns
}

// GalleryBoard renders the demo board, with an optional move already applied.
//
// The target is the board itself, so a move re-renders only the board. Pointing
// it at the page would mean every drag repaints the whole gallery, and a
// rejected move would scroll the reader back to the top.
templ GalleryBoard(card, to string) {
	@ui.Kanban(ui.KanbanOpts{
		ID:      "gallery-board",
		MoveURL: "/dev/ui/kanban/move",
		Target:  "#gallery-board",
		Columns: galleryBoardWithMove(card, to),
	})
}
