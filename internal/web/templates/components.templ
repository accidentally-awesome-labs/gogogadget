package templates

import "github.com/gogogadget/gogogadget/internal/billing"

templ Badge(text, kind string) {
	<span data-testid="plan-badge" class={ "badge", "bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300" }>{ text }</span>
}

// PlanCard renders one plan on the pricing page and in upgrade CTAs.
templ PlanCard(plan billing.Plan, current bool) {
	<div class={ "card flex flex-col gap-4", templ.KV("ring-2 ring-brand-500", current) }>
		<div class="flex items-center justify-between">
			<h3 class="text-lg font-semibold">{ plan.Name }</h3>
			if current {
				@Badge("Current plan", "brand")
			}
		</div>
		<div class="text-3xl font-bold">{ plan.PriceDisplay }</div>
		<ul class="space-y-2 text-sm text-fg-muted flex-1">
			for _, f := range plan.Features {
				<li class="flex gap-2">
					<svg class="w-4 h-4 mt-0.5 shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M20 6 9 17l-5-5"></path>
					</svg>
					{ f }
				</li>
			}
		</ul>
		{ children... }
	</div>
}

// EmptyState is the zero-data pattern for tables.
templ EmptyState(title, body string) {
	<div class="card text-center py-12">
		<h3 class="font-semibold">{ title }</h3>
		<p class="text-sm text-fg-muted mt-1">{ body }</p>
		<div class="mt-4">
			{ children... }
		</div>
	</div>
}

// FormField renders label + input + field-level error.
templ FormField(name, label, inputType, value, err, placeholder string, required bool) {
	<div>
		<label for={ name } class="label">{ label }</label>
		<input id={ name } name={ name } type={ inputType } value={ value } class="input" placeholder={ placeholder } required?={ required } autofocus?={ required }/>
		if err != "" {
			<p class="mt-1 text-sm text-red-600 dark:text-red-400" data-testid="form-error">{ err }</p>
		}
	</div>
}
