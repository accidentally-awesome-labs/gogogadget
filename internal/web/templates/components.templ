package templates

import (
	"fmt"
	"strings"

	"github.com/gogogadget/gogogadget/internal/billing"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// Kind is the semantic colour axis shared by Badge, Alert and Banner. Every
// state colour in the product is one of these six; the four bespoke
// kind→class switch functions this replaces disagreed on shades.
//
// A Kind is a string type so "badge-" + string(kind) composes in one place.
// An unknown value yields a bare "badge-" with no colour, which reads as a
// visible bug rather than a silent brand default.
type Kind string

const (
	KindBrand   Kind = "brand"
	KindInfo    Kind = "info"
	KindSuccess Kind = "success"
	KindWarn    Kind = "warn"
	KindDanger  Kind = "danger"
	KindNeutral Kind = "neutral"
)

// Kinds is every semantic kind, in severity order. The gallery renders it.
var Kinds = []Kind{KindBrand, KindInfo, KindSuccess, KindWarn, KindDanger, KindNeutral}

// Spinner is htmx's request indicator. htmx adds the htmx-request class to the
// element that issued the request (and to anything named by hx-indicator) for
// the duration of the request; the .htmx-indicator rules in input.css fade this
// in while that class is present. Drop it inside a submit button and the
// button's own request drives it — no wiring needed.
templ Spinner() {
	@Icon(IconSpinner, "htmx-indicator w-4 h-4 animate-spin")
}

// Badge is a small state pill. kind picks the colour; the text is the label.
templ Badge(text string, kind Kind) {
	<span class={ "badge", "badge-" + string(kind) }>{ text }</span>
}

// BadgeTagged is Badge with a data-testid, for the rows tests assert on.
templ BadgeTagged(text string, kind Kind, testID string) {
	<span class={ "badge", "badge-" + string(kind) } data-testid={ testID }>{ text }</span>
}

// Alert is an in-page notice inside a form or card. class carries margins and
// width, which are the caller's business, not the component's.
//
// role is "alert" for something the user must act on (validation failure,
// blocked action) and "status" for a confirmation: role="alert" is assertive
// and interrupts a screen reader mid-sentence, which a success message has
// not earned.
templ Alert(kind Kind, role, class, testID string) {
	<div
		class={ "alert", "alert-" + string(kind), templ.KV(class, class != "") }
		role={ role }
		if testID != "" {
			data-testid={ testID }
		}
	>
		{ children... }
	</div>
}

// Banner is a full-bleed shell notice (impersonation, billing). Same role
// rule as Alert.
templ Banner(kind Kind, role, testID string) {
	<div
		class={ "banner", "banner-" + string(kind) }
		role={ role }
		if testID != "" {
			data-testid={ testID }
		}
	>
		{ children... }
	</div>
}

// PageHeader is the title row every page opens with; children are the
// right-hand actions. Renders the title alone when there are none.
templ PageHeader(title string) {
	<div class="page-header">
		<h1 class="page-title">{ title }</h1>
		{ children... }
	</div>
}

// SectionHeading is a sub-heading inside a page. class carries the margins.
templ SectionHeading(text, class string) {
	<h2 class={ "section-title", templ.KV(class, class != "") }>{ text }</h2>
}

// TableCard is the bordered, clipped box every table sits in.
templ TableCard(testID string) {
	<div
		class="table-card"
		if testID != "" {
			data-testid={ testID }
		}
	>
		{ children... }
	</div>
}

// TableEmpty is the zero-row message inside a TableCard.
templ TableEmpty(text string) {
	<p class="table-empty">{ text }</p>
}

// pageURL appends the page parameter with the right separator: callers pass a
// base that already carries their filters ("/admin/content?kind=post"), and
// hardcoding "?" would bury those in the value of the last one.
func pageURL(baseURL string, page int) string {
	sep := "?"
	if strings.Contains(baseURL, "?") {
		sep = "&"
	}
	return fmt.Sprintf("%s%spage=%d", baseURL, sep, page)
}

// Pagination renders hx-get pager links. target is the box the pager morphs —
// "#table-container" for every table, "#notif-list" for notifications.
templ Pagination(page, totalPages int, baseURL, target string) {
	if totalPages > 1 {
		<nav class="flex items-center justify-between mt-4 text-sm" aria-label={ i18n.T(ctx, "activity.pagination_aria") }>
			if page > 1 {
				<a href={ templ.SafeURL(pageURL(baseURL, page-1)) }
					hx-get={ pageURL(baseURL, page-1) }
					hx-target={ target } hx-swap="innerMorph" hx-push-url="true"
					class="btn btn-ghost">{ i18n.T(ctx, "activity.pagination_prev") }</a>
			} else {
				<span></span>
			}
			<span class="text-fg-muted">{ i18n.T(ctx, "activity.pagination_page_of", page, totalPages) }</span>
			if page < totalPages {
				<a href={ templ.SafeURL(pageURL(baseURL, page+1)) }
					hx-get={ pageURL(baseURL, page+1) }
					hx-target={ target } hx-swap="innerMorph" hx-push-url="true"
					class="btn btn-ghost">{ i18n.T(ctx, "activity.pagination_next") }</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

// PlanCard renders one plan on the pricing page and in upgrade CTAs.
templ PlanCard(plan billing.Plan, current bool) {
	<div class={ "card flex flex-col gap-4", templ.KV("ring-2 ring-brand", current) }>
		<div class="flex items-center justify-between">
			<h3 class="section-title">{ plan.Name }</h3>
			if current {
				@Badge(i18n.T(ctx, "common.current_plan"), KindBrand)
			}
		</div>
		<div class="text-3xl font-bold">{ plan.PriceDisplay }</div>
		<ul class="space-y-2 text-sm text-fg-muted flex-1">
			for _, f := range plan.Features {
				<li class="flex gap-2">
					@Icon(IconCheck, "w-4 h-4 mt-0.5 shrink-0 text-success")
					{ f }
				</li>
			}
		</ul>
		{ children... }
	</div>
}

// EmptyState is the zero-data pattern for tables.
templ EmptyState(title, body string) {
	<div class="card text-center py-12">
		<h3 class="font-semibold">{ title }</h3>
		<p class="text-sm text-fg-muted mt-1">{ body }</p>
		<div class="mt-4">
			{ children... }
		</div>
	</div>
}

// StatCard is one number on a dashboard.
templ StatCard(title, value, sub string) {
	<div class="card" data-testid="stat-card">
		<p class="text-sm text-fg-muted">{ title }</p>
		<p class="text-3xl font-bold mt-1">{ value }</p>
		if sub != "" {
			<p class="text-sm text-fg-muted mt-1">{ sub }</p>
		}
	</div>
}

// FieldError is the per-field validation message under an input.
templ FieldError(err string) {
	<p class="field-error" data-testid="form-error">{ err }</p>
}

// FormField renders label + input + field-level error.
templ FormField(name, label, inputType, value, err, placeholder string, required bool) {
	<div>
		<label for={ name } class="label">{ label }</label>
		<input id={ name } name={ name } type={ inputType } value={ value } class="input" placeholder={ placeholder } required?={ required } autofocus?={ required }/>
		if err != "" {
			@FieldError(err)
		}
	</div>
}

// SearchToolbar is the debounced table search every list page opens with. The
// input morphs `target` and pushes the URL, so a search is shareable and the
// Back button works.
templ SearchToolbar(name, value, placeholder, ariaLabel, getURL, target, indicatorID, testID string) {
	<div class="toolbar">
		<input
			type="search" name={ name } value={ value } placeholder={ placeholder }
			class="input max-w-sm"
			hx-get={ getURL } hx-trigger="input changed delay:300ms, search"
			hx-target={ target } hx-swap="innerMorph" hx-push-url="true" hx-include="this"
			hx-sync="this:replace"
			hx-indicator={ "#" + indicatorID }
			aria-label={ ariaLabel }
			if testID != "" {
				data-testid={ testID }
			}
		/>
		<span id={ indicatorID } class="text-fg-muted">
			@Spinner()
		</span>
	</div>
}

// Meter is a usage bar: pct is already clamped to 0..100 by the caller.
templ Meter(pct int, testID string) {
	<div
		class="meter"
		if testID != "" {
			data-testid={ testID }
		}
	>
		<div class="meter-fill" style={ fmt.Sprintf("width: %d%%", pct) }></div>
	</div>
}

// CopyRow is the reveal-once secret pattern: the value in a code box and a
// copy button that carries it on data-copy. The value never reaches an Alpine
// EXPRESSION — a secret spliced into an attribute value is a secret in the
// page's script surface.
templ CopyRow(value, copyLabel, copiedLabel string) {
	<div class="mt-3 flex items-center gap-2">
		<code class="flex-1 text-sm bg-surface-raised border border-border rounded-lg px-3 py-2 overflow-x-auto">{ value }</code>
		<button type="button" x-data="copy" data-copy={ value } @click="copy()" class="btn btn-ghost btn-xs">
			<span x-show="!copied">{ copyLabel }</span>
			<span x-show="copied" x-cloak>{ copiedLabel }</span>
		</button>
	</div>
}

// DefRow is one term/value pair in a DefinitionList.
type DefRow struct{ Term, Value string }

// DefinitionList is the read-only detail pattern (account, org).
templ DefinitionList(rows []DefRow) {
	<dl class="space-y-4 text-sm">
		for _, row := range rows {
			<div>
				<dt class="text-fg-muted">{ row.Term }</dt>
				<dd class="font-medium">{ row.Value }</dd>
			</div>
		}
	</dl>
}

// Tabs is the boosted sub-navigation inside a page (settings). activePath is
// the current path, matched the same way navCurrent matches shell links.
templ Tabs(items []NavItem, activePath string) {
	<nav class="tab-bar">
		for _, item := range items {
			<a
				href={ templ.SafeURL(item.Href) }
				hx-boost="true"
				hx-target={ NavTarget }
				hx-select={ NavTarget }
				hx-swap={ NavSwap }
				aria-current={ navCurrent(Page{Path: activePath}, item.MatchPath()) }
				class="tab"
			>{ NavLabel(ctx, item) }</a>
		}
	</nav>
}

// errorHeadingClass sizes the terminal-page heading: a numeric HTTP status is
// the giant code, anything else is a title and reads at display size.
func errorHeadingClass(code string) string {
	for _, r := range code {
		if r < '0' || r > '9' {
			return "display-title text-brand-text"
		}
	}
	return "error-code"
}

// ErrorPage is the one shape every terminal page takes: a big code or title, a
// sentence, optional detail, optional way home. The five exported wrappers in
// errors.templ are the vocabulary; this is the layout.
templ ErrorPage(code, message, detail string, showHome bool) {
	<section class="page-narrow text-center">
		<h1 class={ errorHeadingClass(code) }>{ code }</h1>
		<p class="mt-4 text-lg text-fg-muted">{ message }</p>
		if detail != "" {
			<pre class="mt-8 card text-xs overflow-auto whitespace-pre-wrap text-left">{ detail }</pre>
		}
		if showHome {
			<a href="/" class="btn btn-primary mt-8">{ i18n.T(ctx, "errors.back_home") }</a>
		}
	</section>
}
