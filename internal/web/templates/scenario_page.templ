package templates

import (
	"fmt"

	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// ScenarioIndex lists the declared scenarios.
templ ScenarioIndex() {
	@ui.PageHeader(ui.PageHeaderOpts{Title: "Scenarios"}) {
		<p class="text-sm text-fg-muted">Realistic product surfaces, each built from installed components.</p>
	}
	<ul class="space-y-2" data-testid="scenario-index">
		for _, scenario := range ScenarioRegistry {
			<li>
				<a
					href={ templ.SafeURL("/dev/scenarios/" + scenario.Slug) }
					class="card p-4 block hover:bg-surface-raised"
					data-testid={ "scenario-" + scenario.Slug }
				>
					<span class="font-medium">{ scenario.Title }</span>
					<span class="block text-sm text-fg-muted">{ scenario.Summary }</span>
				</a>
			</li>
		}
	</ul>
}

// ScenarioPage renders one scenario's surface.
//
// The state controls are real links, so a state is addressable: a reader can
// send someone the error state of the billing scenario rather than describing
// how to reach it. Only the states the descriptor declares are offered, because
// a control that selects a state the scenario does not have is a control that
// must fail.
templ ScenarioPage(scenario Scenario, gc GalleryContext) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: scenario.Title}) {
		<p class="text-sm text-fg-muted">{ scenario.Summary }</p>
	}
	// Every axis is a group of real links carrying the other axes, so a reviewer
	// can combine them and share the exact view they are questioning.
	<div class="space-y-2" data-testid="scenario-axes">
		for _, axis := range scenarioAxes(scenario) {
			<nav class="flex flex-wrap items-center gap-2" aria-label={ axis.Label } data-testid={ "axis-" + axis.Key }>
				<span class="text-xs text-fg-muted w-20">{ axis.Label }</span>
				for _, option := range axis.Options {
					<a
						href={ templ.SafeURL(scenarioAxisURL(scenario, gc, axis.Key, option)) }
						class={ scenarioStateClass(option == scenarioAxisValue(gc, axis.Key)) }
						aria-current={ scenarioCurrent(option == scenarioAxisValue(gc, axis.Key)) }
						data-testid={ scenarioAxisTestID(axis.Key, option) }
					>{ option }</a>
				}
			</nav>
		}
	</div>
	<p class="text-sm text-fg-muted" data-testid="scenario-slug">
		{ fmt.Sprintf("%s · %s state", scenario.Slug, scenarioActiveState(gc.State)) }
	</p>
	// The components this scenario exists to exercise, named from the
	// descriptor. The visual matrix and the accessibility sweep read the same
	// list, so what is claimed here is what gets covered.
	@ui.DescriptionList(ui.DescriptionListOpts{
		Attrs: ui.Attrs{TestID: "scenario-surfaces"},
		Items: []ui.DescriptionItem{
			{Term: "Layout", Value: scenario.Layout},
			{Term: "Components", Value: joinWith(scenario.Surfaces, ", ")},
			{Term: "States", Value: joinWith(scenarioStateOptions(scenario), ", ")},
			{Term: "Rendered at", Value: scenarioContextSummary(gc)},
		},
	})
	// The surface itself. It renders inside #content only: the shell around it
	// is the real layout, so a scenario cannot drift from the chrome the
	// product ships.
	// The direction lives on the surface wrapper, not the document: the shell
	// around it is the product's own and stays in the reader's direction, so
	// only the composition flips.
	<div class="space-y-8" data-testid="scenario-surface" dir={ gc.Direction }>
		if scenario.Render != nil {
			@scenario.Render(gc)
		} else {
			// Stated, not blank: an empty column is indistinguishable from a
			// composition that failed to render.
			@ui.EmptyState(ui.EmptyStateOpts{
				Title: "This scenario has no composition yet.",
				Body:  "It is declared in internal/web/templates/scenarios.go without a Render function.",
			})
		}
	</div>
}

// scenarioStateOptions always begins with default, so the unfiltered view has a
// control of its own rather than being "no control selected".
func scenarioStateOptions(scenario Scenario) []string {
	out := []string{"default"}
	for _, state := range scenario.States {
		if state == "default" {
			continue
		}
		out = append(out, state)
	}
	return out
}

func scenarioActiveState(state string) string {
	if state == "" {
		return "default"
	}
	return state
}

// scenarioStateURL keeps default as the bare path rather than ?state=default:
// one canonical URL per view, so a shared link and a clicked link match.
func scenarioStateURL(scenario Scenario, state string) string {
	if state == "default" {
		return "/dev/scenarios/" + scenario.Slug
	}
	return "/dev/scenarios/" + scenario.Slug + "?state=" + state
}

func scenarioStateClass(active bool) string {
	if active {
		return "btn btn-primary btn-xs"
	}
	return "btn btn-ghost btn-xs"
}

func scenarioCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

func joinWith(values []string, sep string) string {
	out := ""
	for i, value := range values {
		if i > 0 {
			out += sep
		}
		out += value
	}
	return out
}
