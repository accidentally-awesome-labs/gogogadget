package templates

import (
	"context"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

func fmtI64(v int64) string { return fmt.Sprintf("%d", v) }

func fmtI32(v int32) string { return fmt.Sprintf("%d", v) }

// SchedulesData carries the recurring-work table plus create-form state
// (kept on 422 re-render, project-form convention).
type SchedulesData struct {
	Items         []sqlc.Schedule
	Kinds         []string // schedulable kinds (jobs.SchedulableKinds), passed in — templates must not import jobs (import cycle via mail)
	Orgs          []sqlc.Org
	CreateName    string
	CreateKind    string
	CreatePayload string
	CreateEvery   string
	CreateOrg     string
	Invalid       bool
	Now           func() time.Time // render clock for relative times
}

func scheduleScope(s sqlc.Schedule) string {
	if s.OrgID.Valid {
		return s.OrgID.String
	}
	return "system"
}

// kindOptions turns the schedulable-kind list into select options. The kinds
// are wire identities, not copy, so they are not translated.
func kindOptions(kinds []string, selected string) []ui.Option {
	out := make([]ui.Option, 0, len(kinds))
	for _, k := range kinds {
		out = append(out, ui.Option{Value: k, Label: k, Selected: k == selected})
	}
	return out
}

// scopeOptions puts the system-wide choice first, then every org.
func scopeOptions(ctx context.Context, orgs []sqlc.Org, selected string) []ui.Option {
	out := make([]ui.Option, 0, len(orgs)+1)
	out = append(out, ui.Option{Value: "", Label: i18n.T(ctx, "admin.schedules.scope_system"), Selected: selected == ""})
	for _, o := range orgs {
		out = append(out, ui.Option{Value: o.OrgID, Label: o.Name, Selected: o.OrgID == selected})
	}
	return out
}

func adminScheduleColumns(ctx context.Context) []ui.Column {
	return []ui.Column{
		{Key: "name", Label: i18n.T(ctx, "admin.schedules.col_name")},
		{Key: "kind", Label: i18n.T(ctx, "admin.schedules.col_kind")},
		{Key: "scope", Label: i18n.T(ctx, "admin.schedules.col_scope"), HideBelow: ui.BreakpointSM},
		{Key: "every", Label: i18n.T(ctx, "admin.schedules.col_every"), Numeric: true},
		{Key: "enabled", Label: i18n.T(ctx, "admin.schedules.col_enabled")},
		{Key: "next", Label: i18n.T(ctx, "admin.schedules.col_next")},
		{Key: "actions", Label: i18n.T(ctx, "admin.schedules.col_actions"), Align: ui.AlignEnd},
	}
}

templ AdminSchedulesPage(d SchedulesData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.schedules.title")})
	if AdminWrite(ctx) {
		@scheduleCreateCard(d)
	}
	@ui.DataTable(ui.DataTableOpts{
		Caption:       i18n.T(ctx, "admin.schedules.title"),
		HiddenCaption: true,
		Columns:       adminScheduleColumns(ctx),
		RowCount:      len(d.Items),
		Empty:         adminSchedulesEmpty(),
		Attrs:         ui.Attrs{TestID: "schedules-table", Class: "max-w-4xl"},
	}) {
		for _, row := range d.Items {
			<tr id={ "schedule-row-" + fmtI64(row.ID) } data-testid={ "schedule-row-" + fmtI64(row.ID) }>
				<td class="font-medium">{ row.Name }</td>
				<td><code class="code-chip">{ row.Kind }</code></td>
				<td class="text-fg-muted text-xs hidden sm:table-cell">{ scheduleScope(row) }</td>
				<td class="text-right tabular-nums">{ fmtI32(row.EverySeconds) }s</td>
				<td>
					if AdminWrite(ctx) {
						@ui.Form(ui.FormOpts{Attrs: ui.Attrs{
							Class: "inline",
							HX:    ui.HX{Post: "/admin/schedules/" + fmtI64(row.ID) + "/toggle", Disable: true},
						}}) {
							@ui.ToggleButton(ui.ToggleButtonOpts{
								Label: scheduleOnOffLabel(ctx, row.Enabled),
								On:    row.Enabled,
								Size:  ui.SizeXS,
								Attrs: ui.Attrs{TestID: "schedule-toggle-" + fmtI64(row.ID)},
							})
						}
					} else {
						@ui.Badge(ui.BadgeOpts{Text: scheduleOnOffLabel(ctx, row.Enabled), Kind: onOffKind(row.Enabled)})
					}
				</td>
				<td>
					<span data-testid="relative-time" title={ row.NextRunAt.Time.Format("2006-01-02 15:04") }>{ RelTime(d.Now(), row.NextRunAt.Time) }</span>
				</td>
				<td class="text-right">
					if AdminWrite(ctx) {
						@ui.Toolbar(ui.ToolbarOpts{Label: i18n.T(ctx, "admin.schedules.row_actions_aria", row.Name), Attrs: ui.Attrs{Class: "justify-end"}}) {
							if row.Enabled {
								@ui.Button(ui.ButtonOpts{
									Label: i18n.T(ctx, "admin.schedules.run_now"),
									Size:  ui.SizeXS,
									Icon:  ui.IconPlay,
									Attrs: ui.Attrs{
										TestID: "schedule-run-" + fmtI64(row.ID),
										HX:     ui.HX{Post: "/admin/schedules/" + fmtI64(row.ID) + "/run"},
									},
								})
							}
							@ui.ConfirmAction(ui.ConfirmActionOpts{
								ID:           "schedule-delete-dialog-" + fmtI64(row.ID),
								TriggerLabel: i18n.T(ctx, "admin.schedules.delete_row", row.Name),
								Title:        i18n.T(ctx, "admin.schedules.delete_title"),
								Message:      i18n.T(ctx, "admin.schedules.delete_confirm"),
								ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
								CancelLabel:  i18n.T(ctx, "admin.cancel"),
								Kind:         ui.KindDanger,
								HX:           ui.HX{Post: "/admin/schedules/" + fmtI64(row.ID) + "/delete"},
								Attrs:        ui.Attrs{TestID: "schedule-delete-" + fmtI64(row.ID)},
							})
						}
					}
				</td>
			</tr>
		}
	}
	@ui.Text(ui.TextOpts{Size: ui.SizeXS, Muted: true, Attrs: ui.Attrs{Class: "mt-3"}}) {
		{ i18n.T(ctx, "admin.schedules.hint") }
	}
}

func scheduleOnOffLabel(ctx context.Context, on bool) string {
	if on {
		return i18n.T(ctx, "admin.schedules.on")
	}
	return i18n.T(ctx, "admin.schedules.off")
}

templ adminSchedulesEmpty() {
	@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "admin.schedules.empty"), Variant: ui.EmptyInline})
}

// scheduleCreateCard is its own swap target so a 422 re-render replaces exactly
// this card and keeps the submitted values.
templ scheduleCreateCard(d SchedulesData) {
	<div id="schedule-create-form" class="card mb-8 max-w-2xl">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "admin.schedules.create_title"), Attrs: ui.Attrs{Class: "mb-4"}})
		@ui.Form(ui.FormOpts{
			Target: "#schedule-create-form", Swap: "outerHTML",
			Attrs: ui.Attrs{
				Class: "space-y-4", TestID: "schedule-create-form",
				HX: ui.HX{Post: "/admin/schedules", Disable: true},
			},
		}) {
			if d.Invalid {
				@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive}) {
					{ i18n.T(ctx, "admin.schedules.invalid") }
				}
			}
			@ui.Grid(ui.GridOpts{Cols: 2}) {
				@ui.Field(ui.FieldOpts{Name: "name", Label: i18n.T(ctx, "admin.schedules.name_label")}) {
					@ui.TextInput(ui.TextInputOpts{Name: "name", Value: d.CreateName, Placeholder: i18n.T(ctx, "admin.schedules.name_placeholder")})
				}
				@ui.Field(ui.FieldOpts{Name: "kind", Label: i18n.T(ctx, "admin.schedules.kind_label")}) {
					@ui.Select(ui.SelectOpts{Name: "kind", Options: kindOptions(d.Kinds, d.CreateKind)})
				}
			}
			@ui.Grid(ui.GridOpts{Cols: 2}) {
				@ui.Field(ui.FieldOpts{Name: "every_seconds", Label: i18n.T(ctx, "admin.schedules.every_label")}) {
					@ui.NumberInput(ui.NumberInputOpts{Name: "every_seconds", Value: d.CreateEvery, Min: "60"})
				}
				@ui.Field(ui.FieldOpts{Name: "org", Label: i18n.T(ctx, "admin.schedules.scope_label")}) {
					@ui.Select(ui.SelectOpts{Name: "org", Options: scopeOptions(ctx, d.Orgs, d.CreateOrg)})
				}
			}
			@ui.Field(ui.FieldOpts{Name: "payload", Label: i18n.T(ctx, "admin.schedules.payload_label")}) {
				@ui.TextInput(ui.TextInputOpts{Name: "payload", Value: d.CreatePayload, Placeholder: i18n.T(ctx, "admin.schedules.payload_placeholder")})
			}
			@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
				@ui.Button(ui.ButtonOpts{Label: i18n.T(ctx, "admin.schedules.create"), Type: ui.TypeSubmit, Action: ui.ActionPrimary})
				@ui.Spinner(ui.SpinnerOpts{})
			}
		}
	</div>
}
