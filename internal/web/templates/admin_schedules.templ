package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"
	"time"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

func fmtI64(v int64) string { return fmt.Sprintf("%d", v) }

func fmtI32(v int32) string { return fmt.Sprintf("%d", v) }

// SchedulesData carries the recurring-work table plus create-form state
// (kept on 422 re-render, project-form convention).
type SchedulesData struct {
	Items         []sqlc.Schedule
	Kinds         []string // schedulable kinds (jobs.SchedulableKinds), passed in — templates must not import jobs (import cycle via mail)
	Orgs          []sqlc.Org
	CreateName    string
	CreateKind    string
	CreatePayload string
	CreateEvery   string
	CreateOrg     string
	Invalid       bool
	Now           func() time.Time // render clock for relative times
}

func scheduleScope(s sqlc.Schedule) string {
	if s.ClerkOrgID.Valid {
		return s.ClerkOrgID.String
	}
	return "system"
}

templ AdminSchedulesPage(d SchedulesData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "admin.schedules.title")})
	if AdminWrite(ctx) {
		<div id="schedule-create-form" class="card mb-8 max-w-2xl">
			@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "admin.schedules.create_title"), Attrs: ui.Attrs{Class: "mb-4"}})
			<form hx-post="/admin/schedules" hx-target="#schedule-create-form" hx-swap="outerHTML" novalidate hx-disable="this" data-testid="schedule-create-form" class="space-y-4">
				if d.Invalid {
					@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{Class: "", TestID: ""}}) {
						{ i18n.T(ctx, "admin.schedules.invalid") }
					}
				}
				<div class="grid sm:grid-cols-2 gap-4">
					<div>
						<label class="label" for="schedule-name">{ i18n.T(ctx, "admin.schedules.name_label") }</label>
						<input id="schedule-name" type="text" name="name" value={ d.CreateName } class="input" placeholder={ i18n.T(ctx, "admin.schedules.name_placeholder") }/>
					</div>
					<div>
						<label class="label" for="schedule-kind">{ i18n.T(ctx, "admin.schedules.kind_label") }</label>
						<select id="schedule-kind" name="kind" class="input">
							for _, k := range d.Kinds {
								<option value={ k } selected?={ k == d.CreateKind }>{ k }</option>
							}
						</select>
					</div>
				</div>
				<div class="grid sm:grid-cols-2 gap-4">
					<div>
						<label class="label" for="schedule-every">{ i18n.T(ctx, "admin.schedules.every_label") }</label>
						<input id="schedule-every" type="number" name="every_seconds" value={ d.CreateEvery } min="60" class="input"/>
					</div>
					<div>
						<label class="label" for="schedule-org">{ i18n.T(ctx, "admin.schedules.scope_label") }</label>
						<select id="schedule-org" name="org" class="input">
							<option value="">{ i18n.T(ctx, "admin.schedules.scope_system") }</option>
							for _, o := range d.Orgs {
								<option value={ o.ClerkOrgID } selected?={ o.ClerkOrgID == d.CreateOrg }>{ o.Name }</option>
							}
						</select>
					</div>
				</div>
				<div>
					<label class="label" for="schedule-payload">{ i18n.T(ctx, "admin.schedules.payload_label") }</label>
					<input id="schedule-payload" type="text" name="payload" value={ d.CreatePayload } class="input" placeholder='{"filter":"unread"}'/>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "admin.schedules.create") }</button>
					@ui.Spinner(ui.SpinnerOpts{})
				</div>
			</form>
		</div>
	}
	<div class="table-card max-w-4xl" data-testid="schedules-table">
		if len(d.Items) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "admin.schedules.empty"), Variant: ui.EmptyInline})
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "admin.schedules.col_name") }</th>
						<th>{ i18n.T(ctx, "admin.schedules.col_kind") }</th>
						<th>{ i18n.T(ctx, "admin.schedules.col_scope") }</th>
						<th>{ i18n.T(ctx, "admin.schedules.col_every") }</th>
						<th>{ i18n.T(ctx, "admin.schedules.col_enabled") }</th>
						<th>{ i18n.T(ctx, "admin.schedules.col_next") }</th>
						<th class="text-right">{ i18n.T(ctx, "admin.schedules.col_actions") }</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range d.Items {
						<tr data-testid={ "schedule-row-" + fmtI64(row.ID) }>
							<td class="font-medium">{ row.Name }</td>
							<td><code class="code-chip">{ row.Kind }</code></td>
							<td class="text-fg-muted text-xs">{ scheduleScope(row) }</td>
							<td>{ fmtI32(row.EverySeconds) }s</td>
							<td>
								if AdminWrite(ctx) {
									<form hx-post={ "/admin/schedules/" + fmtI64(row.ID) + "/toggle" } hx-disable="this" class="inline">
										<button type="submit" class={ "badge", "badge-" + string(onOffKind(row.Enabled)), "cursor-pointer" } data-testid={ "schedule-toggle-" + fmtI64(row.ID) }>
											if row.Enabled {
												{ i18n.T(ctx, "admin.schedules.on") }
											} else {
												{ i18n.T(ctx, "admin.schedules.off") }
											}
										</button>
									</form>
								} else {
									if row.Enabled {
										@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.schedules.on"), Kind: ui.KindSuccess})
									} else {
										@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "admin.schedules.off"), Kind: ui.KindNeutral})
									}
								}
							</td>
							<td>
								<span data-testid="relative-time" title={ row.NextRunAt.Time.Format("2006-01-02 15:04") }>{ RelTime(d.Now(), row.NextRunAt.Time) }</span>
							</td>
							<td class="text-right">
								if AdminWrite(ctx) {
									<div class="card-actions">
										if row.Enabled {
											<button
												type="button"
												hx-post={ "/admin/schedules/" + fmtI64(row.ID) + "/run" }
												class="btn btn-ghost btn-xs"
												data-testid={ "schedule-run-" + fmtI64(row.ID) }
											>
												{ i18n.T(ctx, "admin.schedules.run_now") }
											</button>
										}
										<button
											type="button"
											hx-post={ "/admin/schedules/" + fmtI64(row.ID) + "/delete" }
											hx-confirm={ i18n.T(ctx, "admin.schedules.delete_confirm") }
											class="btn btn-ghost btn-xs text-danger-text"
											data-testid={ "schedule-delete-" + fmtI64(row.ID) }
										>
											{ i18n.T(ctx, "admin.schedules.delete") }
										</button>
									</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
	<p class="text-xs text-fg-muted mt-3">{ i18n.T(ctx, "admin.schedules.hint") }</p>
}
