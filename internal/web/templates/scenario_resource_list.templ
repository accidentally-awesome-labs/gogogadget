package templates

import (
	"fmt"

	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// The resource-list scenario: the paged, searchable, selectable table every
// product grows. All four states go through one DataTable call, because the
// point being demonstrated is that the toolbar and the pager are slots on the
// table rather than siblings a caller conditionally omits.

// resourceListPageSize is the fixture's rows per page. Twelve rows over four is
// three pages, which is the smallest set where the numbered pager has to render
// a middle page - one where prev and next are both live.
const resourceListPageSize = 4

// resourceListRow is one fixture project. Literal values, so two renders are
// byte-identical and a visual difference means the markup changed.
type resourceListRow struct {
	ID, Name, Owner, Runs, Updated string
	StatusLabel                    string
	StatusKind                     ui.Kind
	Selected                       bool
}

// ScenarioResourceList renders the project table.
templ ScenarioResourceList(gc GalleryContext) {
	<div class="space-y-4" data-testid="scenario-resource-list">
		if gc.State == "error" {
			// Announced, and above the table rather than inside it: the failure
			// is news the moment it arrives, and a message hidden in the box
			// that failed is the one place a user has stopped looking.
			@ui.Notice(ui.NoticeOpts{
				Kind: ui.KindDanger, Live: ui.LiveAssertive,
				Attrs: ui.Attrs{TestID: "resource-list-notice"},
			}) {
				<p class="font-medium">Projects could not be loaded.</p>
				<p class="text-sm">
					{ resourceListFailure(gc.LongContent) }
				</p>
				@ui.ButtonLink(ui.ButtonLinkOpts{
					Label: "Try again", Href: resourceListURL(""),
					Size: ui.SizeSM, Icon: ui.IconRefresh,
					Attrs: ui.Attrs{TestID: "resource-list-retry"},
				})
			}
		}
		@ui.DataTable(resourceListTable(gc)) {
			if gc.State == "loading" {
				for _, slot := range resourceListSkeletonRows() {
					// The same six cells at the same padding as a real row, so
					// the table does not change height when the data lands.
					<tr data-testid={ slot }>
						<td class="px-4 py-3">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
						<td class="px-4 py-3 hidden sm:table-cell">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
						<td class="px-4 py-3">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
						<td class="px-4 py-3">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
						<td class="px-4 py-3 hidden md:table-cell">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
						<td class="px-4 py-3">
							@ui.Skeleton(ui.SkeletonOpts{})
						</td>
					</tr>
				}
			} else {
				for _, row := range resourceListRows(gc) {
					<tr id={ "project-" + row.ID }>
						<td class="px-4 py-3">
							// The checkbox's label is the project name, so the
							// row selector carries a distinct accessible name.
							// A separate select column would give every row a
							// checkbox called "Select", which is a dozen
							// identical controls to a screen reader.
							@ui.Checkbox(ui.CheckboxOpts{
								Name: "ids", Value: row.ID, Label: row.Name, Checked: row.Selected,
								Attrs: ui.Attrs{TestID: "select-" + row.ID},
							})
						</td>
						<td class="px-4 py-3 hidden sm:table-cell">{ row.Owner }</td>
						<td class="px-4 py-3">
							@ui.StatusDot(ui.StatusDotOpts{Kind: row.StatusKind, Label: row.StatusLabel})
						</td>
						<td class="px-4 py-3 text-right tabular-nums">{ row.Runs }</td>
						<td class="px-4 py-3 hidden md:table-cell">{ row.Updated }</td>
						<td class="px-4 py-3">
							@ui.RowActions(ui.RowActionsOpts{
								Label: "Actions for " + row.Name,
								Items: resourceListRowMenu(row),
								Attrs: ui.Attrs{TestID: "actions-" + row.ID},
							})
						</td>
					</tr>
				}
			}
		}
	</div>
}

// resourceListTable assembles the table and its slots.
// Empty, Toolbar, Selection and Pagination are passed for every state. That is
// what keeps the search box on screen when the search matched nothing: a caller
// that renders the table only when rows exist takes the filter away with the
// rows, and the user has nothing left to undo.
func resourceListTable(gc GalleryContext) ui.DataTableOpts {
	return ui.DataTableOpts{
		Caption: resourceListCaption(gc),
		Columns: []ui.Column{
			{Key: "name", Label: "Project", Sortable: true},
			{Key: "owner", Label: "Owner", HideBelow: ui.BreakpointSM},
			{Key: "status", Label: "Status"},
			{Key: "runs", Label: "Runs", Numeric: true, Sortable: true},
			{Key: "updated", Label: "Last run", HideBelow: ui.BreakpointMD},
			{Key: "actions", Label: "Actions", Align: ui.AlignEnd},
		},
		// One sorted column: name ascending. Passing a direction for every
		// column would mark them all sorted, which tells a screen-reader user
		// the table is ordered six ways at once.
		SortKey: "name", SortDir: ui.SortAsc,
		BaseURL:    resourceListURL(gc.State),
		Target:     ui.NavTarget,
		Density:    gc.Density,
		RowCount:   resourceListRowCount(gc),
		Toolbar:    resourceListToolbar(gc),
		Selection:  resourceListSelection(gc),
		Empty:      resourceListEmpty(gc),
		Pagination: resourceListPagination(gc),
		Attrs:      ui.Attrs{TestID: "resource-list-table"},
	}
}

// resourceListToolbar is the search row above the table.
templ resourceListToolbar(gc GalleryContext) {
	@ui.TableToolbar(ui.TableToolbarOpts{Label: "Project table controls", Attrs: ui.Attrs{TestID: "resource-list-toolbar"}}) {
		@ui.SearchInput(ui.SearchInputOpts{
			Name:        "q",
			Value:       resourceListQuery(gc),
			Placeholder: "Search projects…",
			AriaLabel:   "Search projects",
			GetURL:      resourceListURL(gc.State),
			Target:      ui.NavTarget,
			IndicatorID: "resource-list-search-indicator",
			Attrs:       ui.Attrs{TestID: "resource-list-search"},
		})
		@ui.ButtonLink(ui.ButtonLinkOpts{
			Label: "New project", Href: "/dev/scenarios/settings",
			Action: ui.ActionPrimary, Size: ui.SizeSM, Icon: ui.IconAdd,
			Attrs: ui.Attrs{TestID: "resource-list-new"},
		})
	}
}

// resourceListSelection is the bulk bar for the rows checked on this page.
//
// The count is derived from the rows actually rendered, not a constant: a bar
// claiming two selected above a page where none are checked is the kind of
// fixture that makes a reviewer trust the surface less than no fixture at all.
templ resourceListSelection(gc GalleryContext) {
	@ui.SelectionBar(ui.SelectionBarOpts{
		Count:      resourceListSelectedCount(gc),
		CountLabel: resourceListSelectionLabel(gc),
		ClearURL:   resourceListURL(""),
		ClearLabel: "Clear selection",
		Target:     ui.NavTarget,
		Attrs:      ui.Attrs{TestID: "resource-list-selection"},
	}) {
		// Each bulk action navigates to the state it would produce. The dev
		// surface owns no mutation endpoint, and a control wired to one it does
		// not own either 404s or answers with another surface's fragment.
		@ui.ButtonLink(ui.ButtonLinkOpts{
			Label: "Export selected", Href: resourceListURL("loading"),
			Size: ui.SizeXS, Icon: ui.IconDownload,
			Attrs: ui.Attrs{TestID: "resource-list-export"},
		})
		@ui.ButtonLink(ui.ButtonLinkOpts{
			Label: "Archive selected", Href: resourceListURL("empty"),
			Size: ui.SizeXS, Icon: ui.IconFolder,
			Attrs: ui.Attrs{TestID: "resource-list-archive"},
		})
	}
}

// resourceListEmpty is what the table card holds with no rows.
//
// Two different messages, because they need two different actions: a search
// that matched nothing offers to clear itself, and a failure states that the
// rows are absent rather than that none exist.
templ resourceListEmpty(gc GalleryContext) {
	if gc.State == "error" {
		@ui.EmptyState(ui.EmptyStateOpts{
			Variant: ui.EmptyInline,
			Title:   "No rows to show",
			Body:    "The list failed to load, so nothing is displayed. This is not an empty workspace.",
			Attrs:   ui.Attrs{TestID: "resource-list-empty-error"},
		})
	} else {
		@ui.EmptyState(ui.EmptyStateOpts{
			Variant:    ui.EmptyInline,
			Filtered:   true,
			Title:      "No projects match that search",
			Body:       fmt.Sprintf("Nothing in this workspace matches %q. All 12 projects are still there.", resourceListQuery(gc)),
			ClearURL:   resourceListURL(""),
			ClearLabel: "Clear search",
			Target:     ui.NavTarget,
			Attrs:      ui.Attrs{TestID: "resource-list-empty"},
		})
	}
}

// resourceListPagination is the numbered pager.
//
// No Target, so the numbers are ordinary links to this scenario's own URL: the
// handler reads ?page= and renders that slice, which is the same path a browser
// with no JavaScript takes. Numbered because three pages is small enough that
// the digits are navigation rather than noise.
templ resourceListPagination(gc GalleryContext) {
	@ui.Pagination(ui.PaginationOpts{
		Page:       resourceListPage(gc),
		TotalPages: resourceListTotalPages(gc),
		BaseURL:    resourceListURL(gc.State),
		Param:      "page",
		Numbered:   true,
		Labels:     resourceListPagerLabels(),
		Attrs:      ui.Attrs{TestID: "resource-list-pager"},
	})
}

// resourceListURL is the canonical URL for a state, so a sort, search or page
// link returns to the state the reader was looking at instead of dropping them
// on default.
func resourceListURL(state string) string {
	if state == "" || state == "default" {
		return "/dev/scenarios/resource-list"
	}
	return "/dev/scenarios/resource-list?state=" + state
}

// resourceListRowCount decides rows versus the empty slot. Loading counts as
// rows: the skeleton occupies the tbody, so the header row and the column
// widths are already settled when the real rows replace it.
func resourceListRowCount(gc GalleryContext) int {
	switch gc.State {
	case "empty", "error":
		return 0
	case "loading":
		return len(resourceListSkeletonRows())
	default:
		return len(resourceListRows(gc))
	}
}

func resourceListSkeletonRows() []string {
	out := make([]string, 0, resourceListPageSize)
	for i := 1; i <= resourceListPageSize; i++ {
		out = append(out, fmt.Sprintf("resource-list-skeleton-%d", i))
	}
	return out
}

// resourceListRows is the slice on screen: the page the reader asked for, taken
// from the whole fixture. Slicing here rather than rendering a fixed four rows
// is what makes the pager a real control - the numbers change what is listed.
func resourceListRows(gc GalleryContext) []resourceListRow {
	all := resourceListCorpus(gc)
	start := (resourceListPage(gc) - 1) * resourceListPageSize
	if start >= len(all) {
		return nil
	}
	end := start + resourceListPageSize
	if end > len(all) {
		end = len(all)
	}
	return all[start:end]
}

// resourceListCorpus is the whole fixture table: twelve projects, in the name
// order the sorted column claims. Selection is spread across the pages so the
// bulk bar is exercised on every one of them.
func resourceListCorpus(gc GalleryContext) []resourceListRow {
	return []resourceListRow{
		{
			ID: "apollo", Name: resourceListName(gc.LongContent, "Apollo", "Apollo ingest pipeline (europe-west4, migrated from the legacy tenant)"),
			Owner: "Ada Lovelace", Runs: "1,204", Updated: "15 Jan 2026, 09:12",
			StatusLabel: "Active", StatusKind: ui.KindSuccess, Selected: true,
