// resourceListRowMenu is one row's command set.
//
// Delete carries no Confirm: hx-confirm only gates an htmx request, so putting
// it on a navigating item is a confirmation that never appears. The confirmed
// destructive pattern is ConfirmAction, which the settings danger zone renders.
func resourceListRowMenu(row resourceListRow) []ui.MenuItem {
	return []ui.MenuItem{
		{Label: "Open board", Href: "/dev/scenarios/planning", Icon: ui.IconExternal},
		{Label: "Rename", Href: "/dev/scenarios/settings", Icon: ui.IconEdit},
		{Separator: true},
		// Disabled rather than absent: a command that vanishes when
		// unavailable never explains that the project has to be paused first.
		{Label: "Archive", Icon: ui.IconFolder, Disabled: row.StatusKind == ui.KindSuccess},
		{Label: "Delete", Href: resourceListURL("empty"), Icon: ui.IconDelete, Kind: ui.KindDanger},
	}
}

// resourceListCaption states the slice on screen, not just the noun. "Projects"
// alone leaves a screen-reader user with no idea that they are on page two of a
// sorted, filtered set.
func resourceListCaption(gc GalleryContext) string {
	switch gc.State {
	case "empty":
		return fmt.Sprintf("Projects matching %q, sorted by project ascending", resourceListQuery(gc))
	case "error":
		return "Projects, unavailable"
	case "loading":
		return "Projects, loading"
	default:
		first := (resourceListPage(gc)-1)*resourceListPageSize + 1
		return fmt.Sprintf("Projects %d to %d of %d, sorted by project ascending",
			first, first+len(resourceListRows(gc))-1, len(resourceListCorpus(gc)))
	}
}

func resourceListQuery(gc GalleryContext) string {
	if gc.State == "empty" {
		return "obsolete-tenant"
	}
	return ""
}

// resourceListPage clamps the requested page into the pages this state has. An
// out-of-range page would render a pager whose current position does not exist,
// and an empty tbody that looks like a failure.
func resourceListPage(gc GalleryContext) int {
	total := resourceListTotalPages(gc)
	if gc.Page < 1 {
		return 1
	}
	if gc.Page > total {
		return total
	}
	return gc.Page
}

// resourceListTotalPages keeps the pager honest per state: a filtered-to-nothing
// result is one page, and a set that failed to load has no second page to visit.
func resourceListTotalPages(gc GalleryContext) int {
	if gc.State == "empty" || gc.State == "error" {
		return 1
	}
	corpus := len(resourceListCorpus(gc))
	pages := corpus / resourceListPageSize
	if corpus%resourceListPageSize != 0 {
		pages++
	}
	if pages < 1 {
		return 1
	}
	return pages
}

func resourceListSelectedCount(gc GalleryContext) int {
	if gc.State != "default" && gc.State != "" {
		return 0
	}
	count := 0
	for _, row := range resourceListRows(gc) {
		if row.Selected {
			count++
		}
	}
	return count
}

// resourceListSelectionLabel names what was selected out of what. A bare "2"
// beside a delete button does not say two of how many, which is the number that
// decides whether the click is safe.
func resourceListSelectionLabel(gc GalleryContext) string {
	return fmt.Sprintf("%d of %d projects on this page selected",
		resourceListSelectedCount(gc), len(resourceListRows(gc)))
}

// resourceListPagerLabels are English literals by design: the dev catalog is
// not a translated surface, and routing its strings through i18n would put
// fixture copy in the product's catalogs.
func resourceListPagerLabels() ui.PagerLabels {
	return ui.PagerLabels{
		Aria:   func(page, totalPages int) string { return "Project pages" },
		Prev:   func(page, totalPages int) string { return "Previous" },
		Next:   func(page, totalPages int) string { return "Next" },
		PageOf: func(page, totalPages int) string { return fmt.Sprintf("Page %d of %d", page, totalPages) },
		Page:   func(page int) string { return fmt.Sprintf("Page %d", page) },
	}
}

func resourceListFailure(long bool) string {
	if long {
		return "The workspace API answered 503 at 15 Jan 2026, 09:41 UTC after three attempts, so the rows for this page were never retrieved. Your search text and the sort you chose are still in the URL above, which means retrying resumes exactly where you were rather than starting from an unfiltered first page."
	}
	return "The workspace API answered 503 at 09:41. Your search and sort are still in the URL, so retrying resumes where you were."
}

func resourceListName(long bool, short, extended string) string {
	if long {
		return extended
	}
	return short
}
