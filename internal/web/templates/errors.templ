package templates

import "github.com/gogogadget/gogogadget/internal/i18n"

// The five terminal pages are one shape (ErrorPage) with five vocabularies.
// All five names stay exported: they are called from htmx.go, auth.go,
// handlers_account_data.go and the maintenanceMode middleware.

templ NotFound() {
	@ErrorPage(i18n.T(ctx, "errors.code_404"), i18n.T(ctx, "errors.not_found"), "", true)
}

templ Forbidden() {
	@ErrorPage(i18n.T(ctx, "errors.code_403"), i18n.T(ctx, "errors.forbidden"), "", true)
}

// Maintenance offers no way home: the home page is down too.
templ Maintenance() {
	@ErrorPage(i18n.T(ctx, "errors.code_503"), i18n.T(ctx, "errors.maintenance"), "", false)
}

templ ServerError(detail string) {
	@ErrorPage(i18n.T(ctx, "errors.code_500"), i18n.T(ctx, "errors.server_error"), detail, true)
}

// StatusPage is the named variant (rate limit, CSRF): a title rather than a
// status code, so it renders at display size instead of code size.
templ StatusPage(title, detail string) {
	@ErrorPage(title, detail, "", true)
}
