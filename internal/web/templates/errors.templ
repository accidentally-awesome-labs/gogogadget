package templates

templ NotFound() {
	<section class="max-w-3xl mx-auto px-4 py-24 text-center">
		<h1 class="text-6xl font-extrabold text-brand-600">404</h1>
		<p class="mt-4 text-lg text-fg-muted">That page doesn't exist.</p>
		<a href="/" class="btn btn-primary mt-8">Back to home</a>
	</section>
}

templ ServerError(detail string) {
	<section class="max-w-3xl mx-auto px-4 py-24">
		<h1 class="text-6xl font-extrabold text-brand-600 text-center">500</h1>
		<p class="mt-4 text-lg text-fg-muted text-center">Something went wrong on our side.</p>
		if detail != "" {
			<pre class="mt-8 card text-xs overflow-auto whitespace-pre-wrap">{ detail }</pre>
		}
		<div class="text-center"><a href="/" class="btn btn-primary mt-8">Back to home</a></div>
	</section>
}

templ StatusPage(title, detail string) {
	<section class="max-w-3xl mx-auto px-4 py-24 text-center">
		<h1 class="text-4xl font-extrabold text-brand-600">{ title }</h1>
		<p class="mt-4 text-fg-muted">{ detail }</p>
		<a href="/" class="btn btn-primary mt-8">Back to home</a>
	</section>
}
