package templates

import (
	"github.com/gogogadget/gogogadget/internal/billing"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

templ Home(plans []billing.Plan) {
	<!-- Hero -->
	<section class="max-w-6xl mx-auto px-4 pt-20 pb-16 text-center">
		<h1 class="text-5xl font-extrabold tracking-tight" data-testid="hero">
			{ i18n.T(ctx, "home.hero.title1") }<span class="text-brand-600 dark:text-brand-400">{ i18n.T(ctx, "home.hero.title2") }</span>
		</h1>
		<p class="mt-6 text-lg text-fg-muted max-w-2xl mx-auto">
			{ i18n.T(ctx, "home.hero.subtitle") }
		</p>
		<div class="mt-8 flex justify-center gap-4">
			<a href="/signup" class="btn btn-primary text-base px-6 py-3">{ i18n.T(ctx, "home.cta.start") }</a>
			<a href="/docs" class="btn btn-ghost text-base px-6 py-3">{ i18n.T(ctx, "home.cta.docs") }</a>
		</div>
		<div class="mt-12 card aspect-video flex items-center justify-center text-fg-muted" aria-hidden="true">
			{ i18n.T(ctx, "home.screenshot") }
		</div>
	</section>

	<!-- Logo cloud -->
	<section class="max-w-6xl mx-auto px-4 py-8">
		<p class="text-center text-sm text-fg-muted mb-6">{ i18n.T(ctx, "home.stack") }</p>
		<div class="flex flex-wrap justify-center gap-x-10 gap-y-4 text-fg-muted font-semibold">
			<span>Go</span><span>HTMX</span><span>templ</span><span>Tailwind v4</span><span>Postgres</span><span>Clerk</span><span>Polar</span><span>Resend</span><span>PostHog</span><span>Sentry</span>
		</div>
	</section>

	<!-- Feature grid -->
	<section id="features" class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">{ i18n.T(ctx, "home.features.title") }</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6">
			for _, f := range []struct{ Title, Body string }{
				{i18n.T(ctx, "home.f1.title"), i18n.T(ctx, "home.f1.body")},
				{i18n.T(ctx, "home.f2.title"), i18n.T(ctx, "home.f2.body")},
				{i18n.T(ctx, "home.f3.title"), i18n.T(ctx, "home.f3.body")},
				{i18n.T(ctx, "home.f4.title"), i18n.T(ctx, "home.f4.body")},
				{i18n.T(ctx, "home.f5.title"), i18n.T(ctx, "home.f5.body")},
				{i18n.T(ctx, "home.f6.title"), i18n.T(ctx, "home.f6.body")},
			} {
				<div class="card">
					<h3 class="font-semibold">{ f.Title }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ f.Body }</p>
				</div>
			}
		</div>
	</section>

	<!-- How it works -->
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">{ i18n.T(ctx, "home.how.title") }</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6 text-center">
			for i, s := range []struct{ Title, Body string }{
				{i18n.T(ctx, "home.step1.title"), i18n.T(ctx, "home.step1.body")},
				{i18n.T(ctx, "home.step2.title"), i18n.T(ctx, "home.step2.body")},
				{i18n.T(ctx, "home.step3.title"), i18n.T(ctx, "home.step3.body")},
			} {
				<div>
					<div class="w-10 h-10 mx-auto rounded-full bg-brand-600 text-white flex items-center justify-center font-bold">{ i + 1 }</div>
					<h3 class="mt-4 font-semibold">{ s.Title }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ s.Body }</p>
				</div>
			}
		</div>
	</section>

	<!-- Pricing preview -->
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">{ i18n.T(ctx, "home.pricing.title") }</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6">
			for _, p := range plans {
				@PlanCard(p, false) {
					<a href="/signup" class="btn btn-ghost w-full">{ i18n.T(ctx, "home.pricing.get_started") }</a>
				}
			}
		</div>
	</section>

	<!-- FAQ -->
	<section class="max-w-3xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">{ i18n.T(ctx, "home.faq.title") }</h2>
		<div class="mt-10 space-y-6">
			for _, q := range []struct{ Q, A string }{
				{i18n.T(ctx, "home.faq.q1"), i18n.T(ctx, "home.faq.a1")},
				{i18n.T(ctx, "home.faq.q2"), i18n.T(ctx, "home.faq.a2")},
				{i18n.T(ctx, "home.faq.q3"), i18n.T(ctx, "home.faq.a3")},
				{i18n.T(ctx, "home.faq.q4"), i18n.T(ctx, "home.faq.a4")},
				{i18n.T(ctx, "home.faq.q5"), i18n.T(ctx, "home.faq.a5")},
			} {
				<div class="card">
					<h3 class="font-semibold">{ q.Q }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ q.A }</p>
				</div>
			}
		</div>
	</section>

	<!-- CTA band -->
	<section class="bg-brand-600 text-white">
		<div class="max-w-6xl mx-auto px-4 py-16 text-center">
			<h2 class="text-3xl font-bold">{ i18n.T(ctx, "home.cta_band.title") }</h2>
			<p class="mt-4 text-brand-100">{ i18n.T(ctx, "home.cta_band.body") }</p>
			<a href="/signup" class="btn bg-white text-brand-700 hover:bg-brand-50 mt-8 text-base px-6 py-3">{ i18n.T(ctx, "home.cta_band.button") }</a>
		</div>
	</section>
}

templ Pricing(plans []billing.Plan, authed bool, currentPlanKey string) {
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-extrabold text-center">{ i18n.T(ctx, "home.pricing.heading") }</h1>
		<p class="mt-4 text-center text-fg-muted">{ i18n.T(ctx, "home.pricing.subtitle") }</p>
		<div class="mt-12 grid md:grid-cols-3 gap-6">
			for _, p := range plans {
				@PlanCard(p, authed && p.Key == currentPlanKey) {
					if !authed {
						<a href="/signup" class="btn btn-primary w-full">{ i18n.T(ctx, "home.pricing.choose", p.Name) }</a>
					} else if p.Key == currentPlanKey {
						<span class="btn-ghost w-full !border-transparent text-fg-muted pointer-events-none">{ i18n.T(ctx, "home.pricing.current") }</span>
					} else if p.PolarProductID != "" {
						<form hx-post="/app/billing/checkout" hx-disable="this">
							<input type="hidden" name="plan" value={ p.Key }/>
							<button type="submit" class="btn btn-primary w-full">{ i18n.T(ctx, "home.pricing.upgrade", p.Name) }</button>
						</form>
					}
				}
			}
		</div>
		<p class="mt-8 text-center text-sm text-fg-muted">{ i18n.T(ctx, "home.pricing.taxes") }</p>
	</section>
}
