package templates

import "github.com/gogogadget/gogogadget/internal/billing"

templ Home(plans []billing.Plan) {
	<!-- Hero -->
	<section class="max-w-6xl mx-auto px-4 pt-20 pb-16 text-center">
		<h1 class="text-5xl font-extrabold tracking-tight" data-testid="hero">
			Ship your SaaS this weekend,<span class="text-brand-600"> not next quarter</span>
		</h1>
		<p class="mt-6 text-lg text-fg-muted max-w-2xl mx-auto">
			The production-grade Go + HTMX boilerplate. Auth, teams, billing, email, admin,
			blog, and docs — wired to best-in-class managed services so you own the product,
			not the plumbing.
		</p>
		<div class="mt-8 flex justify-center gap-4">
			<a href="/signup" class="btn btn-primary text-base px-6 py-3">Start building</a>
			<a href="/docs" class="btn btn-ghost text-base px-6 py-3">Read the docs</a>
		</div>
		<div class="mt-12 card aspect-video flex items-center justify-center text-fg-muted" aria-hidden="true">
			Product screenshot
		</div>
	</section>

	<!-- Logo cloud -->
	<section class="max-w-6xl mx-auto px-4 py-8">
		<p class="text-center text-sm text-fg-muted mb-6">Built on a curated value stack</p>
		<div class="flex flex-wrap justify-center gap-x-10 gap-y-4 text-fg-muted font-semibold">
			<span>Go</span><span>HTMX</span><span>templ</span><span>Tailwind v4</span><span>Postgres</span><span>Clerk</span><span>Polar</span><span>Resend</span><span>PostHog</span><span>Sentry</span>
		</div>
	</section>

	<!-- Feature grid -->
	<section id="features" class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">Everything a SaaS needs, nothing it doesn't</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6">
			for _, f := range []struct{ Title, Body string }{
				{"Auth & teams, hosted", "Clerk powers sign-in, social OAuth, 2FA, orgs, roles, and invitations — mirrored locally for fast queries."},
				{"Billing without tax pain", "Polar.sh is your merchant of record. Checkout, customer portal, webhooks, and entitlements included."},
				{"Type-safe end to end", "templ templates, sqlc queries, and Go handlers — the compiler catches what templates usually hide."},
				{"HTMX interactivity", "No SPA weight. Fragments, toasts, inline validation, and optimistic-feeling tables at ~14 KB."},
				{"Secure by default", "Strict CSP, CSRF, per-IP rate limiting, hashed API tokens, and auto-escaped templates."},
				{"Operable from day one", "Postgres job queue, audit log, structured logs, Sentry + PostHog hooks, /healthz and /readyz."},
			} {
				<div class="card">
					<h3 class="font-semibold">{ f.Title }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ f.Body }</p>
				</div>
			}
		</div>
	</section>

	<!-- How it works -->
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">How it works</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6 text-center">
			for i, s := range []struct{ Title, Body string }{
				{"Clone & configure", "make setup, add your Clerk and Polar keys, make dev. Zero to running SaaS in ten minutes."},
				{"Own the product surface", "Your pages, your domain model, your pricing. Undifferentiated heavy lifting stays delegated."},
				{"Deploy anywhere", "One static binary. Docker, fly.io, or any VM — migrations run on boot, scaling is horizontal."},
			} {
				<div>
					<div class="w-10 h-10 mx-auto rounded-full bg-brand-600 text-white flex items-center justify-center font-bold">{ i + 1 }</div>
					<h3 class="mt-4 font-semibold">{ s.Title }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ s.Body }</p>
				</div>
			}
		</div>
	</section>

	<!-- Pricing preview -->
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">Simple pricing</h2>
		<div class="mt-10 grid md:grid-cols-3 gap-6">
			for _, p := range plans {
				@PlanCard(p, false) {
					<a href="/signup" class="btn btn-ghost w-full">Get started</a>
				}
			}
		</div>
	</section>

	<!-- FAQ -->
	<section class="max-w-3xl mx-auto px-4 py-16">
		<h2 class="text-3xl font-bold text-center">Frequently asked questions</h2>
		<div class="mt-10 space-y-6">
			for _, q := range []struct{ Q, A string }{
				{"Why Go + HTMX instead of a JS framework?", "One static binary, no node in production, no hydration cost. HTMX + Alpine cover the interactivity a SaaS dashboard actually needs."},
				{"Do I need accounts with Clerk, Polar, and Resend?", "Not to evaluate: DEV_AUTH_BYPASS runs the full app locally with zero SaaS accounts. Connect real services when you are ready to ship."},
				{"Can I swap a managed service?", "Yes. Every external service sits behind one narrow Go interface — swapping a provider means replacing one file."},
				{"Is this production-ready?", "Strict CSP, CSRF, rate limiting, migrations on boot, background jobs, audit log, tests, CI, and a Dockerfile ship in the box."},
				{"What about the frontend build?", "Tailwind v4 standalone CLI and vendored JS — there is no node_modules anywhere in the shipped artifact."},
			} {
				<div class="card">
					<h3 class="font-semibold">{ q.Q }</h3>
					<p class="mt-2 text-sm text-fg-muted">{ q.A }</p>
				</div>
			}
		</div>
	</section>

	<!-- CTA band -->
	<section class="bg-brand-600 text-white">
		<div class="max-w-6xl mx-auto px-4 py-16 text-center">
			<h2 class="text-3xl font-bold">Stop rebuilding the same 40%</h2>
			<p class="mt-4 text-brand-100">Auth, billing, and email are solved problems. Ship the part that makes you money.</p>
			<a href="/signup" class="btn bg-white text-brand-700 hover:bg-brand-50 mt-8 text-base px-6 py-3">Get started free</a>
		</div>
	</section>
}

templ Pricing(plans []billing.Plan) {
	<section class="max-w-6xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-extrabold text-center">Pricing</h1>
		<p class="mt-4 text-center text-fg-muted">Start free. Upgrade when you outgrow it. Cancel anytime.</p>
		<div class="mt-12 grid md:grid-cols-3 gap-6">
			for _, p := range plans {
				@PlanCard(p, false) {
					// Static until the billing step wires checkout: anon → /signup.
					<a href="/signup" class="btn btn-primary w-full">Choose { p.Name }</a>
				}
			}
		</div>
		<p class="mt-8 text-center text-sm text-fg-muted">Prices in USD. Taxes handled by Polar as merchant of record.</p>
	</section>
}
