package templates

import (
	"context"

	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/identity"
)

// appNavLink is one shell navigation link. Desktop sidebar and mobile drawer
// render the same component, so the two can never drift; data-nav-match is
// what lets app.js re-derive aria-current after a #content-only swap.
templ appNavLink(page Page, item NavItem) {
	<a
		href={ templ.SafeURL(item.Href) }
		hx-boost="true"
		hx-target={ NavTarget }
		hx-select={ NavTarget }
		hx-swap={ NavSwap }
		data-app-nav
		data-nav-match={ item.MatchPath() }
		aria-current={ navCurrent(page, item.MatchPath()) }
		class="nav-link"
	>{ NavLabel(ctx, item) }</a>
}

// appNavSections is the single source for the app-shell navigation items:
// rendered by the desktop Sidebar and by the mobile drawer in Topbar. Links
// are boosted and swap only #content, so the shell (and its SSE stream)
// survives navigation. The item lists live in chrome.go.
// appNavSections takes a scope because it is rendered twice - once in the
// desktop sidebar and once in the mobile drawer - and both copies are in the
// DOM at the same time. Identical landmark names collide, and whether the
// hidden copy is exempt depends on when Alpine cloaks it, which is not
// something an accessibility guarantee should rest on. Distinct names hold
// regardless.
templ appNavSections(page Page, scope string) {
	<nav class="flex flex-col gap-1 text-sm" aria-label={ navScopeLabel(ctx, scope, "sidebar.app_nav") }>
		for _, item := range activeNav(AppNav, environmentFrom(ctx)) {
			@appNavLink(page, item)
		}
	</nav>
	if identity.IsStaff(page.User) {
		<div>
			// The eyebrow is a paragraph, so it names nothing on its own; the
			// landmark carries the name itself.
			<p class="eyebrow mb-2">{ i18n.T(ctx, "sidebar.admin") }</p>
			<nav class="flex flex-col gap-1 text-sm" aria-label={ navScopeLabel(ctx, scope, "sidebar.admin") }>
				for _, item := range activeNav(AdminNav, environmentFrom(ctx)) {
					@appNavLink(page, item)
				}
			</nav>
		</div>
	}
}

// Sidebar is the app-shell navigation. The org-switcher mount is a slot: an
// identity adapter that ships a switcher widget contributes the live element,
// and the shell renders the empty box below when none does. Site admins also
// get the admin section.
templ Sidebar(page Page) {
	<aside class="hidden md:flex w-sidebar shrink-0 flex-col border-r border-border bg-surface-raised p-4 gap-6">
		@logo()
		@shellMount("org-switcher", orgSwitcherPlaceholder(page))
		// The SSE connection lives in the shell on purpose: boosted navigation
		// swaps only #content, so the stream survives page changes. app.js
		// opens it with a native EventSource and fires a "notifications"
		// event at the badge below.
		<div data-notification-stream="/app/notifications/stream">
			<a href="/app/notifications" data-testid="notifications-bell" aria-label={ i18n.T(ctx, "notifications.title") }
				hx-boost="true" hx-target={ NavTarget } hx-select={ NavTarget } hx-swap={ NavSwap }
				class="relative inline-flex items-center gap-2 text-sm text-fg-muted hover:text-fg">
				@Icon(IconBell, "w-5 h-5")
				{ i18n.T(ctx, "sidebar.notifications") }
				<span id="notif-badge" hx-get="/app/notifications/badge" hx-trigger="load, notifications" data-testid="notifications-badge">
					// Placeholder until the count arrives, so the bell does not
					// jump sideways on every page load. Replaced wholesale by
					// the fragment (hx-swap defaults to innerHTML here).
					<span class="skeleton inline-block h-4 w-4 align-middle" aria-hidden="true"></span>
				</span>
			</a>
		</div>
		@appNavSections(page, "sidebar")
		<div class="mt-auto pt-4 border-t border-border">
			@LocaleSwitcher(page.Path)
		</div>
	</aside>
}

// orgSwitcherPlaceholder and userButtonPlaceholder are the shell's neutral
// mount containers: the ids a provider's script looks for, sized so the chrome
// does not jump, and empty. They render only when no adapter fills the slot,
// so a project with no organization widget gets a stable box instead of a
// dead one carrying somebody's class names.
//
// data-shell-placeholder carries the name the box stands in for. Nothing in
// the shell styles it — the fallback is deliberately blank — but it is what a
// test can assert the shell resolved the active org and viewer, and what an
// adapter's own stylesheet can surface if it wants to.
templ orgSwitcherPlaceholder(page Page) {
	<div id="org-switcher" class="min-h-8" data-shell-placeholder={ orgPlaceholder(page.Org) }></div>
}

templ userButtonPlaceholder(page Page) {
	<div id="user-button" class="min-h-8 min-w-8" data-shell-placeholder={ userPlaceholder(page.User) }></div>
}

// Topbar carries the mobile nav + the user-button mount slot. The hamburger
// and drawer are md:hidden; the drawer reuses appNavSections so mobile and
// desktop navigation never drift.
templ Topbar(page Page) {
	<div class="relative border-b border-border bg-surface px-4 h-topbar flex items-center justify-between" x-data="mobileNav">
		// A header landmark, because at phone width this bar is the only shell
		// chrome on screen and its brand link otherwise sits outside every
		// landmark - leaving part of the page unreachable by landmark navigation.
		<header class="flex items-center gap-2 md:hidden">
			<button type="button" @click="toggle" :aria-expanded="open.toString()" aria-label={ i18n.T(ctx, "a11y.menu") } data-testid="mobile-nav-toggle" class="btn btn-ghost btn-icon">
				@Icon(IconMenu, "w-6 h-6")
			</button>
			@logo()
		</header>
		<div class="ml-auto flex items-center gap-3">
			@themeToggle()
			@shellMount("user-button", userButtonPlaceholder(page))
		</div>
		<div x-show="open" x-cloak @click.outside="close" @click="close" class="absolute top-topbar left-0 right-0 z-(--z-nav) bg-surface border-b border-border p-4 flex flex-col gap-4 md:hidden">
			@appNavSections(page, "drawer")
		</div>
	</div>
}

// navScopeLabel names one copy of a duplicated navigation. The scope is appended
// rather than replacing the name so both copies still say what they navigate.
func navScopeLabel(ctx context.Context, scope, key string) string {
	name := i18n.T(ctx, key)
	if scope == "drawer" {
		return name + " (" + i18n.T(ctx, "a11y.menu") + ")"
	}
	return name
}
