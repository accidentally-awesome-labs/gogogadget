package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

// pageTitle is the one place the document title is composed, so a fragment
// swap and a full page load can never disagree.
templ pageTitle(page Page) {
	<title>{ page.Title } — { BrandName }</title>
}

// headMeta renders title, description, and OG/Twitter tags.
templ headMeta(page Page) {
	@pageTitle(page)
	if page.Description != "" {
		<meta name="description" content={ page.Description }/>
	}
	<meta property="og:type" content="website"/>
	<meta property="og:title" content={ page.Title + " — " + BrandName }/>
	if page.Description != "" {
		<meta property="og:description" content={ page.Description }/>
	}
	<meta property="og:url" content={ page.AppURL + page.Path }/>
	<meta property="og:image" content={ page.AppURL + "/static/og.png" }/>
	<meta name="twitter:card" content="summary_large_image"/>
	if page.Canonical != "" {
		<link rel="canonical" href={ page.Canonical }/>
		for _, alt := range page.Alternates {
			<link rel="alternate" hreflang={ alt.Lang } href={ alt.Href }/>
		}
		// Autodiscovery: the feed has existed since day one, but without this
		// no browser or reader could find it from a page.
		<link rel="alternate" type="application/rss+xml" title={ BrandName + " Blog" } href={ page.AppURL + "/rss.xml" }/>
	}
	if page.JSONLD != nil {
		// A data block, not executable script: CSP script-src does not apply
		// to non-JavaScript script types. templ marshals and escapes the
		// value, so page content cannot close the element.
		@LDScript(page.JSONLD)
	}
}

// headScripts loads vendored JS. app.js is NOT deferred so dark-mode init runs
// pre-paint; everything else defers. No inline scripts anywhere (CSP).
//
// htmx reads its config from this meta tag at init — before any of our JS could
// run — which is why it lives here and not in app.js:
//   - includeIndicatorCSS: htmx would otherwise inject a <style> element for
//     .htmx-indicator. We own those rules in input.css, so decline the inject
//     and keep one source of truth (and one less inline style under CSP).
//   - transitions: opted in per-swap on navigation instead of globally, so
//     table search, row deletes and polls stay instant.
templ headScripts(page Page) {
	<meta name="htmx-config" content='{"includeIndicatorCSS":false}'/>
	<script src="/static/app.js"></script>
	<script defer src="/static/vendor/htmx.min.js"></script>
	<script defer src="/static/vendor/alpine-focus.min.js"></script>
	// Module-owned Alpine sources, generated from the installed modules and
	// loaded before alpine-csp boots. Each fragment registers its components on
	// alpine:init, so order between fragments does not matter - only that they
	// all run before Alpine initialises.
	for _, fragment := range ui.AlpineFragments {
		<script defer src={ fragment }></script>
	}
	// The engine registry is data, not behaviour: it tells the loader which
	// versioned vendor file each engine maps to and what its integrity hash is.
	<script defer src="/static/ui-engines.js"></script>
	<script defer src="/static/ui-components.js"></script>
	<script defer src="/static/vendor/alpine-csp.min.js"></script>
	if page.ClerkPublishableKey != "" {
		// Load-bearing: clerk-js owns the ~60s __session JWT refresh cycle.
		// Removing it expires auth ~60s after login. See /docs/authentication.
		<meta name="clerk-publishable-key" content={ page.ClerkPublishableKey }/>
		<script defer src="/static/vendor/clerk.browser.js" data-clerk-publishable-key={ page.ClerkPublishableKey }></script>
	}
	if page.PostHogKey != "" {
		// PostHog loads through the /ingest proxy so CSP stays script-src 'self'.
		<meta name="ph-key" content={ page.PostHogKey }/>
		<script defer src="/ingest/static/array.js"></script>
		<script defer src="/static/analytics.js"></script>
	}
}

// documentHead is the ONE <head> both shells render. It exists because the two
// copies it replaces had already drifted — the web-app manifest link was in
// the public shell only.
templ documentHead(page Page) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		@headMeta(page)
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<link rel="manifest" href="/static/site.webmanifest"/>
		<link rel="stylesheet" href="/static/app.css"/>
		@headScripts(page)
	</head>
}

// contentBox is the ONLY element navigation swaps. `id` stays the first
// attribute and hx-history-elt the second: tests split the document on that
// literal prefix to assert the chrome around it is identical between layouts.
templ contentBox(class string, content templ.Component) {
	<main
		id="content"
		hx-history-elt="true"
		if class != "" {
			class={ class }
		}
	>
		@content
	</main>
}

templ skipLink() {
	<a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-(--z-overlay) focus:top-2 focus:left-2 focus:px-4 focus:py-2 focus:bg-brand focus:text-brand-fg focus:rounded-lg">{ i18n.T(ctx, "layout.skip_content") }</a>
}

// toastRoot stays a named fragment because both shells render it, but the
// markup now lives in ui.ToastRegion - a fixed stack with live-region
// semantics and an Alpine hook is a component, and the shell had the only copy
// of it in the whole catalog.
templ toastRoot() {
	@ui.ToastRegion(ui.ToastRegionOpts{})
}

// phConsent is the analytics consent banner (rendered only when PostHog is
// configured). posthog.init runs only after acceptance — see static/analytics.js.
templ phConsent(page Page) {
	if page.PostHogKey != "" {
		<div x-data="phConsent" x-show="show" x-cloak class="fixed bottom-4 left-4 z-(--z-overlay) card max-w-sm text-sm" role="dialog" aria-label={ i18n.T(ctx, "a11y.analytics_consent") }>
			<p>{ i18n.T(ctx, "layout.analytics_consent_body") }</p>
			<div class="flex gap-2 mt-3">
				<button type="button" @click="accept" class="btn btn-primary btn-xs">{ i18n.T(ctx, "layout.analytics_accept") }</button>
				<button type="button" @click="decline" class="btn btn-ghost btn-xs">{ i18n.T(ctx, "layout.analytics_decline") }</button>
			</div>
		</div>
	}
}

// publicShell is the chrome shared by every unauthenticated page. Public and
// docs pages MUST render byte-identical chrome, because navigation between them
// swaps only #content: anything layout-specific left outside the swap target
// would survive into a page that never asked for it (a docs table of contents
// stranded on the pricing page) or go missing from one that did (no footer).
// So the rule is: if it differs between pages, it belongs inside #content.
templ publicShell(page Page, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.Tag(ctx).String() } { page.HTMLAttrs()... }>
		@documentHead(page)
		<body class="bg-surface text-fg antialiased" hx-headers:inherited={ fmt.Sprintf(`{"X-CSRF-Token": %q}`, page.CSRFToken) }>
			@skipLink()
			@Nav(page)
			@contentBox("", content)
			@Footer(page)
			@toastRoot()
			@phConsent(page)
		</body>
	</html>
}

// PublicLayout wraps marketing/content pages.
templ PublicLayout(page Page, content templ.Component) {
	@publicShell(page, content)
}

// AppLayout is the authenticated shell (sidebar + topbar + toast root).
templ AppLayout(page Page, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.Tag(ctx).String() } { page.HTMLAttrs()... }>
		@documentHead(page)
		<body class="bg-surface text-fg antialiased" hx-headers:inherited={ fmt.Sprintf(`{"X-CSRF-Token": %q}`, page.CSRFToken) }>
			@skipLink()
			if page.Impersonator != nil {
				@ui.Banner(ui.BannerOpts{Kind: ui.KindWarn, Live: ui.LiveAssertive, Attrs: ui.Attrs{TestID: "impersonation-banner"}}) {
					<div class="flex items-center justify-center gap-3">
						<span>{ i18n.T(ctx, "impersonation.banner") } <strong>{ page.User.Name }</strong></span>
						@ui.Form(ui.FormOpts{Attrs: ui.Attrs{HX: ui.HX{Post: "/app/impersonation/exit", Disable: true}}}) {
							<button type="submit" class="font-semibold underline cursor-pointer" data-testid="impersonation-exit">{ i18n.T(ctx, "impersonation.exit") }</button>
						}
					</div>
				}
			}
			<div class="flex min-h-screen">
				@Sidebar(page)
				<div class="flex-1 flex flex-col min-w-0">
					@Topbar(page)
					@announcementBanner(page)
					@billingBanner(page)
					@contentBox("flex-1 p-4 md:p-6 max-w-page w-full mx-auto", content)
				</div>
			</div>
			@toastRoot()
			@phConsent(page)
		</body>
	</html>
}

// announcementKind maps the stored announcement kind onto the shared semantic
// axis. This is the only domain-specific part; the colours themselves live in
// input.css.
func announcementKind(kind string) ui.Kind {
	switch kind {
	case "warning":
		return ui.KindWarn
	case "critical":
		return ui.KindDanger
	default: // info
		return ui.KindInfo
	}
}

// announcementBanner is the platform-wide admin-authored banner. One active
// row at a time; dismissal is per-browser per-announcement (id-keyed
// localStorage, dismissible pattern). It cannot use @Banner: the Alpine
// attributes have to live on the same element the x-show hides.
templ announcementBanner(page Page) {
	if page.Announcement != nil {
		<div
			x-data="dismissible"
			data-key={ "ggg_ann_" + fmt.Sprint(page.Announcement.ID) }
			x-show="!hidden"
			class={ "banner", "banner-" + string(announcementKind(page.Announcement.Kind)) }
			role="alert"
			data-testid="announcement-banner"
		>
			<div class="flex items-center gap-3 max-w-page mx-auto">
				<span class="flex-1">{ page.Announcement.Message }
					if page.Announcement.Url != "" {
						<a href={ templ.SafeURL(page.Announcement.Url) } class="font-semibold underline ml-1" rel="noopener">{ i18n.T(ctx, "announcement.link") }</a>
					}
				</span>
				<button type="button" @click="dismiss()" class="shrink-0 font-semibold cursor-pointer" aria-label={ i18n.T(ctx, "announcement.dismiss") }>×</button>
			</div>
		</div>
	}
}

// billingBanner is the persistent past_due / ending-plan nudge in the shell.
templ billingBanner(page Page) {
	if page.Sub != nil && page.Sub.Status == "past_due" {
		@ui.Banner(ui.BannerOpts{Kind: ui.KindWarn, Live: ui.LiveAssertive, Attrs: ui.Attrs{TestID: ""}}) {
			{ i18n.T(ctx, "layout.banner_past_due_prefix") } <a href="/app/settings/billing" class="font-semibold underline">{ i18n.T(ctx, "layout.banner_past_due_link") }</a> { i18n.T(ctx, "layout.banner_past_due_suffix") }
		}
	}
	if page.Sub != nil && page.Sub.Status == "canceled" && page.Sub.CurrentPeriodEnd.Valid && page.Sub.CurrentPeriodEnd.Time.After(page.NowOrDefault()) {
		@ui.Banner(ui.BannerOpts{Kind: ui.KindInfo, Live: ui.LivePolite, Attrs: ui.Attrs{TestID: ""}}) {
			{ i18n.T(ctx, "layout.banner_ending_prefix") } { page.Sub.CurrentPeriodEnd.Time.Format("January 2, 2006") } — <a href="/app/settings/billing" class="font-semibold underline">{ i18n.T(ctx, "layout.banner_ending_link") }</a>.
		}
	}
}

// AdminLayout is the app shell under the admin routes. It is AppLayout
// verbatim — the admin nav section is gated by identity.IsStaff inside
// appNavSections, not by the layout. The distinct name exists because
// wrapLayout switches on Page.Layout, and an admin page that renders the app
// shell should say so.
templ AdminLayout(page Page, content templ.Component) {
	@AppLayout(page, content)
}

// DocsLayout wraps documentation pages: the shared public chrome, with the docs
// table of contents INSIDE #content so it arrives and leaves with the page
// rather than stranding itself on the next one.
templ DocsLayout(page Page, content templ.Component) {
	@publicShell(page, docsBody(page, content))
}

templ docsBody(page Page, content templ.Component) {
	<div class="max-w-page mx-auto px-4 py-8 flex gap-10">
		<aside class="hidden md:block w-docnav shrink-0">
			<nav class="sticky top-navbar pt-8 space-y-6 text-sm" aria-label={ i18n.T(ctx, "a11y.documentation") }>
				@docsSearch(page, "q", "docs-search-form")
				@docsSections(page)
			</nav>
		</aside>
		<div class="min-w-0 flex-1 pb-16">
			// Below md the aside is gone, which left a docs reader with no way
			// to reach any other page: the only navigation was the browser's
			// Back button. A native <details> needs no script, no focus trap
			// and no state to restore across a boosted swap.
			<details class="md:hidden mb-6" data-testid="docs-nav-mobile">
				<summary class="btn btn-ghost btn-sm">{ i18n.T(ctx, "docs.nav_toggle") }</summary>
				<nav class="mt-4 space-y-6 text-sm" aria-label={ i18n.T(ctx, "a11y.documentation") }>
					@docsSearch(page, "q-mobile", "docs-search-form-mobile")
					@docsSections(page)
				</nav>
			</details>
			@content
		</div>
	</div>
}

// docsSearch and docsSections are shared by the sidebar and the mobile
// disclosure. Two copies of this markup would drift on the first change, and
// the copy nobody looks at on a desktop is the phone one.
//
// controlID and testID are parameters because both copies are in the DOM at
// once - only one is displayed at a time, but a duplicated element id makes
// every `for=` resolve to the first match, and a duplicated test id turns a
// Playwright locator into a strict-mode failure.
templ docsSearch(page Page, controlID, testID string) {
	if page.Docs != nil {
		@ui.Form(ui.FormOpts{
			Method: "get", Action: "/docs/search",
			Attrs: ui.Attrs{Class: "mb-6", TestID: testID},
		}) {
			@ui.Field(ui.FieldOpts{
				ID:          controlID,
				Name:        "q",
				Label:       i18n.T(ctx, "docs.search_aria"),
				HiddenLabel: true,
			}) {
				@ui.TextInput(ui.TextInputOpts{
					ID:          controlID,
					Name:        "q",
					Type:        ui.InputTypeSearch,
					Placeholder: i18n.T(ctx, "docs.search_placeholder"),
					Size:        ui.SizeSM,
				})
			}
		}
	}
}

templ docsSections(page Page) {
	if page.Docs != nil {
		for _, section := range page.Docs.Sections {
			<div>
				<p class="eyebrow mb-2">{ section.Name }</p>
				<ul class="space-y-1">
					for _, doc := range section.Pages {
						<li>
							<a
								href={ "/docs/" + doc.Slug }
								hx-boost="true"
								hx-target={ NavTarget }
								hx-select={ NavTarget }
								hx-swap={ NavSwap }
								aria-current={ navCurrent(page, "/docs/" + doc.Slug) }
								class="doc-link"
							>{ doc.Title }</a>
						</li>
					}
				</ul>
			</div>
		}
	}
}
