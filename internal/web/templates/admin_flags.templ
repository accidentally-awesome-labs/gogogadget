package templates

import (
	"context"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// FlagsData carries the flag table plus the create-form state (kept on 422
// re-render, project-form convention).
type FlagsData struct {
	Flags             []sqlc.FeatureFlag
	CreateKey         string
	CreateDescription string
	CreateErr         string
}

// onOffKind is the shared on/off badge colour: a live flag or schedule reads
// success, a dormant one reads neutral.
func onOffKind(on bool) ui.Kind {
	if on {
		return ui.KindSuccess
	}
	return ui.KindNeutral
}

// AdminFlagsPage is the feature-flag table: key, description, enabled,
// rollout — with per-row toggle, rollout form, delete, and a create form.
// The key cell links to the per-org override detail page.
templ AdminFlagsPage(d FlagsData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "flags.title")})
	if AdminWrite(ctx) {
		@flagCreateCard(d)
	}
	@adminFlagsTable(d)
}

// flagCreateCard is admin-only: support staff read the flag table but do not
// create flags.
templ flagCreateCard(d FlagsData) {
	<div id="flag-create-form" class="card mb-8 max-w-3xl">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "flags.create_title"), Attrs: ui.Attrs{Class: "mb-4"}})
		<form hx-post="/admin/flags" hx-target="#flag-create-form" hx-swap="outerHTML" novalidate hx-disable="this" data-testid="flag-create-form" class="space-y-4">
			if d.CreateErr != "" {
				@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive}) {
					{ d.CreateErr }
				}
			}
			@ui.Grid(ui.GridOpts{Cols: 2}) {
				@ui.Field(ui.FieldOpts{Name: "key", Label: i18n.T(ctx, "flags.key_label")}) {
					@ui.TextInput(ui.TextInputOpts{Name: "key", Value: d.CreateKey, Placeholder: i18n.T(ctx, "flags.key_placeholder")})
				}
				@ui.Field(ui.FieldOpts{Name: "rollout", Label: i18n.T(ctx, "flags.rollout_label")}) {
					@ui.NumberInput(ui.NumberInputOpts{Name: "rollout", Value: "100", Min: "0", Max: "100"})
				}
			}
			@ui.Field(ui.FieldOpts{Name: "description", Label: i18n.T(ctx, "flags.description_label")}) {
				@ui.TextInput(ui.TextInputOpts{Name: "description", Value: d.CreateDescription, Placeholder: i18n.T(ctx, "flags.description_placeholder")})
			}
			@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
				@ui.Button(ui.ButtonOpts{Label: i18n.T(ctx, "flags.create"), Type: ui.TypeSubmit, Action: ui.ActionPrimary})
				@ui.Spinner(ui.SpinnerOpts{})
			}
		</form>
	</div>
}

func adminFlagColumns(ctx context.Context) []ui.Column {
	return []ui.Column{
		{Key: "key", Label: i18n.T(ctx, "flags.col_key")},
		{Key: "description", Label: i18n.T(ctx, "flags.col_description")},
		{Key: "enabled", Label: i18n.T(ctx, "flags.col_enabled")},
		{Key: "rollout", Label: i18n.T(ctx, "flags.col_rollout")},
		{Key: "actions", Label: i18n.T(ctx, "flags.col_actions"), Align: ui.AlignEnd},
	}
}

templ adminFlagsTable(d FlagsData) {
	@ui.DataTable(ui.DataTableOpts{
		Caption:       i18n.T(ctx, "flags.title"),
		HiddenCaption: true,
		Columns:       adminFlagColumns(ctx),
		RowCount:      len(d.Flags),
		Empty:         adminFlagsEmpty(),
		Attrs:         ui.Attrs{TestID: "flags-table", Class: "max-w-3xl"},
	}) {
		for _, f := range d.Flags {
			<tr id={ "flag-row-" + f.Key } data-testid="flag-row">
				<td>
					@ui.Link(ui.LinkOpts{Label: f.Key, Href: "/admin/flags/" + f.Key, Attrs: ui.Attrs{Class: "font-medium"}})
				</td>
				<td class="text-fg-muted text-xs">{ f.Description }</td>
				<td>
					if AdminWrite(ctx) {
						<form hx-post={ fmt.Sprintf("/admin/flags/%s/toggle", f.Key) } hx-disable="this" class="inline">
							@ui.ToggleButton(ui.ToggleButtonOpts{
								Label: onOffLabel(ctx, f.Enabled),
								On:    f.Enabled,
								Size:  ui.SizeXS,
								Attrs: ui.Attrs{TestID: "flag-toggle-" + f.Key},
							})
						</form>
					} else {
						@ui.Badge(ui.BadgeOpts{Text: onOffLabel(ctx, f.Enabled), Kind: onOffKind(f.Enabled)})
					}
				</td>
				<td>
					if AdminWrite(ctx) {
						<form hx-post={ fmt.Sprintf("/admin/flags/%s/rollout", f.Key) } hx-disable="this" class="flex items-center gap-2">
							// Name stays "rollout" for every row because that is what
							// the handler reads, so the element id comes from ID.
							@ui.Field(ui.FieldOpts{
								ID:          "rollout-" + f.Key,
								Name:        "rollout",
								Label:       i18n.T(ctx, "flags.rollout_aria", f.Key),
								HiddenLabel: true,
							}) {
								@ui.NumberInput(ui.NumberInputOpts{
									ID: "rollout-" + f.Key, Name: "rollout",
									Value: fmt.Sprint(f.Rollout), Min: "0", Max: "100",
									Attrs: ui.Attrs{Class: "input-xs w-20", TestID: "flag-rollout-" + f.Key},
								})
							}
							@ui.Button(ui.ButtonOpts{Label: i18n.T(ctx, "flags.set"), Type: ui.TypeSubmit, Size: ui.SizeXS})
						</form>
					} else {
						<span class="text-xs text-fg-muted">{ fmt.Sprint(f.Rollout) }%</span>
					}
				</td>
				<td class="text-right">
					if AdminWrite(ctx) {
						@ui.ConfirmAction(ui.ConfirmActionOpts{
							ID:           "flag-delete-dialog-" + f.Key,
							TriggerLabel: i18n.T(ctx, "flags.delete_row", f.Key),
							Title:        i18n.T(ctx, "flags.delete_title"),
							Message:      i18n.T(ctx, "flags.delete_confirm"),
							ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
							CancelLabel:  i18n.T(ctx, "admin.cancel"),
							Kind:         ui.KindDanger,
							HX:           ui.HX{Post: fmt.Sprintf("/admin/flags/%s/delete", f.Key)},
							Attrs:        ui.Attrs{TestID: "flag-delete-" + f.Key},
						})
					}
				</td>
			</tr>
		}
	}
	@ui.Text(ui.TextOpts{Size: ui.SizeXS, Muted: true, Attrs: ui.Attrs{Class: "mt-3"}}) {
		{ i18n.T(ctx, "flags.hint") }
	}
}

templ adminFlagsEmpty() {
	@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "flags.empty"), Variant: ui.EmptyInline})
}

func onOffLabel(ctx context.Context, on bool) string {
	if on {
		return i18n.T(ctx, "flags.on")
	}
	return i18n.T(ctx, "flags.off")
}

// AdminFlagDetailPage shows one flag and its per-org overrides. Overrides
// win over the global setting in both directions and are read per
// evaluation (no cache), so they apply immediately.
templ AdminFlagDetailPage(flag sqlc.FeatureFlag, overrides []sqlc.ListFlagOverridesByFlagRow, orgs []sqlc.Org) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: flag.Key})
	@ui.DescriptionList(ui.DescriptionListOpts{
		Items: []ui.DescriptionItem{
			{Term: i18n.T(ctx, "flags.col_description"), Value: flag.Description},
			{Term: i18n.T(ctx, "flags.col_enabled"), ValueSlot: flagStateBadge(flag)},
			{Term: i18n.T(ctx, "flags.col_rollout"), Value: fmt.Sprint(flag.Rollout) + "%"},
		},
		Columns: 3,
		Attrs:   ui.Attrs{Class: "mb-6"},
	})
	@ui.BackLink(ui.BackLinkOpts{Label: i18n.T(ctx, "flags.back"), Href: "/admin/flags", Attrs: ui.Attrs{Class: "mb-8"}})
	@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "flags.overrides_heading"), Attrs: ui.Attrs{Class: "mb-3"}})
	@ui.DataTable(ui.DataTableOpts{
		Caption:       i18n.T(ctx, "flags.overrides_heading"),
		HiddenCaption: true,
		Columns: []ui.Column{
			{Key: "org", Label: i18n.T(ctx, "flags.col_org")},
			{Key: "override", Label: i18n.T(ctx, "flags.col_override")},
			{Key: "actions", Label: i18n.T(ctx, "flags.col_actions"), Align: ui.AlignEnd},
		},
		RowCount: len(overrides),
		Empty:    adminFlagOverridesEmpty(),
		Attrs:    ui.Attrs{TestID: "flag-overrides", Class: "max-w-3xl mb-6"},
	}) {
		for _, o := range overrides {
			<tr id={ "flag-override-row-" + o.ClerkOrgID } data-testid={ "flag-override-" + o.ClerkOrgID }>
				<td class="font-medium">{ o.Name }</td>
				<td>
					if o.OverrideEnabled {
						@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "flags.on"), Kind: ui.KindSuccess})
					} else {
						@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "flags.off"), Kind: ui.KindDanger})
					}
				</td>
				<td class="text-right">
					if AdminWrite(ctx) {
						@ui.ConfirmAction(ui.ConfirmActionOpts{
							ID:           "flag-override-delete-dialog-" + o.ClerkOrgID,
							TriggerLabel: i18n.T(ctx, "flags.override_delete_row", o.Name),
							Title:        i18n.T(ctx, "flags.override_delete_title"),
							Message:      i18n.T(ctx, "flags.override_delete_confirm"),
							ConfirmLabel: i18n.T(ctx, "admin.confirm_continue"),
							CancelLabel:  i18n.T(ctx, "admin.cancel"),
							Kind:         ui.KindDanger,
							HX:           ui.HX{Post: "/admin/flags/" + flag.Key + "/overrides/" + o.ClerkOrgID + "/delete"},
							Attrs:        ui.Attrs{TestID: "flag-override-delete-" + o.ClerkOrgID},
						})
					}
				</td>
			</tr>
		}
	}
	if AdminWrite(ctx) {
		<form hx-post={ "/admin/flags/" + flag.Key + "/overrides" } hx-swap="none" novalidate hx-disable="this" class="card max-w-3xl space-y-4" data-testid="flag-override-form">
			<div class="grid sm:grid-cols-3 gap-4 items-end">
				@ui.Field(ui.FieldOpts{Name: "org", Label: i18n.T(ctx, "flags.override_org_label")}) {
					@ui.Select(ui.SelectOpts{Name: "org", Options: orgOptions(orgs)})
				}
				@ui.Field(ui.FieldOpts{Name: "state", Label: i18n.T(ctx, "flags.override_state_label")}) {
					@ui.Select(ui.SelectOpts{Name: "state", Options: []ui.Option{
						{Value: "on", Label: i18n.T(ctx, "flags.on")},
						{Value: "off", Label: i18n.T(ctx, "flags.off")},
					}})
				}
				@ui.Button(ui.ButtonOpts{Label: i18n.T(ctx, "flags.override_add"), Type: ui.TypeSubmit, Action: ui.ActionPrimary})
			</div>
		</form>
	}
}

templ flagStateBadge(flag sqlc.FeatureFlag) {
	@ui.Badge(ui.BadgeOpts{Text: onOffLabel(ctx, flag.Enabled), Kind: onOffKind(flag.Enabled)})
}

templ adminFlagOverridesEmpty() {
	@ui.EmptyState(ui.EmptyStateOpts{Body: i18n.T(ctx, "flags.overrides_empty"), Variant: ui.EmptyInline})
}

// orgOptions turns the org list into select options. Declared here rather than
// inline so both the override form and the schedule scope select read the same
// shape.
func orgOptions(orgs []sqlc.Org) []ui.Option {
	out := make([]ui.Option, 0, len(orgs))
	for _, o := range orgs {
		out = append(out, ui.Option{Value: o.ClerkOrgID, Label: o.Name})
	}
	return out
}
