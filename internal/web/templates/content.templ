package templates

import (
	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// Generic public rendering for any registered content type. A type keeps
// bespoke markup by registering an override in web.contentViews (blog and
// changelog do); everything else lands here, labelled by its own i18n keys,
// so a new type is publishable without touching a template.

// ContentIndex lists a ModePages type's entries, newest first.
templ ContentIndex(t content.Type, entries []content.Entry) {
	<section class="page-narrow">
		<h1 class="display-title">{ i18n.T(ctx, t.PluralKey) }</h1>
		<div class="mt-10 space-y-8">
			if len(entries) == 0 {
				<p class="text-fg-muted" data-testid="content-index-empty">{ i18n.T(ctx, "content.empty") }</p>
			}
			for _, e := range entries {
				<article data-testid="content-index-entry">
					<h2 class="text-2xl font-bold">
						<a href={ templ.SafeURL(t.Path + "/" + e.Slug) } class="hover:text-brand-text">{ e.Title }</a>
					</h2>
					<p class="text-sm text-fg-muted mt-1">
						<time datetime={ e.PublishedAt.Format("2006-01-02") }>{ e.PublishedAt.Format("January 2, 2006") }</time>
					</p>
					if e.Summary != "" {
						<p class="mt-2 text-fg-muted">{ e.Summary }</p>
					}
				</article>
			}
		</div>
	</section>
}

// ContentDetail renders one entry of a ModePages type.
templ ContentDetail(t content.Type, e content.Entry) {
	<article class="page-narrow" data-testid="content-detail">
		<h1 class="display-title">{ e.Title }</h1>
		<p class="text-sm text-fg-muted mt-2">
			<time datetime={ e.PublishedAt.Format("2006-01-02") }>{ e.PublishedAt.Format("January 2, 2006") }</time>
		</p>
		<div class="prose mt-8">
			@templ.Raw(e.Body)
		</div>
	</article>
}

// ContentSinglePage renders every entry of a ModeSinglePage type on one
// scrollable page, each with a stable anchor to link at.
templ ContentSinglePage(t content.Type, entries []content.Entry) {
	<article class="page-narrow">
		<h1 class="display-title">{ i18n.T(ctx, t.PluralKey) }</h1>
		<div class="mt-12 space-y-16">
			if len(entries) == 0 {
				<p class="text-fg-muted" data-testid="content-index-empty">{ i18n.T(ctx, "content.empty") }</p>
			}
			for _, e := range entries {
				<section id={ e.Anchor } class="scroll-mt-24" data-testid="content-entry">
					<div class="flex items-baseline gap-3 flex-wrap">
						<h2 class="text-2xl font-bold">
							<a href={ templ.SafeURL("#" + e.Anchor) } class="hover:text-brand-text">{ e.Title }</a>
						</h2>
						<time datetime={ e.PublishedAt.Format("2006-01-02") } class="text-sm text-fg-muted">
							{ e.PublishedAt.Format("January 2, 2006") }
						</time>
					</div>
					if e.Summary != "" {
						<p class="mt-2 text-fg-muted">{ e.Summary }</p>
					}
					<div class="prose mt-6">
						@templ.Raw(e.Body)
					</div>
				</section>
			}
		</div>
	</article>
}

// ContentPreview is the admin editor's live preview pane: the same HTML the
// public page will show, rendered by the same goldmark instance.
templ ContentPreview(html string) {
	@templ.Raw(html)
}
