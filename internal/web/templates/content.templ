package templates

import (
	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// Generic public rendering for any registered content type. A type keeps
// bespoke markup by registering an override in web.contentViews (blog and
// changelog do); everything else lands here, labelled by its own i18n keys,
// so a new type is publishable without touching a template.

// ContentIndex lists a ModePages type's entries, newest first.
templ ContentIndex(t content.Type, entries []content.Entry) {
	<section class="page-narrow">
		@ui.Heading(ui.HeadingOpts{Text: i18n.T(ctx, t.PluralKey), Level: 1, Size: ui.SizeLG})
		<div class="mt-10 space-y-8">
			if len(entries) == 0 {
				@ui.EmptyState(ui.EmptyStateOpts{
					Body:    i18n.T(ctx, "content.empty"),
					Variant: ui.EmptyCard,
					Attrs:   ui.Attrs{TestID: "content-index-empty"},
				})
			}
			for _, entry := range entries {
				<article data-testid="content-index-entry">
					// Unstyled on both: Heading owns the level, Link owns the
					// anchor, and neither imposes its own typography on a 2xl
					// bold entry title.
					@ui.Heading(ui.HeadingOpts{Level: 2, Unstyled: true, Attrs: ui.Attrs{Class: "text-2xl font-bold"}}) {
						@ui.Link(ui.LinkOpts{
							Label: entry.Title, Href: t.Path + "/" + entry.Slug, Unstyled: true,
							Attrs: ui.Attrs{Class: "hover:text-brand-text"},
						})
					}
					@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-1"}}) {
						<time datetime={ entry.PublishedAt.Format("2006-01-02") }>{ entry.PublishedAt.Format("January 2, 2006") }</time>
					}
					if entry.Summary != "" {
						@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-2"}}) {
							{ entry.Summary }
						}
					}
				</article>
			}
		</div>
	</section>
}

// ContentDetail renders one entry of a ModePages type.
templ ContentDetail(t content.Type, e content.Entry) {
	<article class="page-narrow" data-testid="content-detail">
		@ui.Heading(ui.HeadingOpts{Text: e.Title, Level: 1, Size: ui.SizeLG})
		@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-2"}}) {
			<time datetime={ e.PublishedAt.Format("2006-01-02") }>{ e.PublishedAt.Format("January 2, 2006") }</time>
		}
		@ui.Prose(ui.ProseOpts{Attrs: ui.Attrs{Class: "mt-8"}}) {
			@templ.Raw(e.Body)
		}
	</article>
}

// ContentSinglePage renders every entry of a ModeSinglePage type on one
// scrollable page, each with a stable anchor to link at.
templ ContentSinglePage(t content.Type, entries []content.Entry) {
	<article class="page-narrow">
		@ui.Heading(ui.HeadingOpts{Text: i18n.T(ctx, t.PluralKey), Level: 1, Size: ui.SizeLG})
		<div class="mt-12 space-y-16">
			if len(entries) == 0 {
				@ui.EmptyState(ui.EmptyStateOpts{
					Body:    i18n.T(ctx, "content.empty"),
					Variant: ui.EmptyCard,
					Attrs:   ui.Attrs{TestID: "content-index-empty"},
				})
			}
			for _, entry := range entries {
				<section id={ entry.Anchor } class="scroll-mt-24" data-testid="content-entry">
					<div class="flex items-baseline gap-3 flex-wrap">
						@ui.Heading(ui.HeadingOpts{Level: 2, Unstyled: true, Attrs: ui.Attrs{Class: "text-2xl font-bold"}}) {
							// Boost stays off: this is an in-page fragment, and
							// boosting it repaints the content box at the top
							// before scrolling, flashing the wrong entry.
							@ui.Link(ui.LinkOpts{
								Label: entry.Title, Href: "#" + entry.Anchor, Unstyled: true,
								Attrs: ui.Attrs{Class: "hover:text-brand-text"},
							})
						}
						<time datetime={ entry.PublishedAt.Format("2006-01-02") } class="text-sm text-fg-muted">
							{ entry.PublishedAt.Format("January 2, 2006") }
						</time>
					</div>
					if entry.Summary != "" {
						@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-2"}}) {
							{ entry.Summary }
						}
					}
					@ui.Prose(ui.ProseOpts{Attrs: ui.Attrs{Class: "mt-6"}}) {
						@templ.Raw(entry.Body)
					}
				</section>
			}
		</div>
	</article>
}

// ContentPreview is the admin editor's live preview pane: the same HTML the
// public page will show, rendered by the same goldmark instance.
templ ContentPreview(html string) {
	@templ.Raw(html)
}
