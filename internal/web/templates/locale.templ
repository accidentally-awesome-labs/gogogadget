package templates

import (
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

func localeItemClass(current bool) string {
	if current {
		return "w-full text-left rounded-lg px-3 py-1.5 text-sm hover:bg-surface font-semibold text-fg"
	}
	return "w-full text-left rounded-lg px-3 py-1.5 text-sm hover:bg-surface text-fg-muted"
}

func localeAriaCurrent(current bool) string {
	if current {
		return "true"
	}
	return ""
}

// LocaleSwitcher is the language dropdown (public footer + app sidebar).
// Each option is a tiny ui.Form posting to /set-locale, and returnTo brings the
// user back to the page they were on. The response is a HARD redirect because
// the locale changes the SHELL, which boosted navigation never re-renders — and
// that is also what makes the no-script path correct: a plain submit derives
// method="post" action="/set-locale" from the htmx verb, carries the hidden
// token field, and lands on a 303 back to returnTo. Plain <details> — no JS,
// CSP-safe.
templ LocaleSwitcher(path string) {
	<details class="relative">
		<summary class="flex items-center gap-1 cursor-pointer list-none text-sm text-fg-muted hover:text-fg select-none" data-testid="locale-switcher">
			@Icon(IconGlobe, "w-4 h-4")
			{ i18n.T(ctx, "i18n.language") }
		</summary>
		<div class="absolute left-0 mt-2 w-36 card p-2 flex flex-col gap-1 z-(--z-overlay)">
			for _, l := range i18n.Locales {
				@ui.Form(ui.FormOpts{Swap: "none", Attrs: ui.Attrs{HX: ui.HX{Post: "/set-locale"}}}) {
					<input type="hidden" name="lang" value={ l.Code }/>
					<input type="hidden" name="returnTo" value={ path }/>
					<button
						type="submit"
						class={ localeItemClass(i18n.Tag(ctx) == l.Tag) }
						aria-current={ localeAriaCurrent(i18n.Tag(ctx) == l.Tag) }
						data-testid={ "locale-option-" + l.Code }
					>{ l.Label }</button>
				}
			}
		</div>
	</details>
}
