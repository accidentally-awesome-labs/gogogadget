package templates

import (
	"strings"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

func navCurrent(page Page, match string) string {
	if page.Path == match {
		return "page"
	}
	if match != "/app" && match != "/admin" && strings.HasPrefix(page.Path, strings.TrimSuffix(match, "/")+"/") {
		return "page"
	}
	return ""
}

templ logo() {
	<a href="/" class="flex items-center gap-2 font-bold text-lg">
		<svg class="w-7 h-7 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2z"></path>
		</svg>
		GoGoGadget
	</a>
}

templ themeToggle() {
	<button type="button" x-data="themeToggle" @click="toggle" class="btn-ghost btn !px-2" aria-label={ i18n.T(ctx, "a11y.theme") } data-testid="theme-toggle">
		<svg x-show="!dark" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</svg>
		<svg x-show="dark" x-cloak class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
		</svg>
	</button>
}

// isAnchorLink reports an in-page target. Boosting these is worse than leaving
// them alone: htmx would fetch the page, swap #content (repainting at the top of
// the document) and only then scroll to the fragment — a visible flash of the
// wrong section. Unboosted, the browser scrolls natively with no request at all
// when the page is already loaded, and lands on the fragment when it is not.
func isAnchorLink(href string) bool { return strings.Contains(href, "#") }

templ navLinks(page Page) {
	for _, item := range []struct{ Label, Href string }{
		{i18n.T(ctx, "nav.features"), "/#features"},
		{i18n.T(ctx, "nav.pricing"), "/pricing"},
		{i18n.T(ctx, "nav.blog"), "/blog"},
		{i18n.T(ctx, "nav.docs"), "/docs"},
	} {
		<a
			href={ templ.SafeURL(item.Href) }
			if !isAnchorLink(item.Href) {
				hx-boost="true"
				hx-target={ NavTarget }
				hx-select={ NavTarget }
				hx-swap={ NavSwap }
			}
			class="text-sm font-medium text-fg-muted hover:text-fg"
			aria-current={ navCurrent(page, item.Href) }
		>{ item.Label }</a>
	}
}

templ Nav(page Page) {
	<header class="border-b border-border bg-surface/80 backdrop-blur sticky top-0 z-40">
		<nav class="max-w-6xl mx-auto flex items-center justify-between px-4 h-16" x-data="mobileNav">
			@logo()
			<div class="hidden md:flex items-center gap-6">
				@navLinks(page)
			</div>
			<div class="hidden md:flex items-center gap-3">
				@themeToggle()
				<a href="/login" class="text-sm font-medium text-fg-muted hover:text-fg">{ i18n.T(ctx, "nav.sign_in") }</a>
				<a href="/signup" class="btn btn-primary">{ i18n.T(ctx, "nav.get_started") }</a>
			</div>
			<div class="flex md:hidden items-center gap-2">
				@themeToggle()
				<button type="button" @click="toggle" class="btn-ghost btn !px-2" aria-label={ i18n.T(ctx, "a11y.menu") } :aria-expanded="open.toString()">
					<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
			<div x-show="open" x-cloak @click.outside="close" class="absolute top-16 left-0 right-0 bg-surface border-b border-border p-4 flex flex-col gap-4 md:hidden">
				@navLinks(page)
				<a href="/login" class="text-sm font-medium text-fg-muted">{ i18n.T(ctx, "nav.sign_in") }</a>
				<a href="/signup" class="btn btn-primary">{ i18n.T(ctx, "nav.get_started") }</a>
			</div>
		</nav>
	</header>
}

templ Footer(path string) {
	<footer class="border-t border-border mt-24">
		<div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
			for _, col := range []struct {
				Title string
				Links []struct{ Label, Href string }
			}{
				{i18n.T(ctx, "footer.product"), []struct{ Label, Href string }{{i18n.T(ctx, "footer.features"), "/#features"}, {i18n.T(ctx, "footer.pricing"), "/pricing"}, {i18n.T(ctx, "footer.docs"), "/docs"}}},
				{i18n.T(ctx, "footer.company"), []struct{ Label, Href string }{{i18n.T(ctx, "footer.blog"), "/blog"}, {i18n.T(ctx, "footer.about"), "/#about"}}},
				{i18n.T(ctx, "footer.resources"), []struct{ Label, Href string }{{i18n.T(ctx, "footer.getting_started"), "/docs/getting-started"}, {i18n.T(ctx, "footer.api"), "/docs/api"}, {i18n.T(ctx, "footer.rss"), "/rss.xml"}}},
				{i18n.T(ctx, "footer.legal"), []struct{ Label, Href string }{{i18n.T(ctx, "footer.terms"), "/terms"}, {i18n.T(ctx, "footer.privacy"), "/privacy"}}},
			} {
				<div>
					<h3 class="font-semibold mb-3">{ col.Title }</h3>
					<ul class="space-y-2">
						for _, l := range col.Links {
							<li><a href={ templ.SafeURL(l.Href) } class="text-fg-muted hover:text-fg">{ l.Label }</a></li>
						}
					</ul>
				</div>
			}
		</div>
		<div class="border-t border-border py-6 flex items-center justify-center gap-4 text-sm text-fg-muted">
			<span>{ i18n.T(ctx, "footer.copyright", 2026) }</span>
			@LocaleSwitcher(path)
		</div>
	</footer>
}
