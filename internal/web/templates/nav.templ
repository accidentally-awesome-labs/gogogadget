package templates

func navCurrent(page Page, href string) string {
	if page.Path == href {
		return "page"
	}
	return ""
}

templ logo() {
	<a href="/" class="flex items-center gap-2 font-bold text-lg">
		<svg class="w-7 h-7 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2z"></path>
		</svg>
		GoGoGadget
	</a>
}

templ themeToggle() {
	<button type="button" x-data="themeToggle" @click="toggle" class="btn-ghost btn !px-2" aria-label="Toggle dark mode" data-testid="theme-toggle">
		<svg x-show="!dark" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</svg>
		<svg x-show="dark" x-cloak class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"></path>
		</svg>
	</button>
}

templ navLinks(page Page) {
	for _, item := range []struct{ Label, Href string }{
		{"Features", "/#features"},
		{"Pricing", "/pricing"},
		{"Blog", "/blog"},
		{"Docs", "/docs"},
	} {
		<a href={ templ.SafeURL(item.Href) } class="text-sm font-medium text-fg-muted hover:text-fg" aria-current={ navCurrent(page, item.Href) }>{ item.Label }</a>
	}
}

templ Nav(page Page) {
	<header class="border-b border-border bg-surface/80 backdrop-blur sticky top-0 z-40">
		<nav class="max-w-6xl mx-auto flex items-center justify-between px-4 h-16" hx-boost="true" x-data="mobileNav">
			@logo()
			<div class="hidden md:flex items-center gap-6">
				@navLinks(page)
			</div>
			<div class="hidden md:flex items-center gap-3">
				@themeToggle()
				<a href="/login" class="text-sm font-medium text-fg-muted hover:text-fg">Sign in</a>
				<a href="/signup" class="btn btn-primary">Get started</a>
			</div>
			<div class="flex md:hidden items-center gap-2">
				@themeToggle()
				<button type="button" @click="toggle" class="btn-ghost btn !px-2" aria-label="Open menu" :aria-expanded="open.toString()">
					<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
			<div x-show="open" x-cloak @click.outside="close" class="absolute top-16 left-0 right-0 bg-surface border-b border-border p-4 flex flex-col gap-4 md:hidden">
				@navLinks(page)
				<a href="/login" class="text-sm font-medium text-fg-muted">Sign in</a>
				<a href="/signup" class="btn btn-primary">Get started</a>
			</div>
		</nav>
	</header>
}

templ Footer() {
	<footer class="border-t border-border mt-24">
		<div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
			for _, col := range []struct {
				Title string
				Links []struct{ Label, Href string }
			}{
				{"Product", []struct{ Label, Href string }{{"Features", "/#features"}, {"Pricing", "/pricing"}, {"Docs", "/docs"}}},
				{"Company", []struct{ Label, Href string }{{"Blog", "/blog"}, {"About", "/#about"}}},
				{"Resources", []struct{ Label, Href string }{{"Getting started", "/docs/getting-started"}, {"API", "/docs/api"}, {"RSS", "/rss.xml"}}},
				{"Legal", []struct{ Label, Href string }{{"Terms", "/terms"}, {"Privacy", "/privacy"}}},
			} {
				<div>
					<h3 class="font-semibold mb-3">{ col.Title }</h3>
					<ul class="space-y-2">
						for _, l := range col.Links {
							<li><a href={ templ.SafeURL(l.Href) } class="text-fg-muted hover:text-fg">{ l.Label }</a></li>
						}
					</ul>
				</div>
			}
		</div>
		<div class="border-t border-border py-6 text-center text-sm text-fg-muted">© 2026 GoGoGadget. MIT licensed.</div>
	</footer>
}
