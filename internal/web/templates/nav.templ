package templates

import (
	"strconv"
	"strings"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

func navCurrent(page Page, match string) string {
	if page.Path == match {
		return "page"
	}
	if match != "/app" && match != "/admin" && strings.HasPrefix(page.Path, strings.TrimSuffix(match, "/")+"/") {
		return "page"
	}
	return ""
}

templ logo() {
	<a href="/" class="flex items-center gap-2 font-bold text-lg">
		@Icon(IconLogo, "w-7 h-7 text-brand-text")
		{ BrandName }
	</a>
}

templ themeToggle() {
	<button
		type="button"
		x-data="themeToggle"
		@click="toggle"
		class="btn btn-ghost btn-icon"
		aria-label={ i18n.T(ctx, "a11y.theme") }
		data-testid="theme-toggle"
	>
		@Icon(IconSun, "w-5 h-5", templ.Attributes{"x-show": "!dark"})
		@Icon(IconMoon, "w-5 h-5", templ.Attributes{"x-show": "dark", "x-cloak": true})
	</button>
}

// isAnchorLink reports an in-page target. Boosting these is worse than leaving
// them alone: htmx would fetch the page, swap #content (repainting at the top of
// the document) and only then scroll to the fragment — a visible flash of the
// wrong section. Unboosted, the browser scrolls natively with no request at all
// when the page is already loaded, and lands on the fragment when it is not.
func isAnchorLink(href string) bool { return strings.Contains(href, "#") }

templ navLinks(page Page) {
	for _, item := range PublicNav {
		<a
			href={ templ.SafeURL(item.Href) }
			if !isAnchorLink(item.Href) {
				hx-boost="true"
				hx-target={ NavTarget }
				hx-select={ NavTarget }
				hx-swap={ NavSwap }
			}
			class="text-sm font-medium text-fg-muted hover:text-fg"
			aria-current={ navCurrent(page, item.MatchPath()) }
		>{ NavLabel(ctx, item) }</a>
	}
}

templ Nav(page Page) {
	<header class="border-b border-border bg-surface/80 backdrop-blur sticky top-0 z-(--z-nav)">
		<nav class="max-w-page mx-auto flex items-center justify-between px-4 h-navbar" x-data="mobileNav">
			@logo()
			<div class="hidden md:flex items-center gap-6">
				@navLinks(page)
			</div>
			<div class="hidden md:flex items-center gap-3">
				@themeToggle()
				<a href="/login" class="text-sm font-medium text-fg-muted hover:text-fg">{ i18n.T(ctx, "nav.sign_in") }</a>
				<a href="/signup" class="btn btn-primary">{ i18n.T(ctx, "nav.get_started") }</a>
			</div>
			<div class="flex md:hidden items-center gap-2">
				@themeToggle()
				<button type="button" @click="toggle" class="btn btn-ghost btn-icon" aria-label={ i18n.T(ctx, "a11y.menu") } :aria-expanded="open.toString()">
					@Icon(IconMenu, "w-6 h-6")
				</button>
			</div>
			<div x-show="open" x-cloak @click.outside="close" class="absolute top-navbar left-0 right-0 bg-surface border-b border-border p-4 flex flex-col gap-4 md:hidden">
				@navLinks(page)
				<a href="/login" class="text-sm font-medium text-fg-muted">{ i18n.T(ctx, "nav.sign_in") }</a>
				<a href="/signup" class="btn btn-primary">{ i18n.T(ctx, "nav.get_started") }</a>
			</div>
		</nav>
	</header>
}

// Footer takes the whole Page so the copyright year comes from the render
// clock (frozen under APP_ENV=test) instead of a literal that rots.
//
// The year goes through the catalog as a STRING: message.Printer formats %d
// with locale digit grouping, which rendered the footer as "© 2,026".
templ Footer(page Page) {
	<footer class="border-t border-border mt-24">
		<div class="max-w-page mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
			for _, col := range FooterColumns {
				<div>
					<h3 class="font-semibold mb-3">{ i18n.T(ctx, col.TitleKey) }</h3>
					<ul class="space-y-2">
						for _, l := range col.Items {
							<li><a href={ templ.SafeURL(l.Href) } class="text-fg-muted hover:text-fg">{ NavLabel(ctx, l) }</a></li>
						}
					</ul>
				</div>
			}
		</div>
		<div class="border-t border-border py-6 flex items-center justify-center gap-4 text-sm text-fg-muted">
			<span>{ i18n.T(ctx, "footer.copyright", strconv.Itoa(page.NowOrDefault().Year()), BrandName) }</span>
			@LocaleSwitcher(page.Path)
		</div>
	</footer>
}
