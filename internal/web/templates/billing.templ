package templates

import (
	"fmt"

	"github.com/gogogadget/gogogadget/internal/billing"
	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

func planRank(key string) int {
	switch key {
	case "pro":
		return 1
	case "team":
		return 2
	default:
		return 0
	}
}

func statusBadge(status string) string {
	switch status {
	case "active", "trialing":
		return "bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-300"
	case "past_due":
		return "bg-amber-50 text-amber-700 dark:bg-amber-950 dark:text-amber-300"
	case "canceled":
		return "bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300"
	default:
		return "bg-surface-raised text-fg-muted"
	}
}

// BillingCard is the current-plan card (polled fragment after checkout).
templ BillingCard(plan billing.Plan, sub *sqlc.Subscription, processing bool) {
	<div id="billing-card" class="card mb-6 max-w-lg"
		if processing {
			hx-get="/app/settings/billing/fragment" hx-trigger="every 2s" hx-swap="outerMorph"
		}
	>
		if processing {
			<p class="font-semibold">{ i18n.T(ctx, "billing.processing_title") }</p>
			<p class="text-sm text-fg-muted mt-1">{ i18n.T(ctx, "billing.processing_sub") }</p>
		} else {
			<div class="flex items-center justify-between">
				<h2 class="text-lg font-semibold">{ i18n.T(ctx, "billing.plan_heading", plan.Name) }</h2>
				if sub != nil {
					<span class={ "badge", statusBadge(sub.Status) } data-testid="plan-badge">{ sub.Status }</span>
				} else {
					<span class="badge bg-surface-raised text-fg-muted" data-testid="plan-badge">{ i18n.T(ctx, "billing.plan_free") }</span>
				}
			</div>
			if sub != nil && sub.CurrentPeriodEnd.Valid {
				<p class="text-sm text-fg-muted mt-2">
					if sub.CancelAtPeriodEnd {
						{ i18n.T(ctx, "billing.ends_on", sub.CurrentPeriodEnd.Time.Format("January 2, 2006")) }
					} else {
						{ i18n.T(ctx, "billing.period_ends", sub.CurrentPeriodEnd.Time.Format("January 2, 2006")) }
					}
				</p>
			}
		}
	</div>
}

templ BillingError(msg string) {
	<div class="alert-error max-w-lg" role="alert">{ msg }</div>
}

// NotConfigured is the 503 fragment for an unconfigured service; it always
// links the matching docs page.
templ NotConfigured(feature, docsSlug string) {
	<section class="max-w-3xl mx-auto px-4 py-24 text-center">
		<h1 class="text-4xl font-extrabold text-brand-600 dark:text-brand-400">{ i18n.T(ctx, "billing.not_configured", feature) }</h1>
		<p class="mt-4 text-fg-muted">{ i18n.T(ctx, "billing.not_configured_body") }</p>
		<a href={ "/docs/" + docsSlug } class="btn btn-primary mt-8">{ i18n.T(ctx, "billing.setup_guide") }</a>
	</section>
}

templ SettingsBilling(d BillingData) {
	@SettingsTabs("/app/settings/billing")
	<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "billing.title") }</h1>

	if d.Success && !d.Processing {
		<div class="alert-success mb-4 max-w-lg" role="status">{ i18n.T(ctx, "billing.welcome") }</div>
	}

	@BillingCard(d.Plan, d.Sub, d.Processing)

	if d.Plan.MaxProjects > 0 {
		<div class="card mb-6 max-w-lg" data-testid="usage-meter">
			<h2 class="text-sm font-semibold mb-2">{ i18n.T(ctx, "billing.usage") }</h2>
			<p class="text-sm text-fg-muted">{ i18n.T(ctx, "billing.projects_used", fmt.Sprint(d.ProjectCount), fmt.Sprint(d.Plan.MaxProjects)) }</p>
			<div class="w-full bg-surface-raised rounded-full h-2 mt-2">
				<div class="bg-brand-600 h-2 rounded-full" style={ fmt.Sprintf("width: %d%%", min(100, d.ProjectCount*100/int64(max(d.Plan.MaxProjects, 1)))) }></div>
			</div>
		</div>
	}

	if d.Plan.MaxStorageMB > 0 {
		<div class="card mb-6 max-w-lg" data-testid="storage-meter">
			<h2 class="text-sm font-semibold mb-2">{ i18n.T(ctx, "billing.storage") }</h2>
			<p class="text-sm text-fg-muted">{ i18n.T(ctx, "billing.storage_used", usedMB(d.UsedStorageBytes), fmt.Sprint(d.Plan.MaxStorageMB)) }</p>
			<div class="w-full bg-surface-raised rounded-full h-2 mt-2">
				<div class="bg-brand-600 h-2 rounded-full" style={ fmt.Sprintf("width: %d%%", min(100, d.UsedStorageBytes*100/(int64(d.Plan.MaxStorageMB)*1024*1024))) }></div>
			</div>
		</div>
	}

	for _, m := range d.Plan.Meters {
		if m.LimitPerMonth > 0 {
			<div class="card mb-6 max-w-lg" data-testid={ "meter-" + m.Key }>
				<h2 class="text-sm font-semibold mb-2">{ m.Label }</h2>
				<p class="text-sm text-fg-muted">{ i18n.T(ctx, "billing.meter_used", fmt.Sprint(d.MeterUsage[m.Key]), fmt.Sprint(m.LimitPerMonth)) }</p>
				<div class="w-full bg-surface-raised rounded-full h-2 mt-2">
					<div class="bg-brand-600 h-2 rounded-full" style={ fmt.Sprintf("width: %d%%", min(100, d.MeterUsage[m.Key]*100/max(m.LimitPerMonth, 1))) }></div>
				</div>
			</div>
		}
	}

	<div class="grid sm:grid-cols-3 gap-4 max-w-4xl">
		for _, p := range d.Plans {
			@PlanCard(p, p.Key == d.Plan.Key) {
				if planRank(p.Key) > planRank(d.Plan.Key) {
					<form hx-post="/app/billing/checkout" hx-disable="this">
						<input type="hidden" name="plan" value={ p.Key }/>
						<button type="submit" class="btn btn-primary w-full inline-flex items-center justify-center gap-2">
							@Spinner()
							{ i18n.T(ctx, "billing.upgrade_to", p.Name) }
						</button>
					</form>
				} else if p.Key == d.Plan.Key {
					<span class="btn-ghost w-full !border-transparent text-fg-muted pointer-events-none">{ i18n.T(ctx, "billing.current_plan") }</span>
				}
			}
		}
	</div>

	if d.Sub != nil {
		<form hx-post="/app/billing/portal" hx-disable="this" class="mt-6">
			<button type="submit" class="btn btn-ghost inline-flex items-center gap-2" data-testid="manage-subscription">
				@Spinner()
				{ i18n.T(ctx, "billing.manage") }
			</button>
		</form>
	}
}
