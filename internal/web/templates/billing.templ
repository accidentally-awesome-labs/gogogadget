package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/billing"
	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

func planRank(key string) int {
	switch key {
	case "pro":
		return 1
	case "team":
		return 2
	default:
		return 0
	}
}

// subKind maps a subscription status onto the shared semantic axis.
func subKind(status string) ui.Kind {
	switch status {
	case "active", "trialing":
		return ui.KindSuccess
	case "past_due":
		return ui.KindWarn
	case "canceled":
		return ui.KindDanger
	default:
		return ui.KindNeutral
	}
}

// meterPct is the clamped fill of a usage bar. A zero or negative limit means
// "unlimited" upstream, so it never reaches here — guard anyway rather than
// divide by zero.
func meterPct(used, limit int64) int {
	if limit <= 0 {
		limit = 1
	}
	v := used * 100 / limit
	if v > 100 {
		v = 100
	}
	if v < 0 {
		v = 0
	}
	return int(v)
}

// BillingCard is the current-plan card (polled fragment after checkout).
templ BillingCard(plan billing.Plan, sub *sqlc.Subscription, processing bool) {
	<div id="billing-card" class="card mb-6 max-w-lg"
		if processing {
			hx-get="/app/settings/billing/fragment" hx-trigger="every 2s" hx-swap="outerMorph"
		}
	>
		if processing {
			<p class="font-semibold">{ i18n.T(ctx, "billing.processing_title") }</p>
			<p class="text-sm text-fg-muted mt-1">{ i18n.T(ctx, "billing.processing_sub") }</p>
		} else {
			<div class="flex items-center justify-between">
				@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "billing.plan_heading", plan.Name), Attrs: ui.Attrs{Class: ""}})
				if sub != nil {
					@ui.Badge(ui.BadgeOpts{Text: sub.Status, Kind: subKind(sub.Status), Attrs: ui.Attrs{TestID: "plan-badge"}})
				} else {
					@ui.Badge(ui.BadgeOpts{Text: i18n.T(ctx, "billing.plan_free"), Kind: ui.KindNeutral, Attrs: ui.Attrs{TestID: "plan-badge"}})
				}
			</div>
			if sub != nil && sub.CurrentPeriodEnd.Valid {
				<p class="text-sm text-fg-muted mt-2">
					if sub.CancelAtPeriodEnd {
						{ i18n.T(ctx, "billing.ends_on", sub.CurrentPeriodEnd.Time.Format("January 2, 2006")) }
					} else {
						{ i18n.T(ctx, "billing.period_ends", sub.CurrentPeriodEnd.Time.Format("January 2, 2006")) }
					}
				</p>
			}
		}
	</div>
}

templ BillingError(msg string) {
	@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{Class: "max-w-lg", TestID: ""}}) {
		{ msg }
	}
}

// NotConfigured is the 503 fragment for an unconfigured service; it always
// links the matching docs page.
templ NotConfigured(feature, docsSlug string) {
	<section class="page-narrow text-center">
		<h1 class="display-title text-brand-text">{ i18n.T(ctx, "billing.not_configured", feature) }</h1>
		<p class="mt-4 text-fg-muted">{ i18n.T(ctx, "billing.not_configured_body") }</p>
		<a href={ "/docs/" + docsSlug } class="btn btn-primary mt-8">{ i18n.T(ctx, "billing.setup_guide") }</a>
	</section>
}

// usageCard is the shared shape of every quota meter: label, "x of y", bar.
//
// The meter carries the card's heading as its own label. A meter is announced by
// its accessible name, and without one a screen reader reads a bare percentage
// with no indication of which quota it measures - three unnamed meters on this
// page were indistinguishable.
templ usageCard(heading, detail string, pct int, testID string) {
	<div class="card mb-6 max-w-lg" data-testid={ testID }>
		<h2 class="text-sm font-semibold mb-2">{ heading }</h2>
		<p class="text-sm text-fg-muted">{ detail }</p>
		@ui.Meter(ui.MeterOpts{Percent: pct, Label: heading, ValueText: detail})
	</div>
}

templ SettingsBilling(d BillingData) {
	@SettingsTabs("/app/settings/billing")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "billing.title")})

	if d.Success && !d.Processing {
		@ui.Notice(ui.NoticeOpts{Kind: ui.KindSuccess, Live: ui.LivePolite, Attrs: ui.Attrs{Class: "mb-4 max-w-lg", TestID: ""}}) {
			{ i18n.T(ctx, "billing.welcome") }
		}
	}

	@BillingCard(d.Plan, d.Sub, d.Processing)

	if d.Plan.MaxProjects > 0 {
		@usageCard(
			i18n.T(ctx, "billing.usage"),
			i18n.T(ctx, "billing.projects_used", fmt.Sprint(d.ProjectCount), fmt.Sprint(d.Plan.MaxProjects)),
			meterPct(d.ProjectCount, int64(d.Plan.MaxProjects)),
			"usage-meter",
		)
	}

	if d.Plan.MaxStorageMB > 0 {
		@usageCard(
			i18n.T(ctx, "billing.storage"),
			i18n.T(ctx, "billing.storage_used", usedMB(d.UsedStorageBytes), fmt.Sprint(d.Plan.MaxStorageMB)),
			meterPct(d.UsedStorageBytes, int64(d.Plan.MaxStorageMB)*1024*1024),
			"storage-meter",
		)
	}

	for _, m := range d.Plan.Meters {
		if m.LimitPerMonth > 0 {
			@usageCard(
				m.Label,
				i18n.T(ctx, "billing.meter_used", fmt.Sprint(d.MeterUsage[m.Key]), fmt.Sprint(m.LimitPerMonth)),
				meterPct(d.MeterUsage[m.Key], m.LimitPerMonth),
				"meter-"+m.Key,
			)
		}
	}

	<div class="grid sm:grid-cols-3 gap-4 max-w-4xl">
		for _, p := range d.Plans {
			@ui.PlanCard(uiPlanCard(ctx, p, p.Key == d.Plan.Key)) {
				if planRank(p.Key) > planRank(d.Plan.Key) {
					<form hx-post="/app/billing/checkout" hx-disable="this">
						<input type="hidden" name="plan" value={ p.Key }/>
						<button type="submit" class="btn btn-primary w-full">
							@ui.Spinner(ui.SpinnerOpts{})
							{ i18n.T(ctx, "billing.upgrade_to", p.Name) }
						</button>
					</form>
				} else if p.Key == d.Plan.Key {
					<span class="btn btn-ghost w-full border-transparent text-fg-muted pointer-events-none">{ i18n.T(ctx, "billing.current_plan") }</span>
				}
			}
		}
	</div>

	if d.Sub != nil {
		<form hx-post="/app/billing/portal" hx-disable="this" class="mt-6">
			<button type="submit" class="btn btn-ghost" data-testid="manage-subscription">
				@ui.Spinner(ui.SpinnerOpts{})
				{ i18n.T(ctx, "billing.manage") }
			</button>
		</form>
	}
}
