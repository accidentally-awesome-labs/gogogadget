package templates

import (
	"context"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// SelectOrg is rendered when the user has memberships but no active org in
// their session claims. DevMode buttons use the dev cookie switcher; production
// buttons call Clerk.setActive via clerk-js.
templ SelectOrg(orgs []sqlc.Org, devMode bool) {
	<section class="max-w-md mx-auto px-4 py-24">
		<h1 class="text-2xl font-bold text-center">{ i18n.T(ctx, "settings.select_org_title") }</h1>
		<p class="mt-2 text-center text-fg-muted text-sm">{ i18n.T(ctx, "settings.select_org_sub", len(orgs)) }</p>
		<div class="mt-8 space-y-3" x-data="selectOrg">
			for _, o := range orgs {
				if devMode {
					<a href={ "/dev/switch-org?org=" + o.ClerkOrgID } class="card flex items-center gap-3 hover:border-brand-500 w-full" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</a>
				} else {
					<button type="button" @click={ "choose('" + o.ClerkOrgID + "')" } class="card flex items-center gap-3 hover:border-brand-500 w-full text-left" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</button>
				}
			}
		</div>
	</section>
}

templ Disabled() {
	<section class="max-w-md mx-auto px-4 py-24 text-center">
		<h1 class="text-2xl font-bold">{ i18n.T(ctx, "settings.disabled_title") }</h1>
		<p class="mt-4 text-fg-muted">{ i18n.T(ctx, "settings.disabled_body") }</p>
	</section>
}

templ SettingsTabs(active string) {
	<nav class="flex gap-1 border-b border-border mb-8">
		for _, item := range settingsTabs(ctx) {
			<a
				href={ templ.SafeURL(item.Href) }
				hx-boost="true"
				hx-target={ NavTarget }
				hx-select={ NavTarget }
				hx-swap={ NavSwap }
				aria-current={ navCurrent(Page{Path: active}, item.Href) }
				class="px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-fg-muted hover:text-fg aria-[current=page]:border-brand-600 aria-[current=page]:text-fg"
			>{ item.Label }</a>
		}
	</nav>
}

// settingsTabs assembles the tab list; the Webhooks tab obeys its feature
// flag (WithWebhooksEnabled on the request context).
func settingsTabs(ctx context.Context) []struct{ Label, Href string } {
	items := []struct{ Label, Href string }{
		{i18n.T(ctx, "settings.tab_account"), "/app/settings/account"},
		{i18n.T(ctx, "settings.tab_org"), "/app/settings/org"},
		{i18n.T(ctx, "settings.tab_billing"), "/app/settings/billing"},
		{i18n.T(ctx, "settings.tab_api"), "/app/settings/api"},
	}
	if WebhooksEnabled(ctx) {
		items = append(items, struct{ Label, Href string }{i18n.T(ctx, "settings.tab_webhooks"), "/app/settings/webhooks"})
	}
	// Notification preferences are always available (not flag-gated).
	items = append(items, struct{ Label, Href string }{i18n.T(ctx, "settings.tab_notifications"), "/app/settings/notifications"})
	return items
}

templ SettingsAccount(user sqlc.User, accountPortalURL string, dangerErr string) {
	@SettingsTabs("/app/settings/account")
	<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "settings.account_title") }</h1>
	<div class="card max-w-lg">
		<dl class="space-y-4 text-sm">
			<div>
				<dt class="text-fg-muted">{ i18n.T(ctx, "settings.account_name") }</dt>
				<dd class="font-medium">{ user.Name }</dd>
			</div>
			<div>
				<dt class="text-fg-muted">{ i18n.T(ctx, "settings.account_email") }</dt>
				<dd class="font-medium">{ string(user.Email) }</dd>
			</div>
			<div>
				<dt class="text-fg-muted">{ i18n.T(ctx, "settings.account_member_since") }</dt>
				<dd class="font-medium">{ user.CreatedAt.Time.Format("January 2, 2006") }</dd>
			</div>
		</dl>
		<p class="mt-6 text-sm text-fg-muted">
			{ i18n.T(ctx, "settings.account_clerk_managed") }
			if accountPortalURL != "" {
				<a href={ accountPortalURL } class="link">{ i18n.T(ctx, "settings.account_manage_link") }</a>
			}
		</p>
	</div>

	<div class="card max-w-lg mt-6">
		<h2 class="text-lg font-semibold">{ i18n.T(ctx, "settings.data_title") }</h2>
		<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.data_body") }</p>
		<a href="/app/settings/account/export" class="btn mt-4" data-testid="export-data">{ i18n.T(ctx, "settings.data_export") }</a>
	</div>

	<div id="danger-zone">
		@SettingsDangerZone(user, dangerErr)
	</div>
}

// SettingsDangerZone is the account-deletion card. Extracted so the 422
// re-render (email mismatch, sole-admin blocker) swaps exactly this card.
templ SettingsDangerZone(user sqlc.User, dangerErr string) {
	<div class="card max-w-lg mt-6 border-red-200 dark:border-red-900">
		<h2 class="text-lg font-semibold text-red-700 dark:text-red-400">{ i18n.T(ctx, "settings.danger_title") }</h2>
		<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.danger_body") }</p>
		<form hx-post="/app/settings/account/delete" hx-target="#danger-zone" hx-swap="outerHTML" novalidate hx-disable="this" class="mt-4 space-y-3">
			if dangerErr != "" {
				<div class="alert-error" role="alert" data-testid="delete-account-error">{ dangerErr }</div>
			}
			<div>
				<label class="block text-sm font-medium mb-1" for="confirm_email">{ i18n.T(ctx, "settings.danger_confirm_label") }</label>
				<input id="confirm_email" type="email" name="confirm_email" class="input" autocomplete="email" />
			</div>
			<div class="flex items-center gap-3">
				<button type="submit" class="btn btn-danger" data-testid="delete-account"
					hx-confirm={ i18n.T(ctx, "settings.danger_confirm_prompt") }>
					{ i18n.T(ctx, "settings.danger_delete") }
				</button>
				@Spinner()
			</div>
		</form>
	</div>
}

templ SettingsOrg(org sqlc.Org, members []sqlc.ListMembersByOrgRow, organizationPortalURL string) {
	@SettingsTabs("/app/settings/org")
	<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "settings.org_title") }</h1>
	<div class="card mb-6 max-w-lg">
		<dl class="space-y-4 text-sm">
			<div>
				<dt class="text-fg-muted">{ i18n.T(ctx, "settings.org_name") }</dt>
				<dd class="font-medium">{ org.Name }</dd>
			</div>
			<div>
				<dt class="text-fg-muted">{ i18n.T(ctx, "settings.org_slug") }</dt>
				<dd class="font-medium">{ org.Slug }</dd>
			</div>
		</dl>
		<p class="mt-6 text-sm text-fg-muted">
			{ i18n.T(ctx, "settings.org_clerk_managed") }
			if organizationPortalURL != "" {
				<a href={ organizationPortalURL } class="link">{ i18n.T(ctx, "settings.org_manage_link") }</a>
			}
		</p>
	</div>
	<h2 class="text-lg font-semibold mb-3">{ i18n.T(ctx, "settings.org_members_heading") }</h2>
	<div class="card !p-0 overflow-hidden">
		<table class="table">
			<thead>
				<tr><th>{ i18n.T(ctx, "settings.org_col_member") }</th><th>{ i18n.T(ctx, "settings.org_col_email") }</th><th>{ i18n.T(ctx, "settings.org_col_role") }</th></tr>
			</thead>
			<tbody>
				for _, m := range members {
					<tr>
						<td class="font-medium">{ m.Name }</td>
						<td>{ string(m.Email) }</td>
						<td><span class="badge bg-surface-raised text-fg-muted">{ m.Role }</span></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
