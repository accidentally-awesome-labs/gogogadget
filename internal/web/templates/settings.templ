package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// SelectOrg is rendered when the user has memberships but no active org in
// their session claims. DevMode buttons use the dev cookie switcher; every
// other button hands the choice to the selectOrg Alpine component, which
// asks the identity provider's own client to make the org active.
templ SelectOrg(orgs []sqlc.Org, devMode bool) {
	<section class="max-w-md mx-auto px-4 py-24">
		<h1 class="page-title text-center">{ i18n.T(ctx, "settings.select_org_title") }</h1>
		<p class="mt-2 text-center text-fg-muted text-sm">{ i18n.T(ctx, "settings.select_org_sub", len(orgs)) }</p>
		<div class="mt-8 space-y-3" x-data="selectOrg">
			for _, o := range orgs {
				if devMode {
					<a href={ "/dev/switch-org?org=" + o.OrgID } class="card flex items-center gap-3 hover:border-brand w-full" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</a>
				} else {
					<button type="button" @click={ "choose('" + o.OrgID + "')" } class="card flex items-center gap-3 hover:border-brand w-full text-left cursor-pointer" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</button>
				}
			}
		</div>
	</section>
}

templ Disabled() {
	<section class="max-w-md mx-auto px-4 py-24 text-center">
		<h1 class="page-title">{ i18n.T(ctx, "settings.disabled_title") }</h1>
		<p class="mt-4 text-fg-muted">{ i18n.T(ctx, "settings.disabled_body") }</p>
	</section>
}

templ SettingsTabs(active string) {
	@ui.NavTabs(ui.NavTabsOpts{Items: uiNavItems(ctx, settingsTabs(ctx)), ActivePath: active})
}

templ SettingsAccount(user sqlc.User, accountPortalURL string, dangerErr string) {
	@SettingsTabs("/app/settings/account")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "settings.account_title")})
	@ui.Card(ui.CardOpts{Attrs: ui.Attrs{Class: "max-w-lg"}}) {
		@ui.DescriptionList(ui.DescriptionListOpts{Items: []ui.DescriptionItem{
			{Term: i18n.T(ctx, "settings.account_name"), Value: user.Name},
			{Term: i18n.T(ctx, "settings.account_email"), Value: string(user.Email)},
			{Term: i18n.T(ctx, "settings.account_member_since"), Value: user.CreatedAt.Time.Format("January 2, 2006")},
		}})
		@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-6"}}) {
			{ i18n.T(ctx, "settings.account_identity_managed") }
			if accountPortalURL != "" {
				@ui.Link(ui.LinkOpts{Label: i18n.T(ctx, "settings.account_manage_link"), Href: accountPortalURL})
			}
		}
	}
	// Level 2 throughout: these blocks sit directly under the page title, and
	// the component's h3 default would skip a level.
	@ui.SettingsSection(ui.SettingsSectionOpts{
		Title:       i18n.T(ctx, "settings.appearance_title"),
		Description: i18n.T(ctx, "settings.appearance_body"),
		Level:       2,
		Attrs:       ui.Attrs{Class: "max-w-lg mt-6", TestID: "appearance-card"},
	}) {
		// A fieldset per preference: three buttons with no group name are three
		// unrelated commands to a screen reader, and "System" alone says
		// nothing about what it selects.
		@ui.Fieldset(ui.FieldsetOpts{Legend: i18n.T(ctx, "settings.theme_label")}) {
			<div class="flex gap-2">
				@themeChoice("system", i18n.T(ctx, "settings.theme_system"), user.Theme)
				@themeChoice("light", i18n.T(ctx, "settings.theme_light"), user.Theme)
				@themeChoice("dark", i18n.T(ctx, "settings.theme_dark"), user.Theme)
			</div>
		}
		@ui.Fieldset(ui.FieldsetOpts{Legend: i18n.T(ctx, "settings.language_label"), Attrs: ui.Attrs{Class: "mt-6"}}) {
			<div class="flex gap-2">
				@localeChoice("", i18n.T(ctx, "settings.language_auto"), user.Locale)
				for _, l := range i18n.Locales {
					@localeChoice(l.Code, l.Label, user.Locale)
				}
			</div>
		}
	}
	@ui.SettingsSection(ui.SettingsSectionOpts{
		Title:       i18n.T(ctx, "settings.data_title"),
		Description: i18n.T(ctx, "settings.data_body"),
		Level:       2,
		Attrs:       ui.Attrs{Class: "max-w-lg mt-6"},
	}) {
		@ui.ButtonLink(ui.ButtonLinkOpts{
			Label: i18n.T(ctx, "settings.data_export"), Href: "/app/settings/account/export",
			Icon: ui.IconDownload, Attrs: ui.Attrs{TestID: "export-data"},
		})
	}
	@SettingsDangerZone(user, dangerErr)
}

// SettingsDangerZone is the account-deletion card. It owns #danger-zone itself
// rather than sitting inside a wrapper: the 422 re-render swaps this target
// with outerHTML, and a fragment that did not carry the id left the page with
// no target for the next attempt.
//
// There is deliberately no <form>. The confirmation lives in an AlertDialog
// whose confirm control carries the request, and a dialog's own
// `form method="dialog"` cannot be nested inside another form - the parser
// drops it, which would make Cancel submit the deletion. hx-include carries the
// typed address instead.
templ SettingsDangerZone(user sqlc.User, dangerErr string) {
	@ui.SettingsSection(ui.SettingsSectionOpts{
		Title:       i18n.T(ctx, "settings.danger_title"),
		Description: i18n.T(ctx, "settings.danger_body"),
		Danger:      true,
		Level:       2,
		Attrs:       ui.Attrs{ID: "danger-zone", Class: "max-w-lg mt-6"},
	}) {
		if dangerErr != "" {
			@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Live: ui.LiveAssertive, Attrs: ui.Attrs{Class: "mb-3", TestID: "delete-account-error"}}) {
				{ dangerErr }
			}
		}
		@ui.Field(ui.FieldOpts{Name: "confirm_email", Label: i18n.T(ctx, "settings.danger_confirm_label")}) {
			@ui.TextInput(ui.TextInputOpts{Name: "confirm_email", Type: ui.InputTypeEmail, Autocomplete: "email"})
		}
		@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
			@ui.ConfirmAction(ui.ConfirmActionOpts{
				ID:           "delete-account-dialog",
				TriggerLabel: i18n.T(ctx, "settings.danger_delete"),
				TriggerIcon:  ui.IconDelete,
				Title:        i18n.T(ctx, "settings.danger_confirm_title"),
				Message:      i18n.T(ctx, "settings.danger_confirm_prompt"),
				ConfirmLabel: i18n.T(ctx, "settings.danger_confirm_cta"),
				CancelLabel:  i18n.T(ctx, "settings.danger_confirm_cancel"),
				Kind:         ui.KindDanger,
				HX: ui.HX{
					Post: "/app/settings/account/delete", Target: "#danger-zone", Swap: "outerHTML",
					Include: "[name='confirm_email']", Indicator: "delete-account-spinner", Disable: true,
				},
				Attrs: ui.Attrs{TestID: "delete-account"},
			})
			@ui.Spinner(ui.SpinnerOpts{Attrs: ui.Attrs{ID: "delete-account-spinner"}})
		}
	}
}

templ SettingsOrg(org sqlc.Org, members []sqlc.ListMembersByOrgRow, organizationPortalURL string, canExport bool) {
	@SettingsTabs("/app/settings/org")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "settings.org_title")})
	@ui.Card(ui.CardOpts{Attrs: ui.Attrs{Class: "mb-6 max-w-lg"}}) {
		@ui.DescriptionList(ui.DescriptionListOpts{Items: []ui.DescriptionItem{
			{Term: i18n.T(ctx, "settings.org_name"), Value: org.Name},
			{Term: i18n.T(ctx, "settings.org_slug"), Value: org.Slug},
		}})
		@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-6"}}) {
			{ i18n.T(ctx, "settings.org_identity_managed") }
			if organizationPortalURL != "" {
				@ui.Link(ui.LinkOpts{Label: i18n.T(ctx, "settings.org_manage_link"), Href: organizationPortalURL})
			}
		}
	}
	if canExport {
		@ui.SettingsSection(ui.SettingsSectionOpts{
			Title:       i18n.T(ctx, "settings.org_export_title"),
			Description: i18n.T(ctx, "settings.org_export_body"),
			Level:       2,
			Attrs:       ui.Attrs{Class: "mb-6 max-w-lg", TestID: "org-export-card"},
		}) {
			@ui.Button(ui.ButtonOpts{
				Label: i18n.T(ctx, "settings.org_export_button"), Icon: ui.IconDownload,
				HX:    ui.HX{Post: "/app/settings/org/export", Swap: "none"},
				Attrs: ui.Attrs{TestID: "org-export"},
			})
		}
	}
	@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.org_members_heading"), Attrs: ui.Attrs{Class: "mb-3"}})
	// The caption is hidden because the section heading above already names the
	// table on screen; a screen reader still gets a caption that says what the
	// rows are, which "Members" on its own does not.
	@ui.DataTable(ui.DataTableOpts{
		Caption:       i18n.T(ctx, "settings.org_members_caption"),
		HiddenCaption: true,
		Columns: []ui.Column{
			{Key: "member", Label: i18n.T(ctx, "settings.org_col_member")},
			{Key: "email", Label: i18n.T(ctx, "settings.org_col_email")},
			{Key: "role", Label: i18n.T(ctx, "settings.org_col_role")},
		},
		RowCount: len(members),
		Empty: ui.EmptyState(ui.EmptyStateOpts{
			Variant: ui.EmptyInline, Level: 3,
			Body: i18n.T(ctx, "settings.org_members_empty"),
		}),
	}) {
		for _, m := range members {
			<tr>
				<td class="font-medium">{ m.Name }</td>
				<td>{ string(m.Email) }</td>
				<td>
					@ui.Badge(ui.BadgeOpts{Text: m.Role, Kind: ui.KindNeutral})
				</td>
			</tr>
		}
	}
}

// choiceAction styles a preference button as selected or not.
func choiceAction(selected bool) ui.Action {
	if selected {
		return ui.ActionPrimary
	}
	return ui.ActionGhost
}

// themeChoice and localeChoice are one-field posts rather than a select: the
// vendored Alpine CSP build forbids the inline expression that would submit a
// select on change, and a form needs no JS at all. Both carry returnTo, so the
// server hard-redirects and the shell re-renders with the new <html> class /
// language — HX-Redirect for htmx, a 303 to returnTo for a plain submit, so the
// no-script path lands back on this page rather than on a bare 204.
templ themeChoice(value, label, current string) {
	@ui.Form(ui.FormOpts{Swap: "none", Attrs: ui.Attrs{HX: ui.HX{Post: "/set-theme"}}}) {
		<input type="hidden" name="theme" value={ value }/>
		<input type="hidden" name="returnTo" value="/app/settings/account"/>
		@ui.Button(ui.ButtonOpts{
			Label: label, Type: ui.TypeSubmit, Action: choiceAction(current == value), Size: ui.SizeSM,
			Attrs: ui.Attrs{TestID: "theme-" + value},
		})
	}
}

templ localeChoice(code, label, current string) {
	@ui.Form(ui.FormOpts{Swap: "none", Attrs: ui.Attrs{HX: ui.HX{Post: "/set-locale"}}}) {
		<input type="hidden" name="lang" value={ code }/>
		<input type="hidden" name="returnTo" value="/app/settings/account"/>
		@ui.Button(ui.ButtonOpts{
			Label: label, Type: ui.TypeSubmit, Action: choiceAction(current == code), Size: ui.SizeSM,
			Attrs: ui.Attrs{TestID: "locale-pref-" + localeTestID(code)},
		})
	}
}

// localeTestID keeps the "follow the browser" option addressable in tests.
func localeTestID(code string) string {
	if code == "" {
		return "auto"
	}
	return code
}
