package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

// SelectOrg is rendered when the user has memberships but no active org in
// their session claims. DevMode buttons use the dev cookie switcher; production
// buttons call Clerk.setActive via clerk-js.
templ SelectOrg(orgs []sqlc.Org, devMode bool) {
	<section class="max-w-md mx-auto px-4 py-24">
		<h1 class="page-title text-center">{ i18n.T(ctx, "settings.select_org_title") }</h1>
		<p class="mt-2 text-center text-fg-muted text-sm">{ i18n.T(ctx, "settings.select_org_sub", len(orgs)) }</p>
		<div class="mt-8 space-y-3" x-data="selectOrg">
			for _, o := range orgs {
				if devMode {
					<a href={ "/dev/switch-org?org=" + o.ClerkOrgID } class="card flex items-center gap-3 hover:border-brand w-full" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</a>
				} else {
					<button type="button" @click={ "choose('" + o.ClerkOrgID + "')" } class="card flex items-center gap-3 hover:border-brand w-full text-left cursor-pointer" data-testid="select-org-button">
						<span class="font-semibold">{ o.Name }</span>
						<span class="text-sm text-fg-muted ml-auto">{ o.Slug }</span>
					</button>
				}
			}
		</div>
	</section>
}

templ Disabled() {
	<section class="max-w-md mx-auto px-4 py-24 text-center">
		<h1 class="page-title">{ i18n.T(ctx, "settings.disabled_title") }</h1>
		<p class="mt-4 text-fg-muted">{ i18n.T(ctx, "settings.disabled_body") }</p>
	</section>
}

templ SettingsTabs(active string) {
	@ui.NavTabs(ui.NavTabsOpts{Items: uiNavItems(ctx, settingsTabs(ctx)), ActivePath: active})
}


templ SettingsAccount(user sqlc.User, accountPortalURL string, dangerErr string) {
	@SettingsTabs("/app/settings/account")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "settings.account_title")})
	<div class="card max-w-lg">
		@ui.DescriptionList(ui.DescriptionListOpts{Items: []ui.DescriptionItem{
			{Term: i18n.T(ctx, "settings.account_name"), Value: user.Name},
			{Term: i18n.T(ctx, "settings.account_email"), Value: string(user.Email)},
			{Term: i18n.T(ctx, "settings.account_member_since"), Value: user.CreatedAt.Time.Format("January 2, 2006")},
		}})
		<p class="mt-6 text-sm text-fg-muted">
			{ i18n.T(ctx, "settings.account_clerk_managed") }
			if accountPortalURL != "" {
				<a href={ accountPortalURL } class="link">{ i18n.T(ctx, "settings.account_manage_link") }</a>
			}
		</p>
	</div>

	<div class="card max-w-lg mt-6" data-testid="appearance-card">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.appearance_title"), Attrs: ui.Attrs{Class: ""}})
		<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.appearance_body") }</p>
		<div class="mt-4">
			<p class="label">{ i18n.T(ctx, "settings.theme_label") }</p>
			<div class="flex gap-2">
				@themeChoice("system", i18n.T(ctx, "settings.theme_system"), user.Theme)
				@themeChoice("light", i18n.T(ctx, "settings.theme_light"), user.Theme)
				@themeChoice("dark", i18n.T(ctx, "settings.theme_dark"), user.Theme)
			</div>
		</div>
		<div class="mt-6">
			<p class="label">{ i18n.T(ctx, "settings.language_label") }</p>
			<div class="flex gap-2">
				@localeChoice("", i18n.T(ctx, "settings.language_auto"), user.Locale)
				for _, l := range i18n.Locales {
					@localeChoice(l.Code, l.Label, user.Locale)
				}
			</div>
		</div>
	</div>

	<div class="card max-w-lg mt-6">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.data_title"), Attrs: ui.Attrs{Class: ""}})
		<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.data_body") }</p>
		<a href="/app/settings/account/export" class="btn btn-ghost mt-4" data-testid="export-data">{ i18n.T(ctx, "settings.data_export") }</a>
	</div>

	<div id="danger-zone">
		@SettingsDangerZone(user, dangerErr)
	</div>
}

// SettingsDangerZone is the account-deletion card. Extracted so the 422
// re-render (email mismatch, sole-admin blocker) swaps exactly this card.
templ SettingsDangerZone(user sqlc.User, dangerErr string) {
	<div class="card max-w-lg mt-6 border-danger-border">
		@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.danger_title"), Attrs: ui.Attrs{Class: "text-danger-text"}})
		<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.danger_body") }</p>
		<form hx-post="/app/settings/account/delete" hx-target="#danger-zone" hx-swap="outerHTML" novalidate hx-disable="this" class="mt-4 space-y-3">
			if dangerErr != "" {
				@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Role: "alert", Attrs: ui.Attrs{Class: "", TestID: "delete-account-error"}}) {
					{ dangerErr }
				}
			}
			<div>
				<label class="label" for="confirm_email">{ i18n.T(ctx, "settings.danger_confirm_label") }</label>
				<input id="confirm_email" type="email" name="confirm_email" class="input" autocomplete="email"/>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-danger" data-testid="delete-account"
					hx-confirm={ i18n.T(ctx, "settings.danger_confirm_prompt") }>
					{ i18n.T(ctx, "settings.danger_delete") }
				</button>
				@ui.Spinner(ui.SpinnerOpts{})
			</div>
		</form>
	</div>
}

templ SettingsOrg(org sqlc.Org, members []sqlc.ListMembersByOrgRow, organizationPortalURL string, canExport bool) {
	@SettingsTabs("/app/settings/org")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "settings.org_title")})
	<div class="card mb-6 max-w-lg">
		@ui.DescriptionList(ui.DescriptionListOpts{Items: []ui.DescriptionItem{
			{Term: i18n.T(ctx, "settings.org_name"), Value: org.Name},
			{Term: i18n.T(ctx, "settings.org_slug"), Value: org.Slug},
		}})
		<p class="mt-6 text-sm text-fg-muted">
			{ i18n.T(ctx, "settings.org_clerk_managed") }
			if organizationPortalURL != "" {
				<a href={ organizationPortalURL } class="link">{ i18n.T(ctx, "settings.org_manage_link") }</a>
			}
		</p>
	</div>
	if canExport {
		<div class="card mb-6 max-w-lg" data-testid="org-export-card">
			@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.org_export_title"), Attrs: ui.Attrs{Class: ""}})
			<p class="mt-2 text-sm text-fg-muted">{ i18n.T(ctx, "settings.org_export_body") }</p>
			<button
				type="button"
				hx-post="/app/settings/org/export"
				hx-swap="none"
				class="btn btn-ghost mt-4"
				data-testid="org-export"
			>{ i18n.T(ctx, "settings.org_export_button") }</button>
		</div>
	}
	@ui.SectionHeader(ui.SectionHeaderOpts{Text: i18n.T(ctx, "settings.org_members_heading"), Attrs: ui.Attrs{Class: "mb-3"}})
	@ui.TableCard(ui.TableCardOpts{Attrs: ui.Attrs{TestID: ""}}) {
		<table class="table">
			<thead>
				<tr><th>{ i18n.T(ctx, "settings.org_col_member") }</th><th>{ i18n.T(ctx, "settings.org_col_email") }</th><th>{ i18n.T(ctx, "settings.org_col_role") }</th></tr>
			</thead>
			<tbody>
				for _, m := range members {
					<tr>
						<td class="font-medium">{ m.Name }</td>
						<td>{ string(m.Email) }</td>
						<td>@ui.Badge(ui.BadgeOpts{Text: m.Role, Kind: ui.KindNeutral})</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// choiceClass styles a preference button as selected or not.
func choiceClass(selected bool) string {
	if selected {
		return "btn btn-primary btn-sm"
	}
	return "btn btn-ghost btn-sm"
}

// themeChoice and localeChoice are one-field hx-post forms rather than a
// select: the vendored Alpine CSP build forbids the inline expression that
// would submit a select on change, and a form needs no JS at all. Both carry
// returnTo, so the server hard-redirects and the shell re-renders with the
// new <html> class / language.
templ themeChoice(value, label, current string) {
	<form hx-post="/set-theme" hx-swap="none">
		<input type="hidden" name="theme" value={ value }/>
		<input type="hidden" name="returnTo" value="/app/settings/account"/>
		<button type="submit" class={ choiceClass(current == value) } data-testid={ "theme-" + value }>{ label }</button>
	</form>
}

templ localeChoice(code, label, current string) {
	<form hx-post="/set-locale" hx-swap="none">
		<input type="hidden" name="lang" value={ code }/>
		<input type="hidden" name="returnTo" value="/app/settings/account"/>
		<button type="submit" class={ choiceClass(current == code) } data-testid={ "locale-pref-" + localeTestID(code) }>{ label }</button>
	</form>
}

// localeTestID keeps the "follow the browser" option addressable in tests.
func localeTestID(code string) string {
	if code == "" {
		return "auto"
	}
	return code
}
