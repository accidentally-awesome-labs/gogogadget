package templates

import (
	"github.com/gogogadget/gogogadget/internal/content"
	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
)

// DocsPage renders one documentation page with prev/next footer and the
// edit-on-GitHub link.
//
// The article element stays outside Prose: Prose renders a div, and a docs page
// is a self-contained document that belongs in a screen reader's article list.
// max-w-none goes on the Prose root, because that is the element whose measure
// it cancels - the docs column already constrains the width.
templ DocsPage(docs *content.Docs, slug string) {
	for i, p := range docs.Pages {
		if p.Slug == slug {
			<article data-testid="docs-page">
				@ui.Prose(ui.ProseOpts{Attrs: ui.Attrs{Class: "max-w-none"}}) {
					// The title lives in frontmatter and was never rendered, so every
					// docs page had no h1 at all and its sections started at h2 -
					// a document with no top-level heading gives a screen reader
					// nothing to orient from, and the outline reads as fragments.
					//
					// Unstyled: inside Prose the typography belongs to the
					// document, and a size class here would make this one h1
					// disagree with every heading goldmark emitted below it.
					@ui.Heading(ui.HeadingOpts{Text: p.Title, Level: 1, Unstyled: true})
					@templ.Raw(p.Body)
				}
			</article>
			<div class="mt-6 text-sm">
				@ui.Link(ui.LinkOpts{Label: i18n.T(ctx, "docs.edit_page"), Href: DocsEditBase + p.Slug + ".md"})
			</div>
			// CursorPagination, not Pagination: the docs are a sequence with no
			// page count worth showing, and each control is named by the page
			// it leads to rather than by a number. It renders nothing when a
			// single page is installed, which is right - two dead arrows are
			// noise that still occupies the layout. The landmark is named from
			// the catalog because the component's fallback is English.
			@ui.CursorPagination(ui.CursorPaginationOpts{
				PrevURL:   docsSiblingURL(docs, i-1),
				PrevLabel: docsSiblingLabel(docs, i-1, "← ", ""),
				NextURL:   docsSiblingURL(docs, i+1),
				NextLabel: docsSiblingLabel(docs, i+1, "", " →"),
				Label:     i18n.T(ctx, "docs.pager_aria"),
				Attrs:     ui.Attrs{Class: "mt-10 pt-6 border-t border-border"},
			})
		}
	}
}

// docsSiblingURL is the path of the page at an index, or "" past either end.
// CursorPagination reads an empty URL as "this is the end of the sequence", so
// the bounds check lives here rather than in the template.
func docsSiblingURL(docs *content.Docs, at int) string {
	if at < 0 || at >= len(docs.Pages) {
		return ""
	}
	return "/docs/" + docs.Pages[at].Slug
}

// docsSiblingLabel names the neighbour rather than the direction: "Previous"
// tells a reader nothing they cannot already see, while the title of the page
// they are about to open tells them whether they want it. The arrow is a prefix
// or a suffix so it points the way the reader is travelling.
func docsSiblingLabel(docs *content.Docs, at int, prefix, suffix string) string {
	if at < 0 || at >= len(docs.Pages) {
		return ""
	}
	return prefix + docs.Pages[at].Title + suffix
}

// DocsSearchPage renders ranked results for ?q=. Empty query shows the
// prompt; a query with no hits shows the no-results state.
templ DocsSearchPage(query string, results []content.SearchResult) {
	<article data-testid="docs-search">
		@ui.Prose(ui.ProseOpts{Attrs: ui.Attrs{Class: "max-w-none"}}) {
			if query == "" {
				@ui.Heading(ui.HeadingOpts{Text: i18n.T(ctx, "docs.search_title"), Level: 1, Unstyled: true})
				<p class="text-fg-muted">{ i18n.T(ctx, "docs.search_prompt") }</p>
			} else {
				@ui.Heading(ui.HeadingOpts{Text: i18n.T(ctx, "docs.search_results_for", query), Level: 1, Unstyled: true})
				if len(results) == 0 {
					// Filtered, not empty: the docs are not missing, this query
					// missed them, and the two states need different next
					// steps. The escape is the search prompt itself, a real
					// route, and the component renders it as an anchor with an
					// hx-get so it works with scripts disabled. not-prose keeps
					// the card out of the document's typography, which would
					// otherwise restyle its copy.
					@ui.EmptyState(ui.EmptyStateOpts{
						Body:       i18n.T(ctx, "docs.search_no_results"),
						Variant:    ui.EmptyCard,
						Filtered:   true,
						ClearURL:   "/docs/search",
						ClearLabel: i18n.T(ctx, "docs.search_clear"),
						Target:     ui.NavTarget,
						Attrs:      ui.Attrs{TestID: "docs-search-empty", Class: "not-prose"},
					})
				} else {
					<ul class="list-none p-0 space-y-6 not-prose">
						for _, result := range results {
							@ui.Item(ui.ItemOpts{Attrs: ui.Attrs{Class: "card", TestID: "docs-search-result"}}) {
								@ui.Link(ui.LinkOpts{
									Label: result.Title, Href: "/docs/" + result.Slug, Boost: true,
									Attrs: ui.Attrs{Class: "font-semibold"},
								})
								@ui.Badge(ui.BadgeOpts{Text: result.Section, Kind: ui.KindNeutral, Attrs: ui.Attrs{Class: "ml-2"}})
								@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mt-2"}}) {
									{ result.Snippet }
								}
							}
						}
					</ul>
				}
			}
		}
	</article>
}
