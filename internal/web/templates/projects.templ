package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/i18n"
)

templ ProjectsPage(d ProjectListData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "projects.title")}) {
		<div class="flex items-center gap-2">
			<button type="button" hx-post="/app/projects/export" hx-swap="none" class="btn btn-ghost" data-testid="projects-export">{ i18n.T(ctx, "projects.export") }</button>
			<a href="/app/projects/new" class="btn btn-primary">{ i18n.T(ctx, "projects.new") }</a>
		</div>
	}

	if d.Plan.MaxProjects > 0 {
		<div class="card mb-4 text-sm" data-testid="usage-meter">
			{ i18n.T(ctx, "projects.usage", fmt.Sprint(d.Count), fmt.Sprint(d.Plan.MaxProjects), d.Plan.Name) }
		</div>
	}

	@ui.SearchInput(ui.SearchInputOpts{Name: "q", Value: d.Query, Placeholder: i18n.T(ctx, "projects.search_placeholder"), AriaLabel: i18n.T(ctx, "projects.search_label"), GetURL: "/app/projects", Target: "#table-container", IndicatorID: "projects-search-indicator", Attrs: ui.Attrs{TestID: ""}})
	@ProjectsTable(d)
}

templ ProjectsTable(d ProjectListData) {
	<div id="table-container">
		if len(d.Projects) == 0 {
			@ui.EmptyState(ui.EmptyStateOpts{Title: i18n.T(ctx, "projects.empty_title"), Body: i18n.T(ctx, "projects.empty_body")}) {
				<a href="/app/projects/new" class="btn btn-primary">{ i18n.T(ctx, "projects.new") }</a>
			}
		} else {
			@ui.TableCard(ui.TableCardOpts{Attrs: ui.Attrs{TestID: ""}}) {
				<table class="table">
					<thead>
						<tr><th>{ i18n.T(ctx, "projects.col_name") }</th><th>{ i18n.T(ctx, "projects.col_created") }</th><th class="text-right">{ i18n.T(ctx, "projects.col_actions") }</th></tr>
					</thead>
					<tbody>
						for _, p := range d.Projects {
							<tr id={ fmt.Sprintf("project-%d", p.ID) } data-testid="project-row">
								<td class="font-medium">{ p.Name }</td>
								<td class="text-fg-muted">{ p.CreatedAt.Time.Format("Jan 2, 2006") }</td>
								<td class="text-right">
									<div class="card-actions">
										<a href={ templ.SafeURL(fmt.Sprintf("/app/projects/%d/edit", p.ID)) } class="btn btn-ghost btn-xs">{ i18n.T(ctx, "projects.edit") }</a>
										<button
											type="button"
											hx-post={ fmt.Sprintf("/app/projects/%d/archive", p.ID) }
											class="btn btn-ghost btn-xs"
										>{ i18n.T(ctx, "projects.archive") }</button>
										<button
											type="button"
											hx-delete={ fmt.Sprintf("/app/projects/%d", p.ID) }
											hx-confirm={ i18n.T(ctx, "projects.delete_confirm") }
											hx-target="closest tr"
											hx-swap="outerHTML"
											class="btn btn-danger btn-xs"
										>{ i18n.T(ctx, "projects.delete") }</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			@ui.Pagination(ui.PaginationOpts{Page: d.Page, TotalPages: d.TotalPages, BaseURL: "/app/projects?q="+d.Query, Target: "#table-container", Labels: pagerLabels(ctx)})
		}
	</div>
}

templ ProjectForm(d ProjectFormData) {
	<div id="project-form">
		if d.LimitHit {
			@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Role: "alert", Attrs: ui.Attrs{Class: "mb-4", TestID: "plan-limit"}}) {
				{ i18n.T(ctx, "projects.limit_hit", d.Plan.Name, fmt.Sprint(d.Plan.MaxProjects)) }
				<a href="/app/settings/billing" class="link font-semibold">{ i18n.T(ctx, "projects.upgrade") }</a>
			}
		}
		if d.NameErr != "" {
			@ui.Notice(ui.NoticeOpts{Kind: ui.KindDanger, Role: "alert", Attrs: ui.Attrs{Class: "mb-4", TestID: ""}}) {
				{ i18n.T(ctx, "projects.fix_error") }
			}
		}
		<form
			if d.ID == 0 {
				hx-post="/app/projects"
			} else {
				hx-post={ fmt.Sprintf("/app/projects/%d", d.ID) }
			}
			hx-target="#project-form"
			hx-swap="innerHTML"
			hx-disable="this"
			novalidate
			class="card max-w-lg space-y-4"
		>
			@ui.Field(ui.FieldOpts{Name: "name", Label: i18n.T(ctx, "projects.field_name"), Error: d.NameErr, Required: true}) {
			@ui.TextInput(ui.TextInputOpts{Name: "name", Type: "text", Value: d.Name, Placeholder: i18n.T(ctx, "projects.field_placeholder"), Required: true, Error: d.NameErr})
		}
			<div class="flex gap-3">
				<button type="submit" class="btn btn-primary">
					@ui.Spinner(ui.SpinnerOpts{})
					if d.ID == 0 {
						{ i18n.T(ctx, "projects.create") }
					} else {
						{ i18n.T(ctx, "projects.save") }
					}
				</button>
				<a href="/app/projects" class="btn btn-ghost">{ i18n.T(ctx, "projects.cancel") }</a>
			</div>
		</form>
	</div>
}

templ ProjectNewPage(d ProjectFormData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "projects.new")})
	@ProjectForm(d)
}

templ ProjectEditPage(d ProjectFormData) {
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "projects.edit_heading")})
	@ProjectForm(d)
}
