package ui

// InputGroupOpts joins a control with leading or trailing addons.
type InputGroupOpts struct {
	Attrs Attrs
}

// InputGroup joins addons and a control into one visual field. The addons are
// separate elements rather than placeholder text, because placeholder text
// disappears the moment the user types and was never a label to begin with.
templ InputGroup(o InputGroupOpts) {
	<div { root("input-group", "flex items-stretch rounded-lg border border-border overflow-hidden focus-within:outline-2 focus-within:outline-offset-2", o.Attrs)... }>
		{ children... }
	</div>
}
