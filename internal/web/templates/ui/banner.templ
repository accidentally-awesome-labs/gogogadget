package ui

// BannerOpts is a full-bleed shell notice (impersonation, billing).
type BannerOpts struct {
	Kind  Kind
	Live  Live
	Attrs Attrs
}

templ Banner(o BannerOpts) {
	<div { rootWith("banner", "banner banner-"+string(NormalizeKind(o.Kind)), o.Attrs, "role", o.Live.Role())... }>
		{ children... }
	</div>
}
