package ui

import "fmt"

// CharCounterOpts pairs a length-limited control with a live count.
type CharCounterOpts struct {
	// For is the control's field name; the counter watches that input.
	For string
	Max int
	// Label is the counted-noun template shown to the user, e.g. "characters".
	Label string
	Attrs Attrs
}

// CharCounter renders a live character count for a length-limited control.
//
// The native maxlength on the control is what actually enforces the limit, and
// the server enforces it again. This is only the readout, so a user who has
// JavaScript disabled still cannot exceed the limit - they simply do not see
// the running total.
//
// aria-live is polite and the region announces only the count, so a screen
// reader is not interrupted on every keystroke.
templ CharCounter(o CharCounterOpts) {
	<p
		{ rootWith("char-counter", "text-xs text-fg-muted mt-1", o.Attrs,
			"x-data", "uiCharCounter",
			"data-for", o.For,
			"data-max", fmt.Sprint(o.Max),
			"aria-live", "polite")... }
	>
		<span x-text="count">0</span>
		{ " / " + fmt.Sprint(o.Max) + " " + o.Label }
	</p>
}
