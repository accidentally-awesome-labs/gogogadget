package ui

// DeliveryState is the outcome of a delivery attempt.
type DeliveryState string

const (
	DeliveryPending   DeliveryState = "pending"
	DeliverySent      DeliveryState = "sent"
	DeliveryDelivered DeliveryState = "delivered"
	DeliveryFailed    DeliveryState = "failed"
)

var DeliveryStates = []DeliveryState{DeliveryPending, DeliverySent, DeliveryDelivered, DeliveryFailed}

// Value normalizes to pending. An unrecognised state must not read as delivered:
// claiming a webhook arrived when nobody knows is the one wrong answer here.
func (s DeliveryState) Value() DeliveryState { return normalize(s, DeliveryStates, DeliveryPending) }
func (s DeliveryState) Valid() bool          { return contains(s, DeliveryStates) }

// DeliveryStatusOpts is the state of a webhook or email delivery.
type DeliveryStatusOpts struct {
	State DeliveryState
	// Label states the outcome in words, and Detail carries the attempt count
	// or the error, both pre-formatted by the caller.
	Label  string
	Detail string
	Attrs  Attrs
}

// DeliveryStatus renders a delivery outcome.
templ DeliveryStatus(o DeliveryStatusOpts) {
	<span { root("delivery-status", "inline-flex items-center gap-2 text-sm", o.Attrs)... }>
		@StatusDot(StatusDotOpts{Kind: deliveryKind(o.State), Label: o.Label})
		if o.Detail != "" {
			<span class="text-fg-muted">{ o.Detail }</span>
		}
	</span>
}

func deliveryKind(state DeliveryState) Kind {
	switch state.Value() {
	case DeliverySent:
		return KindInfo
	case DeliveryDelivered:
		return KindSuccess
	case DeliveryFailed:
		return KindDanger
	default:
		return KindNeutral
	}
}
