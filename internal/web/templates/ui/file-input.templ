package ui

// FileInputOpts is a file picker.
type FileInputOpts struct {
	Name string
	// ID overrides the element id, which defaults to Name. The same control
	// repeated once per table row would otherwise emit one identical id on
	// every row, and a label's for= resolves to the first match.
	ID string

	// Accept is advisory: the browser filters the picker but a determined user
	// can still submit anything, so the server must validate the type again.
	Accept      string
	Multiple    bool
	Hint, Error string
	Required    bool
	Attrs       Attrs
}

// FileInput renders a native file input.
templ FileInput(o FileInputOpts) {
	<input
		{ controlRoot("file-input", "block w-full text-sm", o.Attrs)... }
		{ FieldARIA(FieldOpts{Name: o.Name, ID: controlID(o.ID, o.Attrs, o.Name), Hint: o.Hint, Error: o.Error, Required: o.Required})... }
		type="file"
		id={ controlID(o.ID, o.Attrs, o.Name) }
		name={ o.Name }
		if o.Accept != "" {
			accept={ o.Accept }
		}
		multiple?={ o.Multiple }
		required?={ o.Required }
	/>
}
