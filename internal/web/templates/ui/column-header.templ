package ui

import (
	"fmt"
	"regexp"
	"strings"
)

// ColumnHeaderOpts is one sortable table header cell.
type ColumnHeaderOpts struct {
	Column Column
	// Sort is this column's current direction. SortNone means the table is not
	// sorted by this column, which is different from ascending.
	Sort SortDirection
	// BaseURL and Param build the toggle link, so sorting works with scripts
	// disabled and the sorted URL is shareable.
	BaseURL string
	Param   string
	Target  string
	Attrs   Attrs
}

// ColumnHeader renders a th with sort semantics.
//
// aria-sort is what tells a screen-reader user which column orders the table
// and in which direction. Without it a sorted table is indistinguishable from
// an unsorted one, and the little arrow glyph is invisible to them.
templ ColumnHeader(o ColumnHeaderOpts) {
	<th
		{ rootWith("column-header", columnHeaderClass(o.Column), o.Attrs,
			"scope", "col",
			"style", columnWidthStyle(o.Column),
			"aria-sort", columnAriaSort(o.Sort))... }
	>
		if o.Column.Sortable && o.BaseURL != "" {
			// The htmx attributes appear only with a target: hx-target="" makes
			// htmx intercept the click and swap into an empty selector, so a
			// sort link meant to navigate fires a request that lands nowhere.
			<a
				href={ templ.SafeURL(SortURL(o.BaseURL, o.Param, o.Column.Key, o.Sort)) }
				if o.Target != "" {
					hx-get={ SortURL(o.BaseURL, o.Param, o.Column.Key, o.Sort) }
					hx-target={ o.Target }
					hx-swap="innerMorph"
					hx-push-url="true"
				}
				class="inline-flex items-center gap-1 hover:text-fg"
			>
				{ o.Column.Label }
				@Icon(IconOpts{Name: columnSortIcon(o.Sort), Attrs: Attrs{Class: "w-3 h-3"}})
			</a>
		} else {
			{ o.Column.Label }
		}
	</th>
}

// SortURL toggles a column's direction: unsorted becomes ascending, ascending
// becomes descending, and descending returns to unsorted. The third state is
// deliberate - without it a user who sorted by mistake cannot get back to the
// table's natural order.
func SortURL(baseURL, param, key string, current SortDirection) string {
	next := SortAsc
	switch current.Value() {
	case SortAsc:
		next = SortDesc
	case SortDesc:
		next = SortNone
	}
	sep := "?"
	if strings.Contains(baseURL, "?") {
		sep = "&"
	}
	if next == SortNone {
		return baseURL
	}
	return fmt.Sprintf("%s%s%s=%s&dir=%s", baseURL, sep, sortParam(param), key, next)
}

func sortParam(param string) string {
	if param == "" {
		return "sort"
	}
	return param
}

// columnAriaSort maps the direction onto the ARIA value. An unsorted column
// emits nothing: aria-sort="none" on every other header is noise a screen
// reader reads out per column.
func columnAriaSort(sort SortDirection) string {
	switch sort.Value() {
	case SortAsc:
		return "ascending"
	case SortDesc:
		return "descending"
	default:
		return ""
	}
}

func columnSortIcon(sort SortDirection) IconName {
	switch sort.Value() {
	case SortAsc:
		return IconArrowUp
	case SortDesc:
		return IconArrowDown
	default:
		return IconSort
	}
}

func columnHeaderClass(column Column) string {
	cls := "px-4 py-3 font-medium"
	if column.Numeric {
		cls += " text-right tabular-nums"
	}
	switch column.Align.Value() {
	case AlignCenter:
		cls += " text-center"
	case AlignEnd:
		cls += " text-right"
	}
	if hide := breakpointHideClass(column.HideBelow); hide != "" {
		cls += " " + hide
	}
	return cls
}

// columnWidthStyle sizes one column from its declared width, or renders nothing
// when the caller declared none.
//
// An inline style rather than a class: the value is data, and a utility class
// cannot carry an arbitrary length without the arbitrary-value syntax the design
// system forbids in templates. It is also deliberately the same property the
// grid controller writes when a user drags a column edge, so one measure has one
// owner and a stored user width simply overrides the declared start - which is
// the precedence a preference has to have.
//
// A value that is not a bare CSS length is dropped. Callers are Go source rather
// than user input, so this is not an escaping defence: it is what keeps the
// field a length instead of an inline-style hook able to carry any declaration
// the rest of the design system exists to forbid.
func columnWidthStyle(column Column) string {
	if !cssLength.MatchString(column.Width) {
		return ""
	}
	return "width:" + column.Width
}

var cssLength = regexp.MustCompile(`^[0-9]+(\.[0-9]+)?(px|rem|em|ch|%)$`)

// breakpointHideClass hides a column below a breakpoint. Without this a wide
// table can only scroll sideways on a phone, which puts data behind a gesture
// instead of choosing what matters.
func breakpointHideClass(bp Breakpoint) string {
	switch bp.Value() {
	case BreakpointSM:
		return "hidden sm:table-cell"
	case BreakpointMD:
		return "hidden md:table-cell"
	case BreakpointLG:
		return "hidden lg:table-cell"
	default:
		return ""
	}
}
