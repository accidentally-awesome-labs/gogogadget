package ui

// TileOpts is a compact, clickable summary card.
type TileOpts struct {
	Title string
	Body  string
	Icon  IconName
	// Href makes the whole tile a link. A tile with no destination is a plain
	// card: this component does not fake clickability with a click handler on a
	// div, which is unreachable by keyboard and announced as nothing.
	Href  string
	Attrs Attrs
}

// Tile renders a compact summary, optionally as a link.
templ Tile(o TileOpts) {
	if o.Href != "" {
		<a
			href={ templ.SafeURL(o.Href) }
			{ root("tile", "card block hover:bg-surface-raised transition-colors", o.Attrs)... }
			hx-boost="true" hx-target={ NavTarget } hx-select={ NavTarget } hx-swap={ NavSwap }
		>
			@tileBody(o)
		</a>
	} else {
		<div { root("tile", "card", o.Attrs)... }>
			@tileBody(o)
		</div>
	}
}

templ tileBody(o TileOpts) {
	<span class="flex items-start gap-3">
		if o.Icon != "" {
			@Icon(IconOpts{Name: o.Icon, Attrs: Attrs{Class: "w-5 h-5 shrink-0 text-brand-text"}})
		}
		<span>
			<span class="block font-semibold">{ o.Title }</span>
			if o.Body != "" {
				<span class="block text-sm text-fg-muted mt-1">{ o.Body }</span>
			}
		</span>
	</span>
}
