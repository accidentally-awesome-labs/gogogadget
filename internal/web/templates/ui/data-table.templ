package ui

// DataTableOpts composes a table with its toolbar, selection, empty state and
// pager. It owns no domain rows: the caller passes them as children, so this
// component never needs to know what it is listing.
type DataTableOpts struct {
	// Caption is required. A table with no caption is announced only as
	// "table", and a page with three of them is unnavigable.
	Caption       string
	HiddenCaption bool
	Columns       []Column
	Density       Density
	// Sort is the currently sorted column key and direction.
	SortKey string
	SortDir SortDirection
	BaseURL string
	// Target is the box the table morphs on sort, search and pagination.
	Target string
	// Empty renders when there are no rows. Passing it here rather than letting
	// the caller conditionally omit the table keeps the toolbar and pager in
	// place, so a filtered-to-nothing table does not lose the control that
	// caused it.
	Empty templ.Component
	// RowCount decides between rows and the empty state.
	RowCount   int
	Toolbar    templ.Component
	Selection  templ.Component
	Pagination templ.Component
	Attrs      Attrs
}

// DataTable renders the full table surface.
templ DataTable(o DataTableOpts) {
	<div { root("data-table", "", o.Attrs)... }>
		if o.Toolbar != nil {
			@o.Toolbar
		}
		if o.Selection != nil {
			@o.Selection
		}
		<div class="table-card">
			if o.RowCount == 0 && o.Empty != nil {
				@o.Empty
			} else {
				<table class={ dataTableClass(o.Density) }>
					<caption class={ captionClass(o.HiddenCaption) }>{ o.Caption }</caption>
					<thead>
						<tr>
							for _, column := range o.Columns {
								@ColumnHeader(ColumnHeaderOpts{
									Column:  column,
									Sort:    dataTableSort(o, column),
									BaseURL: o.BaseURL,
									Target:  o.Target,
								})
							}
						</tr>
					</thead>
					<tbody>
						{ children... }
					</tbody>
				</table>
			}
		</div>
		if o.Pagination != nil {
			@o.Pagination
		}
	</div>
}

// dataTableSort returns a column's direction only when it is the sorted one.
// Passing the table's direction to every header would mark all of them sorted.
func dataTableSort(o DataTableOpts, column Column) SortDirection {
	if column.Key != o.SortKey {
		return SortNone
	}
	return o.SortDir
}

func dataTableClass(density Density) string {
	cls := "table"
	if density.Value() == DensityCompact {
		cls += " table-compact"
	}
	return cls
}
