package ui

// DisclosureOpts configures a single expandable section.
type DisclosureOpts struct {
	Summary string
	Open    bool
	Attrs   Attrs
}

// Disclosure renders a native details/summary.
//
// No JavaScript at all: the platform supplies the toggle, the button semantics,
// keyboard activation, and the correct announcement of expanded state. It also
// means the content is present for in-page search and prints expanded when the
// browser asks it to.
templ Disclosure(o DisclosureOpts) {
	<details { root("disclosure", "border-b border-border py-2", o.Attrs)... } open?={ o.Open }>
		<summary class="cursor-pointer font-medium py-1">{ o.Summary }</summary>
		<div class="pt-2 text-sm text-fg-muted">
			{ children... }
		</div>
	</details>
}
