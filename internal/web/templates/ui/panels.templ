package ui

import "fmt"

// PanelData is one resizable panel.
type PanelData struct {
	// ID and Title are required: the handle names which panel it resizes.
	ID    string
	Title string
	// Size is the starting percentage. Percentages rather than pixels because
	// the group has to survive a narrower viewport.
	Size int
	// MinSize floors a resize; a panel dragged to nothing hides its content
	// with no indication the content exists.
	MinSize int
	// Collapsible allows the panel to be closed entirely, which is different
	// from resized to its floor.
	Collapsible bool
}

// PanelGroupOpts configures a resizable split.
type PanelGroupOpts struct {
	ID string
	// PersistKey stores the sizes for this user on this device. A layout
	// preference is not data, so it never goes to the server.
	PersistKey  string
	Panels      []PanelData
	Orientation Orientation
	Attrs       Attrs
}

// PanelGroup renders resizable panels.
//
// The fallback is stacked, full-width panels: with no JavaScript the content is
// simply laid out one after another, which is also what a narrow screen gets.
// Resizing is an enhancement on a layout that already works, never the thing
// that makes the content reachable.
templ PanelGroup(o PanelGroupOpts) {
	<div
		{ rootWith("panel-group", panelGroupClass(o), o.Attrs,
			"x-data", "uiPanels",
			"id", o.ID,
			"data-panel-persist", o.PersistKey,
			"data-panel-orientation", string(o.Orientation.Value()))... }
	>
		for index, panel := range o.Panels {
			@Panel(PanelOpts{Panel: panel})
			if index < len(o.Panels)-1 {
				@PanelHandle(PanelHandleOpts{
					ID:          o.ID + "-handle-" + fmt.Sprint(index+1),
					Label:       panelHandleLabel(o.Panels, index),
					Value:       panelSize(panel),
					Min:         panelMin(panel),
					Max:         panelMax(o.Panels, index),
					Orientation: o.Orientation,
				})
			}
		}
	</div>
}

// PanelOpts configures one panel.
type PanelOpts struct {
	Panel PanelData
	Attrs Attrs
}

// Panel renders one panel.
templ Panel(o PanelOpts) {
	<section
		{ root("panel", "min-w-0 min-h-0 overflow-auto", o.Attrs)... }
		id={ o.Panel.ID }
		data-panel={ o.Panel.ID }
		data-panel-min={ fmt.Sprint(panelMin(o.Panel)) }
		aria-labelledby={ o.Panel.ID + "-title" }
	>
		<h3 id={ o.Panel.ID + "-title" } class="section-title text-sm mb-2">{ o.Panel.Title }</h3>
		{ children... }
	</section>
}

// PanelHandleOpts configures a resize handle.
type PanelHandleOpts struct {
	ID    string
	Label string
	// Value, Min and Max are the current and bounding sizes, all percentages.
	Value, Min, Max int
	Orientation     Orientation
	Attrs           Attrs
}

// PanelHandle renders the divider between two panels.
//
// It is a focusable role="separator" with bounded aria-valuenow, which is what
// makes the split adjustable by keyboard. A bare styled div would be a
// pointer-only control, and a separator without the values reports a position of
// nothing.
templ PanelHandle(o PanelHandleOpts) {
	<div
		{ root("panel-handle", panelHandleClass(o), o.Attrs)... }
		id={ o.ID }
		role="separator"
		tabindex="0"
		aria-label={ o.Label }
		aria-orientation={ string(o.Orientation.Value()) }
		aria-valuenow={ fmt.Sprint(panelClamp(o.Value, o.Min, o.Max)) }
		aria-valuemin={ fmt.Sprint(o.Min) }
		aria-valuemax={ fmt.Sprint(o.Max) }
		data-panel-handle
	></div>
}

// panelGroupClass stacks by default. The horizontal split only applies from the
// medium breakpoint up, because two narrow columns on a phone are worse than
// one readable one.
func panelGroupClass(o PanelGroupOpts) string {
	if o.Orientation.Value() == OrientationVertical {
		return "flex flex-col gap-0 h-96"
	}
	return "flex flex-col md:flex-row gap-0 md:h-96"
}

func panelHandleClass(o PanelHandleOpts) string {
	base := "bg-border hover:bg-brand focus-visible:bg-brand shrink-0"
	if o.Orientation.Value() == OrientationVertical {
		return base + " h-1 w-full cursor-row-resize my-1"
	}
	// Hidden while stacked: a vertical grip between full-width blocks resizes
	// nothing.
	return base + " hidden md:block w-1 cursor-col-resize mx-1"
}

// panelHandleLabel names the handle after the two panels it sits between. Forty
// handles all called "Resize" are indistinguishable in a screen reader's list.
func panelHandleLabel(panels []PanelData, index int) string {
	if index+1 >= len(panels) {
		return "Resize panel"
	}
	return "Resize " + panels[index].Title + " and " + panels[index+1].Title
}

// panelSize defaults to an even split rather than zero: a panel with no declared
// size must still be visible.
func panelSize(panel PanelData) int {
	if panel.Size <= 0 {
		return 50
	}
	return panel.Size
}

// panelMin floors every panel, including ones whose caller forgot.
func panelMin(panel PanelData) int {
	if panel.MinSize > 0 {
		return panel.MinSize
	}
	if panel.Collapsible {
		return 0
	}
	return 10
}

// panelMax leaves room for the neighbour's floor, so dragging one panel can
// never squeeze the next below its own minimum.
func panelMax(panels []PanelData, index int) int {
	if index+1 >= len(panels) {
		return 100
	}
	max := 100 - panelMin(panels[index+1])
	if max < panelMin(panels[index]) {
		return panelMin(panels[index])
	}
	return max
}

func panelClamp(value, min, max int) int {
	if value < min {
		return min
	}
	if value > max {
		return max
	}
	return value
}
