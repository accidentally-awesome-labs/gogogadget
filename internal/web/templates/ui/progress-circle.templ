package ui

import "fmt"

// ProgressCircleOpts is compact circular progress.
type ProgressCircleOpts struct {
	Value     float64
	Max       float64
	Label     string
	ValueText string
	Size      Size
	Attrs     Attrs
}

// ProgressCircle renders progress as a ring.
//
// The ring is drawn with an SVG stroke offset and is aria-hidden; the semantics
// live on the wrapper, so assistive technology gets a progressbar with a value
// rather than a description of two circles.
templ ProgressCircle(o ProgressCircleOpts) {
	<div
		{ rootWith("progress-circle", "inline-flex items-center justify-center", o.Attrs,
			"role", "progressbar",
			"aria-label", o.Label,
			"aria-valuemin", "0",
			"aria-valuemax", progressMaxText(o.Max),
			"aria-valuenow", progressNowText(o.Value),
			"aria-valuetext", o.ValueText)... }
	>
		<svg class={ progressCircleClass(o.Size) } viewBox="0 0 36 36" aria-hidden="true">
			<circle cx="18" cy="18" r="16" fill="none" class="stroke-border" stroke-width="4"></circle>
			<circle
				cx="18" cy="18" r="16" fill="none" class="stroke-brand" stroke-width="4"
				stroke-linecap="round" transform="rotate(-90 18 18)"
				stroke-dasharray="100.53"
				stroke-dashoffset={ progressDashOffset(o.Value, o.Max) }
			></circle>
		</svg>
	</div>
}

func progressCircleClass(size Size) string {
	switch size.Value() {
	case SizeXS:
		return "w-6 h-6"
	case SizeSM:
		return "w-8 h-8"
	case SizeLG:
		return "w-16 h-16"
	}
	return "w-12 h-12"
}

// progressDashOffset converts progress into the stroke gap. The circumference
// is 2*pi*16 = 100.53 for r=16, which is why the dasharray is that constant.
func progressDashOffset(value, max float64) string {
	const circumference = 100.53
	if value < 0 {
		return fmt.Sprintf("%.2f", circumference*0.75)
	}
	pct := value / progressMax(max)
	if pct < 0 {
		pct = 0
	}
	if pct > 1 {
		pct = 1
	}
	return fmt.Sprintf("%.2f", circumference*(1-pct))
}
