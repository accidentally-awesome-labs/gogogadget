package ui

// ComposerOpts is the message input for a thread or chat.
type ComposerOpts struct {
	Name        string
	Placeholder string
	SubmitLabel string
	Rows        int
	// Hint and Error mirror the enclosing Field, so the control describes only
	// elements that exist.
	Hint, Error string
	HX          HX
	Attrs       Attrs
}

// Composer renders a message form.
//
// It is a real form with a submit button, so a message can be sent with no
// JavaScript and with the keyboard alone. There is no Enter-to-send here: a
// textarea where Enter submits makes multi-line messages impossible to write,
// and a caller who wants it can add it deliberately.
templ Composer(o ComposerOpts) {
	// The verb lives in composerHX, so a browser with no script would submit this
	// as a GET to the current URL - posting nothing, to the wrong place, without
	// a token. Declaring the method and carrying the field is what makes the
	// plain submit land on the endpoint the caller named.
	<form
		{ rootWith("composer", "space-y-2", o.Attrs,
			"novalidate", "novalidate",
			"method", composerMethod(o.HX),
			"action", composerAction(o.HX))... }
		{ composerHX(o.HX)... }
	>
		if composerMethod(o.HX) != "" {
			@CSRFField(CSRFFieldOpts{})
		}
		<label for={ o.Name } class="sr-only">{ o.Placeholder }</label>
		@Textarea(TextareaOpts{
			Name: o.Name, Rows: composerRows(o.Rows), Placeholder: o.Placeholder,
		})
		if o.Error != "" {
			@FieldError(FieldErrorOpts{Error: o.Error, Attrs: Attrs{ID: o.Name + "-error"}})
		}
		@FormActions(FormActionsOpts{}) {
			@Button(ButtonOpts{Label: o.SubmitLabel, Type: TypeSubmit, Action: ActionPrimary, Size: SizeSM})
		}
	</form>
}

func composerRows(rows int) int {
	if rows <= 0 {
		return 3
	}
	return rows
}

func composerHX(hx HX) templ.Attributes {
	out := templ.Attributes{}
	applyHX(out, hx)
	return out
}

// composerMethod and composerAction mirror ui.Form's derivation: the endpoint is
// declared as an htmx verb, and a form that names no method is a GET to the page
// it sits on. Reading the verb set rather than one field means a verb added to
// HX later cannot quietly drop out of the no-script path.
func composerMethod(hx HX) string {
	if hxMutatingURL(hx) == "" {
		return ""
	}
	return "post"
}

func composerAction(hx HX) string {
	return hxMutatingURL(hx)
}
