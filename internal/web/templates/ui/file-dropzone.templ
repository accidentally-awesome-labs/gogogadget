package ui

// FileDropzoneOpts is a drag-and-drop upload area.
type FileDropzoneOpts struct {
	Name string
	// ID overrides the input's element id, which defaults to Name. The same
	// control repeated once per row would otherwise emit one identical id, and
	// the wrapping label's for= resolves to the first match - so every zone on
	// the page would open the first zone's picker.
	//
	// Attrs are deliberately not consulted here: they land on the wrapping
	// label, so Attrs.ID names the wrapper, not the input.
	ID string
	// Form is the id of the form that submits this control, for a dropzone that
	// cannot be a descendant of the form it belongs to - an upload zone inside a
	// page whose enclosing form saves something else entirely. Nested <form> is
	// dropped by the HTML parser, so HTML's form attribute is the only answer
	// that still works with no JavaScript.
	Form        string
	Accept      string
	Multiple    bool
	Label       string
	Hint, Error string
	Attrs       Attrs
}

// FileDropzone renders a labelled drop target around a real file input.
//
// The input is a genuine <input type="file"> inside a <label>, so clicking the
// zone opens the picker and the keyboard reaches the control with no script at
// all. Drag-and-drop is added on top by the Alpine behaviour: a drop target
// that is *only* droppable excludes every keyboard user.
templ FileDropzone(o FileDropzoneOpts) {
	<label
		{ rootWith("file-dropzone", "block rounded-xl border-2 border-dashed border-border p-6 text-center cursor-pointer hover:bg-surface-raised", o.Attrs,
			"x-data", "uiDropzone",
			"for", dropzoneControlID(o))... }
	>
		@Icon(IconOpts{Name: IconUpload, Attrs: Attrs{Class: "w-6 h-6 mx-auto text-fg-muted"}})
		<span class="mt-2 block text-sm text-fg-muted">{ o.Label }</span>
		<input
			{ FieldARIA(FieldOpts{Name: o.Name, ID: dropzoneControlID(o), Hint: o.Hint, Error: o.Error})... }
			type="file"
			id={ dropzoneControlID(o) }
			name={ o.Name }
			class="sr-only"
			if o.Form != "" {
				form={ o.Form }
			}
			if o.Accept != "" {
				accept={ o.Accept }
			}
			multiple?={ o.Multiple }
		/>
		// The hint is rendered, not just referenced. FieldARIA points
		// aria-describedby at "<id>-hint", and a zone that named the hint
		// without drawing it shipped a reference to an element that does not
		// exist - which reads as nothing at all to a screen reader and fails an
		// aria-valid-attr-value scan.
		if o.Hint != "" && o.Error == "" {
			@Hint(HintOpts{For: dropzoneControlID(o), Text: o.Hint})
		}
		if o.Error != "" {
			@FieldError(FieldErrorOpts{Error: o.Error, Attrs: Attrs{ID: dropzoneErrorID(o)}})
		}
	</label>
}

// dropzoneControlID is the id shared by the wrapping label's for= and the input
// it points at. One resolution, two consumers: a label pointing at a different
// id than the input carries is a label that does nothing.
func dropzoneControlID(o FileDropzoneOpts) string {
	return controlID(o.ID, Attrs{}, o.Name)
}

func dropzoneErrorID(o FileDropzoneOpts) string {
	_, _, errID := FieldIDs(dropzoneControlID(o))
	return errID
}
