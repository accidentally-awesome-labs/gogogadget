package ui

// PasswordInputOpts is a password input.
type PasswordInputOpts struct {
	Name string
	// Autocomplete must be set deliberately: "current-password" on a sign-in
	// form and "new-password" on a change form. Getting it wrong makes a
	// password manager either fail to fill or overwrite the wrong credential.
	Autocomplete string
	Hint, Error  string
	Required     bool
	Size         Size
	Attrs        Attrs
}

// PasswordInput renders a native password field.
//
// There is no reveal toggle here on purpose: it belongs to a module that owns
// the Alpine behaviour, and a half-built toggle that leaves the value in the
// DOM as plain text is worse than none.
templ PasswordInput(o PasswordInputOpts) {
	<input
		{ root("password-input", inputClass(o.Size), o.Attrs)... }
		{ FieldARIA(FieldOpts{Name: o.Name, Hint: o.Hint, Error: o.Error, Required: o.Required})... }
		type="password" id={ o.Name } name={ o.Name }
		autocomplete={ passwordAutocomplete(o.Autocomplete) }
		required?={ o.Required }
	/>
}

// passwordAutocomplete defaults to current-password: filling an existing
// credential is the common case, and it is the safe mistake - a manager that
// declines to fill is recoverable, one that overwrites a saved password is not.
func passwordAutocomplete(value string) string {
	if value == "" {
		return "current-password"
	}
	return value
}
