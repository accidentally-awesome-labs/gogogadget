package ui

// SecretRevealOpts is the reveal-once secret pattern: the value in a code box
// and a copy button carrying it on data-copy. The value never reaches an Alpine
// expression, so a secret containing quotes cannot break out of one.
type SecretRevealOpts struct {
	Value        string
	CopyLabel    string
	CopiedLabel  string
	Attrs        Attrs
}

templ SecretReveal(o SecretRevealOpts) {
	<div { root("secret-reveal", "mt-3 flex items-center gap-2", o.Attrs)... }>
		// tabindex because the value scrolls: a long key overflows on a phone, and a
		// scroll container with nothing focusable inside is pointer-only - so the
		// end of the secret would be unreachable by keyboard.
		<code
			class="flex-1 text-sm bg-surface-raised border border-border rounded-lg px-3 py-2 overflow-x-auto"
			tabindex="0"
		>{ o.Value }</code>
		<button type="button" x-data="copy" data-copy={ o.Value } @click="copy()" class="btn btn-ghost btn-xs">
			<span x-show="!copied">{ o.CopyLabel }</span>
			<span x-show="copied" x-cloak>{ o.CopiedLabel }</span>
		</button>
	</div>
}
