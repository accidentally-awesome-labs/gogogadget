package ui

// HeadingOpts configures a section heading.
//
// Level and Size are separate on purpose. The level is document structure - a
// screen reader user navigates by it, and skipping from h1 to h4 breaks that
// outline. The size is visual weight. Tying them together forces a choice
// between a correct outline and a correct design, and the usual casualty is the
// outline.
type HeadingOpts struct {
	Text string
	// Level is 1-6. An out-of-range level falls back to 2: a page's h1 is a
	// deliberate, single decision, so silently minting another one is worse
	// than nesting one level too deep.
	Level int
	Size  Size
	Attrs Attrs
}

// Heading renders a structural heading at an independent visual size.
templ Heading(o HeadingOpts) {
	switch headingLevel(o.Level) {
		case 1:
			<h1 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h1>
		case 3:
			<h3 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h3>
		case 4:
			<h4 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h4>
		case 5:
			<h5 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h5>
		case 6:
			<h6 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h6>
		default:
			<h2 { root("heading", headingClass(o.Size), o.Attrs)... }>{ o.Text }</h2>
	}
}

func headingLevel(level int) int {
	if level < 1 || level > 6 {
		return 2
	}
	return level
}

func headingClass(size Size) string {
	switch size.Value() {
	case SizeXS:
		return "text-sm font-semibold"
	case SizeSM:
		return "section-title"
	case SizeLG:
		return "display-title"
	}
	return "page-title"
}
