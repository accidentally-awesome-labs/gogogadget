package ui

import "fmt"

// ProgressBarOpts is task progress.
type ProgressBarOpts struct {
	// Value is the current progress out of Max. A negative value means
	// indeterminate: work is happening but its extent is unknown, which is a
	// real state and not the same as zero progress.
	Value float64
	Max   float64
	// Label names what is progressing. Required: "63%" with no subject tells a
	// screen-reader user nothing about what is at 63%.
	Label string
	// ValueText overrides the announced value for work measured in something
	// other than percent ("3 of 8 files").
	ValueText string
	Attrs     Attrs
}

// ProgressBar renders task progress with progressbar semantics.
//
// progressbar, not meter: a progress bar describes a task advancing towards
// completion, while a meter describes a measurement within a range. Screen
// readers announce them differently, and using meter for a running task tells
// the user a quota is filling up.
templ ProgressBar(o ProgressBarOpts) {
	<div
		{ rootWith("progress-bar", "w-full bg-surface-raised rounded-full h-2 overflow-hidden", o.Attrs,
			"role", "progressbar",
			"aria-label", o.Label,
			"aria-valuemin", "0",
			"aria-valuemax", progressMaxText(o.Max),
			"aria-valuenow", progressNowText(o.Value),
			"aria-valuetext", o.ValueText)... }
	>
		if o.Value < 0 {
			// Indeterminate: the bar animates without claiming a position.
			<div class="h-2 w-1/3 bg-brand rounded-full animate-pulse"></div>
		} else {
			<div class="h-2 bg-brand rounded-full" style={ progressWidth(o.Value, o.Max) }></div>
		}
	</div>
}

func progressMax(max float64) float64 {
	if max <= 0 {
		return 100
	}
	return max
}

func progressMaxText(max float64) string {
	return fmt.Sprintf("%g", progressMax(max))
}

// progressNowText is empty for the indeterminate case, so aria-valuenow is
// absent - which is exactly how an indeterminate progressbar is expressed.
func progressNowText(value float64) string {
	if value < 0 {
		return ""
	}
	return fmt.Sprintf("%g", value)
}

func progressWidth(value, max float64) string {
	pct := value / progressMax(max) * 100
	if pct < 0 {
		pct = 0
	}
	if pct > 100 {
		pct = 100
	}
	return fmt.Sprintf("width: %.2f%%", pct)
}
