package ui

// DateFieldOpts is a date input.
type DateFieldOpts struct {
	Name string
	// ID overrides the element id, which defaults to Name. The same control
	// repeated once per table row would otherwise emit one identical id on
	// every row, and a label's for= resolves to the first match.
	ID          string
	Value       string
	Min, Max    string
	Hint, Error string
	Required    bool
	Attrs       Attrs
}

// DateField renders a native date input. The platform picker already handles
// locale format, keyboard entry, and the mobile date wheel; a custom calendar
// has to re-earn all three and usually loses the keyboard.
templ DateField(o DateFieldOpts) {
	<input
		{ controlRoot("date-field", "input", o.Attrs)... }
		{ FieldARIA(FieldOpts{Name: o.Name, ID: controlID(o.ID, o.Attrs, o.Name), Hint: o.Hint, Error: o.Error, Required: o.Required})... }
		type="date"
		id={ controlID(o.ID, o.Attrs, o.Name) }
		name={ o.Name }
		value={ o.Value }
		if o.Min != "" {
			min={ o.Min }
		}
		if o.Max != "" {
			max={ o.Max }
		}
		required?={ o.Required }
	/>
}
