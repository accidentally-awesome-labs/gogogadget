package ui

// SettingsSectionOpts is one settings block: description on one side, control
// on the other.
type SettingsSectionOpts struct {
	Title       string
	Description string
	// Danger marks a destructive block so it reads as separate from ordinary
	// settings, which is why a "danger zone" exists at all.
	Danger bool
	// Level is the title's heading level, defaulting to 3. A settings block's
	// depth is a fact about the page, not the component: a run of blocks
	// rendered directly under the page title needs h2, and hardcoding h3 skips
	// a level there - which sends heading navigation somewhere the reader did
	// not ask for.
	Level int
	Attrs Attrs
}

// SettingsSection renders a titled settings block.
//
// The heading and the control live in one <section> with an accessible name, so
// a screen-reader user can jump between settings blocks instead of tabbing
// through every control to find the next one.
templ SettingsSection(o SettingsSectionOpts) {
	<section { rootWith("settings-section", settingsSectionClass(o.Danger), o.Attrs, "aria-label", o.Title)... }>
		<div class="grid gap-4 md:grid-cols-3">
			<div class="md:col-span-1">
				// Unstyled: the title's typography is this component's own -
				// including the danger colour - and borrowing a Size to obtain
				// the tag would resize it.
				@Heading(HeadingOpts{
					Text: o.Title, Level: settingsSectionLevel(o.Level),
					Unstyled: true, Attrs: Attrs{Class: settingsTitleClass(o.Danger)},
				})
				if o.Description != "" {
					<p class="text-sm text-fg-muted mt-1">{ o.Description }</p>
				}
			</div>
			<div class="md:col-span-2">
				{ children... }
			</div>
		</div>
	</section>
}

// settingsSectionLevel defaults to 3: a settings page usually groups its blocks
// under a tab or section heading of its own.
func settingsSectionLevel(level int) int {
	if level > 0 {
		return level
	}
	return 3
}

func settingsSectionClass(danger bool) string {
	if danger {
		return "card border-danger-border"
	}
	return "card"
}

func settingsTitleClass(danger bool) string {
	if danger {
		return "font-semibold text-danger-text"
	}
	return "font-semibold"
}
