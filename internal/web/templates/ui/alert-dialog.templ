package ui

// AlertDialogOpts configures an alert dialog requiring confirmation.
type AlertDialogOpts struct {
	ID, Title, Message, ConfirmLabel, CancelLabel string
	Kind                                          Kind
	// ConfirmHX puts the request on the confirm control, so the dialog decides
	// whether a request is issued rather than reimplementing it. This is what
	// lets ConfirmAction replace hx-confirm without changing the delete
	// contract the server already honours.
	ConfirmHX HX
	// Level is the title's heading level, defaulting to 2. A dialog's depth is
	// a fact about the page it opens over, not the component: one opened from
	// inside a titled region reads as h3 there, and hardcoding h2 flattens that
	// nesting - which sends heading navigation somewhere the reader did not ask
	// for.
	Level int
	Attrs Attrs
}

// AlertDialog renders a modal requiring an explicit confirm or cancel.
//
// Both buttons submit the enclosing `form method="dialog"` with a value, so the
// platform closes the dialog and records the choice in `returnValue`. They were
// once type="button" with no handler, which left a keyboard or pointer user
// inside a modal with no way out; a destructive confirmation is the last place
// to depend on JavaScript having loaded.
//
// role="alertdialog" with a described message is what makes a screen reader
// announce the consequence rather than just the title.
//
// Cancel is first in the DOM, so the platform's own initial focus lands on the
// safe choice. A destructive dialog that opens with Delete focused turns a
// stray Enter - the key the user just pressed to open it - into the deletion.
templ AlertDialog(o AlertDialogOpts) {
	<dialog
		id={ o.ID }
		{ rootWith("alert-dialog", "dialog card max-w-md w-full", o.Attrs,
			"role", "alertdialog",
			"aria-labelledby", o.ID+"-title",
			"aria-describedby", o.ID+"-message")... }
	>
		<form method="dialog" class="flex flex-col gap-4">
			@Heading(HeadingOpts{
				Text: o.Title, Level: dialogLevel(o.Level), Size: SizeSM,
				Attrs: Attrs{ID: o.ID + "-title", Class: alertTitleColour(o.Kind)},
			})
			<p id={ o.ID + "-message" } class="text-sm text-fg-muted">{ o.Message }</p>
			<div class="flex justify-end gap-2">
				<button type="submit" value="cancel" class="btn btn-ghost" data-ui-dialog-cancel>{ o.CancelLabel }</button>
				<button
					type="submit"
					value="confirm"
					class={ "btn btn-" + dialogButtonClass(o.Kind) }
					data-ui-dialog-confirm
					{ applyHXAttrs(o.ConfirmHX)... }
				>{ o.ConfirmLabel }</button>
			</div>
		</form>
	</dialog>
}

// alertTitleColour colours the title by kind. The kind is normalized first: an
// unset kind would otherwise compose the class "text--text", which matches
// nothing and renders an uncoloured heading.
func alertTitleColour(kind Kind) string {
	return "text-" + string(NormalizeKind(kind)) + "-text"
}

// dialogLevel defaults to 2, shared by every modal: a dialog's content is its
// own outline, and h2 under the page's single h1 is the ordinary case.
func dialogLevel(level int) int {
	if level > 0 {
		return level
	}
	return 2
}

// applyHXAttrs renders the confirm control's request attributes, or nothing at
// all when the caller only wants the returnValue.
func applyHXAttrs(hx HX) templ.Attributes {
	out := templ.Attributes{}
	applyHX(out, hx)
	return out
}

func dialogButtonClass(kind Kind) string {
	if kind == KindDanger {
		return "danger"
	}
	return "primary"
}
