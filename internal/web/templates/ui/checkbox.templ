package ui

// CheckboxOpts configures a single checkbox.
type CheckboxOpts struct {
	Name, Label, Value string
	Checked            bool
	Attrs              Attrs
}

// Checkbox is a labelled checkbox.
templ Checkbox(o CheckboxOpts) {
	<label { root("checkbox", "flex items-center gap-2 text-sm", Attrs{})... }>
		// The size class is merged into the caller's rather than written as a
		// second class attribute beside it: two class attributes on one element
		// is invalid HTML and the browser keeps the FIRST, so a caller who set
		// Attrs.Class silently lost the checkbox's own sizing.
		<input { attributes(withClass(o.Attrs, "h-4 w-4"))... } type="checkbox" name={ o.Name } value={ o.Value } checked?={ o.Checked }/>
		{ o.Label }
	</label>
}
