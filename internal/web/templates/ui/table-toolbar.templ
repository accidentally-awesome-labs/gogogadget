package ui

// TableToolbarOpts is the search/filter/action row above a table.
type TableToolbarOpts struct {
	// Label names the toolbar. A group of unlabelled controls above a table
	// gives no indication of what they act on.
	Label string
	Attrs Attrs
}

// TableToolbar renders the control row above a table.
templ TableToolbar(o TableToolbarOpts) {
	<div
		{ rootWith("table-toolbar", "flex items-center justify-between gap-3 flex-wrap mb-3", o.Attrs,
			"role", "group",
			"aria-label", breadcrumbOrDefault(o.Label, "Table controls"))... }
	>
		{ children... }
	</div>
}
