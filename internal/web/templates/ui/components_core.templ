package ui

import "fmt"

// Every renderer in this package takes exactly one options struct that embeds
// Attrs, and spreads one merged attribute map on its root element. That is what
// keeps a component's own semantics (role, aria-*, type, base class) out of
// caller reach: there is no arbitrary-attribute escape hatch to override them
// with, and a caller's Class is additive rather than replacing.

// SpinnerOpts renders htmx's request indicator.
type SpinnerOpts struct{ Attrs Attrs }

templ Spinner(o SpinnerOpts) {
	@Icon(IconOpts{Name: IconSpinner, Attrs: withClass(o.Attrs, "htmx-indicator w-4 h-4 animate-spin"), component: "spinner"})
}

// BadgeOpts is a small state pill: Kind picks the semantic colour.
type BadgeOpts struct {
	Text  string
	Kind  Kind
	Attrs Attrs
}

templ Badge(o BadgeOpts) {
	<span { root("badge", "badge badge-"+string(NormalizeKind(o.Kind)), o.Attrs)... }>{ o.Text }</span>
}

// NoticeOpts is an in-page notice inside a form or card. Role is "alert" for
// actionable failures and "status" for confirmations; the component owns the
// attribute so a caller cannot silently downgrade an error to a status.
type NoticeOpts struct {
	Kind  Kind
	Role  string
	Attrs Attrs
}

templ Notice(o NoticeOpts) {
	<div { rootWith("notice", "alert alert-"+string(NormalizeKind(o.Kind)), o.Attrs, "role", noticeRole(o.Role))... }>
		{ children... }
	</div>
}

// BannerOpts is a full-bleed shell notice (impersonation, billing).
type BannerOpts struct {
	Kind  Kind
	Role  string
	Attrs Attrs
}

templ Banner(o BannerOpts) {
	<div { rootWith("banner", "banner banner-"+string(NormalizeKind(o.Kind)), o.Attrs, "role", noticeRole(o.Role))... }>
		{ children... }
	</div>
}

// PageHeaderOpts is the title row every page opens with; children are the
// right-hand actions.
type PageHeaderOpts struct {
	Title string
	Attrs Attrs
}

templ PageHeader(o PageHeaderOpts) {
	<div { root("page-header", "page-header", o.Attrs)... }>
		<h1 class="page-title">{ o.Title }</h1>
		{ children... }
	</div>
}

// SectionHeaderOpts is a sub-heading inside a page.
type SectionHeaderOpts struct {
	Text  string
	Attrs Attrs
}

templ SectionHeader(o SectionHeaderOpts) {
	<h2 { root("section-header", "section-title", o.Attrs)... }>{ o.Text }</h2>
}

// TableCardOpts is the bordered, clipped box every table sits in.
type TableCardOpts struct{ Attrs Attrs }

templ TableCard(o TableCardOpts) {
	<div { root("table-card", "table-card", o.Attrs)... }>
		{ children... }
	</div>
}

// TableEmptyOpts is the zero-row message inside a TableCard.
type TableEmptyOpts struct {
	Text  string
	Attrs Attrs
}

templ TableEmpty(o TableEmptyOpts) {
	<p { root("table-empty", "table-empty", o.Attrs)... }>{ o.Text }</p>
}

// MetricOpts is one number on a dashboard.
type MetricOpts struct {
	Title string
	Value string
	Sub   string
	Attrs Attrs
}

templ Metric(o MetricOpts) {
	<div { root("metric", "card", defaultTestID(o.Attrs, "stat-card"))... }>
		<p class="text-sm text-fg-muted">{ o.Title }</p>
		<p class="text-3xl font-bold mt-1">{ o.Value }</p>
		if o.Sub != "" {
			<p class="text-sm text-fg-muted mt-1">{ o.Sub }</p>
		}
	</div>
}

// EmptyStateOpts is the zero-data pattern for tables and lists.
type EmptyStateOpts struct {
	Title string
	Body  string
	Attrs Attrs
}

templ EmptyState(o EmptyStateOpts) {
	<div { root("empty-state", "card text-center py-12", o.Attrs)... }>
		<h3 class="font-semibold">{ o.Title }</h3>
		<p class="text-sm text-fg-muted mt-1">{ o.Body }</p>
		<div class="mt-4">
			{ children... }
		</div>
	</div>
}

// FieldErrorOpts is the per-field validation message under an input.
type FieldErrorOpts struct {
	Error string
	Attrs Attrs
}

templ FieldError(o FieldErrorOpts) {
	<p { root("field-error", "field-error", defaultTestID(o.Attrs, "form-error"))... }>{ o.Error }</p>
}

// MeterOpts is a usage bar. Percent is clamped, so an over-quota caller cannot
// render a bar wider than its track.
type MeterOpts struct {
	Percent int
	Attrs   Attrs
}

templ Meter(o MeterOpts) {
	<div { root("meter", "meter", o.Attrs)... }>
		<div class="meter-fill" style={ fmt.Sprintf("width: %d%%", clampPercent(o.Percent)) }></div>
	</div>
}

// SecretRevealOpts is the reveal-once secret pattern: the value in a code box
// and a copy button carrying it on data-copy. The value never reaches an Alpine
// expression, so a secret containing quotes cannot break out of one.
type SecretRevealOpts struct {
	Value        string
	CopyLabel    string
	CopiedLabel  string
	Attrs        Attrs
}

templ SecretReveal(o SecretRevealOpts) {
	<div { root("secret-reveal", "mt-3 flex items-center gap-2", o.Attrs)... }>
		<code class="flex-1 text-sm bg-surface-raised border border-border rounded-lg px-3 py-2 overflow-x-auto">{ o.Value }</code>
		<button type="button" x-data="copy" data-copy={ o.Value } @click="copy()" class="btn btn-ghost btn-xs">
			<span x-show="!copied">{ o.CopyLabel }</span>
			<span x-show="copied" x-cloak>{ o.CopiedLabel }</span>
		</button>
	</div>
}

// DescriptionItem is one term/value pair in a DescriptionList.
type DescriptionItem struct{ Term, Value string }

// DescriptionListOpts is the read-only detail pattern (account, org).
type DescriptionListOpts struct {
	Items []DescriptionItem
	Attrs Attrs
}

templ DescriptionList(o DescriptionListOpts) {
	<dl { root("description-list", "space-y-4 text-sm", o.Attrs)... }>
		for _, item := range o.Items {
			<div>
				<dt class="text-fg-muted">{ item.Term }</dt>
				<dd class="font-medium">{ item.Value }</dd>
			</div>
		}
	</dl>
}
