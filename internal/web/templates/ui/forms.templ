package ui

import "fmt"

// Option is one entry shared by select, checkbox-group and radio-group.
type Option struct {
	Value    string
	Label    string
	Group    string
	Disabled bool
	Selected bool
}

// FieldIDs returns the stable input/hint/error IDs for a field name.
func FieldIDs(name string) (input, hint, error string) {
	return name, name + "-hint", name + "-error"
}

// FieldARIA returns the aria attributes for a field name/error/required state.
func FieldARIA(name, err string, required bool) templ.Attributes {
	attrs := templ.Attributes{}
	if err != "" {
		attrs["aria-invalid"] = "true"
	}
	if required {
		attrs["aria-required"] = "true"
	}
	attrs["aria-describedby"] = FieldAriaDescribedBy(name, err)
	return attrs
}

// FieldAriaDescribedBy names the hint/error element describing a field.
func FieldAriaDescribedBy(name, err string) string {
	if err != "" {
		return name + "-error"
	}
	return name + "-hint"
}

// FormOpts renders a form wrapper; children are the fields. novalidate is
// always set: server validation is authoritative, and letting the browser block
// submission first means the server's rules never run.
type FormOpts struct {
	Method string
	Action string
	Target string
	Swap   string
	Attrs  Attrs
}

templ Form(o FormOpts) {
	<form
		{ root("form", "", o.Attrs)... }
		method={ o.Method } action={ o.Action }
		hx-target={ o.Target } hx-swap={ o.Swap }
		novalidate
	>
		{ children... }
	</form>
}

// FieldsetOpts groups related fields under a legend.
type FieldsetOpts struct {
	Legend string
	Attrs  Attrs
}

templ Fieldset(o FieldsetOpts) {
	<fieldset { root("fieldset", "", o.Attrs)... }>
		if o.Legend != "" {
			<legend class="label">{ o.Legend }</legend>
		}
		{ children... }
	</fieldset>
}

// FieldOpts renders label + control + field-level error. The control arrives as
// children so any input type composes, and the hint/error ids come from
// FieldIDs so a custom control can wire the same aria-describedby.
type FieldOpts struct {
	Name        string
	Label       string
	Hint        string
	Error       string
	Required    bool
	Optional    bool
	HiddenLabel bool
	Attrs       Attrs
}

templ Field(o FieldOpts) {
	<div { root("field", "", o.Attrs)... }>
		if o.HiddenLabel {
			<label for={ o.Name } class="sr-only">{ o.Label }</label>
		} else {
			<label for={ o.Name } class="label">
				{ o.Label }
				if o.Optional {
					<span class="text-fg-muted"> ({ "optional" })</span>
				}
			</label>
		}
		{ children... }
		if o.Hint != "" && o.Error == "" {
			<p id={ o.Name + "-hint" } class="text-sm text-fg-muted mt-1">{ o.Hint }</p>
		}
		if o.Error != "" {
			@FieldError(FieldErrorOpts{Error: o.Error, Attrs: Attrs{ID: o.Name + "-error"}})
		}
	</div>
}

// TextInputOpts is a single-line text input.
type TextInputOpts struct {
	Name        string
	Value       string
	Placeholder string
	Type        InputType
	Required    bool
	Error       string
	Attrs       Attrs
}

templ TextInput(o TextInputOpts) {
	<input
		{ root("text-input", "input", o.Attrs)... }
		{ FieldARIA(o.Name, o.Error, o.Required)... }
		id={ o.Name } name={ o.Name } type={ string(o.Type.Value()) }
		value={ o.Value } placeholder={ o.Placeholder } required?={ o.Required }
	/>
}

// SearchInputOpts is the debounced table search. It morphs Target and pushes
// the URL, so a search is shareable and the Back button works.
type SearchInputOpts struct {
	Name        string
	Value       string
	Placeholder string
	AriaLabel   string
	GetURL      string
	Target      string
	IndicatorID string
	Attrs       Attrs
}

templ SearchInput(o SearchInputOpts) {
	<div { root("search-input", "toolbar", Attrs{})... }>
		<input
			{ attributes(o.Attrs)... }
			type="search" name={ o.Name } value={ o.Value } placeholder={ o.Placeholder }
			class={ mergeClasses("input max-w-sm", o.Attrs.Class) }
			hx-get={ o.GetURL } hx-trigger="input changed delay:300ms, search"
			hx-target={ o.Target } hx-swap="innerMorph" hx-push-url="true" hx-include="this"
			hx-sync="this:replace"
			hx-indicator={ "#" + o.IndicatorID }
			aria-label={ o.AriaLabel }
		/>
		<span id={ o.IndicatorID } class="text-fg-muted">
			@Spinner(SpinnerOpts{})
		</span>
	</div>
}

// TextareaOpts configures a multi-line input.
type TextareaOpts struct {
	Name, Value, Placeholder string
	Rows                     int
	Required                 bool
	Attrs                    Attrs
}

// Textarea is a multi-line text input.
templ Textarea(o TextareaOpts) {
	<textarea
		{ root("textarea", "input", o.Attrs)... }
		id={ o.Name } name={ o.Name } rows={ fmt.Sprint(o.Rows) }
		placeholder={ o.Placeholder }
		required?={ o.Required }
	>{ o.Value }</textarea>
}

// SelectOpts configures a select control.
type SelectOpts struct {
	Name     string
	Options  []Option
	Required bool
	Attrs    Attrs
}

// Select is a native select.
templ Select(o SelectOpts) {
	<select
		{ root("select", "input", o.Attrs)... }
		id={ o.Name } name={ o.Name }
		required?={ o.Required }
	>
		for _, opt := range o.Options {
			<option value={ opt.Value } selected?={ opt.Selected } disabled?={ opt.Disabled }>{ opt.Label }</option>
		}
	</select>
}

// CheckboxOpts configures a single checkbox.
type CheckboxOpts struct {
	Name, Label, Value string
	Checked            bool
	Attrs              Attrs
}

// Checkbox is a labelled checkbox.
templ Checkbox(o CheckboxOpts) {
	<label { root("checkbox", "flex items-center gap-2 text-sm", Attrs{})... }>
		<input { attributes(o.Attrs)... } type="checkbox" name={ o.Name } value={ o.Value } checked?={ o.Checked } class="h-4 w-4"/>
		{ o.Label }
	</label>
}

// RadioGroupOpts configures a radio group.
type RadioGroupOpts struct {
	Name     string
	Options  []Option
	Required bool
	Attrs    Attrs
}

// RadioGroup renders a group of radios sharing a name.
templ RadioGroup(o RadioGroupOpts) {
	<div { rootWith("radio-group", "space-y-2", o.Attrs, "role", "radiogroup")... }>
		for _, opt := range o.Options {
			<label class="flex items-center gap-2 text-sm">
				<input type="radio" name={ o.Name } value={ opt.Value } checked?={ opt.Selected } disabled?={ opt.Disabled } class="h-4 w-4"/>
				{ opt.Label }
			</label>
		}
	</div>
}

// SwitchOpts configures a toggle switch.
type SwitchOpts struct {
	Name, Label string
	On          bool
	Attrs       Attrs
}

// Switch is a labelled toggle.
templ Switch(o SwitchOpts) {
	<label { root("switch", "flex items-center gap-2 text-sm", Attrs{})... }>
		<input { attributes(o.Attrs)... } type="checkbox" name={ o.Name } checked?={ o.On } class="h-4 w-4"/>
		{ o.Label }
	</label>
}
