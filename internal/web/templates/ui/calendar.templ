package ui

import "fmt"

// MonthGridOpts renders a static month, with no picker attached.
type MonthGridOpts struct {
	// ID is required: the grid's caption and its table reference each other.
	ID string
	// Month is the ISO year-month this grid shows, e.g. "2026-01".
	Month string
	// Caption names the month in words, already localized.
	Caption string
	// DayNames are the seven column headings, starting at FirstDayOfWeek.
	DayNames []string
	// Weeks are rows of day cells; a nil cell is a leading or trailing blank.
	Weeks [][]MonthDay
	Attrs Attrs
}

// MonthDay is one cell in a month grid.
type MonthDay struct {
	// Date is the ISO date, empty for a padding cell.
	Date string
	// Label is the day number as displayed.
	Label string
	// Content is an optional slot for what happens that day.
	Content  templ.Component
	Today    bool
	Selected bool
	Disabled bool
}

// MonthGrid renders a month as a table.
//
// A calendar is tabular data - days across, weeks down - so it is a <table> with
// real column headers. A grid of divs looks identical and tells a screen reader
// nothing about which weekday a date falls on, which is the one thing a calendar
// exists to convey.
templ MonthGrid(o MonthGridOpts) {
	<table { rootWith("month-grid", "w-full text-sm", o.Attrs, "aria-labelledby", o.ID+"-caption")... }>
		<caption id={ o.ID + "-caption" } class="font-semibold pb-2">{ o.Caption }</caption>
		<thead>
			<tr>
				for _, day := range o.DayNames {
					// abbr carries the full weekday name: a header reading "Mo"
					// is ambiguous read aloud, and abbreviating in the markup
					// rather than the accessible name is what keeps both right.
					<th scope="col" class="py-1 font-medium text-fg-muted"><abbr title={ day }>{ monthDayAbbrev(day) }</abbr></th>
				}
			</tr>
		</thead>
		<tbody>
			for _, week := range o.Weeks {
				<tr>
					for _, day := range week {
						if day.Date == "" {
							// A padding cell holds no date, so it is not a cell
							// a screen reader should announce as empty content.
							<td class="py-1" aria-hidden="true"></td>
						} else {
							<td class={ monthDayClass(day) }>
								<time datetime={ day.Date } aria-current={ monthDayCurrent(day) }>{ day.Label }</time>
								if day.Content != nil {
									@day.Content
								}
							</td>
						}
					}
				</tr>
			}
		</tbody>
	</table>
}

// DatePickerOpts wraps a native date field with a calendar popover.
type DatePickerOpts struct {
	// Field is the native input, and it stays authoritative: visible, named,
	// constrained, and submitted. The calendar only writes into it.
	Field DateFieldOpts
	// Locale and TriggerLabel are localized by the caller; ui never imports
	// i18n. FirstDayOfWeek is 0 for Sunday.
	Locale         string
	TriggerLabel   string
	FirstDayOfWeek int
	// DisabledDates are ISO dates the calendar greys out. The server validates
	// them again: a date blocked only in the browser is not blocked.
	DisabledDates []string
	Attrs         Attrs
}

// DatePicker renders a native date input plus an optional calendar.
//
// The input is the control. With no JavaScript the user types a date and the
// form submits; the platform supplies the format, the keyboard entry and the
// mobile date wheel. Cally adds a calendar in a first-party popover, and it
// writes into the same input rather than replacing it - which is why the value
// cannot diverge from what the server receives.
templ DatePicker(o DatePickerOpts) {
	<div
		{ rootWith("date-picker", "relative", o.Attrs,
			"x-data", "uiCalendar",
			"data-ui-engine", "cally",
			"data-calendar-kind", "date",
			"data-calendar-locale", o.Locale,
			"data-calendar-first-day", fmt.Sprint(o.FirstDayOfWeek),
			"data-calendar-disabled", joinDates(o.DisabledDates))... }
	>
		<div class="flex items-center gap-2">
			@DateField(o.Field)
			// The trigger starts hidden: until the calendar engine loads there
			// is nothing for it to open, and a button that does nothing is
			// worse than no button.
			<button type="button" class="btn btn-ghost btn-icon" data-calendar-trigger hidden aria-expanded="false" aria-label={ o.TriggerLabel }>
				@Icon(IconOpts{Name: IconCalendar, Attrs: Attrs{Class: "w-4 h-4"}})
			</button>
		</div>
		// The popover lives in the same subtree as the input, so an htmx swap
		// removes both together and cannot leave a calendar bound to a detached
		// field.
		<div data-calendar-popover hidden class="absolute z-(--z-overlay) mt-1 card p-2"></div>
	</div>
}

// DateTimePickerOpts wraps a native datetime-local field with a calendar.
type DateTimePickerOpts struct {
	Field          DateTimeFieldOpts
	Locale         string
	TriggerLabel   string
	FirstDayOfWeek int
	DisabledDates  []string
	Attrs          Attrs
}

// DateTimePicker renders a native datetime-local input plus a calendar.
//
// The calendar contributes only the date half. It writes nothing until a time
// exists too, because a datetime with a guessed midnight is a wrong answer that
// looks like a right one - and the user never chose it.
templ DateTimePicker(o DateTimePickerOpts) {
	<div
		{ rootWith("date-time-picker", "relative", o.Attrs,
			"x-data", "uiCalendar",
			"data-ui-engine", "cally",
			"data-calendar-kind", "datetime",
			"data-calendar-locale", o.Locale,
			"data-calendar-first-day", fmt.Sprint(o.FirstDayOfWeek),
			"data-calendar-disabled", joinDates(o.DisabledDates))... }
	>
		<div class="flex items-center gap-2">
			@DateTimeField(o.Field)
			<button type="button" class="btn btn-ghost btn-icon" data-calendar-trigger hidden aria-expanded="false" aria-label={ o.TriggerLabel }>
				@Icon(IconOpts{Name: IconCalendar, Attrs: Attrs{Class: "w-4 h-4"}})
			</button>
		</div>
		<div data-calendar-popover hidden class="absolute z-(--z-overlay) mt-1 card p-2"></div>
	</div>
}

// DateRangePickerOpts wraps the two-input native range with a calendar.
type DateRangePickerOpts struct {
	Range          DateRangeFieldOpts
	Locale         string
	TriggerLabel   string
	FirstDayOfWeek int
	DisabledDates  []string
	Attrs          Attrs
}

// DateRangePicker renders two native date inputs plus a range calendar.
//
// Two inputs rather than one string: a range submitted as one value has to be
// parsed and re-validated, and a partially filled range cannot be represented at
// all. The server owns start<=end regardless of what the calendar allowed.
templ DateRangePicker(o DateRangePickerOpts) {
	<div
		{ rootWith("date-range-picker", "relative", o.Attrs,
			"x-data", "uiCalendar",
			"data-ui-engine", "cally",
			"data-calendar-kind", "range",
			"data-calendar-locale", o.Locale,
			"data-calendar-first-day", fmt.Sprint(o.FirstDayOfWeek),
			"data-calendar-disabled", joinDates(o.DisabledDates))... }
	>
		<div class="flex items-start gap-2">
			@DateRangeField(o.Range)
			<button type="button" class="btn btn-ghost btn-icon mt-6" data-calendar-trigger hidden aria-expanded="false" aria-label={ o.TriggerLabel }>
				@Icon(IconOpts{Name: IconCalendar, Attrs: Attrs{Class: "w-4 h-4"}})
			</button>
		</div>
		<div data-calendar-popover hidden class="absolute z-(--z-overlay) mt-1 card p-2"></div>
	</div>
}

// SchedulerOpts renders scheduled items grouped by day.
type SchedulerOpts struct {
	ID string
	// Label names the schedule for assistive technology.
	Label string
	Days  []ScheduleDay
	Attrs Attrs
}

// ScheduleDay is one day's entries.
type ScheduleDay struct {
	// Date is the ISO date; Label is the localized heading.
	Date, Label string
	Entries     []ScheduleEntry
	Empty       string
}

// ScheduleEntry is one scheduled item.
type ScheduleEntry struct {
	// Start and End are localized display strings; MachineStart is the ISO
	// instant for <time datetime>.
	Start, End, MachineStart string
	Title                    string
	Kind                     Kind
	Href                     string
}

// Scheduler renders a day-grouped agenda.
//
// An agenda list, not a pixel grid: a time grid positions entries by offset,
// which conveys duration visually and nothing at all to a screen reader, and
// collapses badly on a phone. The list states each entry's times as text.
templ Scheduler(o SchedulerOpts) {
	<div { rootWith("scheduler", "space-y-4", o.Attrs, "role", "region", "aria-label", o.Label)... }>
		for _, day := range o.Days {
			<section aria-labelledby={ o.ID + "-" + day.Date }>
				<h3 id={ o.ID + "-" + day.Date } class="font-semibold text-sm">
					<time datetime={ day.Date }>{ day.Label }</time>
				</h3>
				if len(day.Entries) == 0 {
					<p class="text-sm text-fg-muted">{ day.Empty }</p>
				} else {
					<ul class="mt-2 space-y-1">
						for _, entry := range day.Entries {
							<li class="flex items-baseline gap-3 text-sm">
								<time class="tabular-nums text-fg-muted shrink-0" datetime={ entry.MachineStart }>{ scheduleTimeRange(entry) }</time>
								@StatusDot(StatusDotOpts{Kind: entry.Kind, Label: ""})
								if entry.Href != "" {
									<a href={ templ.SafeURL(entry.Href) } class="link">{ entry.Title }</a>
								} else {
									<span>{ entry.Title }</span>
								}
							</li>
						}
					</ul>
				}
			</section>
		}
	</div>
}

// AvailabilityGridOpts renders selectable time slots.
type AvailabilityGridOpts struct {
	// Name is the checkbox group name; every slot submits under it, so the
	// selection survives without JavaScript.
	Name   string
	Legend string
	Slots  []AvailabilitySlot
	Attrs  Attrs
}

// AvailabilitySlot is one selectable slot.
type AvailabilitySlot struct {
	// Value is the submitted ISO instant; Label is the localized display.
	Value, Label string
	Selected     bool
	Disabled     bool
	// DisabledReason names why a slot cannot be chosen. A greyed cell with no
	// explanation leaves the user guessing whether it is taken or invalid.
	DisabledReason string
}

// AvailabilityGrid renders slots as real checkboxes.
//
// Checkboxes inside a fieldset, not clickable divs: the selection submits with
// no JavaScript, every slot is reachable by keyboard, and the legend associates
// the question with the answers. A grid of divs with click handlers has none of
// those properties and looks the same.
templ AvailabilityGrid(o AvailabilityGridOpts) {
	<fieldset { root("availability-grid", "space-y-2", o.Attrs)... }>
		<legend class="label">{ o.Legend }</legend>
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
			for _, slot := range o.Slots {
				<label class={ availabilitySlotClass(slot) }>
					<input
						type="checkbox"
						name={ o.Name }
						value={ slot.Value }
						checked?={ slot.Selected }
						disabled?={ slot.Disabled }
						class="sr-only"
					/>
					<span>{ slot.Label }</span>
					if slot.Disabled && slot.DisabledReason != "" {
						<span class="block text-xs text-fg-muted">{ slot.DisabledReason }</span>
					}
				</label>
			}
		</div>
	</fieldset>
}

func availabilitySlotClass(slot AvailabilitySlot) string {
	base := "rounded-lg border px-3 py-2 text-sm text-center cursor-pointer has-[:checked]:bg-selected has-[:checked]:text-selected-fg has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2"
	if slot.Disabled {
		return base + " border-border text-fg-muted cursor-not-allowed"
	}
	return base + " border-border hover:bg-surface-raised"
}

func scheduleTimeRange(entry ScheduleEntry) string {
	if entry.End == "" {
		return entry.Start
	}
	return entry.Start + "–" + entry.End
}

func monthDayClass(day MonthDay) string {
	cls := "py-1 text-center align-top"
	switch {
	case day.Selected:
		cls += " bg-selected text-selected-fg font-semibold rounded"
	case day.Today:
		cls += " font-semibold"
	case day.Disabled:
		cls += " text-fg-muted"
	}
	return cls
}

// monthDayCurrent marks today with aria-current="date", which is what lets a
// screen-reader user find today without counting cells.
func monthDayCurrent(day MonthDay) string {
	if day.Today {
		return "date"
	}
	return ""
}

// monthDayAbbrev shows the first two letters. The full name stays in the abbr
// title, so the visual abbreviation never becomes the accessible name.
func monthDayAbbrev(day string) string {
	runes := []rune(day)
	if len(runes) <= 2 {
		return day
	}
	return string(runes[:2])
}

// joinDates renders disabled dates as one comma-separated attribute value. The
// server validates them again: a date blocked only in the browser is not
// blocked at all.
func joinDates(dates []string) string {
	out := ""
	for i, date := range dates {
		if i > 0 {
			out += ","
		}
		out += date
	}
	return out
}
