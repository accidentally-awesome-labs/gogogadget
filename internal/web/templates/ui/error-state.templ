package ui

// ErrorStateOpts is the in-page failure pattern.
type ErrorStateOpts struct {
	Title string
	Body  string
	// RetryURL makes the failure actionable. A failure with no next step leaves
	// the user with nothing to do but reload and hope.
	RetryURL   string
	RetryLabel string
	Target     string
	// Level is the title's heading level, defaulting to 3. An error state's
	// depth is a fact about the page, not the component: one rendered directly
	// under the page title needs h2, and hardcoding h3 skips a level there -
	// which sends heading navigation somewhere the reader did not ask for.
	Level int
	Attrs Attrs
}

// ErrorState renders a failed region with a retry.
//
// role="alert" because a region that failed after the user acted must be
// announced - unlike EmptyState, which is a resting state and not news. The
// retry is a real link with an hx-get, so it works with scripts disabled.
templ ErrorState(o ErrorStateOpts) {
	<div { rootWith("error-state", "card text-center py-10", o.Attrs, "role", "alert")... }>
		@Icon(IconOpts{Name: IconError, Attrs: Attrs{Class: "w-6 h-6 mx-auto text-danger-text"}})
		// Unstyled: the title's typography is this component's own, and
		// borrowing a Size to obtain the tag would resize it.
		@Heading(HeadingOpts{
			Text: o.Title, Level: errorStateLevel(o.Level),
			Unstyled: true, Attrs: Attrs{Class: "font-semibold mt-2"},
		})
		<p class="text-sm text-fg-muted mt-1">{ o.Body }</p>
		if o.RetryURL != "" {
			<a
				href={ templ.SafeURL(o.RetryURL) }
				hx-get={ o.RetryURL }
				hx-target={ o.Target }
				hx-swap="innerHTML"
				class="btn btn-ghost btn-sm mt-4"
			>{ breadcrumbOrDefault(o.RetryLabel, "Try again") }</a>
		}
	</div>
}

// errorStateLevel defaults to 3: most error states stand in for a region that
// already has a heading of its own.
func errorStateLevel(level int) int {
	if level > 0 {
		return level
	}
	return 3
}
