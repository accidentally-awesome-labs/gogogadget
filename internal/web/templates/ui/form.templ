package ui

import "strings"

// FormOpts renders a form wrapper; children are the fields. novalidate is
// always set: server validation is authoritative, and letting the browser block
// submission first means the server's rules never run.
type FormOpts struct {
	Method string
	Action string
	// Enctype is the native encoding. A form containing a file input MUST send
	// multipart/form-data or the browser submits the filename as text and the
	// bytes never leave the machine - and that is a silent failure, because the
	// request succeeds and the file is simply absent. htmx has its own
	// hx-encoding for the scripted path; this is the one a plain browser reads,
	// so an upload form needs both and neither implies the other.
	Enctype string
	Target  string
	Swap    string
	Attrs   Attrs
}

templ Form(o FormOpts) {
	// Every attribute is dropped when its option is empty, through the same
	// pair mechanism the rest of the package uses. An emitted hx-target="" is
	// not the absence of a target: htmx reads the attribute as present and
	// swaps into nothing, so a form that simply did not want htmx behaviour
	// silently posts into a void.
	<form
		{ rootWith("form", "", o.Attrs,
			"method", formMethod(o),
			"action", formAction(o),
			"enctype", o.Enctype,
			"hx-target", o.Target,
			"hx-swap", o.Swap)... }
		novalidate
	>
		// Every unsafe form carries its own token. Rendering it here rather than
		// asking callers to add a field is what makes the no-script path real:
		// the header htmx sends is unreachable when htmx never loaded, and a
		// form the server then refuses with 403 is a worse fallback than no
		// form at all.
		if formCarriesCSRF(formMethod(o)) {
			@CSRFField(CSRFFieldOpts{})
		}
		{ children... }
	</form>
}

// formCarriesCSRF reports whether the browser's own submission of this form
// would be checked. GET and HEAD are safe methods that the check skips, and a
// token in a GET is a token in the URL bar, the browser history, the Referer
// header and every access log along the way.
func formCarriesCSRF(method string) bool {
	switch strings.ToLower(strings.TrimSpace(method)) {
	case "", "get", "head":
		return false
	}
	return true
}

// formMethod is the method the BROWSER would use, which is not always the one
// the caller wrote down. Almost every form in this product declares its request
// as hx-post and leaves Method unset, because htmx is what normally submits it.
// Unset means GET to a browser - so with scripting off those forms did not post
// at all, they navigated, and carried no token because a GET needs none.
//
// Deriving the method from the htmx verb is what makes the no-script path real
// for the forms that actually exist, rather than only for the ones whose author
// remembered a second place to say "post". A caller who sets Method explicitly
// still wins: this fills a gap, it does not overrule an instruction.
func formMethod(o FormOpts) string {
	if strings.TrimSpace(o.Method) != "" {
		return o.Method
	}
	if hxMutates(o.Attrs.HX) {
		return "post"
	}
	return ""
}

// formAction is where that submission goes. An htmx form names its endpoint in
// the verb rather than in action, and a form with no action posts to the current
// URL - which for /app/projects/new is the page itself, not the create handler.
// So the URL travels with the derived method or the fallback lands nowhere
// useful.
//
// PUT, PATCH and DELETE have no HTML form equivalent; a browser sends POST and
// the server routes on the path. Emitting the URL is still right - the endpoint
// is where the request belongs - and a handler that only accepts DELETE will
// answer 405 rather than silently doing something else.
func formAction(o FormOpts) string {
	if strings.TrimSpace(o.Action) != "" {
		return o.Action
	}
	if strings.TrimSpace(o.Method) != "" {
		return ""
	}
	return hxMutatingURL(o.Attrs.HX)
}

// hxMutates and hxMutatingURL read the verb set rather than a hand-written list
// of fields, so a verb added to HX later cannot quietly fall out of the
// no-script path the way four HX fields once fell out of the emitter.
func hxMutates(hx HX) bool {
	return hxMutatingURL(hx) != ""
}

func hxMutatingURL(hx HX) string {
	for _, url := range []string{hx.Post, hx.Put, hx.Patch, hx.Delete} {
		if strings.TrimSpace(url) != "" {
			return url
		}
	}
	return ""
}
