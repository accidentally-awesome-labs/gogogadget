package ui

// ToggleOption is one choice in a toggle group.
type ToggleOption struct {
	Value, Label string
	Icon         IconName
	Selected     bool
	// HX issues the request this option makes. It lives here rather than on the
	// group because htmx does not inherit the verb from an ancestor, so a
	// group-level hx-post would never fire, and because a single group-level
	// request cannot say which option the user chose - the choice is the whole
	// point of the control.
	HX HX
}

// ToggleGroupOpts configures a set of mutually exclusive toggles.
type ToggleGroupOpts struct {
	// Label names the group. Without it a screen reader announces each button
	// with no indication of what the set controls.
	Label   string
	Options []ToggleOption
	Size    Size
	Attrs   Attrs
}

// ToggleGroup renders exclusive toggles as a labelled group.
//
// These are buttons with aria-pressed rather than role="radiogroup": a radio
// group promises arrow-key navigation between options, and the buttons here are
// each independently tabbable. Announcing the honest role is better than
// claiming a keyboard contract that is not implemented.
templ ToggleGroup(o ToggleGroupOpts) {
	<div
		{ rootWith("toggle-group", "inline-flex rounded-lg border border-border overflow-hidden", o.Attrs,
			"role", "group",
			"aria-label", o.Label)... }
	>
		for _, opt := range o.Options {
			<button
				{ withRequest(templ.Attributes{}, opt.HX)... }
				type="button"
				aria-pressed={ pressedAttr(&opt.Selected) }
				value={ opt.Value }
				class={ "px-3 py-1.5 text-sm border-r border-border last:border-r-0",
					templ.KV("bg-selected text-selected-fg font-semibold", opt.Selected),
					templ.KV("text-fg-muted hover:bg-surface-raised", !opt.Selected) }
			>
				if opt.Icon != "" {
					@Icon(IconOpts{Name: opt.Icon, Attrs: Attrs{Class: "w-4 h-4 inline-block mr-1 align-text-bottom"}})
				}
				{ opt.Label }
			</button>
		}
	</div>
}
