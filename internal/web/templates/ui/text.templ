package ui

// TextOpts configures a run of body copy.
type TextOpts struct {
	Size Size
	// Muted lowers contrast for secondary copy. It is a separate flag rather
	// than a colour so no caller can tint body text arbitrarily.
	Muted bool
	Attrs Attrs
}

// Text renders body copy. It is a <p>, not a <div>: paragraph structure is what
// lets a screen reader user move through prose a paragraph at a time.
templ Text(o TextOpts) {
	<p { root("text", textClass(o), o.Attrs)... }>{ children... }</p>
}

// textClass maps the size axis onto one class per rung. SizeSM and SizeMD both
// returned text-sm, which cost two things at once: text-base had no typed
// representation at all, so base-size body copy could not be expressed, and one
// of the four declared enum values was silently redundant.
//
// Changing MD - the normalize default - moves an unsized caller from 14px to
// 16px, so every call site that relied on the default was pinned to SizeSM in
// the same change and renders byte-identically. New callers get the ladder.
func textClass(o TextOpts) string {
	cls := "text-base"
	switch o.Size.Value() {
	case SizeXS:
		cls = "text-xs"
	case SizeSM:
		cls = "text-sm"
	case SizeLG:
		cls = "text-lg"
	}
	if o.Muted {
		cls += " text-fg-muted"
	}
	return cls
}
