package ui

// TextOpts configures a run of body copy.
type TextOpts struct {
	Size Size
	// Muted lowers contrast for secondary copy. It is a separate flag rather
	// than a colour so no caller can tint body text arbitrarily.
	Muted bool
	Attrs Attrs
}

// Text renders body copy. It is a <p>, not a <div>: paragraph structure is what
// lets a screen reader user move through prose a paragraph at a time.
templ Text(o TextOpts) {
	<p { root("text", textClass(o), o.Attrs)... }>{ children... }</p>
}

func textClass(o TextOpts) string {
	cls := "text-sm"
	switch o.Size.Value() {
	case SizeXS:
		cls = "text-xs"
	case SizeLG:
		cls = "text-lg"
	}
	if o.Muted {
		cls += " text-fg-muted"
	}
	return cls
}
