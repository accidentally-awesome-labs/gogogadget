package ui

// ColorInputOpts is a colour picker.
type ColorInputOpts struct {
	Name        string
	Value       string
	Hint, Error string
	Attrs       Attrs
}

// ColorInput renders a native colour input paired with its hex value.
//
// The hex text is shown because a swatch alone cannot be read, compared,
// copied, or communicated - and it is the value the user will paste elsewhere.
templ ColorInput(o ColorInputOpts) {
	<div class="flex items-center gap-3">
		<input
			{ root("color-input", "h-9 w-12 rounded-lg border border-border bg-surface", o.Attrs)... }
			{ FieldARIA(FieldOpts{Name: o.Name, Hint: o.Hint, Error: o.Error})... }
			type="color" id={ o.Name } name={ o.Name } value={ o.Value }
		/>
		if o.Value != "" {
			// The readout only appears when there is a value to read: an empty
			// hex string tells the user nothing and reads as a rendering bug.
			<span class="text-sm font-mono text-fg-muted">{ o.Value }</span>
		}
	</div>
}
