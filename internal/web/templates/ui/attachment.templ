package ui

// AttachmentOpts is one uploaded file.
type AttachmentOpts struct {
	Name string
	// Size is the human-readable size string. It is pre-formatted by the
	// caller: byte formatting is locale-dependent and ui never imports i18n.
	Size string
	Href string
	Icon IconName
	// Actions is the trailing control cluster (remove, download).
	Actions templ.Component
	Attrs   Attrs
}

// Attachment renders one file row.
//
// The name is the link text, not "download": a screen reader's link list shows
// link text out of context, and forty links all reading "download" are
// indistinguishable.
templ Attachment(o AttachmentOpts) {
	<div { root("attachment", "flex items-center gap-3 rounded-lg border border-border px-3 py-2 text-sm", o.Attrs)... }>
		@Icon(IconOpts{Name: attachmentIcon(o.Icon), Attrs: Attrs{Class: "w-4 h-4 shrink-0 text-fg-muted"}})
		if o.Href != "" {
			<a href={ templ.SafeURL(o.Href) } class="link truncate">{ o.Name }</a>
		} else {
			<span class="truncate">{ o.Name }</span>
		}
		if o.Size != "" {
			<span class="text-fg-muted shrink-0">{ o.Size }</span>
		}
		if o.Actions != nil {
			<span class="ml-auto shrink-0">
				@o.Actions
			</span>
		}
	</div>
}

func attachmentIcon(icon IconName) IconName {
	if icon == "" {
		return IconFile
	}
	return icon
}
