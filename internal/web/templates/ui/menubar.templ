package ui

// MenubarOpts configures an application menubar.
type MenubarOpts struct {
	Label string
	Menus []MenubarMenu
	Attrs Attrs
}

// MenubarMenu is one top-level menu and its items.
type MenubarMenu struct {
	Label string
	Items []MenuItem
}

// Menubar renders application menus as a row of disclosure buttons.
//
// Each menu is a DropdownMenu, so the whole bar inherits one behaviour: click
// or Enter to open, Escape to close, focus into the panel and back to the
// trigger. A real ARIA menubar adds cross-menu arrow navigation and typeahead;
// building half of that and claiming role="menubar" would promise a keyboard
// contract the widget does not honour.
templ Menubar(o MenubarOpts) {
	<div { rootWith("menubar", "flex items-center gap-1", o.Attrs, "role", "group", "aria-label", o.Label)... }>
		for _, menu := range o.Menus {
			@DropdownMenu(DropdownMenuOpts{Label: menu.Label, Items: menu.Items})
		}
	</div>
}
