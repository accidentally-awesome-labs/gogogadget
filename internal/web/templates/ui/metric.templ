package ui

// MetricOpts is one number on a dashboard.
type MetricOpts struct {
	Title string
	Value string
	Sub   string
	// Sparkline is an optional trend visual. It is a slot rather than data
	// because a metric card should not grow a charting engine: the caller
	// passes whatever renderer it already uses.
	Sparkline templ.Component
	Attrs     Attrs
}

templ Metric(o MetricOpts) {
	<div { root("metric", "card", defaultTestID(o.Attrs, "stat-card"))... }>
		<p class="text-sm text-fg-muted">{ o.Title }</p>
		<p class="text-3xl font-bold mt-1">{ o.Value }</p>
		if o.Sub != "" {
			<p class="text-sm text-fg-muted mt-1">{ o.Sub }</p>
		}
		if o.Sparkline != nil {
			<div class="mt-3">
				@o.Sparkline
			</div>
		}
	</div>
}
