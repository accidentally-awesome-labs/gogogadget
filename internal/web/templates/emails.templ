package templates

import "github.com/gogogadget/gogogadget/internal/i18n"

// EmailLayout is an inline-styled table shell (email clients strip <style>).
templ EmailLayout(content templ.Component) {
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:24px 0;">
		<tr>
			<td align="center">
				<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px;font-family:system-ui,-apple-system,sans-serif;color:#0f172a;">
					<tr>
						<td>
							<div style="font-weight:700;font-size:18px;color:#4f46e5;margin-bottom:24px;">⚡ GoGoGadget</div>
							@content
							<p style="color:#94a3b8;font-size:12px;margin-top:32px;">{ i18n.T(ctx, "email.footer") }</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
}

templ WelcomeEmailHTML(appURL, name string) {
	@EmailLayout(WelcomeEmailBody(appURL, name))
}

templ WelcomeEmailBody(appURL, name string) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.welcome.title", greetingName(name)) }</h1>
	<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.welcome.body") }</p>
	<p style="margin:0;"><a href={ appURL + "/app" } style="color:#4f46e5;">{ i18n.T(ctx, "email.welcome.cta") }</a></p>
}

templ PaymentFailedEmailHTML(appURL string) {
	@EmailLayout(PaymentFailedEmailBody(appURL))
}

templ PaymentFailedEmailBody(appURL string) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.payment_failed.title") }</h1>
	<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.payment_failed.body") }</p>
	<p style="margin:0;"><a href={ appURL + "/app/settings/billing" } style="color:#4f46e5;">{ i18n.T(ctx, "email.payment_failed.cta") }</a></p>
}

