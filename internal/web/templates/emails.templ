	<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.canceled.body_a") } <strong>{ periodEnd }</strong>{ i18n.T(ctx, "email.canceled.body_b") }</p>
	<p style="margin:0;"><a href={ appURL + "/app/settings/billing" } style="color:#4f46e5;">{ i18n.T(ctx, "email.canceled.cta") }</a></p>
