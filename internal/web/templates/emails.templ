templ TrialEndingEmailBody(appURL, trialEnd string) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.trial_ending.title") }</h1>
	<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.trial_ending.body_a") } <strong>{ trialEnd }</strong>. { i18n.T(ctx, "email.trial_ending.body_b") }</p>
	<p style="margin:0;"><a href={ appURL + "/app/settings/billing" } style="color:#4f46e5;">{ i18n.T(ctx, "email.trial_ending.cta") }</a></p>
}

// absoluteURL turns a stored notification path into a link for email. Only
// in-app relative paths are honoured: a notification row's url is written by
// internal callers today, but a digest is the one place those strings leave
// the app and land in a mail client, so anything that is not a plain "/path"
// is dropped rather than linked.
func absoluteURL(appURL, path string) string {
	if len(path) < 2 || path[0] != '/' || path[1] == '/' {
		return ""
	}
	return appURL + path
}

func greetingName(name string) string {
	if name == "" {
		return ""
	}
	return ", " + name
}

// Plain-text counterparts (separate component per email kind).

templ WelcomeEmailText(appURL, name string) {
	{ i18n.T(ctx, "email.welcome.title", greetingName(name)) }

	{ i18n.T(ctx, "email.welcome.body") }

	{ i18n.T(ctx, "email.welcome.cta") } { appURL }/app
}

templ PaymentFailedEmailText(appURL string) {
	{ i18n.T(ctx, "email.payment_failed.title") }

	{ i18n.T(ctx, "email.payment_failed.body") }

	{ i18n.T(ctx, "email.payment_failed.cta") } { appURL }/app/settings/billing
}

templ SubscriptionCanceledEmailText(appURL, periodEnd string) {
	{ i18n.T(ctx, "email.canceled.title") }

	{ i18n.T(ctx, "email.canceled.body_a") } { periodEnd }{ i18n.T(ctx, "email.canceled.body_b") }

	{ i18n.T(ctx, "email.canceled.cta") } { appURL }/app/settings/billing
}

templ TrialEndingEmailText(appURL, trialEnd string) {
	{ i18n.T(ctx, "email.trial_ending.title") }

	{ i18n.T(ctx, "email.trial_ending.body_a") } { trialEnd }. { i18n.T(ctx, "email.trial_ending.body_b") }

	{ i18n.T(ctx, "email.trial_ending.cta") } { appURL }/app/settings/billing
}

// DigestItem is one line of the periodic rollup — deliberately a view struct
// rather than sqlc.Notification, so the email never depends on the shape of
// a database row.
type DigestItem struct {
	Title string
	Body  string
	URL   string
	When  string
}

templ DigestEmailHTML(appURL, name string, items []DigestItem) {
	@EmailLayout(DigestEmailBody(appURL, name, items))
}

templ DigestEmailBody(appURL, name string, items []DigestItem) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.digest.title", greetingName(name)) }</h1>
	<p style="margin:0 0 16px;line-height:1.6;">{ i18n.T(ctx, "email.digest.intro") }</p>
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
		for _, item := range items {
			<tr>
				<td style="padding:0 0 16px;border-bottom:1px solid #e2e8f0;">
					<div style="font-weight:600;font-size:15px;margin-bottom:2px;">
						if link := absoluteURL(appURL, item.URL); link != "" {
							<a href={ templ.URL(link) } style="color:#4f46e5;text-decoration:none;">{ item.Title }</a>
						} else {
							{ item.Title }
						}
					</div>
					<div style="color:#475569;font-size:14px;line-height:1.5;">{ item.Body }</div>
					<div style="color:#94a3b8;font-size:12px;margin-top:4px;">{ item.When }</div>
				</td>
			</tr>
		}
	</table>
	<p style="margin:24px 0 0;"><a href={ appURL + "/app/notifications" } style="color:#4f46e5;">{ i18n.T(ctx, "email.digest.cta") }</a></p>
	<p style="margin:16px 0 0;color:#94a3b8;font-size:12px;">
		{ i18n.T(ctx, "email.digest.manage") } <a href={ appURL + "/app/settings/notifications" } style="color:#94a3b8;">{ appURL }/app/settings/notifications</a>
	</p>
}

templ DigestEmailText(appURL, name string, items []DigestItem) {
	{ i18n.T(ctx, "email.digest.title", greetingName(name)) }

	{ i18n.T(ctx, "email.digest.intro") }
	for _, item := range items {
		- { item.Title }: { item.Body } ({ item.When })
	}

	{ i18n.T(ctx, "email.digest.cta") } { appURL }/app/notifications
	{ i18n.T(ctx, "email.digest.manage") } { appURL }/app/settings/notifications
}

templ DunningReminderEmailHTML(appURL string) {
	@EmailLayout(DunningReminderEmailBody(appURL))
}

templ DunningReminderEmailBody(appURL string) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.dunning_reminder.title") }</h1>
	<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.dunning_reminder.body") }</p>
	<p style="margin:0;"><a href={ appURL + "/app/settings/billing" } style="color:#4f46e5;">{ i18n.T(ctx, "email.dunning_reminder.cta") }</a></p>
}

templ DunningFinalEmailHTML(appURL, periodEnd string) {
	@EmailLayout(DunningFinalEmailBody(appURL, periodEnd))
}

templ DunningFinalEmailBody(appURL, periodEnd string) {
	<h1 style="font-size:22px;margin:0 0 12px;">{ i18n.T(ctx, "email.dunning_final.title") }</h1>
	if periodEnd != "" {
		<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.dunning_final.body_dated") } <strong>{ periodEnd }</strong>.</p>
	} else {
		<p style="margin:0 0 12px;line-height:1.6;">{ i18n.T(ctx, "email.dunning_final.body") }</p>
	}
	<p style="margin:0;"><a href={ appURL + "/app/settings/billing" } style="color:#4f46e5;">{ i18n.T(ctx, "email.dunning_final.cta") }</a></p>
}

templ DunningReminderEmailText(appURL string) {
	{ i18n.T(ctx, "email.dunning_reminder.title") }

	{ i18n.T(ctx, "email.dunning_reminder.body") }

	{ i18n.T(ctx, "email.dunning_reminder.cta") } { appURL }/app/settings/billing
}

templ DunningFinalEmailText(appURL, periodEnd string) {
	{ i18n.T(ctx, "email.dunning_final.title") }

	if periodEnd != "" {
		{ i18n.T(ctx, "email.dunning_final.body_dated") } { periodEnd }.
	} else {
		{ i18n.T(ctx, "email.dunning_final.body") }
	}

	{ i18n.T(ctx, "email.dunning_final.cta") } { appURL }/app/settings/billing
}
