package templates

import (
	"context"
	"fmt"

	"github.com/gogogadget/gogogadget/internal/db/sqlc"
	"github.com/gogogadget/gogogadget/internal/i18n"
)

templ AdminHome(d AdminHomeData) {
	@PageHeader(i18n.T(ctx, "admin.title"))
	<div class="grid sm:grid-cols-4 gap-4">
		@StatCard(i18n.T(ctx, "admin.stats.total_users"), fmt.Sprint(d.TotalUsers), "")
		@StatCard(i18n.T(ctx, "admin.stats.total_orgs"), fmt.Sprint(d.TotalOrgs), "")
		@StatCard(i18n.T(ctx, "admin.stats.active_subs"), fmt.Sprint(d.ActiveSubs), "")
		@StatCard(i18n.T(ctx, "admin.stats.mrr"), fmt.Sprintf("$%d", d.MRR), i18n.T(ctx, "admin.stats.mrr_hint"))
	</div>

	@SectionHeading(i18n.T(ctx, "admin.signups_heading"), "mt-10 mb-3")
	@TableCard("") {
		if len(d.RecentSignups) == 0 {
			@TableEmpty(i18n.T(ctx, "admin.signups_empty"))
		} else {
			<table class="table">
				<tbody>
					for _, u := range d.RecentSignups {
						<tr>
							<td class="font-medium">{ string(u.Email) }</td>
							<td>{ u.Name }</td>
							<td class="text-right text-fg-muted"><span data-testid="relative-time">{ RelTime(d.Now, u.CreatedAt.Time) }</span></td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ AdminUsersPage(d AdminUsersData) {
	@PageHeader(i18n.T(ctx, "admin.users.title"))
	@SearchToolbar("q", d.Query, i18n.T(ctx, "admin.users.search_placeholder"), i18n.T(ctx, "admin.users.search_aria"),
		"/admin/users", "#table-container", "admin-search-indicator", "")
	@AdminUsersTable(d)
}

templ AdminUsersTable(d AdminUsersData) {
	<div id="table-container">
		@TableCard("") {
			<table class="table">
				<thead>
					<tr><th>{ i18n.T(ctx, "admin.users.col_email") }</th><th>{ i18n.T(ctx, "admin.users.col_name") }</th><th>{ i18n.T(ctx, "admin.users.col_joined") }</th><th>{ i18n.T(ctx, "admin.users.col_role") }</th><th>{ i18n.T(ctx, "admin.users.col_status") }</th><th class="text-right">{ i18n.T(ctx, "admin.users.col_actions") }</th></tr>
				</thead>
				<tbody>
					for _, u := range d.Users {
						<tr id={ "user-" + u.ClerkUserID }>
							<td class="font-medium">{ string(u.Email) }</td>
							<td>{ u.Name }</td>
							<td class="text-fg-muted">{ u.CreatedAt.Time.Format("Jan 2, 2006") }</td>
							<td>
								if AdminWrite(ctx) {
									@roleForm(u)
								} else {
									@roleBadge(u.AdminRole)
								}
							</td>
							<td>
								if u.DisabledAt.Valid {
									@Badge(i18n.T(ctx, "admin.users.status_disabled"), KindDanger)
								} else {
									@Badge(i18n.T(ctx, "admin.users.status_active"), KindSuccess)
								}
							</td>
							<td class="text-right">
								if AdminWrite(ctx) {
									<div class="card-actions">
										if !u.DisabledAt.Valid {
											<a
												href={ templ.SafeURL("/admin/users/" + u.ClerkUserID + "/impersonate") }
												hx-boost="true"
												hx-target={ NavTarget }
												hx-select={ NavTarget }
												hx-swap={ NavSwap }
												class="btn btn-ghost btn-xs"
												data-testid="admin-impersonate"
											>{ i18n.T(ctx, "admin.users.impersonate") }</a>
										}
										<button
											type="button"
											hx-post={ "/admin/users/" + u.ClerkUserID + "/disable" }
											hx-confirm={ disableConfirm(ctx, u) }
											class="btn btn-ghost btn-xs"
											data-testid="admin-disable-toggle"
										>
											if u.DisabledAt.Valid {
												{ i18n.T(ctx, "admin.users.enable") }
											} else {
												{ i18n.T(ctx, "admin.users.disable") }
											}
										</button>
									</div>
								} else {
									<span class="text-xs text-fg-muted" data-testid="admin-readonly">{ i18n.T(ctx, "admin.read_only") }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@Pagination(d.Page, d.TotalPages, "/admin/users?q="+d.Query, "#table-container")
	</div>
}

func disableConfirm(ctx context.Context, u sqlc.User) string {
	if u.DisabledAt.Valid {
		return i18n.T(ctx, "admin.users.confirm_enable", string(u.Email))
	}
	return i18n.T(ctx, "admin.users.confirm_disable", string(u.Email))
}

templ AdminOrgsPage(d AdminOrgsData) {
	@PageHeader(i18n.T(ctx, "admin.orgs.title"))
	@TableCard("") {
		<table class="table">
			<thead>
				<tr><th>{ i18n.T(ctx, "admin.orgs.col_name") }</th><th>{ i18n.T(ctx, "admin.orgs.col_slug") }</th><th>{ i18n.T(ctx, "admin.orgs.col_members") }</th><th>{ i18n.T(ctx, "admin.orgs.col_plan") }</th><th>{ i18n.T(ctx, "admin.orgs.col_created") }</th></tr>
			</thead>
			<tbody>
				for _, o := range d.Orgs {
					<tr>
						<td class="font-medium">{ o.Name }</td>
						<td class="text-fg-muted">{ o.Slug }</td>
						<td>{ fmt.Sprint(o.MemberCount) }</td>
						<td>@BadgeTagged(o.ProductKey, KindBrand, "plan-badge")</td>
						<td class="text-fg-muted">{ o.CreatedAt.Time.Format("Jan 2, 2006") }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// roleBadge shows a staff role without offering to change it (support view).
templ roleBadge(role string) {
	switch role {
		case "admin":
			@BadgeTagged(i18n.T(ctx, "admin.users.role_admin"), KindBrand, "role-badge")
		case "support":
			@BadgeTagged(i18n.T(ctx, "admin.users.role_support"), KindWarn, "role-badge")
		default:
			<span class="text-xs text-fg-muted" data-testid="role-badge">{ i18n.T(ctx, "admin.users.role_none") }</span>
	}
}

// roleForm grants or revokes staff access. Options are spelled out rather
// than looped: a computed i18n key is invisible to the catalog guard, and the
// three roles are a closed set by construction (the column has a CHECK).
templ roleForm(u sqlc.User) {
	<form hx-post={ "/admin/users/" + u.ClerkUserID + "/role" } hx-swap="none" class="inline-block">
		<select
			name="role"
			class="input input-xs w-28"
			data-testid={ "role-select-" + u.ClerkUserID }
			hx-post={ "/admin/users/" + u.ClerkUserID + "/role" }
			hx-trigger="change"
			hx-swap="none"
		>
			<option value="" selected?={ u.AdminRole == "" }>{ i18n.T(ctx, "admin.users.role_none") }</option>
			<option value="support" selected?={ u.AdminRole == "support" }>{ i18n.T(ctx, "admin.users.role_support") }</option>
			<option value="admin" selected?={ u.AdminRole == "admin" }>{ i18n.T(ctx, "admin.users.role_admin") }</option>
		</select>
	</form>
}
