package templates

import (
	"github.com/gogogadget/gogogadget/internal/web/templates/ui"
	"strings"

	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/notify"
)

// kindKey maps a notify kind to its i18n label key: dots become underscores
// (export.ready → notifications.kind.export_ready).
func kindKey(kind string) string {
	return "notifications.kind." + strings.ReplaceAll(kind, ".", "_")
}

// DigestFrequencies are the cadences a user may pick. 'off' is the opt-out;
// the schedule decides how often the worker looks, this decides who is due.
var DigestFrequencies = []string{"off", "daily", "weekly"}

templ SettingsNotificationsPage(prefs map[string]bool, digest string) {
	@SettingsTabs("/app/settings/notifications")
	@ui.PageHeader(ui.PageHeaderOpts{Title: i18n.T(ctx, "settings.notifications_title")})
	@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true, Attrs: ui.Attrs{Class: "mb-6"}}) {
		{ i18n.T(ctx, "settings.notifications_intro") }
	}
	@ui.Form(ui.FormOpts{
		Swap: "none",
		Attrs: ui.Attrs{
			Class:  "card max-w-lg space-y-4",
			TestID: "notification-prefs-form",
			HX:     ui.HX{Post: "/app/settings/notifications", Disable: true},
		},
	}) {
		for _, kind := range notify.Kinds {
			// The wrapper carries the test id because Checkbox spreads Attrs
			// onto the input itself; the row, not the control, is what a test
			// and a reader both address.
			<div class="flex items-center gap-3" data-testid={ "pref-" + kind }>
				@ui.Checkbox(ui.CheckboxOpts{
					Name:    "kind_" + kind,
					Label:   i18n.T(ctx, kindKey(kind)),
					Checked: prefs[kind],
				})
				@ui.Text(ui.TextOpts{Size: ui.SizeSM, Muted: true}) {
					{ kind }
				}
			</div>
		}
		<div class="border-t border-border pt-4">
			// Options are spelled out rather than looped: a computed key
			// ("settings.digest_" + f) is invisible to the catalog guard in
			// i18n_test.go, and an unverifiable translation key is how a
			// missing string reaches production. TestDigestFrequencyOptions
			// keeps this list and DigestFrequencies from drifting apart.
			@ui.Field(ui.FieldOpts{
				Name:  "digest_frequency",
				Label: i18n.T(ctx, "settings.digest_label"),
				Hint:  i18n.T(ctx, "settings.digest_hint"),
			}) {
				@ui.Select(ui.SelectOpts{
					Name: "digest_frequency",
					Options: []ui.Option{
						{Value: "off", Label: i18n.T(ctx, "settings.digest_off"), Selected: digest == "off"},
						{Value: "daily", Label: i18n.T(ctx, "settings.digest_daily"), Selected: digest == "daily"},
						{Value: "weekly", Label: i18n.T(ctx, "settings.digest_weekly"), Selected: digest == "weekly"},
					},
					Attrs: ui.Attrs{Class: "max-w-xs", TestID: "digest-frequency"},
				})
			}
		</div>
		@ui.FormActions(ui.FormActionsOpts{Align: ui.AlignStart}) {
			@ui.Button(ui.ButtonOpts{
				Label: i18n.T(ctx, "settings.notifications_save"),
				Type:  ui.TypeSubmit, Action: ui.ActionPrimary,
			})
			@ui.Spinner(ui.SpinnerOpts{})
		}
	}
}

// IsDigestFrequency reports whether a submitted value is one we offer — the
// handler's guard against a hand-crafted POST reaching the CHECK constraint.
func IsDigestFrequency(v string) bool {
	for _, f := range DigestFrequencies {
		if f == v {
			return true
		}
	}
	return false
}
