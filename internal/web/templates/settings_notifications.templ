package templates

import (
	"strings"

	"github.com/gogogadget/gogogadget/internal/i18n"
	"github.com/gogogadget/gogogadget/internal/notify"
)

// kindKey maps a notify kind to its i18n label key: dots become underscores
// (export.ready → notifications.kind.export_ready).
func kindKey(kind string) string {
	return "notifications.kind." + strings.ReplaceAll(kind, ".", "_")
}

// DigestFrequencies are the cadences a user may pick. 'off' is the opt-out;
// the schedule decides how often the worker looks, this decides who is due.
var DigestFrequencies = []string{"off", "daily", "weekly"}

templ SettingsNotificationsPage(prefs map[string]bool, digest string) {
	@SettingsTabs("/app/settings/notifications")
	<h1 class="text-2xl font-bold mb-2">{ i18n.T(ctx, "settings.notifications_title") }</h1>
	<p class="text-fg-muted mb-6">{ i18n.T(ctx, "settings.notifications_intro") }</p>
	<form hx-post="/app/settings/notifications" hx-swap="none" novalidate hx-disable="this" data-testid="notification-prefs-form" class="card max-w-lg space-y-4">
		for _, kind := range notify.Kinds {
			<label class="flex items-center gap-3 text-sm" data-testid={ "pref-" + kind }>
				<input
					type="checkbox"
					name={ "kind_" + kind }
					checked?={ prefs[kind] }
					class="h-4 w-4 accent-brand-600"
				/>
				<span class="font-medium">{ i18n.T(ctx, kindKey(kind)) }</span>
				<span class="text-fg-muted">{ kind }</span>
			</label>
		}
		<div class="border-t border-border pt-4">
			<label class="block text-sm font-medium mb-1" for="digest_frequency">{ i18n.T(ctx, "settings.digest_label") }</label>
			<p class="text-fg-muted text-sm mb-2">{ i18n.T(ctx, "settings.digest_hint") }</p>
			// Options are spelled out rather than looped: a computed key
			// ("settings.digest_" + f) is invisible to the catalog guard in
			// i18n_test.go, and an unverifiable translation key is how a
			// missing string reaches production. TestDigestFrequencyOptions
			// keeps this list and DigestFrequencies from drifting apart.
			<select id="digest_frequency" name="digest_frequency" class="input max-w-xs" data-testid="digest-frequency">
				<option value="off" selected?={ digest == "off" }>{ i18n.T(ctx, "settings.digest_off") }</option>
				<option value="daily" selected?={ digest == "daily" }>{ i18n.T(ctx, "settings.digest_daily") }</option>
				<option value="weekly" selected?={ digest == "weekly" }>{ i18n.T(ctx, "settings.digest_weekly") }</option>
			</select>
		</div>
		<div class="pt-2 flex items-center gap-3">
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "settings.notifications_save") }</button>
			@Spinner()
		</div>
	</form>
}

// IsDigestFrequency reports whether a submitted value is one we offer — the
// handler's guard against a hand-crafted POST reaching the CHECK constraint.
func IsDigestFrequency(v string) bool {
	for _, f := range DigestFrequencies {
		if f == v {
			return true
		}
	}
	return false
}
