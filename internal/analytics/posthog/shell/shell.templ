package shell

import "github.com/gogogadget/gogogadget/internal/i18n"

// head loads the PostHog browser client.
//
// The project API key is public by construction: it is a write-only ingest key
// that has to reach the browser for autocapture to work, which is why it is
// declared non-secret and why this renderer is allowed to receive it.
//
// array.js is fetched through the /ingest reverse proxy, so the CSP stays
// script-src 'self' and no third-party origin is contacted from the document.
// analytics.js reads the meta tag below, gates posthog.init on stored consent,
// and registers the Alpine data the consent dialog binds to.
templ head(projectKey string) {
	<meta name="ph-key" content={ projectKey }/>
	<script defer src="/ingest/static/array.js"></script>
	<script defer src="/static/analytics.js"></script>
}

// consent is the analytics consent dialog. posthog.init runs ONLY after
// acceptance — GDPR-sane by default; see static/analytics.js.
//
// It renders into the shell's persistent-body slot rather than inside
// #content, because boosted navigation swaps #content and would remount the
// dialog (and lose its Alpine state) on every page change.
templ consent() {
	<div x-data="phConsent" x-show="show" x-cloak class="fixed bottom-4 left-4 z-(--z-overlay) card max-w-sm text-sm" role="dialog" aria-label={ i18n.T(ctx, "a11y.analytics_consent") }>
		<p>{ i18n.T(ctx, "layout.analytics_consent_body") }</p>
		<div class="flex gap-2 mt-3">
			<button type="button" @click="accept" class="btn btn-primary btn-xs">{ i18n.T(ctx, "layout.analytics_accept") }</button>
			<button type="button" @click="decline" class="btn btn-ghost btn-xs">{ i18n.T(ctx, "layout.analytics_decline") }</button>
		</div>
	</div>
}
