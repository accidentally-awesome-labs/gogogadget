        "contract": true
      },
      {
        "source": "registry/modules/system/audit-export-ledger/ledger_test.go.txt",
        "target": "internal/gadgetworks/ledger/ledger_test.go",
        "class": "test",
        "sha256": "ccc12b60ca04716e18582496972ba795735a589d0925100fcc344c16ef17331a",
