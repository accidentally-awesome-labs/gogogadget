{
  "schema": 2,
  "module": {
    "id": "gadgetworks/system/audit-export-ledger",
    "kind": "system",
    "name": "audit-export-ledger",
    "revision": 3,
    "contract": 1,
    "title": "Gadgetworks audit ledger",
    "description": "External adapter for the ggg/audit-export slot, with a zero-account file target and a managed cloud target.",
    "requires": [
      {
        "id": "ggg/system/apphost",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/audit-export",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/config",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/modkit",
        "contract": {
          "min": 2,
          "max": 4
        }
      }
    ],
    "dependencies": {
      "go": [
        {
          "module": "github.com/stretchr/testify",
          "version": "v1.11.1"
        }
      ],
      "tools": [],
      "containers": []
    },
    "files": [
      {
