    ],
    "claims": {
      "packages": [
        "internal/gadgetworks/ledger",
        "internal/gadgetworks/ledger/cli",
        "internal/gadgetworks/ledger/meta"
      ],
      "cli": [
        "ledger"
      ]
    },
    "runtime": {
      "system": {
        "package": "internal/gadgetworks/ledger",
        "constructor": "NewModule",
        "needs": [
          {
            "field": "Config",
            "capability": "config",
            "type": "*config.Config",
            "optional": false
          }
        ],
        "provides": [
          {
            "field": "Value",
            "capability": "audit.exporter",
            "type": "audit.Exporter"
          }
        ],
        "type_imports": [
          "internal/audit",
          "internal/config"
        ],
        "start": false,
        "stop": true,
        "health": true,
        "adapter": {
          "slot": "ggg/audit-export",
          "targets": [
            {
              "id": "ledger-cloud",
              "title": "Gadgetworks Ledger Cloud",
              "mode": "managed",
              "environments": [
                "production"
              ],
              "automation": "manual",
              "docs_url": "https://gadgetworks.example/docs/ledger",
              "console_url": "https://app.gadgetworks.example/ledger",
              "inputs": [
                {
                  "key": "endpoint",
                  "env_key": "GADGETWORKS_LEDGER_ENDPOINT",
                  "label": "Ledger ingest endpoint",
                  "type": "url",
                  "required": true,
                  "secret": false
                },
                {
                  "key": "token",
                  "env_key": "GADGETWORKS_LEDGER_TOKEN",
                  "label": "Ledger API token",
                  "type": "string",
                  "required": true,
                  "secret": true
                }
              ]
            },
            {
              "id": "ledger-file",
              "title": "Gadgetworks Ledger file",
              "mode": "development",
              "environments": [
                "development",
                "test"
              ],
              "automation": "manual",
              "docs_url": "https://gadgetworks.example/docs/ledger-file",
              "inputs": [
                {
                  "key": "dir",
                  "env_key": "GADGETWORKS_LEDGER_DIR",
                  "label": "Ledger directory",
                  "type": "string",
                  "required": false,
                  "secret": false
                }
              ]
            }
          ]
        }
      },
      "cli": [
        {
          "name": "ledger",
          "summary": "Report the Gadgetworks ledger selection for this project",
          "package": "internal/gadgetworks/ledger/cli",
          "handler": "Run"
        }
      ]
    },
    "migrations": [],
    "environment": [
      {
        "key": "GADGETWORKS_LEDGER_DIR",
        "field": "GadgetworksLedgerDir",
        "type": "string",
        "description": "Directory the Gadgetworks ledger file target appends to",
        "default": "tmp/gadgetworks-ledger",
        "targets": [
          "gadgetworks/system/audit-export-ledger@ledger-file"
        ]
      },
      {
        "key": "GADGETWORKS_LEDGER_ENDPOINT",
        "field": "GadgetworksLedgerEndpoint",
        "type": "string",
        "description": "Gadgetworks Ledger Cloud ingest endpoint",
        "required": true,
        "targets": [
          "gadgetworks/system/audit-export-ledger@ledger-cloud"
        ]
      },
      {
        "key": "GADGETWORKS_LEDGER_TOKEN",
        "field": "GadgetworksLedgerToken",
        "type": "string",
        "description": "Gadgetworks Ledger Cloud API token",
        "required": true,
        "secret": true,
        "targets": [
          "gadgetworks/system/audit-export-ledger@ledger-cloud"
        ]
      }
    ],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/gadgetworks/ledger"
      ],
      "capabilities": [
        "audit.exporter"
      ]
    },
    "data": [],
    "removal_policy": "free"
