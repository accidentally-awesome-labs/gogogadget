bin/
tmp/
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
/gogogadget

# Local server binaries
/server
/.worktrees

# CLI-managed local state: env values, provider state, journals
.ggg/

# registry.snapshot.sig is NOT ignored. It was, on the theory that this
# repository's own catalog is only ever consumed as a directory source — false
# the moment anyone runs `ggg new --registry github:OWNER/REPO`, which fetches
# this tree and verifies it against the key compiled into the CLI. With the
# signature ignored, that refused with "read registry.snapshot.sig: no such
# file or directory" and no adoption path worked at all.
