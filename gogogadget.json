{
  "schema": 2,
  "registries": [
    {
      "namespace": "ggg",
      "source": "directory",
      "path": "registry"
    }
  ],
  "modules": [
    "ggg/profile/full"
  ],
  "exclude": [
    "ggg/component/table-empty",
    "ggg/element/divider"
  ],
  "providers": {
    "ggg/billing": {
      "development": {"adapter": "ggg/system/billing-local", "target": "local"},
      "test": {"adapter": "ggg/system/billing-local", "target": "local"},
      "production": {"adapter": "ggg/system/billing-polar", "target": "polar"}
    },
    "ggg/identity": {
      "development": {"adapter": "ggg/system/identity-dev", "target": "local"},
      "test": {"adapter": "ggg/system/identity-dev", "target": "local"},
      "production": {"adapter": "ggg/system/identity-clerk", "target": "clerk"}
    },
    "ggg/mail": {
      "development": {"adapter": "ggg/system/mail-dev", "target": "filesystem"},
      "test": {"adapter": "ggg/system/mail-dev", "target": "filesystem"},
      "production": {"adapter": "ggg/system/mail-resend", "target": "resend"}
    },
    "ggg/storage": {
      "development": {"adapter": "ggg/system/storage-filesystem", "target": "filesystem"},
      "test": {"adapter": "ggg/system/storage-filesystem", "target": "filesystem"},
      "production": {"adapter": "ggg/system/storage-s3", "target": "r2"}
    }
  },
  "deployment": ""
}
