{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/ModuleDocument"
    },
    {
      "$ref": "#/$defs/ProfileDocument"
    }
  ],
  "$defs": {
    "AssetContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "script",
            "style",
            "font",
            "image",
            "file"
          ]
        },
        "engine": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        },
        "esm": {
          "type": "boolean"
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "path",
        "kind"
      ]
    },
    "ContentTypeContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "pages",
            "single"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/(?:(?:\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*|\\{(?:[A-Za-z_][A-Za-z0-9_]*(?:[.][.][.])?|\\$)\\})(?:/(?:\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*|\\{(?:[A-Za-z_][A-Za-z0-9_]*(?:[.][.][.])?|\\$)\\}))*)?$"
          },
          "uniqueItems": true
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$"
        },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "id",
        "mode",
        "paths",
        "package",
        "handler"
      ]
    },
    "DataDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "row_discriminator": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "user",
            "org",
            "platform"
          ]
        },
        "export": {
          "type": "boolean"
        },
        "secret_redaction_owner": {
          "type": "string",
          "pattern": "^(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "account_delete": {
          "type": "string",
          "enum": [
            "cascade",
            "manual",
            "retain"
          ]
        },
        "organization_delete": {
          "type": "string",
          "enum": [
            "cascade",
            "manual",
            "retain"
          ]
        },
        "external_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "persisted_jobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "table",
        "scope",
        "export",
        "account_delete",
        "organization_delete"
      ]
    },
    "DocumentationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "title"
      ]
    },
    "EnvironmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "example": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "max": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "production_required": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "trim_slash": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "int",
            "bool",
            "time"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "field",
        "key",
        "type"
      ]
    },
    "JanitorContribution": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$"
        },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "name",
        "package",
        "handler"
      ],
      "type": "object"
    },
    "JobContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$"
        },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "schedulable": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "package",
        "handler",
        "schedulable",
        "max_attempts"
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claims": {
          "$ref": "#/$defs/NamespaceClaims"
        },
        "contract": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataDeclaration"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentationRef"
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvironmentVariable"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestFile"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "element",
            "component",
            "page",
            "workflow",
            "system"
          ]
        },
        "locales": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestMigration"
          }
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "openapi": {
          "$ref": "#/$defs/OpenAPIContribution"
        },
        "personas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonaContribution"
          }
        },
        "removal_policy": {
          "type": "string",
          "enum": [
            "free",
            "retain-data",
            "drain-required",
            "replacement-required",
            "major-version-only"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "contract": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "min",
                  "max"
                ]
              }
            },
            "required": [
              "id",
              "contract"
            ]
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeContributions"
        },
        "test_only": {
          "type": "boolean"
        },
        "tests": {
          "$ref": "#/$defs/TestMetadata"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "vendors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VendorArtifact"
          }
        },
        "dependencies": {
          "$ref": "#/$defs/Dependencies"
        }
      },
      "required": [
        "files",
        "id",
        "kind",
        "name",
        "revision",
        "contract",
        "title",
        "description",
        "requires",
        "dependencies",
        "claims",
        "runtime",
        "migrations",
        "environment",
        "docs",
        "tests",
        "data",
        "removal_policy"
      ]
    },
    "ManifestFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
        },
        "target": {
          "type": "string",
          "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
        },
        "class": {
          "type": "string",
          "enum": [
            "go",
            "templ",
            "style",
            "script",
            "asset",
            "query",
            "migration",
            "i18n",
            "content",
            "seed",
            "docs",
            "test",
            "openapi"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rewrite_module": {
          "type": "boolean"
        },
        "contract": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "target",
        "class",
        "sha256",
        "rewrite_module",
        "contract"
      ]
    },
    "ManifestMigration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "immutable",
            "neutralize",
            "purge"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "sha256"
      ]
    },
    "ModuleDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "module": {
          "$ref": "#/$defs/Manifest"
        }
      },
      "required": [
        "schema",
        "module"
      ]
    },
    "NamespaceClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "i18n": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "openapi": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "content_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provider_slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provisioners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "database_ops": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cli": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "deploy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": []
    },
    "NavigationContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "area": {
          "type": "string",
          "enum": [
            "public",
            "app",
            "admin",
            "footer",
            "settings"
          ]
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^/"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label_key": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "pattern": "^/"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "area",
        "id",
        "label_key"
      ]
    },
    "OpenAPIContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "info": {
          "type": "object"
        },
        "servers": {
          "type": "array"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenAPITag"
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenAPIOperation"
          }
        }
      }
    },
    "OpenAPIOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameters": {
          "type": "array"
        },
        "request_body": {
          "type": "object"
        },
        "responses": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "operation_id",
        "responses",
        "route_id",
        "summary"
      ]
    },
    "OpenAPITag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "PersonaContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "org": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "org",
        "role",
        "user"
      ]
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/profile/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "const": "profile"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "required_provider_slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provider_defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "default_deployment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "revision",
        "contract",
        "title",
        "description",
        "members",
        "required_provider_slots",
        "provider_defaults",
        "default_deployment"
      ]
    },
    "ProfileDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 2
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        }
