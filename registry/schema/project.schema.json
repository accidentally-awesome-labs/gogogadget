{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "$ref": "#/$defs/Project",
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "registry": {
          "$ref": "#/$defs/ProjectRegistry"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:element|component|page|workflow|system|profile)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "registry",
        "modules",
        "exclude"
      ]
    },
    "ProjectRegistry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "ref"
      ]
    }
  }
}
