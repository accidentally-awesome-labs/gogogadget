{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "$ref": "#/$defs/Project",
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "const": 2
        },
        "registries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectRegistry"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:element|component|page|workflow|system|profile)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProjectProviderSelections"
          }
        },
        "deployment": {
          "type": "string",
          "pattern": "^(?:$|[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?:element|component|page|workflow|system)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
        }
      },
      "required": [
        "schema",
        "registries",
        "modules",
        "exclude",
        "providers",
        "deployment"
      ]
    },
    "ProjectRegistry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source": {
          "type": "string",
          "enum": [
            "github",
            "directory"
          ]
        },
        "repository": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "public_key": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "source"
      ]
    },
    "ProjectProviderSelections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "development": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "adapter",
            "target"
          ]
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "adapter",
            "target"
          ]
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "adapter",
            "target"
          ]
        }
      },
      "required": [
        "development",
        "test",
        "production"
      ]
    }
  }
}
