{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "registry": { "$ref": "registry.schema.json#/$defs/RegistryRoot" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*(?:/\\.{0,2}[A-Za-z0-9_~+@-][A-Za-z0-9._~+@-]*)*$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["path", "sha256"]
      },
      "uniqueItems": true
    }
  },
  "required": ["schema", "registry", "files"]
}
