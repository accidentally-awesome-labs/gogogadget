{
  "schema": 1,
  "module": {
    "id": "system/metrics",
    "kind": "system",
    "name": "metrics",
    "revision": 1,
    "contract": 1,
    "title": "Runtime metrics endpoint",
    "description": "The bearer-gated /metrics endpoint. Production refuses to expose it without a token, because Go runtime stats must not be public by default.",
    "requires": [
      "system/server"
    ],
    "files": [
      {
        "source": "internal/web/metrics.go",
        "target": "internal/web/metrics.go",
        "class": "go",
        "sha256": "c31bc493cdb80784bbdc39e15866842325bee2fdac0f64b48aab449a5463cff9",
        "rewrite_module": true,
        "contract": true
      }
    ],
    "claims": {
      "routes": [
        "metrics.scrape"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "metrics.scrape",
          "method": "GET",
          "pattern": "/metrics",
          "scope": "probe",
          "policy": {
            "csrf_exempt": true,
            "csrf_reason": "unauthenticated liveness probe with no session and no side effects",
            "rate_exempt": true,
            "maintenance_exempt": true,
            "max_body_bytes": 0,
            "idempotent": false,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handleMetrics",
          "enabled": "metricsEnabled"
        }
      ]
    },
    "migrations": [],
    "environment": [
      {
        "key": "METRICS_TOKEN",
        "field": "MetricsToken",
        "type": "string",
        "description": "Bearer token for `GET /metrics`. Empty outside production leaves the scrape open; empty in production leaves the route unregistered, so internal stats are never public by default",
        "secret": true
      }
    ],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "free"
  }
}
