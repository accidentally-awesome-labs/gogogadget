    "environment": [
      {
        "key": "POLAR_ACCESS_TOKEN",
        "field": "PolarAccessToken",
        "type": "string",
        "description": "Polar API token. Empty means billing routes render 503 not-configured",
        "secret": true
      },
      {
        "key": "POLAR_PRODUCT_PRO",
        "field": "PolarProductPro",
        "type": "string",
        "description": "Polar product id for the Pro plan"
      },
      {
        "key": "POLAR_PRODUCT_TEAM",
        "field": "PolarProductTeam",
        "type": "string",
        "description": "Polar product id for the Team plan"
      },
      {
        "key": "POLAR_SERVER",
        "field": "PolarServer",
        "type": "string",
        "description": "sandbox | production",
        "default": "sandbox",
        "enum": [
          "sandbox",
          "production"
        ]
      },
      {
        "key": "POLAR_WEBHOOK_SECRET",
        "field": "PolarWebhookSecret",
        "type": "string",
        "description": "Verifies `webhook-*` signatures on `/webhooks/polar`",
        "secret": true
      }
    ],
