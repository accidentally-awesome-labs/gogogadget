    "environment": [
      {
        "key": "ADMIN_EMAIL",
        "field": "AdminEmail",
        "type": "string",
        "description": "First sign-in with this address is granted the full admin role. Empty means nobody is staff"
      },
      {
        "key": "CLERK_FRONTEND_API_URL",
        "field": "ClerkFrontendAPIURL",
        "type": "string",
        "description": "Clerk Frontend API origin, which feeds the CSP `connect-src`. Derived from APP_URL when unset: `https://clerk.<host>` in production, the Clerk dev wildcard otherwise"
      },
      {
        "key": "CLERK_PORTAL_URL",
        "field": "ClerkPortalURL",
        "type": "string",
        "description": "Hosted Account Portal base, e.g. `https://accounts.your-app.com`",
        "trim_slash": true,
        "production_required": true
      },
      {
        "key": "CLERK_PUBLISHABLE_KEY",
        "field": "ClerkPublishableKey",
        "type": "string",
        "description": "Drives the vendored clerk-js that keeps the `__session` JWT fresh",
        "production_required": true
      },
      {
        "key": "CLERK_SECRET_KEY",
        "field": "ClerkSecretKey",
        "type": "string",
        "description": "Clerk API secret. Empty means auth is not configured and `/app` renders 503 (unless the dev bypass is on)",
        "production_required": true,
        "secret": true
      },
      {
        "key": "CLERK_WEBHOOK_SECRET",
        "field": "ClerkWebhookSecret",
        "type": "string",
        "description": "Verifies `svix-*` signatures on `/webhooks/clerk`",
        "production_required": true,
        "secret": true
      },
      {
        "key": "DEV_AUTH_BYPASS",
        "field": "DevAuthBypass",
        "type": "bool",
        "description": "Enables synthetic `e2e:` session tokens. true with APP_ENV=production is a hard boot error",
        "default": "false",
        "example": "true"
      }
    ],
