    "runtime": {
      "system": {
        "package": "internal/database/postgres",
        "constructor": "NewModule",
        "needs": [
          {
            "field": "Config",
            "capability": "config",
            "type": "*config.Config",
            "optional": false
          },
          {
            "field": "Telemetry",
            "capability": "telemetry.providers",
            "type": "telemetry.Providers",
            "optional": true
          }
        ],
        "provides": [
          {
            "field": "Pool",
            "capability": "database.pool",
            "type": "*pgxpool.Pool"
          },
          {
            "field": "Queries",
            "capability": "database.queries",
            "type": "*sqlc.Queries"
          }
        ],
        "type_imports": [
          "github.com/jackc/pgx/v5/pgxpool",
          "internal/config",
          "internal/db/sqlc",
          "internal/telemetry"
        ],
        "start": false,
        "stop": true,
        "health": true,
        "adapter": {
          "slot": "ggg/database",
          "targets": [
            {
              "id": "docker-postgres",
              "title": "Docker Postgres",
              "mode": "self-hosted",
              "environments": [
                "development",
                "test"
              ],
              "automation": "manual",
              "docs_url": "https://gogogadget.dev/docs/providers/docker-postgres",
              "inputs": [],
              "local_service": {
                "container": "postgres@sha256:16bc17c64a573ef34162af9298258d1aec548232985b33ed7b1eac33ba35c229",
                "ports": [
                  {
                    "name": "postgres",
                    "container": 5432,
                    "default_host": 5432
                  }
                ],
                "environment": [
                  {
                    "key": "POSTGRES_USER",
                    "value": "postgres"
                  },
                  {
                    "key": "POSTGRES_PASSWORD",
                    "value": "postgres"
                  },
                  {
                    "key": "POSTGRES_DB",
                    "value": "gogogadget"
                  }
                ],
                "volumes": [
                  {
                    "name": "data",
                    "target": "/var/lib/postgresql/data"
                  }
                ],
                "health": {
                  "kind": "tcp",
                  "port": 5432,
                  "command": "pg_isready -U postgres"
                }
              },
              "database_operator": "docker_operator"
            },
            {
              "id": "neon",
              "title": "Neon",
              "mode": "managed",
              "environments": [
                "production"
              ],
              "automation": "provision",
              "docs_url": "https://gogogadget.dev/docs/providers/neon",
              "console_url": "https://console.neon.tech",
              "inputs": [
                {
                  "key": "project_id",
                  "env_key": "NEON_PROJECT_ID",
                  "label": "Existing Neon project id (leave unset to provision one)",
                  "type": "string",
                  "required": false,
                  "secret": false
                },
                {
                  "key": "api_key",
                  "env_key": "NEON_API_KEY",
                  "label": "Neon API key",
                  "type": "string",
                  "required": true,
                  "secret": true
                }
              ],
              "provisioner": "neon_provisioner"
            }
          ]
        }
      },
      "provisioners": [
        {
          "id": "neon_provisioner",
          "package": "internal/provision/neon",
          "constructor": "NewProvisioner"
        }
      ],
      "database_ops": [
        {
          "id": "docker_operator",
          "package": "internal/database/ops/docker",
          "constructor": "NewOperator"
        }
      ]
