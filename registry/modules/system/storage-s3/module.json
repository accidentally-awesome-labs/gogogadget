{
  "schema": 2,
  "module": {
    "id": "ggg/system/storage-s3",
    "kind": "system",
    "name": "storage-s3",
    "revision": 1,
    "contract": 1,
    "title": "S3-compatible storage",
    "description": "S3-compatible object storage with MinIO self-hosting and Cloudflare R2 managed targets.",
    "requires": [
      {
        "id": "ggg/system/apphost",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/config",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/storage",
        "contract": {
          "min": 1,
          "max": 1
        }
      }
    ],
    "dependencies": {
      "go": [
        {
          "module": "github.com/aws/aws-sdk-go-v2/config",
          "version": "v1.32.37"
        },
        {
          "module": "github.com/aws/aws-sdk-go-v2/credentials",
          "version": "v1.19.36"
        },
        {
          "module": "github.com/aws/aws-sdk-go-v2/service/s3",
          "version": "v1.107.2"
        },
        {
          "module": "github.com/stretchr/testify",
          "version": "v1.11.1"
        }
      ],
      "tools": [],
      "containers": []
    },
    "files": [
      {
        "source": "internal/storage/s3/contract_test.go",
        "target": "internal/storage/s3/contract_test.go",
        "class": "test",
        "sha256": "79c7c8fb4cb251423e6543b452b44ece8daae242c3860292d4ad87d411a34187",
        "rewrite_module": true,
        "contract": false
      },
      {
        "source": "internal/storage/s3/module.go",
        "target": "internal/storage/s3/module.go",
        "class": "go",
        "sha256": "888e4f17a6bec4537783637d262662136429247f52f5e1cc006d25af64b68768",
        "rewrite_module": true,
        "contract": true
      },
      {
        "source": "internal/storage/s3/protocol_test.go",
        "target": "internal/storage/s3/protocol_test.go",
        "class": "test",
        "sha256": "23b4c4c961ec08fd847ddd4baf19452cc0f3453ce2ae03a04bba93deeadbecfa",
        "rewrite_module": true,
        "contract": false
      },
      {
        "source": "internal/storage/s3/r2.go",
        "target": "internal/storage/s3/r2.go",
        "class": "go",
        "sha256": "bd007c437eb78f6466f78f358d39926111c1defcc3d2b49440992e119c9d2400",
        "rewrite_module": true,
        "contract": true
      }
    ],
    "claims": {
      "packages": [
        "internal/storage/s3"
      ]
    },
    "runtime": {
      "system": {
        "package": "internal/storage/s3",
        "constructor": "NewModule",
        "needs": [
          {
            "field": "Config",
            "capability": "config",
            "type": "*config.Config",
            "optional": false
          }
        ],
        "provides": [
          {
            "field": "Store",
            "capability": "storage.store",
            "type": "storage.Store"
          }
        ],
        "type_imports": [
          "internal/storage"
        ],
        "start": false,
        "stop": false,
        "health": true,
        "adapter": {
          "slot": "ggg/storage",
          "targets": [
            {
              "id": "minio",
              "title": "MinIO",
              "mode": "self-hosted",
              "environments": [
                "development",
                "test"
              ],
              "automation": "manual",
              "docs_url": "https://min.io/docs",
              "inputs": [],
              "local_service": {
                "container": "minio/minio:RELEASE.2024-06-29T01-20-47Z",
                "ports": [
                  {
                    "name": "api",
                    "container": 9000,
                    "default_host": 9000
                  },
                  {
                    "name": "console",
                    "container": 9001,
                    "default_host": 9001
                  }
                ],
                "environment": [
                  {
                    "key": "MINIO_ROOT_USER",
                    "value": "minioadmin"
                  },
                  {
                    "key": "MINIO_ROOT_PASSWORD",
                    "value": "minioadmin"
                  }
                ],
                "volumes": [
                  {
                    "name": "minio-data",
                    "target": "/data"
                  }
                ],
                "health": {
                  "kind": "http",
                  "port": 9000,
                  "path": "/minio/health/live"
                }
              }
            },
            {
              "id": "r2",
              "title": "Cloudflare R2",
              "mode": "managed",
              "environments": [
                "production"
              ],
              "automation": "manual",
              "docs_url": "https://developers.cloudflare.com/r2/",
              "console_url": "https://dash.cloudflare.com/",
              "inputs": []
            }
          ]
        }
      }
    },
    "migrations": [],
    "environment": [
      {
        "key": "STORAGE_R2_ACCESS_KEY_ID",
        "field": "StorageR2AccessKeyID",
        "type": "string",
        "description": "S3 access key id",
        "required": true,
        "secret": true,
        "targets": [
          "ggg/system/storage-s3@minio",
          "ggg/system/storage-s3@r2"
        ]
      },
      {
        "key": "STORAGE_R2_ACCOUNT_ID",
        "field": "StorageR2AccountID",
        "type": "string",
        "description": "R2 account id used for the default endpoint",
        "required": true,
        "targets": [
          "ggg/system/storage-s3@r2"
        ]
      },
      {
        "key": "STORAGE_R2_BUCKET",
        "field": "StorageR2Bucket",
        "type": "string",
        "description": "S3 bucket name",
        "required": true,
        "targets": [
          "ggg/system/storage-s3@minio",
          "ggg/system/storage-s3@r2"
        ]
      },
      {
        "key": "STORAGE_R2_SECRET_ACCESS_KEY",
        "field": "StorageR2SecretAccessKey",
        "type": "string",
        "description": "S3 secret access key",
        "required": true,
        "secret": true,
        "targets": [
          "ggg/system/storage-s3@minio",
          "ggg/system/storage-s3@r2"
        ]
      },
      {
        "key": "STORAGE_S3_ENDPOINT",
        "field": "StorageS3Endpoint",
        "type": "string",
        "description": "S3-compatible endpoint override; empty uses the R2 account endpoint",
        "targets": [
          "ggg/system/storage-s3@minio",
          "ggg/system/storage-s3@r2"
        ]
      }
    ],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/storage/s3"
      ]
    },
    "data": [],
    "removal_policy": "retain-data"
  }
}
