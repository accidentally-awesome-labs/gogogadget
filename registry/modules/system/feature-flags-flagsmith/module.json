{
  "schema": 2,
  "module": {
    "id": "ggg/system/feature-flags-flagsmith",
    "kind": "system",
    "name": "feature-flags-flagsmith",
    "revision": 2,
    "contract": 1,
    "title": "Feature Flags Flagsmith",
    "description": "Managed feature flags through Flagsmith's Flags API and Management API. Replaces feature-flags-launchdarkly: every flags.Service method is satisfiable over a documented HTTP contract in which Flagsmith performs the decision, with no vendored SDK and no reimplementation of vendor targeting.",
    "requires": [
      {
        "id": "ggg/system/feature-flags",
        "contract": {
          "min": 1,
          "max": 1
        }
      }
    ],
    "dependencies": {
      "go": [
        {
          "module": "github.com/stretchr/testify",
          "version": "v1.11.1"
        }
      ],
      "tools": [],
      "containers": []
    },
    "files": [
      {
        "source": "internal/flags/flagsmith/flagsmith.go",
        "target": "internal/flags/flagsmith/flagsmith.go",
        "class": "go",
        "sha256": "0baf061d05195b98b03bd7f3a7c2003880c92b09a66400911a32bcf9c3247536",
        "rewrite_module": true,
        "contract": true
      },
      {
        "source": "internal/flags/flagsmith/flagsmith_test.go",
        "target": "internal/flags/flagsmith/flagsmith_test.go",
        "class": "test",
        "sha256": "fdfdce4a71fd6456c971f280ed4afa5208ca74ec8c797c85f0e1740847360290",
        "rewrite_module": true,
        "contract": false
      }
    ],
    "claims": {
      "packages": [
        "internal/flags/flagsmith"
      ]
    },
    "runtime": {
      "system": {
        "package": "internal/flags/flagsmith",
        "constructor": "NewModule",
        "needs": [
          {
            "field": "Cache",
            "capability": "cache.store",
            "type": "cache.Store",
            "optional": false
          }
        ],
        "provides": [
          {
            "field": "Value",
            "capability": "flags.service",
            "type": "flags.Service"
          }
        ],
        "type_imports": [
          "internal/cache",
          "internal/flags"
        ],
        "start": false,
        "stop": false,
        "health": true,
        "adapter": {
          "slot": "ggg/feature-flags",
          "targets": [
            {
              "id": "flagsmith",
              "title": "Flagsmith",
              "mode": "managed",
              "environments": [
                "production"
              ],
              "automation": "manual",
              "docs_url": "https://docs.flagsmith.com/integrating-with-flagsmith/flagsmith-api-overview",
              "console_url": "https://app.flagsmith.com/",
              "inputs": [
                {
                  "key": "environment_key",
                  "env_key": "FLAGSMITH_ENVIRONMENT_KEY",
                  "label": "Environment Key (public, Flags API; Flagsmith documents it as non-secret and safe in client-side code)",
                  "type": "string",
                  "required": true,
                  "secret": false
                },
                {
                  "key": "management_token",
                  "env_key": "FLAGSMITH_MANAGEMENT_TOKEN",
                  "label": "Organisation API token (secret, Management API; sent as `Authorization: Api-Key \u003ctoken\u003e`)",
                  "type": "string",
                  "required": true,
                  "secret": true
                },
                {
                  "key": "project_id",
                  "env_key": "FLAGSMITH_PROJECT_ID",
                  "label": "Numeric Flagsmith project id (features are project-scoped)",
                  "type": "integer",
                  "required": true,
                  "secret": false
                },
                {
                  "key": "environment_id",
                  "env_key": "FLAGSMITH_ENVIRONMENT_ID",
                  "label": "Numeric Flagsmith environment id (feature states are environment-scoped)",
                  "type": "integer",
                  "required": true,
                  "secret": false
                },
                {
                  "key": "api_url",
                  "env_key": "FLAGSMITH_API_URL",
                  "label": "Management API base URL; empty uses Flagsmith SaaS. Set this and flags_api_url to one host to point at a self-hosted Flagsmith",
                  "type": "string",
                  "required": false,
                  "secret": false
                },
                {
                  "key": "flags_api_url",
                  "env_key": "FLAGSMITH_FLAGS_API_URL",
                  "label": "Flags API base URL; empty uses the Flagsmith SaaS edge host",
                  "type": "string",
                  "required": false,
                  "secret": false
                }
              ]
            }
          ]
        }
      }
    },
    "migrations": [],
    "environment": [
      {
        "key": "FLAGSMITH_API_URL",
        "field": "FlagsmithAPIURL",
        "type": "string",
        "description": "Flagsmith Management API base URL; empty uses https://api.flagsmith.com",
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_CONSOLE",
        "field": "FlagsmithConsole",
        "type": "string",
        "description": "Flagsmith console URL surfaced by the admin flags page; empty hides the link",
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_ENVIRONMENT_ID",
        "field": "FlagsmithEnvironmentID",
        "type": "int",
        "description": "Numeric Flagsmith environment id the Management API scopes feature states to",
        "required": true,
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_ENVIRONMENT_KEY",
        "field": "FlagsmithEnvironmentKey",
        "type": "string",
        "description": "Public Environment Key sent as X-Environment-Key on the Flags API; Flagsmith documents it as non-secret and exposable in client-side code",
        "required": true,
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_FLAGS_API_URL",
        "field": "FlagsmithFlagsAPIURL",
        "type": "string",
        "description": "Flagsmith Flags API base URL; empty uses https://edge.api.flagsmith.com",
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_MANAGEMENT_TOKEN",
        "field": "FlagsmithManagementToken",
        "type": "string",
        "description": "Secret Flagsmith organisation API token authorising every Management API mutation",
        "required": true,
        "secret": true,
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      },
      {
        "key": "FLAGSMITH_PROJECT_ID",
        "field": "FlagsmithProjectID",
        "type": "int",
        "description": "Numeric Flagsmith project id the Management API scopes features to",
        "required": true,
        "targets": [
          "ggg/system/feature-flags-flagsmith@flagsmith"
        ]
      }
    ],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/flags/flagsmith"
      ]
    },
    "data": [],
    "removal_policy": "free"
  }
}
