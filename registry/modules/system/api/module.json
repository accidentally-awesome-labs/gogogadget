          "name": "idempotency_keys",
          "package": "internal/jobs",
          "handler": "janitorIdempotencyKeys"
        }
      ],
      "queries": [
        {
          "name": "ClaimIdempotencyKey",
          "table": "idempotency_keys"
        },
        {
          "name": "CompleteIdempotencyKey",
