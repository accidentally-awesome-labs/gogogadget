      {
        "id": "0015_idempotency_keys",
        "kind": "immutable",
        "source": "internal/db/migrations/0015_idempotency_keys.sql",
        "sha256": "d17a465e02a1ef405ff50a8c93294d3035631ca637296a9e09d9cff67c4397b4"
      }
    ],
    "environment": [
      {
        "key": "API_RATE_LIMIT_RPM",
        "field": "APIRateLimitPerMinute",
        "type": "int",
        "description": "Per-API-token request budget per minute (burst is 2x) on `/api/v1`. Independent of the per-IP shield because a token survives NAT and roaming, and can be rotated",
        "default": "60",
        "min": 1
      }
    ],
    "openapi": {
      "components": {
        "responses": {
          "Forbidden": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The token's scope cannot perform this operation (`forbidden`)."
          },
          "IdempotencyConflict": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The key was already used for a different request (`idempotency_conflict`),\nor an earlier request with this key is still running\n(`idempotency_in_progress`). Neither case executes the operation.\n"
          },
          "InternalError": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Something failed server-side (`internal_error`)."
          },
          "InvalidJSON": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The body is not valid JSON for this endpoint (`invalid_json`)."
          },
          "PlanLimit": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The organization's plan limit or meter cap was reached (`plan_limit`)."
          },
          "RateLimited": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The token exceeded its per-token request budget (`rate_limited`).\nBudgets are per API token, not per IP, so one token cannot spend\nanother's allowance. Honour `Retry-After`.\n",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "Unauthorized": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing, malformed, unknown, revoked, or expired token (`unauthorized`)."
          },
          "ValidationError": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request parsed but failed validation (`validation_error`)."
          }
        },
        "schemas": {
          "Error": {
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "description": "Stable machine-readable code; the message is for humans and may change.",
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "type": "object"
              }
            },
            "required": [
              "error"
            ],
            "type": "object"
          }
        }
      }
    },
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/api"
      ]
    },
    "data": [
      {
        "table": "api_tokens",
        "scope": "org",
        "export": true,
        "secret_redaction_owner": "system/api",
        "account_delete": "retain",
        "organization_delete": "cascade"
      },
      {
        "table": "idempotency_keys",
        "scope": "org",
        "export": false,
        "account_delete": "retain",
        "organization_delete": "cascade"
      }
    ],
    "removal_policy": "major-version-only"
  }
}
