{
  "schema": 1,
  "module": {
    "id": "system/config",
    "kind": "system",
    "name": "config",
    "revision": 1,
    "contract": 1,
    "title": "Configuration",
    "description": "Environment parsing and validation. Reads through the host seam so a runtime can boot against a fixed environment.",
    "requires": [
      "system/apphost"
    ],
    "files": [
      {
        "source": "internal/config/config.go",
        "target": "internal/config/config.go",
        "class": "go",
        "sha256": "75600d2183674de895f57436585613839fefb76fe5e99d6d9119946157fb5ae0",
        "rewrite_module": true,
        "contract": true
      },
      {
        "source": "internal/config/module.go",
        "target": "internal/config/module.go",
        "class": "go",
        "sha256": "bf6b039b1173eb332cc2ebbde8cb3490a995ea13c69e57ed844c68527be674cc",
        "rewrite_module": true,
        "contract": true
      }
    ],
    "claims": {
      "packages": [
        "internal/config"
      ]
    },
    "runtime": {
      "system": {
        "package": "internal/config",
        "constructor": "NewModule",
        "needs": [],
        "provides": [
          {
            "field": "Config",
            "capability": "config",
            "type": "*config.Config"
          }
        ],
        "start": false,
        "stop": false
      }
    },
    "migrations": [],
    "environment": [
      {
        "key": "APP_ENV",
        "field": "Env",
        "type": "string",
        "description": "development | test | production",
        "default": "development",
        "enum": [
          "development",
          "test",
          "production"
        ]
      },
      {
        "key": "APP_URL",
        "field": "AppURL",
        "type": "string",
        "description": "Public base URL used in emails and webhook links",
        "default": "http://localhost:8080",
        "trim_slash": true
      },
      {
        "key": "LOG_LEVEL",
        "field": "LogLevel",
        "type": "string",
        "description": "debug | info | warn | error (default: debug in development, info otherwise)"
      },
      {
        "key": "TEST_NOW",
        "field": "testNow",
        "type": "time",
        "description": "RFC3339 instant that freezes the render clock; honored only when APP_ENV=test"
      }
    ],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/config"
      ]
    },
    "data": [],
    "removal_policy": "replacement-required"
  }
