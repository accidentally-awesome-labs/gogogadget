{
  "schema": 1,
  "module": {
    "id": "workflow/identity-webhook-sync",
    "kind": "workflow",
    "name": "identity-webhook-sync",
    "revision": 1,
    "contract": 1,
    "title": "Identity provider sync",
    "description": "Receives Clerk user and organization events and mirrors them into the local tables.",
    "requires": [
      "system/identity",
      "system/organizations",
      "system/server"
    ],
    "files": [
      {
        "source": "internal/web/handlers_webhooks.go",
        "target": "internal/web/handlers_webhooks.go",
        "class": "go",
        "sha256": "af0feb48f509a15ee2751bea3aa18cf61217bb215b72b380b70389222965c50a",
        "rewrite_module": true,
        "contract": false
      }
    ],
    "claims": {
      "routes": [
        "identity.webhook.receive"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "identity.webhook.receive",
          "method": "POST",
          "pattern": "/webhooks/clerk",
          "scope": "webhook",
          "policy": {
            "csrf_exempt": true,
            "csrf_reason": "svix signature verified with CLERK_WEBHOOK_SECRET; not a browser form",
            "rate_exempt": false,
            "maintenance_exempt": true,
            "max_body_bytes": 1048576,
            "idempotent": true,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handleClerkWebhook"
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "free"
  }
}
