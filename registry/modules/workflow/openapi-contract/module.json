{
  "schema": 2,
  "module": {
    "id": "ggg/workflow/openapi-contract",
    "kind": "workflow",
    "name": "openapi-contract",
    "revision": 1,
    "contract": 1,
    "title": "OpenAPI description",
    "description": "Serves the generated OpenAPI description of the JSON API.",
    "requires": [
      {
        "id": "ggg/system/api",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/server",
        "contract": {
          "min": 1,
          "max": 1
        }
      }
    ],
    "dependencies": {
      "go": [
        {
          "module": "github.com/stretchr/testify",
          "version": "v1.11.1"
        },
        {
          "module": "gopkg.in/yaml.v3",
          "version": "v3.0.1"
        }
      ],
      "tools": [],
      "containers": []
    },
    "files": [
      {
        "source": "internal/web/api_transport.go",
        "target": "internal/web/api_transport.go",
        "class": "go",
        "sha256": "607bdab7b60857d5771444747f2cf6994e03208cf538d74f4dbcdb400c845b81",
        "rewrite_module": true,
        "contract": false
      },
      {
        "source": "internal/web/openapi_test.go",
        "target": "internal/web/openapi_test.go",
        "class": "test",
        "sha256": "98918883dd4bd52e5ea06e558642e10bc449d8db0a79d61e6283dcee6a1c5615",
        "rewrite_module": true,
        "contract": false
      }
    ],
    "claims": {
      "routes": [
        "api.openapi"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "api.openapi",
          "method": "GET",
          "pattern": "/api/v1/openapi.yaml",
          "scope": "public",
          "policy": {
            "csrf_exempt": true,
            "csrf_reason": "public contract document; a client needs it before it has a token",
            "rate_exempt": false,
            "maintenance_exempt": true,
            "max_body_bytes": 0,
            "idempotent": false,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handleAPIOpenAPISpec"
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "openapi": {
      "info": {
        "description": "The second transport. Every rule the HTML app enforces (plan limits,\nvalidation, org scoping) applies identically here \u2014 the handlers share\nthe same query layer and plan logic, they only differ in how they answer.\n\nAuthentication is a Bearer token minted at `/app/settings/api`\n(`ggg_\u2026`, SHA-256 hashed at rest, shown once). Tokens carry a scope:\n`read` satisfies read operations, `write` satisfies both.\n\nThe token determines the organization \u2014 there is no org parameter, and a\ntoken can never read another org's rows.\n",
        "license": {
          "name": "MIT"
        },
        "summary": "Bearer-authenticated JSON API for projects and metered AI chat.",
        "title": "GoGoGadget API",
        "version": "1.0.0"
      },
      "servers": [
        {
          "description": "Same origin as the app.",
          "url": "/"
        }
      ],
      "tags": [
        {
          "name": "meta",
          "description": "Machine-readable description of this API."
        }
      ],
      "operations": [
        {
          "route_id": "api.openapi",
          "operation_id": "getOpenAPISpec",
          "summary": "This document.",
          "description": "Unauthenticated so tooling can fetch the contract before holding a token.",
          "tags": [
            "meta"
          ],
          "responses": {
            "200": {
              "content": {
                "application/yaml": {
                  "schema": {
                    "type": "string"
                  }
                }
              },
              "description": "The OpenAPI document."
            }
          }
        }
      ]
    },
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "free"
  }
}
