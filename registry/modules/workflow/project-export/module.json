    "kind": "workflow",
    "name": "project-export",
    "revision": 1,
    "contract": 1,
    "title": "Project CSV export",
    "description": "Enqueues the background projects-CSV export job and audits the request; the resulting notification carries the download link.",
    "requires": [
      "system/audit",
      "system/i18n",
      "system/identity",
      "system/jobs",
      "system/security",
      "system/server"
    ],
    "files": [
      {
