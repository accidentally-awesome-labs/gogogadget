          "kind": "export.projects_csv",
          "package": "internal/jobs",
          "handler": "defineExportProjectsCSV",
          "schedulable": false,
          "max_attempts": 0
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
