{
  "schema": 1,
  "module": {
    "id": "workflow/api-ai-chat",
    "kind": "workflow",
    "name": "api-ai-chat",
    "revision": 1,
    "contract": 1,
    "title": "AI chat API",
    "description": "The JSON API for model completions, behind bearer-token auth.",
    "requires": [
      "system/api",
      "system/llm",
      "system/server",
      "workflow/openapi-contract"
    ],
    "files": [],
    "claims": {
      "routes": [
        "api.ai.chat"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "api.ai.chat",
          "method": "POST",
          "pattern": "/api/v1/ai/chat",
          "scope": "api-write",
          "policy": {
            "csrf_exempt": true,
            "csrf_reason": "cookieless transport: authenticated by Bearer token, not a browser session",
            "rate_exempt": false,
            "maintenance_exempt": false,
            "max_body_bytes": 131072,
            "idempotent": true,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handleAPIAIChat"
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "free",
    "openapi": {
      "tags": [
        {
          "name": "ai",
          "description": "Metered LLM chat (usage counts against the plan's ai_tokens meter)."
        }
      ],
      "components": {
        "schemas": {
          "ChatMessage": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        }
      },
      "operations": [
        {
          "route_id": "api.ai.chat",
          "operation_id": "chatCompletion",
          "summary": "Chat completion, metered against the plan.",
          "responses": {
            "200": {
              "description": "The completion.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "content",
                      "usage"
                    ],
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "usage": {
                        "type": "object",
                        "required": [
                          "prompt_tokens",
                          "completion_tokens"
                        ],
                        "properties": {
                          "prompt_tokens": {
                            "type": "integer"
                          },
                          "completion_tokens": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "$ref": "#/components/responses/InvalidJSON"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "402": {
              "$ref": "#/components/responses/PlanLimit"
            },
            "403": {
              "$ref": "#/components/responses/Forbidden"
            },
            "422": {
              "$ref": "#/components/responses/ValidationError"
            },
            "409": {
              "$ref": "#/components/responses/IdempotencyConflict"
            },
            "429": {
              "$ref": "#/components/responses/RateLimited"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            },
            "502": {
              "description": "The upstream AI backend failed (`upstream_error`).",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            },
            "503": {
              "description": "No AI backend configured (`not_configured`).",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              }
            }
          },
          "description": "Requires the `write` scope. Token usage is recorded per organization\nand counted against the plan's `ai_tokens` meter; crossing the cap\nfails with 402 `plan_limit`. With no LLM backend configured the\nendpoint answers 503 `not_configured` instead of pretending.\n",
          "tags": [
            "ai"
          ],
          "request_body": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "messages"
                  ],
                  "properties": {
                    "messages": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "$ref": "#/components/schemas/ChatMessage"
                      }
                    },
                    "max_tokens": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Upper bound for the completion; also feeds the pre-flight meter estimate.",
                      "examples": [
                        512
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
