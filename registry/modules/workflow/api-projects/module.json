      ]
    },
    "contract": 1,
    "data": [],
    "dependencies": {
      "containers": [],
      "go": [],
      "tools": []
    },
    "description": "The JSON API for listing and creating projects, behind bearer-token auth.",
    "docs": [],
    "environment": [],
    "files": [
      {
        "class": "test",
        "contract": false,
        "rewrite_module": true,
        "sha256": "e6adf3b0cfd0ec0dbe8b53c350ac6558eab17d0c564c223034155f50e0a73f35",
        "source": "internal/web/api_test.go",
        "target": "internal/web/api_test.go"
      }
    ],
    "id": "ggg/workflow/api-projects",
    "kind": "workflow",
    "migrations": [],
    "name": "api-projects",
    "openapi": {
      "components": {
        "schemas": {
          "Project": {
            "properties": {
              "clerk_org_id": {
                "description": "The organization the token belongs to.",
                "type": "string"
              },
              "created_at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "format": "int64",
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "active",
                  "archived"
                ],
                "type": "string"
              },
              "updated_at": {
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "id",
              "clerk_org_id",
              "name",
              "status",
              "created_at",
              "updated_at"
            ],
            "type": "object"
          }
        }
      },
      "operations": [
        {
          "description": "Newest first. Two pagination modes share one response shape:\n\n- **`cursor` (preferred)** \u2014 keyset paging. Follow `next_cursor` from\n  the previous response. Stable under concurrent writes: a cursor\n  names a row, so projects created while you page do not shift rows\n  across page boundaries, and depth costs nothing server-side.\n- **`offset` (legacy)** \u2014 the original contract, still honoured. It\n  repeats or drops rows when the set changes mid-walk.\n\n`next_cursor` is `null` on the last page. Cursors are opaque: echo\nthem back verbatim, never parse or construct them.\n",
          "operation_id": "listProjects",
          "parameters": [
            {
              "description": "Page size. Values outside 1\u2013100 fall back to the default.",
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "default": 50,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "description": "Opaque position from a previous response's `next_cursor`.\nTakes precedence over `offset`. A malformed value is rejected\nwith 400 rather than silently restarting at the first page.\n",
              "examples": {
                "page2": {
                  "value": "MTc3MjE1MzYwMDAwMDAwMDAwMC40Mg"
                }
              },
              "in": "query",
              "name": "cursor",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "deprecated": true,
              "description": "Legacy. Rows to skip; negative values are treated as 0. Ignored\nwhen `cursor` is supplied.\n",
              "in": "query",
              "name": "offset",
              "required": false,
              "schema": {
                "default": 0,
                "minimum": 0,
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "properties": {
                      "limit": {
                        "examples": [
                          50
                        ],
                        "type": "integer"
                      },
                      "next_cursor": {
                        "description": "Pass as `cursor` for the next page; null on the last page.",
                        "examples": [
                          "MTc3MjE1MzYwMDAwMDAwMDAwMC40Mg"
                        ],
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "offset": {
                        "examples": [
                          0
                        ],
                        "type": "integer"
                      },
                      "projects": {
                        "items": {
                          "$ref": "#/components/schemas/Project"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "projects",
                      "limit",
                      "offset",
                      "next_cursor"
                    ],
                    "type": "object"
                  }
                }
              },
              "description": "A page of projects."
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "The cursor is malformed (`invalid_cursor`)."
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "403": {
              "$ref": "#/components/responses/Forbidden"
            },
            "429": {
              "$ref": "#/components/responses/RateLimited"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          },
          "route_id": "api.projects.list",
          "summary": "List projects for the token's organization.",
          "tags": [
            "projects"
          ]
        },
        {
          "description": "Enforces the same plan limit as the UI: at the cap the call fails with\n402 `plan_limit` rather than silently succeeding.\n",
          "operation_id": "createProject",
          "request_body": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "name": {
                      "description": "Trimmed; required after trimming.",
                      "examples": [
                        "Launch checklist"
                      ],
                      "maxLength": 80,
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              },
              "description": "The created project."
            },
            "400": {
              "$ref": "#/components/responses/InvalidJSON"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "402": {
              "$ref": "#/components/responses/PlanLimit"
            },
            "403": {
              "$ref": "#/components/responses/Forbidden"
            },
            "409": {
              "$ref": "#/components/responses/IdempotencyConflict"
            },
            "422": {
              "$ref": "#/components/responses/ValidationError"
            },
            "429": {
              "$ref": "#/components/responses/RateLimited"
            },
            "500": {
              "$ref": "#/components/responses/InternalError"
            }
          },
          "route_id": "api.projects.create",
          "summary": "Create a project.",
          "tags": [
            "projects"
          ]
        }
      ],
      "tags": [
        {
          "description": "The canonical CRUD resource.",
          "name": "projects"
        }
      ]
    },
    "removal_policy": "free",
    "requires": [
      {
        "contract": {
          "max": 1,
          "min": 1
        },
        "id": "ggg/system/api"
      },
      {
        "contract": {
          "max": 1,
          "min": 1
        },
        "id": "ggg/system/server"
      },
      {
        "contract": {
          "max": 1,
          "min": 1
        },
        "id": "ggg/workflow/openapi-contract"
      }
    ],
    "revision": 1,
    "runtime": {
