{
  "schema": 2,
  "module": {
    "id": "ggg/workflow/billing-webhook",
    "kind": "workflow",
    "name": "billing-webhook",
    "revision": 1,
    "contract": 1,
    "title": "Billing provider webhook",
    "description": "Receives Polar subscription events, verifies the Standard Webhooks signature, and drives the subscription state machine.",
    "requires": [
      {
        "id": "ggg/system/billing",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/database",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/organizations",
        "contract": {
          "min": 1,
          "max": 1
        }
      },
      {
        "id": "ggg/system/server",
        "contract": {
          "min": 1,
          "max": 1
        }
      }
    ],
    "dependencies": {
      "go": [
        {
          "module": "github.com/jackc/pgx/v5",
          "version": "v5.10.0"
        },
        {
          "module": "github.com/standard-webhooks/standard-webhooks/libraries",
          "version": "v0.0.1"
        }
      ],
      "tools": [],
      "containers": []
    },
    "files": [
      {
        "source": "internal/web/workflow_billing_webhook.go",
        "target": "internal/web/workflow_billing_webhook.go",
        "class": "go",
        "sha256": "38a8f263d723a432f87deea66a484fa03a0cd859d6742cfb8d04b44583eaf276",
        "rewrite_module": true,
        "contract": true
      }
    ],
    "claims": {
      "routes": [
        "billing.webhook.receive"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "billing.webhook.receive",
          "method": "POST",
          "pattern": "/webhooks/polar",
          "scope": "webhook",
          "policy": {
            "csrf_exempt": true,
            "csrf_reason": "Standard Webhooks signature verified with POLAR_WEBHOOK_SECRET; not a browser form",
            "rate_exempt": false,
            "maintenance_exempt": true,
            "max_body_bytes": 1048576,
            "idempotent": true,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handlePolarWebhook"
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "major-version-only"
  }
}
