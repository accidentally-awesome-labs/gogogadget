{
  "schema": 1,
  "module": {
    "id": "page/docs",
    "kind": "page",
    "name": "docs",
    "revision": 1,
    "contract": 1,
    "title": "Documentation page",
    "description": "One rendered documentation page, versioned with the binary.",
    "requires": [
      "page/docs-index",
      "system/content-assets",
      "system/server"
    ],
    "files": [],
    "claims": {
      "routes": [
        "docs.show"
      ]
    },
    "runtime": {
      "routes": [
        {
          "id": "docs.show",
          "method": "GET",
          "pattern": "/docs/{slug}",
          "scope": "public",
          "policy": {
            "csrf_exempt": false,
            "csrf_reason": "",
            "rate_exempt": false,
            "maintenance_exempt": false,
            "max_body_bytes": 0,
            "idempotent": false,
            "admin_write": false
          },
          "package": "internal/web",
          "handler": "handleDocsPage"
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "free"
  }
}
