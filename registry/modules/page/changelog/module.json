{
  "schema": 1,
  "module": {
    "id": "page/changelog",
    "kind": "page",
    "name": "changelog",
    "revision": 1,
    "contract": 1,
    "title": "Changelog",
    "description": "The changelog, rendered as every release on one anchored page.",
    "requires": [
      "system/content",
      "system/content-assets",
      "system/i18n",
      "system/server"
    ],
    "files": [],
    "claims": {
      "content_types": [
        "release"
      ]
    },
    "runtime": {
      "content_types": [
        {
          "id": "release",
          "mode": "single",
          "paths": [
            "/changelog"
          ],
          "package": "internal/web",
          "handler": "handleContent"
        }
      ],
      "navigation": [
        {
          "id": "footer.company.changelog",
          "area": "footer",
          "group": "footer.company",
          "route_id": "content.release.index",
          "label_key": "footer.changelog",
          "before": [
            "footer.company.about"
          ],
          "after": [
            "footer.company.blog"
          ]
        },
        {
          "id": "nav.public.changelog",
          "area": "public",
          "route_id": "content.release.index",
          "label_key": "nav.changelog",
          "after": [
            "nav.public.docs"
          ]
        }
      ]
    },
    "migrations": [],
    "environment": [],
    "docs": [],
    "tests": {
      "go_packages": [
        "internal/web"
      ]
    },
    "data": [],
    "removal_policy": "retain-data",
    "locales": {
      "en": {
        "changelog.intro": "Everything that shipped, newest first. Each release links to itself, so you can point someone at the exact one.",
        "changelog.title": "Changelog"
      },
      "es": {
        "changelog.intro": "Todo lo que se ha lanzado, lo más reciente primero. Cada versión enlaza a sí misma, para que puedas señalar exactamente cuál.",
        "changelog.title": "Novedades"
      }
    }
  }
}
